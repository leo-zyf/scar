  "source_text": "#include <stddef.h>\nstatic double factor(double a) { return a * 2.0 + 1.0; }\nvoid closed_region(double *restrict out, const double *restrict x, size_t n, double a) {\n    for (size_t i = 0; i < n; ++i) {\n        double k = factor(a);\n        double u = x[i] * k;\n        double v = x[i] * k;\n        double unused = x[i] * 13.0;\n        out[i] = u + v;\n    }\n}\nextern double external_operation(double);\nvoid opaque_region(double *restrict out, const double *restrict x, size_t n) {\n    for (size_t i = 0; i < n; ++i) out[i] = external_operation(x[i]);\n}\n",
