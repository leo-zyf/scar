#include "contour_scene.hpp"

#include <exception>
#include <iostream>

int main(int argc, char** argv) {
    if (argc != 3) {
        std::cerr << "usage: scar_contour_scene INPUT OUTPUT\n";
        return 2;
    }
    try {
        const auto grid = scar::contour::read_input(argv[1]);
        const auto bands = scar::contour::filled_grid(grid);
        scar::contour::write_output(argv[2], bands);
        return 0;
    } catch (const std::exception& signal) {
        std::cerr << signal.what() << '\n';
        return 1;
    }
}
