#include <array>
#include <charconv>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <span>
#include <string>
#include <string_view>

namespace {

using Integer = std::int64_t;
using Cells = std::span<const Integer>;

struct Decline {};
struct Row { std::string_view key; Cells cells; };
struct Table { std::string_view version; std::span<const Row> rows; };

@SCAR_TABLE_DEFINITION@

[[maybe_unused]] bool ascii(std::string_view text) {
    for (unsigned char value : text) {
        if (value > 0x7f) {
            return false;
        }
    }
    return true;
}

[[maybe_unused]] Integer parse_integer(std::string_view text) {
    Integer value{};
    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), value);
    if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size()) {
        throw Decline{};
    }
    return value;
}

[[maybe_unused]] std::string parse_string(std::string_view text) {
    if (!ascii(text)) {
        throw Decline{};
    }
    return std::string(text);
}

constexpr Integer low = std::numeric_limits<Integer>::min();
constexpr Integer high = std::numeric_limits<Integer>::max();

[[maybe_unused]] Integer add(Integer a, Integer b) {
    if ((b > 0 && a > high - b) || (b < 0 && a < low - b)) {
        throw Decline{};
    }
    return a + b;
}

[[maybe_unused]] Integer sub(Integer a, Integer b) {
    if ((b > 0 && a < low + b) || (b < 0 && a > high + b)) {
        throw Decline{};
    }
    return a - b;
}

[[maybe_unused]] Integer floor_div(Integer a, Integer b) {
    if (b == 0 || (a == low && b == -1)) {
        throw Decline{};
    }
    const auto remainder = a % b;
    return a / b - (remainder != 0 && ((remainder < 0) != (b < 0)));
}

[[maybe_unused]] Integer absolute(Integer number) {
    if (number == low) {
        throw Decline{};
    }
    return number < 0 ? -number : number;
}

[[maybe_unused]] std::string upper_ascii(std::string value) {
    for (char& byte : value) {
        if ('a' <= byte && byte <= 'z') {
            byte = static_cast<char>(byte - 'a' + 'A');
        }
    }
    return value;
}

[[maybe_unused]] bool contains(std::string_view element, std::string_view text) {
    return text.find(element) != std::string_view::npos;
}

[[maybe_unused]] std::size_t checked_index(Integer index, std::size_t size) {
    if (size > static_cast<std::uint64_t>(high)) {
        throw Decline{};
    }
    const auto length = static_cast<Integer>(size);
    const auto offset = index < 0 ? index + length : index;
    if (offset < 0 || offset >= length) {
        throw Decline{};
    }
    return static_cast<std::size_t>(offset);
}

[[maybe_unused]] Integer item(Cells cells, Integer index) {
    return cells[checked_index(index, cells.size())];
}

[[maybe_unused]] std::string item(const std::string& value, Integer index) {
    return std::string(1, value[checked_index(index, value.size())]);
}

[[maybe_unused]] Cells table_row(const Table& table, std::string_view key) {
    for (const auto& row : table.rows) {
        if (row.key == key) {
            return row.cells;
        }
    }
    throw Decline{};
}

@SCAR_EVALUATOR@

int write_result(Integer result) {
    std::array<char, 22> bytes;
    const auto formatted = std::to_chars(bytes.data(), bytes.data() + bytes.size() - 1, result);
    *formatted.ptr = '\n';
    const auto size = static_cast<std::size_t>(formatted.ptr - bytes.data()) + 1;
    return std::fwrite(bytes.data(), 1, size, stdout) == size && std::fflush(stdout) == 0 ? 0 : 1;
}

}  // namespace

int main(int argc, char** argv) {
    try {
        if (argc != @SCAR_ARGC@) {
            throw Decline{};
        }
        const std::string_view version(argv[1]);
        for (const Table& table : tables) {
            if (table.version == version) {
@SCAR_INPUT_SETUP@
                const auto result = evaluate(table, @SCAR_INPUTS@);
                return write_result(result);
            }
        }
    } catch (const Decline&) {
    }
    std::fputs("score input is outside the admitted version or scalar domain\n", stderr);
    return 2;
}
