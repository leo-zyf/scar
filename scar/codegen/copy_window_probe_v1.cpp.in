#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include "stateful_abi_v1.h"
#include <algorithm>
#include <array>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <cstddef>
#include <cstdint>
#include <limits>
#include <memory>
#include <new>
#include <sched.h>
#include <time.h>
#include <unistd.h>
#include <vector>
#if !defined(__GNUC__) || defined(__clang__)
#error This paired canonical observer requires GNU g++ and noipa.
#endif
#pragma STDC FENV_ACCESS ON

namespace {
static_assert(sizeof(double) == 8 && sizeof(intptr_t) == 8);
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
constexpr int selected_cpu = @CPU_ID@;
constexpr int32_t affinity_guard_status = SCAR_CPU_AFFINITY_GUARD_V1;
constexpr int floating_flags = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;
@AFFINITY_CLASS@
@FLOATING_CLASS@

constexpr std::array<std::array<int64_t, 2>, @ARRAY_COUNT@> array_shapes = {{@ARRAY_SHAPES@}};
constexpr std::array<uint64_t, @SLOT_COUNT@> slot_capacities = {{@SLOT_CAPACITIES@}};
constexpr std::array<size_t, @TARGET_COUNT@> target_slots = {{@TARGET_SLOTS@}};
struct CopyPort { size_t source, target; uint64_t elements; };
constexpr std::array<CopyPort, @COPY_COUNT@> copy_ports = {{@COPY_PORTS@}};

bool clock_ns(uint64_t &output) noexcept {
    timespec stamp{};
    if (clock_gettime(CLOCK_MONOTONIC, &stamp) != 0 || stamp.tv_sec < 0 ||
        stamp.tv_nsec < 0 || stamp.tv_nsec >= 1000000000L) return false;
    const auto seconds = static_cast<uint64_t>(stamp.tv_sec), nanos = static_cast<uint64_t>(stamp.tv_nsec);
    if (seconds > (std::numeric_limits<uint64_t>::max()-nanos)/UINT64_C(1000000000)) return false;
    output = seconds*UINT64_C(1000000000)+nanos;
    return true;
}

__attribute__((noinline, noipa))
int32_t original_window(const scar_array_v1 *arrays, std::vector<std::unique_ptr<double[]>> &slots,
                        uint64_t *elapsed) {
    uint64_t start = 0, end = 0;
    if (!clock_ns(start)) return 3;
    asm volatile("" : : : "memory");
@ORIGINAL_BODY@
    asm volatile("" : : @LIVENESS_OPERANDS@ : "memory");
    if (!clock_ns(end) || end <= start) return 3;
    *elapsed = end-start;
    return 0;
}

__attribute__((noinline, noipa))
int32_t fused_window(const scar_array_v1 *arrays, std::vector<std::unique_ptr<double[]>> &slots,
                     uint64_t *elapsed) {
    uint64_t start = 0, end = 0;
    if (!clock_ns(start)) return 3;
    asm volatile("" : : : "memory");
@FUSED_BODY@
    asm volatile("" : : @LIVENESS_OPERANDS@ : "memory");
    if (!clock_ns(end) || end <= start) return 3;
    *elapsed = end-start;
    return 0;
}

int32_t sample(uint64_t repetitions, uint64_t warmup, uint64_t *elapsed_pairs,
               uint64_t *checksums, int32_t *orders, ThreadAffinity &affinity) {
    __int128 payload = 0;
    for (const auto &shape : array_shapes) payload += __int128(shape[0])*shape[1]*sizeof(double);
    for (const auto capacity : slot_capacities) payload += capacity;
    if (payload != @PAYLOAD_BYTES@ULL || payload > @MAX_PAYLOAD_BYTES@ULL ||
        payload > @MEMORY_BUDGET_BYTES@ULL || payload > std::numeric_limits<ptrdiff_t>::max()) return 7;
    if (!affinity.contains(selected_cpu) || !affinity.bind(selected_cpu)) return 4;
    std::vector<std::unique_ptr<double[]>> inputs(array_shapes.size()), slots(slot_capacities.size());
    std::vector<scar_array_v1> arrays(array_shapes.size());
    for (size_t index = 0; index < array_shapes.size(); ++index) {
        const auto rows = array_shapes[index][0], cols = array_shapes[index][1];
        const uint64_t count = uint64_t(rows)*uint64_t(cols);
        if (count) {
            inputs[index].reset(new (std::nothrow) double[count]);
            if (!inputs[index]) return 5;
            std::fill_n(inputs[index].get(), count, 1.25+static_cast<double>(index)*0.125);
        }
        auto &array = arrays[index]; array.data = inputs[index].get(); array.rank = 2;
        array.shape[0] = rows; array.shape[1] = cols;
        array.strides[0] = cols*int64_t(sizeof(double)); array.strides[1] = sizeof(double);
        array.lower_bound = reinterpret_cast<uintptr_t>(array.data);
        array.upper_bound = array.lower_bound+count*sizeof(double);
    }
    for (size_t index = 0; index < slot_capacities.size(); ++index) if (slot_capacities[index]) {
        slots[index].reset(new (std::nothrow) double[slot_capacities[index]/sizeof(double)]);
        if (!slots[index]) return 5;
        std::fill_n(slots[index].get(), slot_capacities[index]/sizeof(double), 0.0);
    }
    for (uint64_t pair = 0; pair < repetitions+warmup; ++pair) {
        uint64_t pair_elapsed[2]{}, pair_checksums[2]{};
        const int32_t order = static_cast<int32_t>(pair%2);
        for (uint64_t visit = 0; visit < 2; ++visit) {
            const uint64_t variant = (visit+uint64_t(order))%2;
            for (const auto slot : target_slots)
                if (slot_capacities[slot]) std::fill_n(slots[slot].get(), slot_capacities[slot]/sizeof(double), 0.0);
            if (std::feclearexcept(floating_flags) != 0) return 3;
            const int32_t status = variant == 0
                ? original_window(arrays.data(), slots, &pair_elapsed[variant])
                : fused_window(arrays.data(), slots, &pair_elapsed[variant]);
            if (status != 0 || std::fetestexcept(floating_flags)) return status ? status : 3;
            if (!affinity.bound()) return 4;
            // All verification and checksum reads follow the end timestamp.
            uint64_t checksum = UINT64_C(14695981039346656037);
            for (const auto &port : copy_ports) {
                const auto *source = static_cast<const double *>(arrays[port.source].data);
                const auto *target = slots[port.target].get();
                for (uint64_t index = 0; index < port.elements; ++index) {
                    const uint64_t original = std::bit_cast<uint64_t>(source[index]);
                    const uint64_t output = std::bit_cast<uint64_t>(target[index]);
                    if (original != output) return 2;
                    checksum ^= output;
                    checksum *= UINT64_C(1099511628211);
                }
            }
            pair_checksums[variant] = checksum;
        }
        if (pair_checksums[0] != pair_checksums[1]) return 2;
        if (pair >= warmup) {
            const uint64_t row = pair-warmup;
            elapsed_pairs[2*row] = pair_elapsed[0]; elapsed_pairs[2*row+1] = pair_elapsed[1];
            checksums[2*row] = pair_checksums[0]; checksums[2*row+1] = pair_checksums[1];
            orders[row] = order;
        }
    }
    return 0;
}
}

// Output buffers are caller-owned: uint64[2*repetitions] elapsed/checksums,
// int32[repetitions] orders. Failure invalidates every partial sample.
extern "C" SCAR_EXPORT_V1 int32_t scar_copy_window_probe_v1(
    uint64_t repetitions, uint64_t warmup, uint64_t *elapsed_pairs,
    uint64_t *checksums, int32_t *orders) {
    if (repetitions < 1 || repetitions > 10000 || warmup > 10000 ||
        elapsed_pairs == nullptr || checksums == nullptr || orders == nullptr) return 1;
    FloatingScope floating;
    if (!floating.begin()) return 3;
    int32_t status = 0;
    {
        // Helper and payload destruction finish before final FENV restoration.
        ThreadAffinity affinity;
        try {
            status = sample(repetitions, warmup, elapsed_pairs, checksums, orders, affinity);
        } catch (const std::bad_alloc &) {
            status = 5;
        }
        if (!affinity.restore_original()) status = 4;
    }
    if (!floating.restore()) return 3;
    return status;
}
