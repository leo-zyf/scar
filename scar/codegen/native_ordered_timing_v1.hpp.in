#pragma once

#include <algorithm>
#include <array>
#include <charconv>
#include <cinttypes>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <new>
#include <sched.h>
#include <stdexcept>
#include <string_view>
#include <sys/mman.h>
#include <time.h>
#include <utility>

namespace scar::ordered_timing_v1 {

enum class Phase {
    entry, ingress, dispatch_bootstrap, issue_prepare, issue_send,
    ordered_wait_receive_header, ordered_receive_payload, retire, digest_update,
    publication_finalize, drain_reap, lifetime, bootstrap, receive_request,
    solve, numeric_provider_solve, send_response, close_receive, count
};

constexpr std::array phase_names{
    "entry", "ingress", "dispatch_bootstrap", "issue_prepare", "issue_send",
    "ordered_wait_receive_header", "ordered_receive_payload", "retire", "digest_update",
    "publication_finalize", "drain_reap", "lifetime", "bootstrap", "receive_request",
    "solve", "numeric_provider_solve", "send_response", "close_receive"
};
static_assert(phase_names.size() == static_cast<std::size_t>(Phase::count));

struct Totals {
    std::uint64_t count = 0;
    std::uint64_t total_wall = 0, total_cpu = 0;
    std::uint64_t min_wall = 0, max_wall = 0, min_cpu = 0, max_cpu = 0;

    void add(std::uint64_t wall, std::uint64_t cpu) noexcept {
        total_wall += wall;
        total_cpu += cpu;
        min_wall = count ? std::min(min_wall, wall) : wall;
        max_wall = std::max(max_wall, wall);
        min_cpu = count ? std::min(min_cpu, cpu) : cpu;
        max_cpu = std::max(max_cpu, cpu);
        ++count;
    }
};

struct alignas(64) Lane {
    int cpu_start = -1, cpu_end = -1;
    std::array<Totals, phase_names.size()> phases;
};

inline Lane* shared = nullptr;
inline Lane* current = nullptr;
inline bool valid_clock = true;

inline std::uint64_t clock_ns(clockid_t clock) noexcept {
    timespec value{};
    if (clock_gettime(clock, &value) != 0) {
        valid_clock = false;
    }
    return std::uint64_t(value.tv_sec) * 1000000000 + std::uint64_t(value.tv_nsec);
}

struct Scope {
    explicit Scope(Phase phase) noexcept : phase_(phase), wall_(clock_ns(CLOCK_MONOTONIC)),
                                           cpu_(clock_ns(CLOCK_PROCESS_CPUTIME_ID)) {}
    Scope(const Scope&) = delete;
    Scope& operator=(const Scope&) = delete;
    ~Scope() { finish(); }

    void finish_as(Phase phase) noexcept {
        phase_ = phase;
        finish();
    }

    void finish() noexcept {
        if (!open_) {
            return;
        }
        const auto cpu = clock_ns(CLOCK_PROCESS_CPUTIME_ID);
        const auto wall = clock_ns(CLOCK_MONOTONIC);
        if (valid_clock && wall >= wall_ && cpu >= cpu_) {
            current->phases[static_cast<std::size_t>(phase_)].add(wall - wall_, cpu - cpu_);
        }
        open_ = false;
    }

private:
    Phase phase_;
    std::uint64_t wall_, cpu_;
    bool open_ = true;
};

template<class Call>
decltype(auto) measure(Phase phase, Call&& call) {
    Scope scope(phase);
    return std::forward<Call>(call)();
}

inline void worker_slot(std::size_t slot) noexcept { current = shared + slot + 1; }
inline void cpu_start() noexcept { current->cpu_start = sched_getcpu(); }
inline void cpu_end() noexcept { current->cpu_end = sched_getcpu(); }

class Probe {
public:
    explicit Probe(std::size_t workers) : lanes_(workers + 1), bytes_(lanes_ * sizeof(Lane)) {
        const auto argument = std::getenv("SCAR_ORDERED_TIMING_FD");
        if (!argument) {
            throw std::runtime_error("ordered diagnostic requires its private timing descriptor");
        }
        const std::string_view text(argument);
        const auto parsed = std::from_chars(text.data(), text.data() + text.size(), fd_);
        if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size() || fd_ < 3) {
            throw std::runtime_error("invalid ordered diagnostic timing descriptor");
        }
        auto* memory = mmap(nullptr, bytes_, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
        if (memory == MAP_FAILED) {
            throw std::runtime_error("cannot allocate ordered diagnostic aggregates");
        }
        shared = static_cast<Lane*>(memory);
        for (std::size_t lane = 0; lane < lanes_; ++lane) {
            new (shared + lane) Lane{};
        }
        current = shared;
    }
    Probe(const Probe&) = delete;
    Probe& operator=(const Probe&) = delete;
    ~Probe() { munmap(shared, bytes_); }

    void publish() const {
        auto* stream = fdopen(fd_, "w");
        if (!valid_clock || !stream) {
            throw std::runtime_error("ordered diagnostic timing clocks or descriptor failed");
        }
        bool success = std::fputs("SCAR_ORDERED_TIMING_V1\n", stream) >= 0;
        for (std::size_t i = 0; i < lanes_; ++i) {
            const auto& lane = shared[i];
            success &= std::fprintf(stream, "lane %zu %d %d\n", i, lane.cpu_start, lane.cpu_end) >= 0;
            for (std::size_t phase = 0; phase < phase_names.size(); ++phase) {
                const auto& totals = lane.phases[phase];
                if (totals.count == 0) {
                    continue;
                }
                success &= std::fprintf(stream, "%s %" PRIu64 " %" PRIu64 " %" PRIu64 " %" PRIu64
                    " %" PRIu64 " %" PRIu64 " %" PRIu64 "\n", phase_names[phase], totals.count,
                    totals.total_wall, totals.total_cpu, totals.min_wall, totals.max_wall, totals.min_cpu,
                    totals.max_cpu) >= 0;
            }
        }
        if (std::fclose(stream) != 0 || !success) {
            throw std::runtime_error("cannot write ordered diagnostic aggregates");
        }
    }

private:
    std::size_t lanes_, bytes_;
    int fd_ = -1;
};

}  // namespace scar::ordered_timing_v1
