#pragma once

#include <array>
#include <cfenv>
#include <charconv>
#include <clocale>
#include <cmath>
#include <cstdint>
#include <cstdlib>
#include <filesystem>
#include <iostream>
#include <limits>
#include <stdexcept>
#include <string>
#include <string_view>
#include <utility>
#include <vector>

class ScarPublicArgvError : public std::runtime_error {
public:
    using std::runtime_error::runtime_error;
};

namespace scar::public_argv {
enum class Kind { Int, Float, Bool, String, Help };
struct Value {
    Kind kind;
    std::string_view text;
};
struct Option {
    Kind supplied;
    Value initial;
};
struct Flag {
    std::string_view name;
    std::size_t index;
};

inline constexpr std::array<Option, @OPTION_COUNT@> options{{@OPTIONS@}};
inline constexpr std::array<Flag, @FLAG_COUNT@> flags{{@FLAGS@}};
constexpr std::size_t missing = options.size();
constexpr std::size_t help = @HELP_INDEX@;
constexpr bool abbreviate = @ABBREVIATE@;
inline constexpr std::string_view help_text = @HELP_TEXT@;

struct ParsedValue {
    Kind kind;
    std::string text;
};

inline bool digit(char value) {
    return value >= '0' && value <= '9';
}

inline std::size_t exact(std::string_view name) {
    for (const auto& flag : flags)
        if (flag.name == name) return flag.index;
    return missing;
}

enum class Token { Positional, Unknown, Ambiguous, Option };
struct Match {
    Token type;
    std::size_t index = missing;
    std::string_view name{};
    std::string_view operand{};
    bool attached = false;
    bool equals = false;
};

inline Match match(std::string_view token) {
    if (token.size() < 2 || token[0] != '-') return {Token::Positional};
    const auto equal = token.find('=');
    const auto name = token.substr(0, equal);
    const auto explicit_value = equal == token.npos ? std::string_view{} : token.substr(equal + 1);
    if (const auto index = exact(name); index != missing)
        return {Token::Option, index, name, explicit_value, equal != token.npos, equal != token.npos};

    if (token[1] == '-') {
        if (abbreviate) {
            const Flag* resolved = nullptr;
            for (const auto& flag : flags) {
                if (!flag.name.starts_with(name)) continue;
                if (resolved) return {Token::Ambiguous};
                resolved = &flag;
            }
            if (resolved)
                return {Token::Option, resolved->index, resolved->name, explicit_value,
                        equal != token.npos, equal != token.npos};
        }
    } else {
        const auto short_name = token.substr(0, 2);
        if (const auto index = exact(short_name); index != missing)
            return {Token::Option, index, short_name, token.substr(2), true};
        const auto first = token[1] == '.' ? 2U : 1U;
        // CPython's qualified argparse version matches the numeric prefix.
        if (first < token.size() && digit(token[first])) return {Token::Positional};
    }
    if (token.find(' ') != token.npos) return {Token::Positional};
    return {Token::Unknown};
}

inline std::string scrub_number(std::string_view token) {
    constexpr std::string_view whitespace = " \t\n\r\f\v";
    const auto first = token.find_first_not_of(whitespace);
    if (first == token.npos) return {};
    const auto last = token.find_last_not_of(whitespace);
    token = token.substr(first, last - first + 1);
    std::string cleaned;
    cleaned.reserve(token.size());
    for (std::size_t i = 0; i < token.size(); ++i) {
        if (token[i] != '_') cleaned.push_back(token[i]);
        else if (i == 0 || i + 1 == token.size() || !digit(token[i-1]) || !digit(token[i+1])) return {};
    }
    return cleaned;
}

inline bool decimal_float(std::string_view token) {
    std::size_t i = 0;
    if (i < token.size() && (token[i] == '-' || token[i] == '+')) ++i;
    auto take_digits = [&] {
        const auto begin = i;
        while (i < token.size() && digit(token[i])) ++i;
        return i > begin;
    };
    bool mantissa = take_digits();
    if (i < token.size() && token[i] == '.') {
        ++i;
        mantissa = take_digits() || mantissa;
    }
    if (!mantissa) return false;
    if (i < token.size() && (token[i] == 'e' || token[i] == 'E')) {
        ++i;
        if (i < token.size() && (token[i] == '-' || token[i] == '+')) ++i;
        if (!take_digits()) return false;
    }
    return i == token.size();
}

inline std::string convert(Kind kind, std::string_view raw, std::string_view option) {
    if (kind == Kind::String) return std::string(raw);
    const auto clean = scrub_number(raw);
    if (kind == Kind::Int && !clean.empty() && (clean[0] != '+' || (clean.size() > 1 && digit(clean[1])))) {
        const auto* start = clean.data() + (clean[0] == '+');
        const auto* end = clean.data() + clean.size();
        std::int64_t number{};
        const auto result = std::from_chars(start, end, number);
        if (result.ec == std::errc{} && result.ptr == end) return std::to_string(number);
    }
    if (kind == Kind::Float && decimal_float(clean)) {
        if (std::fegetround() != FE_TONEAREST || std::string_view(std::localeconv()->decimal_point) != ".")
            throw ScarPublicArgvError("native float conversion requires default rounding and decimal point");
        const double number = std::strtod(clean.c_str(), nullptr);
        std::array<char, 64> buffer{};
        const auto result = std::to_chars(buffer.data(), buffer.data() + buffer.size(), number,
                                          std::chars_format::general, std::numeric_limits<double>::max_digits10);
        if (std::isfinite(number) && result.ec == std::errc{})
            return std::string(buffer.data(), result.ptr);
    }
    throw ScarPublicArgvError("invalid " + std::string(kind == Kind::Int ? "int64" : "finite float") +
                             " value for " + std::string(option) + ": " + std::string(raw));
}

inline void print_help(std::string_view program) {
    constexpr std::string_view placeholder = "SCAR_ENTRY_PROGRAM";
    const auto slash = program.find_last_of('/');
    if (slash != program.npos) program.remove_prefix(slash + 1);
    auto remainder = help_text;
    for (auto pos = remainder.find(placeholder); pos != remainder.npos; pos = remainder.find(placeholder)) {
        std::cout << remainder.substr(0, pos) << program;
        remainder.remove_prefix(pos + placeholder.size());
    }
    std::cout << remainder;
}

inline std::vector<ParsedValue> parse(int argc, char* argv[]) {
    std::vector<ParsedValue> values;
    values.reserve(options.size());
    for (const auto& option : options)
        values.push_back({option.initial.kind, std::string(option.initial.text)});

    for (int i = 1; i < argc; ++i) {
        const std::string_view token = argv[i];
        if (token == "--") break;
        auto current = match(token);
        if (current.type == Token::Ambiguous)
            throw ScarPublicArgvError("ambiguous option: " + std::string(token));
        if (current.type != Token::Option) continue;
        bool requested_help = false;
        for (;;) {
            const auto index = current.index;
            const auto kind = options[index].supplied;
            if (kind != Kind::Bool && kind != Kind::Help) {
                if (!current.attached) {
                    if (i + 1 == argc || std::string_view(argv[i+1]) == "--" ||
                            match(argv[i+1]).type != Token::Positional)
                        throw ScarPublicArgvError(std::string(current.name) + " expects one argument");
                    current.operand = argv[++i];
                }
                values[index] = {kind, convert(kind, current.operand, current.name)};
                break;
            }
            if (current.attached && (current.equals || current.name.starts_with("--") ||
                    current.operand.empty() || current.operand.front() == '-'))
                throw ScarPublicArgvError(std::string(current.name) + " does not take a value");
            if (index == help) requested_help = true;
            else values[index] = {Kind::Bool, "true"};
            if (!current.attached) break;
            const std::array<char, 2> short_flag{'-', current.operand.front()};
            const std::string_view short_name(short_flag.data(), short_flag.size());
            const auto next = exact(short_name);
            if (next == missing) break;
            auto tail = current.operand.substr(1);
            const bool equals = tail.starts_with('=');
            const bool attached = !tail.empty();
            if (equals) tail.remove_prefix(1);
            // The returned spelling is backed by the static flag table.
            for (const auto& flag : flags) {
                if (flag.name == short_name) {
                    current = {Token::Option, next, flag.name, tail, attached, equals};
                    break;
                }
            }
        }
        if (requested_help) {
            print_help(argv[0]);
            return {};
        }
    }
    return values;
}

inline void append(std::vector<std::string>& arguments, std::string_view target, const ParsedValue& value) {
    const char* flag = nullptr;
    switch (value.kind) {
        case Kind::Int: flag = "--int"; break;
        case Kind::Float: flag = "--float"; break;
        case Kind::Bool: flag = "--bool"; break;
        default: throw ScarPublicArgvError("original option does not bind a native scalar");
    }
    arguments.emplace_back(flag);
    arguments.emplace_back(target);
    arguments.push_back(value.text);
}

inline std::string absolute_directory(const ParsedValue& value) {
    if (value.kind != Kind::String || value.text.empty())
        throw ScarPublicArgvError("native directory requires a nonempty original string");
    // Avoid collapsing '..' across symbolic links.
    auto directory = std::filesystem::absolute(value.text);
    if (directory.has_relative_path() && directory.filename().empty()) directory = directory.parent_path();
    return directory.string();
}
}

static std::vector<std::string> lower_controller_argv(int argc, char* argv[]) {
    using namespace scar::public_argv;
    const auto values = parse(argc, argv);
    if (values.empty()) return {};
@BRANCH_GUARD@
    std::vector<std::string> arguments{
        argv[0], "--iteration-limit", std::to_string(std::numeric_limits<std::uint64_t>::max()),
        "--effect-directory", @DIRECTORY_NAME@, absolute_directory(@DIRECTORY_VALUE@)};
@BINDINGS@
    return arguments;
}
