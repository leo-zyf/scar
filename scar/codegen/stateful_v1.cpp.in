#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include "stateful_abi_v1.h"
#include <array>
#include <bit>
#include <cfenv>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <limits>
#include <memory>
#include <new>
#include <cerrno>
#include <sched.h>
#include <unistd.h>
@OPENMP_INCLUDE@
#pragma STDC FENV_ACCESS ON

namespace {
static_assert(sizeof(double) == 8 && sizeof(intptr_t) == 8);
constexpr int planned_cpu_ids[] = {@CPU_IDS@};
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
constexpr int floating_flags = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;
constexpr int32_t affinity_guard_status = SCAR_CPU_AFFINITY_GUARD_V1;
@AFFINITY_CLASS@
@FLOATING_CLASS@

bool finite(double value) {
    return (std::bit_cast<uint64_t>(value) & UINT64_C(0x7ff0000000000000)) !=
           UINT64_C(0x7ff0000000000000);
}
bool valid_array(const scar_array_v1 &a, int64_t rows, int64_t cols) {
    if (a.rank != 2 || a.shape[0] != rows || a.shape[1] != cols ||
        a.lower_bound > a.upper_bound || reinterpret_cast<uintptr_t>(a.data) % alignof(double)) return false;
    if (!rows || !cols) return true;
    if (a.data == nullptr || (cols > 1 && a.strides[1] != 8) ||
        (rows > 1 && a.strides[0] != cols * 8)) return false;
    const __int128 address = reinterpret_cast<uintptr_t>(a.data), bytes = __int128(rows) * cols * 8;
    return bytes <= std::numeric_limits<ptrdiff_t>::max() && address >= a.lower_bound &&
           address + bytes <= a.upper_bound;
}
bool overlap(const scar_array_v1 &a, const scar_array_v1 &b) {
    return a.lower_bound < a.upper_bound && b.lower_bound < b.upper_bound &&
           a.lower_bound < b.upper_bound && b.lower_bound < a.upper_bound;
}

struct Scalar { double value = 0; bool integer = false; };
Scalar scalar_op(Scalar a, Scalar b, char op, uint32_t &guard) {
    if (a.integer && b.integer && op != '/') {
        const __int128 x = static_cast<int64_t>(a.value), y = static_cast<int64_t>(b.value);
        const __int128 result = op == '+' ? x+y : op == '-' ? x-y : x*y;
        if (result < -(__int128(1) << 53) || result > (__int128(1) << 53)) {
            guard |= 1; return {};
        }
        return {static_cast<double>(result), true};
    }
    const double result = op == '+' ? a.value+b.value : op == '-' ? a.value-b.value :
                          op == '*' ? a.value*b.value : a.value/b.value;
    if (!finite(result)) guard |= 1;
    return {result, false};
}
Scalar scalar_neg(Scalar a) { return {-a.value, a.integer}; }

int32_t run(const scar_array_v1 *arrays, uint64_t array_count,
            const scar_scalar_v1 *scalars, uint64_t scalar_count,
            const scar_provider_v1 *providers, uint64_t provider_count) {
    if (array_count != @ARRAY_COUNT@ || scalar_count != @SCALAR_COUNT@ ||
        provider_count != @PROVIDER_COUNT@ || (array_count && !arrays) ||
        (scalar_count && !scalars) || (provider_count && !providers)) return 1;
@ARRAY_GUARDS@
    for (uint64_t i = 0; i < array_count; ++i)
        for (uint64_t j = 0; j < i; ++j) if (overlap(arrays[i], arrays[j])) return 1;
    for (uint64_t i = 0; i < provider_count; ++i) if (!providers[i].loop || !providers[i].context) return 6;
    constexpr std::array<uint64_t, @SLOT_COUNT@> capacities = {@SLOT_CAPACITIES@};
    __int128 total = 0;
    for (uint64_t bytes : capacities) {
        if (bytes % 8 || bytes > std::numeric_limits<ptrdiff_t>::max()) return 7;
        total += bytes;
    }
    __int128 external = 0;
    for (uint64_t i = 0; i < array_count; ++i) external += __int128(arrays[i].shape[0]) * arrays[i].shape[1] * 8;
    if (total != @PAYLOAD_BYTES@ULL || external != @EXTERNAL_BYTES@ULL ||
        total + external != @TOTAL_BYTES@ULL || total + external > @BUDGET@ULL) return 7;
    std::array<std::unique_ptr<double[]>, @SLOT_COUNT@> slots;
    for (size_t i = 0; i < slots.size(); ++i) if (capacities[i]) {
        slots[i].reset(new (std::nothrow) double[capacities[i] / 8]);
        if (!slots[i]) return 5;
    }
    ThreadAffinity caller_affinity;
    for (int cpu : planned_cpu_ids) if (!caller_affinity.contains(cpu)) return 4;
    FloatingScope caller_environment;
    if (!caller_environment.begin()) return 3;
    fenv_t execution_environment;
    if (std::fegetenv(&execution_environment) != 0) return 3;
    for (uint64_t i = 0; i < scalar_count; ++i)
        if (!finite(scalars[i].value) || (scalars[i].integer != 0 && scalars[i].integer != 1) ||
            (scalars[i].integer && (std::abs(scalars[i].value) > 0x1p53 ||
                                   std::trunc(scalars[i].value) != scalars[i].value))) return 8;
    uint32_t numeric_guard = 0, placement_guard = 0;
@INPUT_FINITE_GUARDS@
@SCALAR_DECLARATIONS@
@EXECUTION@
    numeric_guard |= static_cast<uint32_t>(std::fetestexcept(floating_flags) != 0);
    const bool environment_restored = caller_environment.restore();
    const bool affinity_restored = caller_affinity.restore_original();
    if (numeric_guard || !environment_restored) return 3;
    if (placement_guard || !affinity_restored) return 4;
    // All failing work is complete. From this point only nonthrowing copies
    // commit final shadows to original write ROIs; no failure can fall back.
@COMMITS@
    return 0;
}
const scar_stateful_table_v1 table = {1, sizeof(scar_stateful_table_v1),
    @ARRAY_COUNT@, @SCALAR_COUNT@, @PROVIDER_COUNT@, &run,
    "@REGION_SHA256@", "@PLAN_SHA256@", "@CONTRACT_SHA256@"};
}
extern "C" SCAR_EXPORT_V1 const scar_stateful_table_v1 *scar_get_stateful_table_v1() { return &table; }
