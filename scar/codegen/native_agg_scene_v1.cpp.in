#include <algorithm>
#include <array>
#include <bit>
#include <cstdint>
#include <cstdio>
#include <fstream>
#include <limits>
#include <stdexcept>
#include <string_view>
#include <vector>

#include "_backend_agg.h"

namespace {
static_assert(std::endian::native == std::endian::little && sizeof(double) == 8);
constexpr std::uint64_t budget = 64'000'000;

void require(bool ok, const char* reason) {
    if (!ok) throw std::runtime_error(reason);
}

template<class T, std::size_t Rank>
struct Values {
    std::array<std::uint32_t, Rank> dimensions{};
    std::vector<T> values;

    std::size_t shape(std::size_t index) const { return dimensions[index]; }
    T& operator()(std::size_t i, std::size_t j = 0, std::size_t k = 0) {
        if constexpr (Rank == 3) return values.at((i * shape(1) + j) * shape(2) + k);
        if constexpr (Rank == 2) return values.at(i * shape(1) + j);
        return values.at(i);
    }
    T* mutable_data(std::size_t i, std::size_t j) { return &(*this)(i, j); }
};

template<class T, std::size_t Rank>
std::size_t safe_first_shape(const Values<T, Rank>& value) {
    return value.values.empty() ? 0 : value.shape(0);
}

class Tape {
    std::ifstream file_;
    std::uint64_t consumed_ = 0;

public:
    explicit Tape(const char* name) : file_(name, std::ios::binary) {}

    void bytes(void* data, std::uint64_t length) {
        require(length <= budget - consumed_, "AGG tape byte budget exceeded");
        consumed_ += length;
        if (length) require(bool(file_.read(static_cast<char*>(data), length)), "truncated AGG tape");
    }

    template<class T>
    T take() {
        T value{};
        bytes(&value, sizeof value);
        return value;
    }

    template<class T, std::size_t Rank>
    Values<T, Rank> values() {
        Values<T, Rank> item;
        bytes(item.dimensions.data(), sizeof item.dimensions);
        std::uint64_t count = 1;
        for (auto size : item.dimensions) {
            require(size <= budget && (!size || count <= budget / size), "invalid AGG array size");
            count *= size;
        }
        require(count <= (budget - consumed_) / sizeof(T), "AGG array byte budget exceeded");
        item.values.resize(count);
        bytes(item.values.data(), count * sizeof(T));
        return item;
    }

    bool end() { return file_.peek() == EOF && file_.eof(); }
};

agg::trans_affine transform(Tape& tape) {
    std::array<double, 6> values;
    tape.bytes(values.data(), sizeof values);
    return {values[0], values[1], values[2], values[3], values[4], values[5]};
}

agg::rgba color(Tape& tape) {
    std::array<double, 4> values;
    tape.bytes(values.data(), sizeof values);
    return {values[0], values[1], values[2], values[3]};
}

mpl::PathIterator path(Tape& tape) {
    auto vertices = tape.values<double, 2>();
    auto codes = tape.values<std::uint8_t, 1>();
    require((vertices.values.empty() || vertices.shape(1) == 2) &&
            (codes.values.empty() || codes.values.size() == vertices.shape(0)), "invalid AGG path geometry");
    const bool simplify = tape.take<std::uint8_t>();
    const auto threshold = tape.take<double>();
    return {std::move(vertices.values), std::move(codes.values), simplify, threshold};
}

Dashes dashes(Tape& tape) {
    Dashes result;
    result.set_dash_offset(tape.take<double>());
    const auto count = tape.take<std::uint32_t>();
    require(count <= 128, "too many AGG dash pairs");
    for (std::uint32_t i = 0; i < count; ++i) {
        const auto length = tape.take<double>();
        result.add_dash_pair(length, tape.take<double>());
    }
    return result;
}

void state(Tape& tape, GCAgg& gc) {
    gc.linewidth = tape.take<double>();
    gc.alpha = tape.take<double>();
    gc.forced_alpha = tape.take<std::uint8_t>();
    gc.color = color(tape);
    gc.isaa = tape.take<std::uint8_t>();
    const auto cap = tape.take<std::uint8_t>();
    const auto join = tape.take<std::uint8_t>();
    const auto snap = tape.take<std::uint8_t>();
    constexpr std::array caps{agg::butt_cap, agg::square_cap, agg::round_cap};
    constexpr std::array joins{agg::miter_join_revert, agg::round_join, agg::bevel_join};
    constexpr std::array snaps{SNAP_AUTO, SNAP_FALSE, SNAP_TRUE};
    gc.cap = caps.at(cap);
    gc.join = joins.at(join);
    gc.snap_mode = snaps.at(snap);
    std::array<double, 4> rect;
    tape.bytes(rect.data(), sizeof rect);
    gc.cliprect = {rect[0], rect[1], rect[2], rect[3]};
    gc.sketch = {0., 0., 0.};
    gc.hatch_color = {0., 0., 0., 0.};
    gc.hatch_linewidth = 0.;
    gc.dashes = dashes(tape);
}

struct Paths {
    using path_iterator = mpl::PathIterator;
    std::vector<path_iterator> paths;
    std::size_t num_paths() const { return paths.size(); }
    path_iterator operator()(std::size_t index) { return paths.at(index % paths.size()); }
};

void collection(RendererAgg& renderer, GCAgg& gc, Tape& tape) {
    auto mat = transform(tape);
    Paths paths;
    const auto path_count = tape.take<std::uint32_t>();
    require(path_count <= 16384, "too many AGG collection paths");
    for (std::uint32_t i = 0; i < path_count; ++i) paths.paths.push_back(path(tape));
    auto matrices = tape.values<double, 3>();
    auto offsets = tape.values<double, 2>();
    auto ot = transform(tape);
    auto fill = tape.values<double, 2>();
    auto edge = tape.values<double, 2>();
    auto widths = tape.values<double, 1>();
    DashesVector lines;
    const auto count = tape.take<std::uint32_t>();
    require(count <= 16384, "too many AGG line styles");
    for (std::uint32_t i = 0; i < count; ++i) lines.push_back(dashes(tape));
    auto antialias = tape.values<std::uint8_t, 1>();
    auto hatches = tape.values<double, 2>();
    require(!antialias.values.empty(), "missing AGG collection antialias setting");
    renderer.draw_path_collection(gc, mat, paths, matrices, offsets, ot, fill, edge, widths, lines, antialias, hatches);
}

void draw(RendererAgg& renderer, Tape& tape) {
    const auto opcode = tape.take<std::uint8_t>();
    if (opcode == 0) {
        renderer.clear();
        return;
    }
    GCAgg gc;
    state(tape, gc);
    if (opcode == 1) {
        auto points = path(tape);
        auto affine = transform(tape);
        auto fill = color(tape);
        renderer.draw_path(gc, points, affine, fill);
    } else if (opcode == 2) {
        auto mark = path(tape);
        auto mark_affine = transform(tape);
        auto points = path(tape);
        auto affine = transform(tape);
        auto fill = color(tape);
        renderer.draw_markers(gc, mark, mark_affine, points, affine, fill);
    } else if (opcode == 3) {
        auto image = tape.values<std::uint8_t, 2>();
        const auto x = tape.take<std::int32_t>();
        const auto y = tape.take<std::int32_t>();
        const auto angle = tape.take<double>();
        require(!image.values.empty() || angle == 0.0, "rotated empty AGG glyph is out of scope");
        renderer.draw_text_image(gc, image, x, y, angle);
    } else if (opcode == 4) {
        collection(renderer, gc, tape);
    } else {
        throw std::runtime_error("unsupported AGG tape operation");
    }
}
}

int main(int argc, char** argv) {
    try {
        require(argc == 3, "expected DRAW_TAPE OUTPUT_RGBA");
        Tape tape(argv[1]);
        std::array<char, 8> magic;
        tape.bytes(magic.data(), magic.size());
        require(std::string_view(magic.data(), magic.size()) == "SCARAGG1", "unsupported AGG tape version");
        const auto width = tape.take<std::uint32_t>();
        const auto height = tape.take<std::uint32_t>();
        const auto dpi = tape.take<double>();
        const auto count = tape.take<std::uint32_t>();
        require(width && height && width <= 16384 && height <= 16384
                && std::uint64_t{4} * width * height <= budget && dpi > 0 && dpi <= 16384 && count <= 65536,
                "unsupported AGG surface or draw count");
        RendererAgg renderer(width, height, dpi);
        for (std::uint32_t i = 0; i < count; ++i) draw(renderer, tape);
        require(tape.end(), "trailing AGG tape bytes");
        auto* output = std::fopen(argv[2], "wbx");
        require(output != nullptr, "cannot open fresh AGG output");
        const auto wrote = std::fwrite(renderer.pixBuffer, 1, renderer.NUMBYTES, output);
        const auto closed = std::fclose(output);
        require(wrote == renderer.NUMBYTES && closed == 0, "cannot write complete AGG raster");
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
