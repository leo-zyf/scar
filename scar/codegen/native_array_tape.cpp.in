#include "numpy_complex.hpp"

#include <array>
#include <cfenv>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <string>
#include <vector>

#ifdef SCAR_ARRAY_TAPE_NORMALIZE
extern "C" int scar_numpy_normalize_v1(std::size_t, const void*, void*) noexcept;
#endif

namespace {
enum class Op { basis, literal, copy, multiply, add, normalize, checkpoint };
struct Step {
    Op operation;
    std::int64_t count, repeat;
    std::array<std::int64_t, 3> offset, stride, advance;
    std::size_t argument;
};

@STEPS@

constexpr auto fp_errors = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;
constexpr std::size_t item = 16;

bool write_checkpoint(const std::string& file, const std::vector<char>& bytes) {
    auto* stream = std::fopen(file.c_str(), "wbx");
    if (stream == nullptr) return false;
    auto written = std::fwrite(bytes.data(), 1, bytes.size(), stream);
    return std::fclose(stream) == 0 && written == bytes.size();
}

bool execute_round(char* base, std::size_t begin, std::size_t end,
                   bool capture, std::vector<std::vector<char>>& checkpoints) {
    for (auto index = begin; index < end; ++index) {
        const auto& step = steps[index];
        auto* output = base + step.offset[2];
        const auto* input = base + step.offset[0];
        switch (step.operation) {
        case Op::basis: {
            std::memset(output, 0, item * step.count);
            const double one = 1.0;
            std::memcpy(output + item * step.argument, &one, sizeof(one));
            break;
        }
        case Op::literal:
            std::memcpy(output, coefficients[step.argument].data(), step.count);
            break;
        case Op::copy:
            if (step.stride[0] == item && step.stride[2] == item) {
                std::memcpy(output, input, item * step.count);
            } else {
                for (std::int64_t i = 0; i < step.count; ++i) {
                    std::memcpy(output + i * step.stride[2], input + i * step.stride[0], item);
                }
            }
            break;
        case Op::multiply:
        case Op::add: {
            auto loop = step.operation == Op::multiply ? scar_numpy_complex_multiply : scar_numpy_complex_add;
            if (std::feclearexcept(fp_errors) != 0) return false;
            std::int64_t strides[]{step.stride[0], step.stride[1], step.stride[2]};
            for (std::int64_t index = 0; index < step.repeat; ++index) {
                char* operands[3];
                for (unsigned n = 0; n < 3; ++n) {
                    operands[n] = base + step.offset[n] + step.advance[n] * index;
                }
                loop(operands, &step.count, strides, nullptr);
            }
            if (std::fetestexcept(fp_errors)) return false;
            break;
        }
        case Op::normalize:
#ifdef SCAR_ARRAY_TAPE_NORMALIZE
            if (scar_numpy_normalize_v1(step.count, input, output) != static_cast<int>(step.argument))
                return false;
            break;
#else
            return false;
#endif
        case Op::checkpoint:
            if (capture) checkpoints[step.argument].assign(input, input + step.count);
            break;
        }
    }
    return true;
}
}

int main(int argc, char** argv) {
    if (argc > 2 || !scar_numpy_complex_runtime_supported()) return 2;
    bool record = argc == 2;
    std::unique_ptr<void, decltype(&std::free)> arena(std::aligned_alloc(64, arena_bytes), &std::free);
    if (!arena) return 2;
    std::vector<std::vector<char>> checkpoints(record ? checkpoint_count : 0);
    for (const auto& round : rounds) {
        if (!execute_round(static_cast<char*>(arena.get()), round[0], round[1], record, checkpoints)) {
            std::fputs("original floating-point or selection contract declined\n", stderr);
            return 3;
        }
    }
    if (record) {
        for (std::size_t index = 0; index < checkpoints.size(); ++index) {
            if (!write_checkpoint(std::string(argv[1]) + "." + std::to_string(index) + ".bin", checkpoints[index]))
                return 4;
        }
    }
    return 0;
}
