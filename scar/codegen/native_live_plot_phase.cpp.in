#include "native_live_plot_phase.hpp"

#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#if SCAR_PLOT_PHASE_DETAIL
#include <zlib.h>
#endif

namespace scar::plot_phase {
namespace {
thread_local Metrics counters;
thread_local Scope* active_scope = nullptr;

struct Log {
    std::FILE* output = nullptr;
    bool initialized = false;
    std::uint64_t sequence = 0;
    std::uint64_t frame = 0;

    ~Log() { if (output) std::fclose(output); }

    bool enable() noexcept {
        if (initialized) return output;
        initialized = true;
        const char* path = std::getenv("SCAR_PLOT_PHASE_LOG");
        if (!path || !*path) return false;
        const int fd = ::open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK, 0600);
        if (fd < 0) return false;
        struct stat status{};
        if (::fstat(fd, &status) == 0 && S_ISREG(status.st_mode)) output = ::fdopen(fd, "a");
        if (!output) ::close(fd);
        return output;
    }

    void write(const char* operation, bool success, std::uint64_t elapsed, const Metrics& before) noexcept {
        const bool render = std::strcmp(operation, "render") == 0;
        const bool destroy = std::strcmp(operation, "destroy") == 0;
        const long long index = render ? static_cast<long long>(frame++) : -1;
        std::fprintf(output,
            "{\"schema\":\"scar.plot-phase-sample\",\"schema_version\":%u,\"backend\":\"%s\","
            "\"sequence\":%llu,\"operation\":\"%s\",\"frame\":%lld,\"success\":%s,\"wall_ns\":%llu",
            row_schema_version, backend, static_cast<unsigned long long>(sequence), operation, index,
            success ? "true" : "false",
            static_cast<unsigned long long>(elapsed));
        for (std::size_t i = 0; i < names.size(); ++i) {
            std::fprintf(output, ",\"%s_ns\":%llu,\"%s_count\":%llu",
                names[i], static_cast<unsigned long long>(counters.ns[i] - before.ns[i]),
                names[i], static_cast<unsigned long long>(counters.count[i] - before.count[i]));
        }
        std::fputs("}\n", output);
        if (destroy) {
            ++sequence;
            frame = 0;
        }
    }
};

thread_local Log log;
}

Scope::Scope(Phase phase) noexcept
    : phase_(static_cast<std::size_t>(phase)), begin_(Clock::now()), parent_(active_scope) {
    active_scope = this;
}

Scope::~Scope() {
    const auto elapsed = nanoseconds(begin_, Clock::now());
    counters.ns[phase_] += elapsed - children_;
    ++counters.count[phase_];
    if (parent_) parent_->children_ += elapsed;
    active_scope = parent_;
}

#if SCAR_PLOT_PHASE_DETAIL
void Scope::record_leaf(Phase phase, std::uint64_t elapsed) noexcept {
    const auto index = static_cast<std::size_t>(phase);
    counters.ns[index] += elapsed;
    ++counters.count[index];
    if (active_scope) active_scope->children_ += elapsed;
}
#endif

Operation::Operation(const char* name, bool active) noexcept : name_(name), logging_(active && log.enable()) {
    if (logging_) {
        before_ = counters;
        begin_ = Clock::now();
    }
}

Operation::~Operation() {
    if (logging_) log.write(name_, success_, nanoseconds(begin_, Clock::now()), before_);
}

}

extern "C" void scar_plot_phase_reset_v1() noexcept {
    if (!scar::plot_phase::active_scope) scar::plot_phase::counters = {};
}

extern "C" void scar_plot_phase_snapshot_v1(scar::plot_phase::Metrics* metrics) noexcept {
    if (metrics) *metrics = scar::plot_phase::counters;
}

#if SCAR_PLOT_PHASE_DETAIL
extern "C" SCAR_EXPORT_V1 std::uint64_t scar_plot_png_filter_begin_v2() noexcept {
    using namespace scar::plot_phase;
    return nanoseconds(Clock::time_point{}, Clock::now());
}

extern "C" SCAR_EXPORT_V1 void scar_plot_png_filter_end_v2(std::uint64_t begin) noexcept {
    using namespace scar::plot_phase;
    const auto elapsed = nanoseconds(Clock::time_point{}, Clock::now()) - begin;
    Scope::record_leaf(Phase::PngFilterSelection, elapsed);
}

extern "C" int scar_plot_png_deflate_v2(z_streamp stream, int flush) noexcept {
    using namespace scar::plot_phase;
    const Scope scope(Phase::PngDeflate);
    return ::deflate(stream, flush);
}

extern "C" int scar_plot_png_deflate_init_v2(z_streamp stream, int level, int method, int window,
                                             int memory, int strategy) noexcept {
    using namespace scar::plot_phase;
    const Scope scope(Phase::PngZlibLifecycle);
    return ::deflateInit2(stream, level, method, window, memory, strategy);
}

extern "C" int scar_plot_png_deflate_dictionary_v2(z_streamp stream, const Bytef* dictionary, uInt size) noexcept {
    using namespace scar::plot_phase;
    const Scope scope(Phase::PngZlibLifecycle);
    return ::deflateSetDictionary(stream, dictionary, size);
}

extern "C" int scar_plot_png_deflate_end_v2(z_streamp stream) noexcept {
    using namespace scar::plot_phase;
    const Scope scope(Phase::PngZlibLifecycle);
    return ::deflateEnd(stream);
}
#endif
