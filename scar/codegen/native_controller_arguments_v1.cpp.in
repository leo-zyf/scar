    require(argc >= 7 && std::string_view(argv[1]) == "--effect-library" &&
            std::string_view(argv[3]) == "--iteration-limit" && std::string_view(argv[5]) == "--state-out",
            "expected --effect-library FILE --iteration-limit N --state-out FILE");
    const auto* effect_path = argv[2];
    const auto iteration_limit = number<std::uint64_t>(argv[4]);
    require(iteration_limit > 0, "positive iteration limit required");
    const auto requested = fs::absolute(fs::path(argv[6]));
    require(!requested.filename().empty() && requested.filename() != "." && requested.filename() != "..",
            "controller state output must be a file");
    const auto controller_out = fs::canonical(requested.parent_path()) / requested.filename();
    std::array<scar_controller_value_v1, @SLOT_COUNT@> controller_slots{};
    int next = 7;
@EFFECT_ARGUMENTS@    const auto read = [&](std::string_view path) -> scar_controller_value_v1 {
        require(next + 2 < argc && std::string_view(argv[next+1]) == path,
                "expected a typed scalar controller input in declared order");
        const std::string_view flag = argv[next], value = argv[next+2];
        next += 3;
        if (flag == "--int") return {SCAR_CONTROLLER_INT64_V1, 0, number<std::int64_t>(value), 0, nullptr, 0};
        if (flag == "--float") {
            const auto floating = number<double>(value);
            require(std::isfinite(floating), "nonfinite controller input");
            return {SCAR_CONTROLLER_FLOAT64_V1, 0, 0, floating, nullptr, 0};
        }
        require(flag == "--bool" && (value == "true" || value == "false"),
                "expected --int, --float, or --bool for a controller slot");
        return {SCAR_CONTROLLER_BOOL_V1, 0, value == "true", 0, nullptr, 0};
    };
@CONTROLLER_INPUTS@@GUARDS@@STARTUP@    auto arguments = bind(argc - next + 1, argv + next - 1);
    require(!fs::exists(fs::symlink_status(controller_out)) &&
            std::find(arguments.outputs.begin(), arguments.outputs.end(), controller_out) == arguments.outputs.end(),
            "controller output must have a fresh distinct path");
@STARTUP_SCALARS@@NUMBER_INPUTS@@STARTUP_SLOTS@
