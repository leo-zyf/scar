#include "controller_effect_abi_v1.h"

#include <array>
#include <bit>
#include <cfenv>
#include <charconv>
#include <cmath>
#include <cstdint>
#include <limits>
#include <string>
#include <string_view>
#include <utility>
#include <variant>
#if defined(__x86_64__)
#include <xmmintrin.h>
#endif

namespace {
struct Unbound {};
using None = std::monostate;
using Value = std::variant<Unbound, None, std::int64_t, double, bool, std::string>;
using Port = scar_controller_value_v1;

constexpr int invalid_abi = -1;
constexpr int unsupported_scalar = -2;
constexpr int missing_callback = -3;
constexpr int iteration_limit = -4;
constexpr int runtime_failure = -5;
constexpr std::size_t max_text = 1024 * 1024;
constexpr std::size_t slot_count = @SLOT_COUNT@;
constexpr std::size_t register_count = @REGISTER_COUNT@;
constexpr std::size_t array_count = @ARRAY_COUNT@;
constexpr std::array<bool, slot_count> entry_arguments{{@ENTRY_ARGUMENTS@}};

struct Failure { int status; };
void require(bool condition, int status = unsupported_scalar) {
    if (!condition) throw Failure{status};
}

bool floating_context() {
#if defined(__x86_64__)
    // Default SSE rounding, no flush/denormals-to-zero, masked exceptions.
    if ((_mm_getcsr() & 0xffc0u) != 0x1f80u) return false;
#endif
    return std::fegetround() == FE_TONEAREST;
}

bool integral(const Value& value) {
    return std::holds_alternative<std::int64_t>(value) || std::holds_alternative<bool>(value);
}
std::int64_t integer(const Value& value) {
    if (const auto* flag = std::get_if<bool>(&value)) return *flag ? 1 : 0;
    const auto* item = std::get_if<std::int64_t>(&value);
    require(item != nullptr);
    return *item;
}
bool numeric(const Value& value) {
    return integral(value) || std::holds_alternative<double>(value);
}
double floating(const Value& value) {
    if (const auto* item = std::get_if<double>(&value)) return *item;
    return static_cast<double>(integer(value));
}
long double comparison_value(const Value& value) {
    static_assert(std::numeric_limits<long double>::digits >= 64);
    if (const auto* item = std::get_if<double>(&value)) return *item;
    return static_cast<long double>(integer(value));
}
const Value& bound(const Value& value) {
    require(!std::holds_alternative<Unbound>(value));
    return value;
}
bool truth(const Value& value) {
    if (integral(value)) return integer(value) != 0;
    if (const auto* item = std::get_if<double>(&value)) return *item != 0.0;
    if (const auto* item = std::get_if<std::string>(&value)) return !item->empty();
    require(std::holds_alternative<None>(value));
    return false;
}

Value from_port(const Port& port) {
    require(port.reserved == 0, invalid_abi);
    switch (port.kind) {
    case SCAR_CONTROLLER_NONE_V1:
        return None{};
    case SCAR_CONTROLLER_INT64_V1:
        return port.integer;
    case SCAR_CONTROLLER_FLOAT64_V1:
        require(std::isfinite(port.floating), invalid_abi);
        return port.floating;
    case SCAR_CONTROLLER_BOOL_V1:
        require(port.integer == 0 || port.integer == 1, invalid_abi);
        return port.integer == 1;
    case SCAR_CONTROLLER_UTF8_V1:
        require(port.text_size <= max_text && (port.text || !port.text_size), invalid_abi);
        return std::string(port.text ? port.text : "", port.text_size);
    default:
        throw Failure{invalid_abi};
    }
}

Port to_port(const Value& value) {
    Port port{};
    if (std::holds_alternative<None>(value)) return port;
    if (const auto* item = std::get_if<std::int64_t>(&value)) {
        port.kind = SCAR_CONTROLLER_INT64_V1;
        port.integer = *item;
    } else if (const auto* item = std::get_if<double>(&value)) {
        port.kind = SCAR_CONTROLLER_FLOAT64_V1;
        port.floating = *item;
    } else if (const auto* item = std::get_if<bool>(&value)) {
        port.kind = SCAR_CONTROLLER_BOOL_V1;
        port.integer = *item;
    } else {
        const auto* text = std::get_if<std::string>(&value);
        require(text != nullptr);
        port.kind = SCAR_CONTROLLER_UTF8_V1;
        port.text = text->data();
        port.text_size = text->size();
    }
    return port;
}

enum class Op { Add, Sub, Mult, Div, Mod, Lt, LtE, Gt, GtE, Eq, NotEq, USub, UAdd, Not };

bool equal(const Value& left, const Value& right) {
    if (numeric(left) && numeric(right)) return comparison_value(left) == comparison_value(right);
    if (const auto* text = std::get_if<std::string>(&left)) {
        const auto* other = std::get_if<std::string>(&right);
        return other && *text == *other;
    }
    return std::holds_alternative<None>(left) && std::holds_alternative<None>(right);
}

Value binary(Op op, const Value& left, const Value& right) {
    if (op == Op::Eq || op == Op::NotEq) return equal(left, right) == (op == Op::Eq);
    require(numeric(left) && numeric(right));
    if (op == Op::Lt || op == Op::LtE || op == Op::Gt || op == Op::GtE) {
        const auto x = comparison_value(left), y = comparison_value(right);
        return op == Op::Lt ? x < y : op == Op::LtE ? x <= y : op == Op::Gt ? x > y : x >= y;
    }
    if (integral(left) && integral(right) && op != Op::Div) {
        const auto x = integer(left), y = integer(right);
        std::int64_t result = 0;
        if (op == Op::Add) require(!__builtin_add_overflow(x, y, &result));
        else if (op == Op::Sub) require(!__builtin_sub_overflow(x, y, &result));
        else if (op == Op::Mult) require(!__builtin_mul_overflow(x, y, &result));
        else {
            require(op == Op::Mod && y != 0);
            if (y != -1) {
                result = x % y;
                if (result && (result < 0) != (y < 0)) result += y;
            }
        }
        return result;
    }
    require(op == Op::Add || op == Op::Sub || op == Op::Mult || op == Op::Div);
    if (op == Op::Div && integral(left) && integral(right)) {
        constexpr auto exact = std::int64_t{1} << 53;
        auto x = integer(left), y = integer(right);
        require(x >= -exact && x <= exact && y >= -exact && y <= exact);
    }
    const auto x = floating(left), y = floating(right);
    require(op != Op::Div || y != 0.0);
    const auto result = op == Op::Add ? x + y : op == Op::Sub ? x - y : op == Op::Mult ? x * y : x / y;
    require(std::isfinite(result));
    return result;
}

Value unary(Op op, const Value& value) {
    if (op == Op::Not) return !truth(value);
    require(op == Op::USub || op == Op::UAdd);
    if (integral(value)) {
        const auto item = integer(value);
        if (op == Op::UAdd) return item;
        require(item != std::numeric_limits<std::int64_t>::min());
        return -item;
    }
    return op == Op::USub ? -floating(value) : floating(value);
}

Value format(const Value& value, const Value& spec) {
    const auto* explicit_spec = std::get_if<std::string>(&spec);
    require(explicit_spec || std::holds_alternative<None>(spec));
    const std::string_view text = explicit_spec ? std::string_view(*explicit_spec) : std::string_view{};
    if (text.empty()) {
        if (const auto* item = std::get_if<std::string>(&value)) return *item;
        if (const auto* item = std::get_if<bool>(&value)) return std::string(*item ? "True" : "False");
        if (std::holds_alternative<None>(value)) return std::string("None");
    }
    std::array<char, 64> buffer{};
    std::to_chars_result result{};
    if (text == "e") {
        require(numeric(value));
        result = std::to_chars(buffer.data(), buffer.data() + buffer.size(), floating(value),
                               std::chars_format::scientific, 6);
    } else {
        require((text.empty() || text == "d") && integral(value));
        result = std::to_chars(buffer.data(), buffer.data() + buffer.size(), integer(value));
    }
    require(result.ec == std::errc{});
    return std::string(buffer.data(), result.ptr);
}

template<std::size_t Count>
Value join(const std::array<Value, Count>& parts) {
    std::string result;
    for (const auto& part : parts) {
        const auto* text = std::get_if<std::string>(&part);
        require(text && text->size() <= max_text - result.size());
        result.append(*text);
    }
    return result;
}

template<std::size_t Count>
std::array<Port, Count> to_ports(const std::array<Value, Count>& values) {
    std::array<Port, Count> result{};
    for (std::size_t i = 0; i < Count; ++i) result[i] = to_port(values[i]);
    return result;
}

struct Context {
    Port* input;
    const scar_array_v1* arrays;
    void* provider_context;
    scar_controller_update_v1 update;
    scar_controller_effect_v1 effect;
    std::uint64_t remaining;
    std::array<Value, slot_count> slots{};
    std::array<Value, register_count> registers{};
    std::array<bool, slot_count> dirty{};

    void tick() {
        require(remaining > 0, iteration_limit);
        --remaining;
    }

    int finish(const Value& result) {
        require(std::holds_alternative<None>(result));
        std::array<Port, slot_count> changed{};
        for (std::size_t i = 0; i < slot_count; ++i) {
            if (!dirty[i]) continue;
            changed[i] = to_port(slots[i]);
            require(changed[i].kind != SCAR_CONTROLLER_UTF8_V1);
        }
        for (std::size_t i = 0; i < slot_count; ++i) if (dirty[i]) input[i] = changed[i];
        return 0;
    }

    template<std::size_t Count>
    Value invoke_update(std::uint32_t ordinal, const std::array<Value, Count>& values) {
        require(update, missing_callback);
        const auto args = to_ports(values);
        std::array<Port, slot_count> current{};
        for (std::size_t i = 0; i < slot_count; ++i) {
            const auto& item = slots[i];
            if (!std::holds_alternative<Unbound>(item)) current[i] = to_port(item);
        }
        Port result{};
        const auto status = update(provider_context, ordinal, args.data(), args.size(),
                                   current.data(), current.size(), arrays, array_count, &result);
        require(status == 0, status);
        require(floating_context());
        return from_port(result);
    }

    template<std::size_t Count>
    Value invoke_effect(std::uint32_t ordinal, const std::array<Value, Count>& values) {
        require(effect, missing_callback);
        const auto args = to_ports(values);
        const auto status = effect(provider_context, ordinal, args.data(), args.size(), arrays, array_count);
        require(status == 0, status);
        require(floating_context());
        return None{};
    }
};

int execute(Context& ctx) {
@PROGRAM@
    return ctx.finish(None{});
}
}

extern "C" const char* scar_controller_plan_sha256_v1() noexcept {
    return "@PLAN_SHA256@";
}

extern "C" int scar_controller_run_v1(Port* slots, std::uint64_t nslots,
    const scar_array_v1* arrays, std::uint64_t narrays, void* context,
    scar_controller_update_v1 update, scar_controller_effect_v1 effect,
    std::uint64_t max_iterations) noexcept {
    try {
        require(nslots == slot_count && (slots || !nslots) && narrays == array_count &&
                (arrays || !narrays) && floating_context(), invalid_abi);
        Context ctx{slots, arrays, context, update, effect, max_iterations};
        for (std::size_t i = 0; i < slot_count; ++i) {
            if (entry_arguments[i]) ctx.slots[i] = from_port(slots[i]);
            else require(slots[i].kind == SCAR_CONTROLLER_NONE_V1 && slots[i].reserved == 0, invalid_abi);
        }
        return execute(ctx);
    } catch (Failure failure) {
        return failure.status;
    } catch (...) {
        return runtime_failure;
    }
}
