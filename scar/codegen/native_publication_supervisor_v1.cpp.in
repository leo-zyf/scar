#include <algorithm>
#include <array>
#include <cerrno>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <filesystem>
#include <span>
#include <stdexcept>
#include <string_view>
#include <system_error>
#include <utility>

#include <fcntl.h>
#include <poll.h>
#include <sched.h>
#include <signal.h>
#include <spawn.h>
#include <sys/syscall.h>
#include <sys/wait.h>
#include <unistd.h>

namespace {

constexpr bool split = @SCAR_SPLIT@;
constexpr int cpus[] = {@SCAR_CPUS@};
constexpr int owner = @SCAR_OWNER@;
constexpr int capacity = @SCAR_PIPE@;
constexpr auto budget = std::chrono::seconds{120};
using Clock = std::chrono::steady_clock;
using Deadline = Clock::time_point;
volatile sig_atomic_t cancelled = 0;

void request_shutdown(int) { cancelled = 1; }

void check_shutdown() {
    if (cancelled) {
        throw std::runtime_error("ordered publication interrupted");
    }
}

void require(int error, const char* message) {
    if (error) {
        throw std::system_error(error, std::generic_category(), message);
    }
}

class Fd {
public:
    explicit Fd(int fd = -1) noexcept : fd_(fd) {}
    Fd(const Fd&) = delete;
    Fd& operator=(const Fd&) = delete;
    Fd(Fd&& other) noexcept : fd_(std::exchange(other.fd_, -1)) {}
    ~Fd() { close_now(); }
    int get() const noexcept { return fd_; }
    void close_now() noexcept {
        if (fd_ >= 0) {
            close(std::exchange(fd_, -1));
        }
    }

private:
    int fd_;
};

std::array<Fd, 2> make_pipe() {
    int pair[2];
    require(pipe2(pair, O_CLOEXEC) < 0 ? errno : 0, "cannot open supervised publication pipe");
    return {Fd{pair[0]}, Fd{pair[1]}};
}

void ready(int fd, Deadline deadline) {
    pollfd watch{fd, POLLIN, 0};
    while (Clock::now() < deadline) {
        check_shutdown();
        const auto remaining = std::chrono::ceil<std::chrono::milliseconds>(deadline - Clock::now()).count();
        const int count = poll(&watch, 1, static_cast<int>(std::max<std::int64_t>(1, remaining)));
        if (count > 0) {
            if (!(watch.revents & (POLLIN | POLLHUP))) {
                throw std::runtime_error("unexpected publication descriptor status");
            }
            return;
        }
        if (count < 0 && errno != EINTR) {
            require(errno, "cannot wait for publication readiness");
        }
    }
    throw std::runtime_error("ordered publication exceeded its launch deadline");
}

class ChildSettings {
public:
    ChildSettings() {
        require(posix_spawn_file_actions_init(&files), "cannot allocate publication child file actions");
        const int error = posix_spawnattr_init(&attrs);
        if (error) {
            posix_spawn_file_actions_destroy(&files);
            require(error, "cannot allocate publication child attributes");
        }
    }
    ChildSettings(const ChildSettings&) = delete;
    ChildSettings& operator=(const ChildSettings&) = delete;
    ~ChildSettings() {
        posix_spawnattr_destroy(&attrs);
        posix_spawn_file_actions_destroy(&files);
    }
    posix_spawn_file_actions_t files;
    posix_spawnattr_t attrs;
};

class Child {
public:
    Child() = default;
    Child(const Child&) = delete;
    Child& operator=(const Child&) = delete;
    ~Child() {
        if (pid_ > 0) {
            kill(-pid_, SIGKILL);
            while (waitpid(pid_, nullptr, 0) < 0 && errno == EINTR) {}
        }
    }

    void launch(const std::filesystem::path& executable, const char* argument, int input, int output) {
        ChildSettings settings;
        require(posix_spawn_file_actions_addchdir_np(&settings.files, @SCAR_CWD@), "cannot set publication child directory");
        if (input != STDIN_FILENO) {
            require(posix_spawn_file_actions_adddup2(&settings.files, input, STDIN_FILENO), "cannot route child stdin");
        }
        require(posix_spawn_file_actions_adddup2(&settings.files, output, STDOUT_FILENO), "cannot route child stdout");
        require(posix_spawnattr_setflags(&settings.attrs, POSIX_SPAWN_SETPGROUP), "cannot set publication child group policy");
        require(posix_spawnattr_setpgroup(&settings.attrs, 0), "cannot create a private child group");
        char* arguments[] = {const_cast<char*>(executable.c_str()), const_cast<char*>(argument), nullptr};
        char* environment[] = {@SCAR_ENV@nullptr};
        pid_t issued;
        require(posix_spawn(&issued, executable.c_str(), &settings.files, &settings.attrs, arguments, environment),
            "cannot start the selected publication arm");
        pid_ = issued;
    }

    void successful(Deadline end) {
        Fd status_fd(static_cast<int>(syscall(SYS_pidfd_open, pid_, 0)));
        require(status_fd.get() < 0 ? errno : 0, "cannot observe publication child exit");
        ready(status_fd.get(), end);
        siginfo_t status{};
        int observed;
        do {
            observed = waitid(P_PID, static_cast<id_t>(pid_), &status, WEXITED | WNOWAIT);
        } while (observed < 0 && errno == EINTR);
        require(observed < 0 ? errno : 0, "cannot inspect publication child status");
        if (status.si_code != CLD_EXITED || status.si_status != 0) {
            throw std::runtime_error("a publication child did not exit successfully");
        }
        pid_t reaped;
        do {
            reaped = waitpid(pid_, nullptr, 0);
        } while (reaped < 0 && errno == EINTR);
        require(reaped < 0 ? errno : 0, "cannot reap publication child");
        pid_ = -1;
    }

private:
    pid_t pid_ = -1;
};

void set_affinity(std::span<const int> lane) {
    cpu_set_t mask;
    CPU_ZERO(&mask);
    for (const int cpu : lane) {
        CPU_SET(cpu, &mask);
    }
    require(sched_setaffinity(0, sizeof(mask), &mask) < 0 ? errno : 0, "cannot bind a publication lane");
}

std::array<char, 66> read_digest(int fd, Deadline end) {
    std::array<char, 66> data{};
    std::size_t used = 0;
    while (used < data.size()) {
        ready(fd, end);
        const auto count = read(fd, data.data() + used, data.size() - used);
        if (count < 0 && errno == EINTR) {
            continue;
        }
        require(count < 0 ? errno : 0, "cannot read the private digest line");
        if (count == 0) {
            break;
        }
        used += static_cast<std::size_t>(count);
    }
    if (used != 65 || data[64] != '\n' || !std::all_of(data.begin(), data.begin() + 64, [](char byte) {
            return (byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'f');
        })) {
        throw std::runtime_error("a publication child returned an invalid digest line");
    }
    return data;
}

void commit(std::span<const char> line) {
    check_shutdown();
    if (signal(SIGPIPE, SIG_IGN) == SIG_ERR) {
        require(errno, "cannot configure publication stdout");
    }
    while (!line.empty()) {
        const auto size = write(STDOUT_FILENO, line.data(), line.size());
        if (size < 0 && errno == EINTR) {
            continue;
        }
        require(size < 0 ? errno : size == 0 ? EIO : 0, "cannot write the committed digest line");
        line = line.subspan(static_cast<std::size_t>(size));
    }
}

void run() {
    require(signal(SIGCHLD, SIG_DFL) == SIG_ERR ? errno : 0, "cannot configure publication child ownership");
    struct sigaction stop{};
    stop.sa_handler = request_shutdown;
    sigemptyset(&stop.sa_mask);
    for (const int number : {SIGINT, SIGTERM, SIGHUP}) {
        require(sigaction(number, &stop, nullptr) < 0 ? errno : 0, "cannot configure publication shutdown");
    }
    for (const int fd : {STDIN_FILENO, STDOUT_FILENO, STDERR_FILENO}) {
        require(fcntl(fd, F_GETFD) < 0 ? errno : 0, "publication requires stdin, stdout and stderr");
    }
    cpu_set_t original;
    require(sched_getaffinity(0, sizeof(original), &original) < 0 ? errno : 0, "cannot inspect publication cpuset");
    for (const int cpu : cpus) {
        if (!CPU_ISSET(cpu, &original)) {
            throw std::runtime_error("the selected publication lane is outside the process affinity");
        }
    }
    const auto root = std::filesystem::canonical("/proc/self/exe").parent_path();
    const auto digest_program = root / @SCAR_DIGEST@;
    auto answer = make_pipe();
    Child producer, digest;
    const auto end = Clock::now() + budget;
@SCAR_START_INGRESS@    set_affinity(cpus);
    if constexpr (split) {
        auto records = make_pipe();
        if (fcntl(records[0].get(), F_GETPIPE_SZ) != capacity) {
            throw std::runtime_error("binary publication pipe capacity differs from the selected plan");
        }
        producer.launch(root / @SCAR_PRODUCER@, nullptr, @SCAR_INPUT@, records[1].get());
        records[1].close_now();
        set_affinity(std::span(&owner, 1));
        digest.launch(digest_program, "--consume-records", records[0].get(), answer[1].get());
    } else {
        digest.launch(digest_program, nullptr, @SCAR_INPUT@, answer[1].get());
        set_affinity(std::span(&owner, 1));
    }
@SCAR_CLOSE_INGRESS@    answer[1].close_now();
    const auto line = read_digest(answer[0].get(), end);
    digest.successful(end);
    if constexpr (split) {
        producer.successful(end);
    }
@SCAR_WAIT_INGRESS@    commit(std::span(line).first<65>());
}

}  // namespace

int main(int argc, char**) {
    try {
        if (argc != 1) {
            throw std::runtime_error("selected publication accepts @SCAR_INLET@ on stdin and no arguments");
        }
        run();
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
