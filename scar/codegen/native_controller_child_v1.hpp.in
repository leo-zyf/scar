#pragma once

#include "controller_effect_abi_v1.h"

#include <array>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <fcntl.h>
#include <memory>
#include <openssl/evp.h>
#include <signal.h>
#include <spawn.h>
#include <stdexcept>
#include <string>
#include <string_view>
#include <sys/stat.h>
#include <sys/wait.h>
#include <unistd.h>
#include <utility>

class ControllerChildOverlay {
public:
    enum class Completion { NotRun, Exited, Signaled, LaunchFailure, WaitFailure, GuardFailure };

    struct Outcome {
        Completion completion;
        int status;
    };

private:
    static constexpr std::uint32_t selected = @ORDINAL@;
    static constexpr const char* executable = @EXECUTABLE@;
    static constexpr std::string_view digest = "@EXECUTABLE_SHA256@";
    static constexpr std::size_t executable_size = @EXECUTABLE_SIZE@;
    static constexpr int launch_failed = -40;
    static constexpr int wait_failed = -41;
    static constexpr int child_guard_failed = -42;

    std::string directory_;
    Outcome outcome_{Completion::NotRun, 0};

    class File {
        int fd_;
    public:
        explicit File(const char* path) noexcept : fd_(::open(path, O_RDONLY | O_CLOEXEC)) {}
        File(const File&) = delete;
        ~File() { if (fd_ >= 0) ::close(fd_); }
        int get() const noexcept { return fd_; }
    };

    class SpawnSettings {
    public:
        posix_spawn_file_actions_t files;
        posix_spawnattr_t attributes;
        int error;

        SpawnSettings() noexcept
            : error(::posix_spawn_file_actions_init(&files)) {
            if (error) return;
            files_ready_ = true;
            error = ::posix_spawnattr_init(&attributes);
            if (error) return;
            attrs_ready_ = true;
            error = ::posix_spawn_file_actions_addclosefrom_np(&files, 3);
            if (error) return;
            sigset_t signals;
            if (::sigemptyset(&signals) != 0 || ::sigaddset(&signals, SIGPIPE) != 0
#ifdef SIGXFZ
                || ::sigaddset(&signals, SIGXFZ) != 0
#endif
#ifdef SIGXFSZ
                || ::sigaddset(&signals, SIGXFSZ) != 0
#endif
            ) {
                error = errno;
                return;
            }
            error = ::posix_spawnattr_setsigdefault(&attributes, &signals);
            if (!error) error = ::posix_spawnattr_setflags(&attributes, POSIX_SPAWN_SETSIGDEF);
        }

        SpawnSettings(const SpawnSettings&) = delete;
        ~SpawnSettings() {
            if (attrs_ready_) ::posix_spawnattr_destroy(&attributes);
            if (files_ready_) ::posix_spawn_file_actions_destroy(&files);
        }

    private:
        bool files_ready_ = false;
        bool attrs_ready_ = false;
    };

    static bool same_image(const struct stat& a, const struct stat& b) noexcept {
        return a.st_dev == b.st_dev && a.st_ino == b.st_ino && a.st_mode == b.st_mode && a.st_size == b.st_size &&
               a.st_mtim.tv_sec == b.st_mtim.tv_sec && a.st_mtim.tv_nsec == b.st_mtim.tv_nsec &&
               a.st_ctim.tv_sec == b.st_ctim.tv_sec && a.st_ctim.tv_nsec == b.st_ctim.tv_nsec;
    }

    static bool admitted_image() noexcept {
        const File file(executable);
        struct stat before{}, after{}, current{};
        if (file.get() < 0 || ::fstat(file.get(), &before) != 0 || !S_ISREG(before.st_mode) ||
            before.st_size != static_cast<off_t>(executable_size)) return false;
        std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> hash(EVP_MD_CTX_new(), EVP_MD_CTX_free);
        if (!hash || EVP_DigestInit_ex(hash.get(), EVP_sha256(), nullptr) != 1) return false;
        std::array<unsigned char, 16 * 1024> bytes;
        std::size_t observed = 0;
        for (;;) {
            const auto count = ::read(file.get(), bytes.data(), bytes.size());
            if (count < 0 && errno == EINTR) continue;
            if (count < 0 || static_cast<std::size_t>(count) > executable_size - observed) return false;
            if (!count) break;
            observed += count;
            if (EVP_DigestUpdate(hash.get(), bytes.data(), count) != 1) return false;
        }
        std::array<unsigned char, EVP_MAX_MD_SIZE> result;
        unsigned int length = 0;
        if (observed != executable_size || EVP_DigestFinal_ex(hash.get(), result.data(), &length) != 1 ||
            length * 2 != digest.size()) return false;
        constexpr std::string_view hex = "0123456789abcdef";
        for (std::size_t index = 0; index < length; ++index) {
            if (digest[index * 2] != hex[result[index] >> 4] ||
                digest[index * 2 + 1] != hex[result[index] & 0xf]) return false;
        }
        return ::fstat(file.get(), &after) == 0 && ::stat(executable, &current) == 0 &&
               same_image(before, after) && same_image(before, current);
    }

    std::string joined(std::string_view component) const {
        if (!component.empty() && component.front() == '/') return std::string(component);
        std::string result = directory_;
        if (!result.ends_with('/')) result += '/';
        result.append(component);
        return result;
    }

    int fail(Completion completion, int status, int error) noexcept {
        outcome_ = {completion, error};
        return status;
    }

    int launch() {
        std::array<std::string, @ARGUMENT_COUNT@> values{{
            @ARGUMENTS@
        }};
        std::array<char*, values.size() + 1> argv{};
        for (std::size_t index = 0; index < values.size(); ++index) argv[index] = values[index].data();
        SpawnSettings settings;
        if (settings.error) return fail(Completion::LaunchFailure, launch_failed, settings.error);
        if (!admitted_image()) return fail(Completion::GuardFailure, child_guard_failed, 0);
        pid_t pid = -1;
        const auto launch = ::posix_spawn(&pid, executable, &settings.files, &settings.attributes,
                                          argv.data(), ::environ);
        if (launch) return fail(Completion::LaunchFailure, launch_failed, launch);
        int status = 0;
        pid_t waited;
        do {
            waited = ::waitpid(pid, &status, 0);
        } while (waited < 0 && errno == EINTR);
        if (waited != pid) return fail(Completion::WaitFailure, wait_failed, waited < 0 ? errno : ECHILD);
        if (WIFEXITED(status)) {
            outcome_ = {Completion::Exited, WEXITSTATUS(status)};
            return 0;
        }
        if (WIFSIGNALED(status)) {
            outcome_ = {Completion::Signaled, WTERMSIG(status)};
            return 0;
        }
        return fail(Completion::WaitFailure, wait_failed, EPROTO);
    }

public:
    explicit ControllerChildOverlay(std::string directory) : directory_(std::move(directory)) {
        if (directory_.empty() || directory_.front() != '/' || directory_.find('\0') != std::string::npos)
            throw std::runtime_error("native child requires the original directory operand as an absolute path");
    }

    Outcome outcome() const noexcept { return outcome_; }

    template<class Delegate>
    int dispatch(std::uint32_t ordinal, const scar_controller_value_v1* arguments, std::uint64_t argument_count,
                 const scar_array_v1* roots, std::uint64_t root_count, Delegate&& forward) {
        if (ordinal != selected)
            return std::forward<Delegate>(forward)(ordinal, arguments, argument_count, roots, root_count);
        if (argument_count != 0) return fail(Completion::GuardFailure, child_guard_failed, 0);
        return launch();
    }
};
