#include "contour_scene.hpp"

#include <algorithm>
#include <array>
#include <bit>
#include <charconv>
#include <cstdio>
#include <fstream>
#include <stdexcept>
#include <string_view>
#include <vector>

namespace {
using scar::contour::Band;
using scar::contour::Grid;
constexpr std::uint64_t limit = 64'000'000;
static_assert(std::endian::native == std::endian::little && sizeof(double) == 8);

void require(bool ok, const char* status) {
    if (!ok) throw std::runtime_error(status);
}

class Tape {
    std::ifstream input_;
    std::uint64_t total_ = 0;

public:
    explicit Tape(const char* path) : input_(path, std::ios::binary) {}
    void read(void* data, std::size_t size) {
        require(size <= limit - total_, "contour template read budget exceeded");
        total_ += size;
        if (size) require(bool(input_.read(static_cast<char*>(data), size)), "truncated contour template");
    }
    template<class T>
    T take() {
        T value{};
        read(&value, sizeof value);
        return value;
    }
    bool end() { return input_.peek() == EOF && input_.eof(); }
};

class Scene {
    std::vector<char> data_;

public:
    void append(const void* data, std::size_t size) {
        if (!size) return;
        require(size <= limit - data_.size(), "contour scene exceeds output budget");
        const auto* start = static_cast<const char*>(data);
        data_.insert(data_.end(), start, start + size);
    }
    template<class T>
    void append(T value) { append(&value, sizeof value); }

    void literal(Tape& input) {
        const auto count = input.take<std::uint64_t>();
        require(count <= limit - data_.size(), "invalid contour template literal range");
        const auto first = data_.size();
        data_.resize(first + count);
        if (count) input.read(data_.data() + first, count);
    }

    void polygon_band(const Band& band, double threshold) {
        std::uint64_t total = 0;
        for (const auto& polygon : band) {
            total += polygon.codes.size();
            require(total <= limit / 17 && polygon.xy.size() == polygon.codes.size() * 2,
                    "contour point/code geometry differs");
            require(polygon.codes.empty() || polygon.codes.back() == 79, "expected closed original polygon");
        }
        const auto count = static_cast<std::uint32_t>(total);
        append(count);
        append(std::uint32_t{count ? 2U : 0U});
        for (const auto& polygon : band) append(polygon.xy.data(), polygon.xy.size() * sizeof(double));
        append(count);
        for (const auto& polygon : band) append(polygon.codes.data(), polygon.codes.size());
        // Closed path codes disable the original Path simplifier.
        append(std::uint8_t{0});
        append(threshold);
    }

    void publish(const char* path) const {
        auto* file = std::fopen(path, "wbx");
        require(file != nullptr, "expected a fresh contour scene output path");
        const auto wrote = std::fwrite(data_.data(), 1, data_.size(), file);
        const int closed = std::fclose(file);
        require(wrote == data_.size() && closed == 0, "could not publish complete contour scene");
    }
};

std::uint64_t number(const char* value) {
    const std::string_view text(value);
    std::uint64_t result{};
    const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), result);
    require(error == std::errc{} && end == text.data() + text.size() && result <= limit,
            "invalid native array root byte offset");
    return result;
}

std::vector<double> lattice(Tape& tape, const Grid& grid, const char* file, const char* offset) {
    const auto full_rows = tape.take<std::uint64_t>();
    const auto full_cols = tape.take<std::uint64_t>();
    const auto row = tape.take<std::uint64_t>();
    const auto col = tape.take<std::uint64_t>();
    require(full_rows && full_cols && full_rows <= limit / 8 / full_cols
            && row <= full_rows && grid.rows <= full_rows - row
            && col <= full_cols && grid.cols <= full_cols - col,
            "runtime root cannot contain original contour view");
    const auto begin = number(offset);
    std::ifstream input(file, std::ios::binary | std::ios::ate);
    const auto extent = input.tellg();
    require(extent >= 0 && static_cast<std::uint64_t>(extent) >= begin + full_rows * full_cols * 8,
            "runtime contour root file is shorter than its declared view");
    std::vector<double> values(grid.rows * grid.cols);
    for (std::size_t i = 0; i < grid.rows; ++i) {
        input.seekg(begin + ((row + i) * full_cols + col) * 8);
        require(bool(input.read(reinterpret_cast<char*>(&values[i * grid.cols]), grid.cols * 8)),
                "cannot read complete row of original contour input");
    }
    return values;
}

bool same_levels(const std::vector<double>& a, const std::vector<double>& b) {
    return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](double x, double y) {
        return std::bit_cast<std::uint64_t>(x) == std::bit_cast<std::uint64_t>(y);
    });
}

Grid input_grid(Tape& tape, int argc, char* argv[]) {
    Grid selected;
    selected.rows = tape.take<std::uint64_t>();
    selected.cols = tape.take<std::uint64_t>();
    selected.x_chunk_size = tape.take<std::uint64_t>();
    selected.y_chunk_size = tape.take<std::uint64_t>();
    selected.corner_mask = tape.take<std::uint64_t>();
    const auto count = tape.take<std::uint64_t>();
    require(selected.rows > 1 && selected.cols > 1 && selected.rows <= limit / 24 / selected.cols
            && count >= 2 && count <= 4097, "invalid native contour geometry or interval count");
    selected.levels.resize(count);
    tape.read(selected.levels.data(), count * 8);
    const auto root_count = tape.take<std::uint64_t>();
    require(root_count == 0 || root_count == 3, "invalid contour root denominator");
    if (argc == 9) {
        require(root_count == 3, "exact original root slices were not admitted");
        selected.x = lattice(tape, selected, argv[3], argv[4]);
        selected.y = lattice(tape, selected, argv[5], argv[6]);
        selected.z = lattice(tape, selected, argv[7], argv[8]);
        return selected;
    }
    for (std::uint64_t i = 0; i < 4 * root_count; ++i) tape.take<std::uint64_t>();
    auto runtime = scar::contour::read_input(argv[3]);
    require(runtime.rows == selected.rows && runtime.cols == selected.cols
            && runtime.x_chunk_size == selected.x_chunk_size && runtime.y_chunk_size == selected.y_chunk_size
            && runtime.corner_mask == selected.corner_mask && runtime.mask.empty()
            && same_levels(runtime.levels, selected.levels), "runtime grid/levels differ from the scene styles");
    return runtime;
}
}

int main(int argc, char** argv) {
    try {
        require(argc == 4 || argc == 9, "expected TEMPLATE OUTPUT CTI or TEMPLATE OUTPUT X OFF Y OFF Z OFF");
        Tape tape(argv[1]);
        std::array<char, 8> magic;
        tape.read(magic.data(), magic.size());
        require(std::string_view(magic.data(), magic.size()) == "SCARCTT1", "unsupported scene template");
        auto grid = input_grid(tape, argc, argv);
        auto bands = scar::contour::filled_grid(grid);
        Scene scene;
        const auto slots = tape.take<std::uint64_t>();
        require(slots && slots <= 128, "invalid contour scene slot count");
        for (std::uint64_t i = 0; i < slots; ++i) {
            scene.literal(tape);
            const auto count = tape.take<std::uint32_t>();
            require(count && count <= 4096, "invalid contour path table size");
            scene.append(count);
            for (std::uint32_t j = 0; j < count; ++j) {
                const auto band = tape.take<std::uint64_t>();
                const auto threshold = tape.take<double>();
                require(band < bands.size(), "contour band missing from original draw order");
                scene.polygon_band(bands[band], threshold);
            }
        }
        scene.literal(tape);
        require(tape.end(), "trailing contour template bytes");
        scene.publish(argv[2]);
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
