int main(int argc, char** argv) {
    try {
        require(argc == 4 || argc == 9, "expected TEMPLATE OUTPUT CTI or TEMPLATE OUTPUT X OFF Y OFF Z OFF");
        Tape tape(argv[1]);
        std::array<char, 8> magic;
        tape.read(magic.data(), magic.size());
        require(std::string_view(magic.data(), magic.size()) == "SCARCTT1", "unsupported scene template");
        auto grid = input_grid(tape, argc, argv);
        auto bands = scar::contour::filled_grid(grid);
        Scene scene;
        const auto slots = tape.take<std::uint64_t>();
        require(slots && slots <= 128, "invalid contour scene slot count");
        for (std::uint64_t i = 0; i < slots; ++i) {
            scene.literal(tape);
            const auto count = tape.take<std::uint32_t>();
            require(count && count <= 4096, "invalid contour path table size");
            scene.append(count);
            for (std::uint32_t j = 0; j < count; ++j) {
                const auto band = tape.take<std::uint64_t>();
                const auto threshold = tape.take<double>();
                require(band < bands.size(), "contour band missing from original draw order");
                scene.polygon_band(bands[band], threshold);
            }
        }
        scene.literal(tape);
        require(tape.end(), "trailing contour template bytes");
        scene.publish(argv[2]);
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
