#include "graph.hpp"

#include <ATen/ops/from_blob.h>

#include <algorithm>
#include <array>
#include <bit>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <limits>
#include <span>
#include <stdexcept>
#include <string>
#include <system_error>
#include <unistd.h>
#include <utility>
#include <vector>

namespace {
namespace graph = scar_aten_graph;
namespace fs = std::filesystem;

static_assert(graph::abi_version == 1);
static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559);
static_assert(std::endian::native == std::endian::little || std::endian::native == std::endian::big);

std::size_t checked_bytes(std::span<const std::int64_t> shape) {
    if (std::ranges::any_of(shape, [](auto size) { return size < 0; })) {
        throw std::runtime_error("negative tensor dimension");
    }
    if (std::ranges::find(shape, 0) != shape.end()) return 0;
    constexpr std::uintmax_t limit = std::min<std::uintmax_t>(
        std::numeric_limits<std::size_t>::max(), std::numeric_limits<std::streamsize>::max());
    std::size_t bytes = sizeof(float);
    for (auto size : shape) {
        const auto extent = static_cast<std::uintmax_t>(size);
        if (extent > limit / bytes) throw std::runtime_error("tensor byte size exceeds file ABI");
        bytes *= static_cast<std::size_t>(extent);
    }
    return bytes;
}

std::vector<float> read_tensor(const char* path, std::size_t bytes) {
    const auto expected = static_cast<std::streamsize>(bytes);
    std::ifstream source(path, std::ios::binary | std::ios::ate);
    if (!source || source.tellg() != expected || !source.seekg(0)) {
        throw std::runtime_error(std::string("input size differs from the graph contract: ") + path);
    }
    // Keep a non-null backing pointer even for a tensor with zero elements.
    std::vector<float> data(std::max<std::size_t>(1, bytes / sizeof(float)));
    if (!source.read(reinterpret_cast<char*>(data.data()), expected)
            || source.peek() != std::char_traits<char>::eof() || source.bad()) {
        throw std::runtime_error(std::string("could not read exact input bytes: ") + path);
    }
    return data;
}

struct StagedFile {
    std::string temporary;
    bool created = false;

    ~StagedFile() {
        if (created) unlink(temporary.c_str());
    }

    void stage(const fs::path& destination, const void* data, std::size_t bytes) {
        temporary = (destination.parent_path() / ".scar-f32-XXXXXX").string();
        const int fd = mkstemp(temporary.data());
        if (fd == -1) throw std::system_error(errno, std::generic_category(), temporary);
        created = true;
        const auto* next = static_cast<const char*>(data);
        while (bytes != 0) {
            const auto count = write(fd, next, bytes);
            if (count == -1 && errno == EINTR) continue;
            if (count <= 0) {
                const int error = count == 0 ? EIO : errno;
                close(fd);
                throw std::system_error(error, std::generic_category(), temporary);
            }
            next += count;
            bytes -= static_cast<std::size_t>(count);
        }
        if (close(fd) == -1) throw std::system_error(errno, std::generic_category(), temporary);
    }

    void publish(const fs::path& destination) const {
        // Hard-link only complete files. An existing entry, including a symlink, cannot be overwritten.
        if (link(temporary.c_str(), destination.c_str()) == -1) {
            throw std::system_error(errno, std::generic_category(), destination.string());
        }
    }
};

template <class Runner>
int invoke(char** paths, Runner&& runner) {
    std::array<fs::path, graph::output_count> destinations;
    for (std::size_t i = 0; i < destinations.size(); ++i) {
        const fs::path path(paths[graph::input_count + i]);
        const auto parent = path.has_parent_path() ? path.parent_path() : fs::path(".");
        auto absolute = fs::canonical(parent) / path.filename();
        if (fs::exists(fs::symlink_status(absolute))
                || std::find(destinations.begin(), destinations.begin() + i, absolute) != destinations.begin() + i) {
            throw std::runtime_error("output path already exists or is repeated: " + absolute.string());
        }
        destinations[i] = std::move(absolute);
    }

    std::array<std::vector<float>, graph::input_count> backing;
    std::array<at::Tensor, graph::input_count> inputs;
    for (std::size_t i = 0; i < inputs.size(); ++i) {
        const auto shape = graph::input_shapes[i];
        backing[i] = read_tensor(paths[i], checked_bytes(shape));
        inputs[i] = at::from_blob(backing[i].data(), at::IntArrayRef(shape.data(), shape.size()),
                                  at::TensorOptions().device(at::kCPU).dtype(at::kFloat));
    }

    const std::array<at::Tensor, graph::output_count> outputs = runner(inputs);
    std::array<std::size_t, graph::output_count> sizes;
    for (std::size_t i = 0; i < outputs.size(); ++i) {
        const auto& output = outputs[i];
        if (!output.defined() || !output.device().is_cpu() || output.layout() != at::kStrided
                || output.scalar_type() != at::kFloat || !output.is_contiguous() || output.is_neg()) {
            throw std::runtime_error("graph returned an output outside the contiguous CPU float32 file ABI");
        }
        const auto shape = output.sizes();
        sizes[i] = checked_bytes({shape.data(), shape.size()});
    }

    std::array<StagedFile, graph::output_count> staged;
    for (std::size_t i = 0; i < outputs.size(); ++i) {
        staged[i].stage(destinations[i], outputs[i].const_data_ptr<float>(), sizes[i]);
    }
    for (std::size_t i = 0; i < staged.size(); ++i) staged[i].publish(destinations[i]);

    constexpr auto byte_order = std::endian::native == std::endian::little ? "little" : "big";
    std::cout << "{\"abi_version\":" << graph::abi_version << ",\"dtype\":\"float32\",\"byte_order\":\""
              << byte_order << "\",\"outputs\":[";
    for (std::size_t i = 0; i < outputs.size(); ++i) {
        if (i != 0) std::cout << ',';
        const auto shape = outputs[i].sizes();
        std::cout << "{\"shape\":[";
        for (std::size_t dim = 0; dim < shape.size(); ++dim) {
            if (dim != 0) std::cout << ',';
            std::cout << shape[dim];
        }
        std::cout << "],\"nbytes\":" << sizes[i] << '}';
    }
    std::cout << "]}\n";
    return 0;
}
}  // namespace

int main(int argc, char** argv) {
    if (static_cast<std::size_t>(argc) != 1 + graph::input_count + graph::output_count) {
        std::fputs("usage: aten-graph <input.f32>... <new-output.f32>...\n", stderr);
        return 2;
    }
    try {
        return invoke(argv + 1, graph::run);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "SCAR ATen graph failed: %s\n", error.what());
        return 1;
    }
}
