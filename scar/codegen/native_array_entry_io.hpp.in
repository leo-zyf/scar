#pragma once

#include <array>
#include <charconv>
#include <chrono>
#include <cmath>
#include <ostream>
#include <stdexcept>
#include <string>
#include <string_view>
#include <time.h>

namespace scar::array_entry_io {
using Clock = std::chrono::steady_clock;

inline void binary64(std::ostream& out, double value) {
    std::array<char, 64> bytes{};
    const auto converted = std::to_chars(bytes.data(), bytes.data() + bytes.size(), value);
    if (converted.ec != std::errc{} || !std::isfinite(value)) throw std::runtime_error("nonfinite report");
    const std::string_view text(bytes.data(), converted.ptr - bytes.data());
    out << text;
    if (text.find_first_of(".eE") == text.npos) out << ".0";
}

inline void line(std::ostream& out, bool pretty, std::size_t level) {
    if (pretty) out << '\n' << std::string(level * 2, ' ');
}

inline double process_seconds() {
    struct timespec result{};
    if (clock_gettime(CLOCK_PROCESS_CPUTIME_ID, &result) != 0)
        throw std::runtime_error("process clock unavailable");
    return static_cast<double>(result.tv_sec) + static_cast<double>(result.tv_nsec) * 1e-9;
}

inline double seconds(Clock::duration value) {
    return std::chrono::duration<double>(value).count();
}
}
