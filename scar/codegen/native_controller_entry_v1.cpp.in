    const auto* identity = scar_controller_plan_sha256_v1();
    require(identity && std::string_view(identity) == "@IDENTITY@", "controller identity differs");
    const auto* copy_identity = scar_array_copy_plan_sha256_v1();
    require(copy_identity && std::string_view(copy_identity) == "@COPY_IDENTITY@", "copy plan identity differs");
    require(scar_array_copy_preflight_v1(descriptors.data(), descriptors.size()) == 0, "array copy preflight failed");
@PROVIDER_SETUP@@OVERLAY_SETUP@@EFFECT_LOADER@    struct ControllerContext {
        const scar_stateful_table_v1* table;
        const scar_provider_v1* provider;
@EFFECT_MEMBER@@OVERLAY_CONTEXT_MEMBER@        Bindings* numbers;
    };
    ControllerContext context{table, @PROVIDER_POINTER@, @EFFECT_POINTER@@OVERLAY_POINTER@&arguments};
    const auto update = +[](void* opaque, std::uint32_t call, const scar_controller_value_v1* values,
                            std::uint64_t count, const scar_controller_value_v1* current,
                            std::uint64_t current_count, const scar_array_v1* roots, std::uint64_t root_count,
                            scar_controller_value_v1* result) -> int {
        auto& context = *static_cast<ControllerContext*>(opaque);
        auto& arguments = *context.numbers;
        if (call != @UPDATE_ORDINAL@ || count != @UPDATE_ARITY@ || current_count != @SLOT_COUNT@) return -1;
        const auto& carried = values[@CARRIED_INDEX@];
        if (carried.kind != SCAR_CONTROLLER_INT64_V1 && carried.kind != SCAR_CONTROLLER_FLOAT64_V1) return -2;
        constexpr auto limit = std::int64_t{1} << 53;
        if (carried.kind == SCAR_CONTROLLER_INT64_V1 &&
            (carried.integer < -limit || carried.integer > limit)) return -2;
        const double carried_scalar = carried.kind == SCAR_CONTROLLER_INT64_V1
            ? static_cast<double>(carried.integer) : carried.floating;
        if (!std::isfinite(carried_scalar)) return -2;
@UPDATE_NUMBER_BINDINGS@        const auto status = context.table->run(roots, root_count, arguments.values.data(),
                                               arguments.values.size(), context.provider, @PROVIDER_COUNT@);
        if (status != 0) return status;
        const auto copy = scar_array_copy_run_v1(roots, root_count);
        if (copy != 0) return copy;
        const auto returned = @SCALAR_RETURN@;
        if (!std::isfinite(returned)) return -3;
        *result = {SCAR_CONTROLLER_FLOAT64_V1, 0, 0, returned, nullptr, 0};
        return 0;
    };
    const auto effect = +[](void* opaque, std::uint32_t call, const scar_controller_value_v1* values,
                            std::uint64_t count, const scar_array_v1* roots, std::uint64_t root_count) {
        const auto& context = *static_cast<ControllerContext*>(opaque);
@EFFECT_DISPATCH@
    };
    const auto status = scar_controller_run_v1(controller_slots.data(), controller_slots.size(),
        descriptors.data(), descriptors.size(), &context, update, effect, iteration_limit);
    if (status != 0) throw std::runtime_error("native controller declined: " + std::to_string(status));
