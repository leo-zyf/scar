#define _GNU_SOURCE
#endif
#include "stateful_abi_v1.h"
#include <algorithm>
#include <array>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <limits>
#include <memory>
#include <new>
#include <sched.h>
#include <time.h>
#include <unistd.h>
