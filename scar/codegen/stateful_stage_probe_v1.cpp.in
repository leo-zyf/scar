#if !defined(__GNUC__) || defined(__clang__)
#error This canonical stage observer requires GNU g++ and noipa.
#endif
#pragma STDC FENV_ACCESS ON

namespace {
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
constexpr int selected_cpu = @CPU_ID@;
constexpr int32_t affinity_guard_status = SCAR_CPU_AFFINITY_GUARD_V1;
constexpr int floating_flags = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;
@AFFINITY_CLASS@
@FLOATING_CLASS@
@FINITE_HELPER@
@SCALAR_HELPERS@

bool clock_ns(uint64_t &output) noexcept {
    timespec stamp{};
    if (clock_gettime(CLOCK_MONOTONIC, &stamp) != 0 || stamp.tv_sec < 0 ||
        stamp.tv_nsec < 0 || stamp.tv_nsec >= 1000000000L) return false;
    const auto seconds = static_cast<uint64_t>(stamp.tv_sec), nanos = static_cast<uint64_t>(stamp.tv_nsec);
    if (seconds > (std::numeric_limits<uint64_t>::max() - nanos) / UINT64_C(1000000000)) return false;
    output = seconds * UINT64_C(1000000000) + nanos;
    return true;
}

@COMPONENT_FUNCTIONS@
using Component = int32_t (*)(const scar_array_v1 *, const scar_scalar_v1 *, const Scalar *,
    std::vector<std::unique_ptr<double[]>> &, uint64_t *, uint64_t *);
constexpr std::array<Component, @COMPONENT_COUNT@> components = {{@COMPONENT_POINTERS@}};
constexpr std::array<std::array<int64_t, 2>, @ARRAY_COUNT@> array_shapes = {{@ARRAY_SHAPES@}};
constexpr std::array<uint64_t, @SLOT_COUNT@> slot_capacities = {{@SLOT_CAPACITIES@}};
}

// One canonical component at a time. No preceding scalar/array DAG or target
// entry executes; every entry materialization is an independent canonical port.
extern "C" SCAR_EXPORT_V1 int32_t scar_stage_dag_probe_v1(
    uint64_t component_index, uint64_t repetitions, uint64_t warmup,
    uint64_t *samples_ns, int32_t *placement, uint64_t *checksum) {
    if (component_index >= components.size() || repetitions < 1 || repetitions > 10000 || warmup > 10000 ||
        samples_ns == nullptr || placement == nullptr || checksum == nullptr) return 1;
    placement[0] = sched_getcpu(); placement[1] = -1; placement[2] = -1;
    *checksum = 0;
    try {
        __int128 bytes = 0;
        for (const auto &shape : array_shapes) bytes += __int128(shape[0]) * shape[1] * sizeof(double);
        for (const auto capacity : slot_capacities) bytes += capacity;
        if (bytes != @PAYLOAD_BYTES@ULL || bytes > @MAX_PAYLOAD_BYTES@ULL ||
            bytes > std::numeric_limits<ptrdiff_t>::max()) return 7;
        std::vector<std::unique_ptr<double[]>> inputs(array_shapes.size()), slots(slot_capacities.size());
        std::vector<scar_array_v1> arrays(array_shapes.size());
        for (size_t i = 0; i < array_shapes.size(); ++i) {
            const auto rows = array_shapes[i][0], cols = array_shapes[i][1];
            const uint64_t count = uint64_t(rows) * uint64_t(cols);
            if (count) {
                inputs[i].reset(new (std::nothrow) double[count]);
                if (!inputs[i]) return 5;
                std::fill_n(inputs[i].get(), count, 1.25);
            }
            auto &array = arrays[i]; array.data = inputs[i].get(); array.rank = 2;
            array.shape[0] = rows; array.shape[1] = cols; array.strides[0] = cols * int64_t(sizeof(double));
            array.strides[1] = sizeof(double);
            array.lower_bound = reinterpret_cast<uintptr_t>(array.data);
            array.upper_bound = array.lower_bound + count * sizeof(double);
        }
        for (size_t i = 0; i < slot_capacities.size(); ++i) if (slot_capacities[i]) {
            slots[i].reset(new (std::nothrow) double[slot_capacities[i] / sizeof(double)]);
            if (!slots[i]) return 5;
            std::fill_n(slots[i].get(), slot_capacities[i] / sizeof(double), 1.25);
        }
        std::vector<scar_scalar_v1> scalars(@SCALAR_COUNT@);
        for (auto &scalar : scalars) { scalar.value = 0.75; scalar.integer = 0; }
        std::vector<Scalar> saved(@NODE_COUNT@, Scalar{0.75, false});
        ThreadAffinity affinity;
        if (!affinity.contains(selected_cpu)) return 4;
        FloatingScope floating;
        if (!floating.begin()) return 3;
        if (!affinity.bind(selected_cpu)) return 4;
        placement[1] = sched_getcpu();
        uint64_t sink = 0;
        for (uint64_t repetition = 0; repetition < repetitions + warmup; ++repetition) {
            if (std::feclearexcept(floating_flags) != 0) return 3;
            uint64_t elapsed = 0, result = 0;
            const int32_t status = components[component_index](arrays.data(), scalars.data(), saved.data(), slots,
                &elapsed, &result);
            if (status != 0 || std::fetestexcept(floating_flags)) return status ? status : 3;
            if (repetition >= warmup) samples_ns[repetition - warmup] = elapsed;
            sink ^= result;
        }
        const bool held = affinity.bound();
        const bool environment_restored = floating.restore();
        const bool affinity_restored = affinity.restore_original();
        placement[2] = sched_getcpu(); *checksum = sink;
        return !held || !affinity_restored ? 4 : !environment_restored ? 3 : 0;
    } catch (const std::bad_alloc &) {
        return 5;
    }
}
