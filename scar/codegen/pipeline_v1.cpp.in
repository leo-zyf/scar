#include "scar_abi_v1.h"
#include <array>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <limits>
#include <memory>
#include <new>
#include <vector>

namespace {
static_assert(sizeof(double) == 8);
constexpr uint64_t no_value = std::numeric_limits<uint64_t>::max();
constexpr uint64_t payload_budget = @BUDGET@ULL;
constexpr uint64_t final_value = @FINAL_VALUE@;
constexpr size_t input_count = @INPUT_COUNT@;
constexpr size_t max_arguments = @MAX_ARGUMENTS@;
enum { external_input = 0, workspace = 1, final_output = 2 };
enum { argument_guard = 10, shape_guard = 11, budget_guard = 12,
       lifetime_guard = 13, operator_guard = 14, allocation_guard = 15 };

struct ValuePlan {
    int64_t rows, cols;
    uint64_t bytes;
    int kind;
    uint64_t storage_index;
    int64_t producer, last_use;
};
struct CallPlan {
    uint64_t count;
    std::array<uint64_t, max_arguments> inputs;
    uint64_t output;
    const char *plan_sha256;
    bool c_contiguous_inputs;
    uint64_t output_budget;
};
constexpr std::array<ValuePlan, @VALUE_COUNT@> value_plans = {{
@VALUE_PLANS@
}};
constexpr std::array<CallPlan, @CALL_COUNT@> call_plans = {{
@CALL_PLANS@
}};
constexpr std::array<uint64_t, @SLOT_COUNT@> slot_capacities = {{@SLOT_CAPACITIES@}};

bool valid_array(const scar_array_v1 &a, const ValuePlan &p) {
    if (a.rank != 2 || a.shape[0] != p.rows || a.shape[1] != p.cols ||
        p.rows < 0 || p.cols < 0 || a.lower_bound > a.upper_bound ||
        reinterpret_cast<uintptr_t>(a.data) % alignof(double) != 0 ||
        a.strides[0] % int64_t(sizeof(double)) != 0 ||
        a.strides[1] % int64_t(sizeof(double)) != 0) return false;
    if (p.rows == 0 || p.cols == 0) return true;
    if (a.data == nullptr) return false;
    __int128 low = 0, high = 0;
    for (int axis = 0; axis < 2; ++axis) {
        const __int128 offset = __int128(a.shape[axis] - 1) * a.strides[axis];
        if (offset < 0) low += offset;
        else high += offset;
    }
    if (low < std::numeric_limits<ptrdiff_t>::min() ||
        high > std::numeric_limits<ptrdiff_t>::max()) return false;
    const __int128 address = reinterpret_cast<uintptr_t>(a.data);
    return address + low >= a.lower_bound &&
           address + high + sizeof(double) <= a.upper_bound;
}

bool contiguous(const scar_array_v1 &a) {
    if (a.shape[0] == 0 || a.shape[1] == 0) return true;
    return (a.shape[1] <= 1 || a.strides[1] == int64_t(sizeof(double))) &&
           (a.shape[0] <= 1 || a.strides[0] == a.shape[1] * int64_t(sizeof(double)));
}

bool overlap(const scar_array_v1 &a, const scar_array_v1 &b) {
    if (a.lower_bound == a.upper_bound || b.lower_bound == b.upper_bound) return false;
    return a.lower_bound < b.upper_bound && b.lower_bound < a.upper_bound;
}

scar_array_v1 slot_array(double *data, uint64_t capacity, const ValuePlan &p) {
    scar_array_v1 a{};
    a.data = data;
    a.rank = 2;
    a.shape[0] = p.rows; a.shape[1] = p.cols;
    a.strides[0] = p.cols * int64_t(sizeof(double));
    a.strides[1] = sizeof(double);
    a.lower_bound = reinterpret_cast<uintptr_t>(data);
    a.upper_bound = a.lower_bound + capacity;
    return a;
}
}  // namespace

extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_plan_sha256_v1() {
    return "@PIPELINE_SHA256@";
}
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_memory_sha256_v1() {
    return "@MEMORY_SHA256@";
}

extern "C" SCAR_EXPORT_V1 int32_t scar_pipeline_run_v1(
    const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
    const scar_operator_table_v1 *const *operators, uint64_t operator_count,
    uint64_t *failed_call) {
    if (failed_call != nullptr) *failed_call = no_value;
    if (count != input_count || output == nullptr || (count && inputs == nullptr) ||
        operators == nullptr || operator_count != call_plans.size()) return argument_guard;
    __int128 payload = value_plans[final_value].bytes;
    for (const auto capacity : slot_capacities) {
        if (capacity % sizeof(double) || capacity > std::numeric_limits<ptrdiff_t>::max())
            return budget_guard;
        payload += capacity;
    }
    if (payload > payload_budget || payload > std::numeric_limits<size_t>::max()) return budget_guard;
    for (const auto &p : value_plans) {
        if (__int128(p.rows) * p.cols * sizeof(double) != p.bytes) return shape_guard;
        if (p.kind == external_input && !valid_array(inputs[p.storage_index], p)) return shape_guard;
    }
    if (!valid_array(*output, value_plans[final_value]) || !contiguous(*output)) return shape_guard;
    for (uint64_t i = 0; i < count; ++i) {
        if (overlap(*output, inputs[i])) return argument_guard;
    }
    for (size_t i = 0; i < call_plans.size(); ++i) {
        const auto *table = operators[i];
        const auto &call = call_plans[i];
        if (table == nullptr || table->abi_version != 1 ||
            table->struct_size < sizeof(scar_operator_table_v1) || table->run == nullptr ||
            table->input_count != call.count || table->plan_sha256 == nullptr ||
            std::strcmp(table->plan_sha256, call.plan_sha256) != 0) return operator_guard;
    }
    try {
        // Only these double buffers count toward the declared workspace
        // payload. Descriptors/dispatch metadata and allocator overhead do not.
        std::vector<std::unique_ptr<double[]>> slots(slot_capacities.size());
        for (size_t i = 0; i < slots.size(); ++i) {
            if (slot_capacities[i]) {
                slots[i].reset(new (std::nothrow) double[slot_capacities[i] / sizeof(double)]);
                if (!slots[i]) return allocation_guard;
            }
        }
        std::vector<scar_array_v1> values(value_plans.size());
        std::vector<uint8_t> ready(value_plans.size(), 0);
        std::vector<uint64_t> owners(slot_capacities.size(), no_value);
        std::array<scar_array_v1, max_arguments> arguments{};
        for (size_t i = 0; i < value_plans.size(); ++i) {
            const auto &p = value_plans[i];
            if (p.kind == external_input) {
                values[i] = inputs[p.storage_index]; ready[i] = 1;
            }
        }
        values[final_value] = *output;
        for (size_t i = 0; i < call_plans.size(); ++i) {
            if (failed_call != nullptr) *failed_call = i;
            const auto &call = call_plans[i];
            const auto &p = value_plans[call.output];
            if (p.producer != int64_t(i) || p.bytes > call.output_budget) return budget_guard;
            if (p.kind == workspace) {
                const uint64_t slot = p.storage_index;
                if (slot >= slots.size() || p.bytes > slot_capacities[slot]) return budget_guard;
                const uint64_t old = owners[slot];
                if (old != no_value && value_plans[old].last_use >= int64_t(i)) return lifetime_guard;
                if (old != no_value) ready[old] = 0;
                values[call.output] = slot_array(slots[slot].get(), slot_capacities[slot], p);
                owners[slot] = call.output;
            } else if (p.kind != final_output) return lifetime_guard;
            if (!valid_array(values[call.output], p)) return argument_guard;
            for (uint64_t j = 0; j < call.count; ++j) {
                const uint64_t value = call.inputs[j];
                if (!ready[value] || value_plans[value].producer >= int64_t(i) ||
                    value_plans[value].last_use < int64_t(i)) return lifetime_guard;
                arguments[j] = values[value];
                if (overlap(values[call.output], arguments[j])) return lifetime_guard;
                if (call.c_contiguous_inputs && !contiguous(arguments[j])) return shape_guard;
            }
            const int32_t status = operators[i]->run(arguments.data(), call.count, &values[call.output]);
            if (status != SCAR_OK_V1) return status >= 1 && status <= 4 ? 100 + status : operator_guard;
            ready[call.output] = 1;
            // Logical release permits later slot reuse. Pool storage remains
            // owned by this entry until all calls finish or a guard returns.
            for (size_t value = 0; value < value_plans.size(); ++value) {
                const auto &old = value_plans[value];
                if (old.kind == workspace && old.last_use == int64_t(i)) {
                    ready[value] = 0;
                    if (owners[old.storage_index] == value) owners[old.storage_index] = no_value;
                }
            }
        }
        if (!ready[final_value]) return lifetime_guard;
        if (failed_call != nullptr) *failed_call = no_value;
        return SCAR_OK_V1;
    } catch (const std::bad_alloc &) {
        return allocation_guard;
    }
}
