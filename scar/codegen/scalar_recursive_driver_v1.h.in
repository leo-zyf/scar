#ifndef SCAR_RECURSIVE_DRIVER_V1_H
#define SCAR_RECURSIVE_DRIVER_V1_H

#include <stddef.h>
#include <stdint.h>
#include "scar_scalar_sorted_v1.h"

#ifdef __cplusplus
extern "C" {
#endif

struct scar_recursive_driver_v1;

struct scar_recursive_yield_v1 {
    int64_t depth;
    int64_t threshold;
    int64_t score;
    int64_t nodes;
    uint32_t has_move;
    uint32_t table_slot;
    struct scar_sorted_record_v1 move;
};

enum scar_recursive_driver_status_v1 {
    SCAR_RECURSIVE_DRIVER_OK_V1 = 0,
    SCAR_RECURSIVE_DRIVER_EMPTY_OR_CAPACITY_V1 = 1,
    SCAR_RECURSIVE_DRIVER_DECLINED_V1 = 2,
    SCAR_RECURSIVE_DRIVER_INTERNAL_V1 = 3,
    SCAR_RECURSIVE_DRIVER_SOURCE_STOP_V1 = 4
};

typedef double (*scar_recursive_deadline_reader_v1)(void*);

/* Use one handle per source generator. The owner serializes operations on it. */
int scar_recursive_driver_create_v1(const uint8_t* seed, size_t bytes, struct scar_recursive_driver_v1** out);
int scar_recursive_driver_advance_v1(struct scar_recursive_driver_v1* handle, double soft_epoch, double deadline_epoch,
    struct scar_recursive_yield_v1* out);
int scar_recursive_driver_get_move_v1(const struct scar_recursive_driver_v1* handle, const uint8_t* state,
    size_t bytes, struct scar_sorted_record_v1* out);
int scar_recursive_driver_snapshot_v1(const struct scar_recursive_driver_v1* handle, uint8_t* out,
    size_t capacity, size_t* written);
int scar_recursive_driver_set_deadline_reader_v1(struct scar_recursive_driver_v1* handle,
    scar_recursive_deadline_reader_v1 reader, void* context);
void scar_recursive_driver_close_v1(struct scar_recursive_driver_v1* handle);

#ifdef __cplusplus
}
#endif

#endif
