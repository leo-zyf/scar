#include "scar_recursive_driver_v1.h"
#include <memory>

@SCAR_KERNEL@

using DriverRow = std::tuple<Integer, Integer, Integer, std::optional<Move>>;

std::size_t choose_version(const State& position) {
    return @SCAR_SELECT@ ? @SCAR_TABLE_TRUE@ : @SCAR_TABLE_FALSE@;
}

Stream<DriverRow> drive(World& world, const Table& table, const State& position, const double& soft) {
@SCAR_DRIVER@
    co_return;
}

scar_sorted_record_v1 export_move(const Move& move) {
    scar_sorted_record_v1 output;
    std::memset(&output, 0, sizeof(output));
@SCAR_MOVE_OUTPUT@
    return output;
}

}  // namespace

struct scar_recursive_driver_v1 {
    World world;
    Query query{};
    double soft = 0;
    std::optional<Stream<DriverRow>> stream;
};

extern "C" __attribute__((visibility("default")))
int scar_recursive_driver_create_v1(const uint8_t* seed, std::size_t bytes, scar_recursive_driver_v1** out) {
    if (!out) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    *out = nullptr;
    if (!seed || bytes == 0) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    try {
        auto handle = std::make_unique<scar_recursive_driver_v1>();
        handle->query = setup(std::string_view(reinterpret_cast<const char*>(seed), bytes), handle->world);
        const auto& position = handle->query.position;
        const auto version = choose_version(position);
        if (version != handle->query.table) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
@SCAR_INITIALIZE@
        handle->stream.emplace(drive(handle->world, tables[version], position, handle->soft));
        *out = handle.release();
        return SCAR_RECURSIVE_DRIVER_OK_V1;
    } catch (const Decline&) {
        return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    } catch (...) {
        return SCAR_RECURSIVE_DRIVER_INTERNAL_V1;
    }
}

extern "C" __attribute__((visibility("default")))
int scar_recursive_driver_advance_v1(scar_recursive_driver_v1* handle, double soft_epoch, double deadline_epoch,
    scar_recursive_yield_v1* out) {
    if (!handle || !out || !std::isfinite(soft_epoch) || !std::isfinite(deadline_epoch)) {
        return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    }
    if (!handle->stream) return SCAR_RECURSIVE_DRIVER_EMPTY_OR_CAPACITY_V1;
    handle->soft = soft_epoch;
    handle->world.@SCAR_DEADLINE@ = deadline_epoch;
    try {
        if (!handle->stream->advance()) {
            handle->stream.reset();
            return SCAR_RECURSIVE_DRIVER_EMPTY_OR_CAPACITY_V1;
        }
        const auto& [depth, threshold, score, move] = handle->stream->current();
        scar_recursive_yield_v1 staged;
        std::memset(&staged, 0, sizeof(staged));
        staged.depth = depth;
        staged.threshold = threshold;
        staged.score = score;
        staged.nodes = handle->world.@SCAR_NODES@;
        staged.table_slot = static_cast<uint32_t>(handle->query.table);
        if (move) {
            staged.has_move = 1;
            staged.move = export_move(*move);
        }
        std::memcpy(out, &staged, sizeof(staged));
        return SCAR_RECURSIVE_DRIVER_OK_V1;
    } catch (const SourceStop&) {
        handle->stream.reset();
        return SCAR_RECURSIVE_DRIVER_SOURCE_STOP_V1;
    } catch (const Decline&) {
        handle->stream.reset();
        return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    } catch (...) {
        handle->stream.reset();
        return SCAR_RECURSIVE_DRIVER_INTERNAL_V1;
    }
}

extern "C" __attribute__((visibility("default")))
int scar_recursive_driver_get_move_v1(const scar_recursive_driver_v1* handle, const uint8_t* state,
    std::size_t bytes, scar_sorted_record_v1* out) {
    if (!handle || !state || bytes == 0 || !out) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    try {
        std::istringstream input(std::string(reinterpret_cast<const char*>(state), bytes));
        const auto key = receive<State>(input);
        if (input.peek() != std::char_traits<char>::eof()) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
        const auto* value = handle->world.@SCAR_MOVE_MAP@.find(key);
        if (!value) return SCAR_RECURSIVE_DRIVER_EMPTY_OR_CAPACITY_V1;
        const auto record = export_move(*value);
        std::memcpy(out, &record, sizeof(record));
        return SCAR_RECURSIVE_DRIVER_OK_V1;
    } catch (const Decline&) {
        return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    } catch (...) {
        return SCAR_RECURSIVE_DRIVER_INTERNAL_V1;
    }
}

extern "C" __attribute__((visibility("default")))
int scar_recursive_driver_snapshot_v1(const scar_recursive_driver_v1* handle, uint8_t* out,
    std::size_t capacity, std::size_t* written) {
    if (!written) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    *written = 0;
    if (!handle || (!out && capacity)) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    try {
        std::ostringstream stream;
        stream << "SCAR_DRIVER_WORLD_V1\n";
        publish_state(stream, handle->world);
        const auto record = stream.str();
        *written = record.size();
        if (capacity < record.size()) return SCAR_RECURSIVE_DRIVER_EMPTY_OR_CAPACITY_V1;
        std::memcpy(out, record.data(), record.size());
        return SCAR_RECURSIVE_DRIVER_OK_V1;
    } catch (...) {
        return SCAR_RECURSIVE_DRIVER_INTERNAL_V1;
    }
}

extern "C" __attribute__((visibility("default")))
int scar_recursive_driver_set_deadline_reader_v1(scar_recursive_driver_v1* handle,
    scar_recursive_deadline_reader_v1 reader, void* context) {
    if (!handle) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    handle->world.deadline_reader = reader;
    handle->world.deadline_context = context;
    return SCAR_RECURSIVE_DRIVER_OK_V1;
}

extern "C" __attribute__((visibility("default")))
void scar_recursive_driver_close_v1(scar_recursive_driver_v1* handle) { delete handle; }
