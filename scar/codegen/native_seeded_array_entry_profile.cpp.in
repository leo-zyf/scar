#define main scar_private_seeded_probe
#include "tape_0.inc"
#undef main

#include "numpy_observables.hpp"
#include "numpy_random.hpp"
#include "numpy_random_coefficients.hpp"

#include <cmath>
#include <iterator>
#include <limits>

namespace {
using Coefficient = std::array<double, 8>;

enum class HookKind { coefficient, normalization };
struct Hook {
    std::size_t step;
    HookKind kind;
    std::size_t index;
};

@SEEDED_ROUTES@

bool normalize_and_publish(char* bytes, const Step& step) {
    auto* raw = bytes + step.offset[0];
    auto* scratch = bytes + step.offset[2];
    const auto selected = scar_numpy_normalize_v1(step.count, raw, scratch);
    if (selected != 0 && selected != 1) return false;
    // A source-bound lifetime proof admits this write into the canonical
    // destination. The provider still computes the original branch.
    if (selected != static_cast<int>(step.argument)) {
        auto* destination = step.argument ? scratch : raw;
        auto* source = selected ? scratch : raw;
        std::memcpy(destination, source, item * step.count);
    }
    return true;
}

bool run_seeded(char* bytes, const std::array<Coefficient, coefficient_count>& prepared,
                bool diagnostic, std::vector<std::vector<char>>& captured) {
    std::size_t next_hook = 0;
    for (const auto& round : rounds) {
        auto cursor = round[0];
        while (next_hook < std::size(hooks) && hooks[next_hook].step < round[1]) {
            const auto& hook = hooks[next_hook++];
            const auto& step = steps[hook.step];
            if (!execute_round(bytes, cursor, hook.step, diagnostic, captured)) return false;
            if (hook.kind == HookKind::coefficient) {
                std::memcpy(bytes + step.offset[2], prepared[hook.index].data(), step.count);
            } else if (!normalize_and_publish(bytes, step)) {
                return false;
            }
            cursor = hook.step + 1;
        }
        if (!execute_round(bytes, cursor, round[1], diagnostic, captured)) return false;
    }
    return next_hook == std::size(hooks);
}
}

extern "C" int scar_array_entry_profile_0(double* norm, double* difference,
                                              const char* state_prefix, std::uint64_t seed, std::uint64_t) {
    if (seed > std::numeric_limits<std::uint32_t>::max() || !scar_numpy_complex_runtime_supported()) return 1;
    std::array<Coefficient, coefficient_count> prepared{};
    if (!prepare_coefficients(seed, prepared)) return 1;
    std::unique_ptr<void, decltype(&std::free)> arena(std::aligned_alloc(64, arena_bytes), &std::free);
    if (!arena) return 1;
    auto* bytes = static_cast<char*>(arena.get());
    const bool diagnostic = state_prefix != nullptr;
    std::vector<std::vector<char>> captured(diagnostic ? checkpoint_count : 0);
    if (!run_seeded(bytes, prepared, diagnostic, captured)) return 1;
    const auto& final_step = steps[std::size(steps) - 1];
    if (final_step.operation != Op::checkpoint || final_step.count % item != 0 ||
            scar_numpy_split_observable_v1(final_step.count / item, bytes + final_step.offset[0],
                                           norm, difference) != 0) return 1;
    if (diagnostic) {
        for (std::size_t index = 0; index < captured.size(); ++index) {
            if (!write_checkpoint(std::string(state_prefix) + "." + std::to_string(index) + ".bin",
                                  captured[index])) return 1;
        }
    }
    return 0;
}
