#include "native_live_plot_resident_abi_v2.h"
#include <atomic>
#include <cerrno>
#include <fcntl.h>
#include <limits>
#include <memory>
#include <sys/stat.h>
#include <unordered_map>
#include <unistd.h>

namespace {
class AssetFile {
    int descriptor_;
public:
    explicit AssetFile(const char* path) : descriptor_(::open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK)) {
        require(descriptor_ >= 0, "cannot open original native plot asset");
    }
    AssetFile(const AssetFile&) = delete;
    ~AssetFile() { ::close(descriptor_); }
    int descriptor() const { return descriptor_; }
    ssize_t read(char* output, std::size_t length) const {
        ssize_t result;
        do { result = ::read(descriptor_, output, length); } while (result < 0 && errno == EINTR);
        return result;
    }
    struct stat info() const {
        struct stat status{};
        require(::fstat(descriptor_, &status) == 0 && S_ISREG(status.st_mode),
                "native plot asset must be a regular file");
        return status;
    }
};

std::vector<char> profile_bytes(const char* path, std::size_t size,
                                const std::array<unsigned char, 32>& expected) {
    require(path != nullptr, "missing native plot asset");
    const AssetFile file(path);
    const auto before = file.info();
    require(before.st_size >= 0 && static_cast<std::uint64_t>(before.st_size) == size,
            "native plot asset size differs");
    std::vector<char> bytes(size);
    for (std::size_t offset = 0; offset < size;) {
        const auto part = file.read(bytes.data() + offset, size - offset);
        require(part > 0, "truncated native plot asset");
        offset += part;
    }
    char extra;
    require(file.read(&extra, 1) == 0, "native plot asset size differs");
    const auto after = file.info();
    require(before.st_size == after.st_size &&
            before.st_mtim.tv_sec == after.st_mtim.tv_sec && before.st_mtim.tv_nsec == after.st_mtim.tv_nsec &&
            before.st_ctim.tv_sec == after.st_ctim.tv_sec && before.st_ctim.tv_nsec == after.st_ctim.tv_nsec,
            "native plot asset changed while being read");
    std::array<unsigned char, 32> hash{};
    unsigned int length{};
    require(EVP_Digest(bytes.data(), bytes.size(), hash.data(), &length, EVP_sha256(), nullptr) == 1 &&
            length == hash.size() && hash == expected, "native plot asset digest differs");
    return bytes;
}

struct LatticeView {
    std::uint64_t rows, cols, row, col;
};

LatticeView read_view(Tape& tape, const Grid& grid) {
    const LatticeView view{tape.take<std::uint64_t>(), tape.take<std::uint64_t>(),
                           tape.take<std::uint64_t>(), tape.take<std::uint64_t>()};
    require(view.rows && view.cols && view.rows <= limit / 8 / view.cols &&
            view.row <= view.rows && grid.rows <= view.rows - view.row &&
            view.col <= view.cols && grid.cols <= view.cols - view.col,
            "runtime root cannot contain original contour view");
    return view;
}

void copy_lattice(const LatticeView& view, const Grid& grid, const scar_array_v1& root,
                  std::vector<double>& result) {
    require(root.rank == 2 && root.shape[0] == static_cast<std::int64_t>(view.rows) &&
            root.shape[1] == static_cast<std::int64_t>(view.cols) && root.strides[1] == 8 &&
            root.strides[0] == static_cast<std::int64_t>(view.cols * 8),
            "runtime contour root shape or strides differ");
    const auto address = reinterpret_cast<std::uintptr_t>(root.data);
    require(root.data && address >= root.lower_bound && address <= root.upper_bound &&
            view.rows * view.cols * 8 <= root.upper_bound - address,
            "runtime contour root allocation does not cover the view");
    const auto* base = static_cast<const char*>(root.data);
    result.resize(grid.rows * grid.cols);
    for (std::size_t i = 0; i < grid.rows; ++i)
        std::memcpy(result.data() + i * grid.cols, base + ((view.row + i) * view.cols + view.col) * 8, grid.cols * 8);
}

struct Owner {
    std::vector<char> layout;
    std::unique_ptr<scar::live::ResidentFont, decltype(&scar::live::destroy_font)> font;
    Grid grid;
    LatticeView z_view;
    std::uint32_t nbins, min_ticks;
    std::size_t steps_offset;

    Owner(const scar_array_v1& x, const scar_array_v1& y, const char* layout_path, const char* font_path)
        : layout(profile_bytes(layout_path, scar::live::layout_size, scar::live::layout_hash)),
          font(scar::live::prepare_font(profile_bytes(font_path, scar::live::font_size, scar::live::font_hash)),
               scar::live::destroy_font) {
        Tape tape(layout);
        std::array<char, 8> magic{};
        tape.read(magic.data(), magic.size());
        require(std::string_view(magic.data(), magic.size()) == "SCARCTT3", "expected SCARCTT3 live plot layout");
        grid.rows = tape.take<std::uint64_t>();
        grid.cols = tape.take<std::uint64_t>();
        grid.x_chunk_size = tape.take<std::uint64_t>();
        grid.y_chunk_size = tape.take<std::uint64_t>();
        const auto corner_mask = tape.take<std::uint64_t>();
        require(grid.rows > 1 && grid.cols > 1 && grid.rows <= limit / 24 / grid.cols &&
                corner_mask <= 1 && tape.take<std::uint64_t>() == 3, "invalid live contour geometry or roots");
        grid.corner_mask = corner_mask;
        const auto x_view = read_view(tape, grid);
        const auto y_view = read_view(tape, grid);
        z_view = read_view(tape, grid);
        copy_lattice(x_view, grid, x, grid.x);
        copy_lattice(y_view, grid, y, grid.y);
        guard_plot_coordinates(tape, grid.x);
        guard_plot_coordinates(tape, grid.y);
        grid.z.resize(grid.rows * grid.cols);
        nbins = tape.take<std::uint32_t>();
        min_ticks = tape.take<std::uint32_t>();
        steps_offset = tape.offset();
    }
};

std::vector<char> compose_resident(Owner& owner, const scar_array_v1& z,
                                  const std::vector<scar::live::Glyph>& glyphs) {
    auto& grid = owner.grid;
    copy_lattice(owner.z_view, grid, z, grid.z);
    auto tape = Tape(std::span<const char>(owner.layout).subspan(owner.steps_offset));
    const auto nbins = owner.nbins;
    const auto min_ticks = owner.min_ticks;
    constexpr bool has_title = true;
@COMPOSE_BODY@
}

void report_error(char* error, std::uint64_t capacity, const char* detail) noexcept {
    if (error && capacity) {
        const auto length = std::min<std::uint64_t>(capacity - 1, std::strlen(detail));
        std::memcpy(error, detail, length);
        error[length] = '\0';
    }
}

// Values crossing the opaque ABI are never dereferenced. Monotonic handles
// prevent a closed owner from naming a later allocation at the same address.
static_assert(sizeof(std::uintptr_t) == 8);
std::atomic<std::uintptr_t> next_handle{1};
thread_local std::unordered_map<std::uintptr_t, std::unique_ptr<Owner>> owners;

std::uintptr_t allocate_handle() {
    auto current = next_handle.load(std::memory_order_relaxed);
    while (current != std::numeric_limits<std::uintptr_t>::max()) {
        if (next_handle.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) return current;
    }
    throw std::runtime_error("native plot owner handle space exhausted");
}
}

extern "C" int scar_live_plot_prepare_v2(const scar_array_v1* x, const scar_array_v1* y,
    const char* layout, const char* font, void** context, char* error, std::uint64_t capacity) {
    if (context) *context = nullptr;
    try {
        require(x && y && context, "missing native plot invariant roots or owner output");
        auto owner = std::make_unique<Owner>(*x, *y, layout, font);
        const auto handle = allocate_handle();
        owners.emplace(handle, std::move(owner));
        *context = reinterpret_cast<void*>(handle);
        report_error(error, capacity, "");
        return 0;
    } catch (const std::exception& failure) {
        report_error(error, capacity, failure.what());
    } catch (...) {
        report_error(error, capacity, "unknown native plot preparation failure");
    }
    return 1;
}

extern "C" int scar_live_plot_render_v2(void* context, const scar_array_v1* z, double time,
    const char* output, char* error, std::uint64_t capacity) {
    try {
        const auto owner = owners.find(reinterpret_cast<std::uintptr_t>(context));
        require(owner != owners.end(), "native plot owner is missing, closed or belongs to another thread");
        require(z && output, "missing live plot root or output");
        const auto glyphs = scar::live::generate_glyphs(*owner->second->font, time);
        const auto scene = compose_resident(*owner->second, *z, glyphs);
        scar::live::render_scene(scene, output);
        report_error(error, capacity, "");
        return 0;
    } catch (const std::exception& failure) {
        report_error(error, capacity, failure.what());
    } catch (...) {
        report_error(error, capacity, "unknown native plot rendering failure");
    }
    return 1;
}

extern "C" void scar_live_plot_destroy_v2(void* context) {
    owners.erase(reinterpret_cast<std::uintptr_t>(context));
}
