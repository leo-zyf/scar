#include "scar_scalar_sorted_transition_v1.h"

@SCAR_SORTED_IMPLEMENTATION@

namespace {

@SCAR_RESIDENT_COMPUTATION@

@SCAR_RESIDENT_BRIDGE@

}  // namespace

extern "C" __attribute__((visibility("default")))
int scar_scalar_lazy_transition_v1(uint32_t table_slot, const scar_resident_output_v1* state,
    const scar_sorted_record_v1* move, const scar_resident_score_v1* producer, scar_resident_output_v1* output) {
    if (!state || !move || !output || table_slot >= tables.size()) {
        return SCAR_RESIDENT_DECLINED_V1;
    }
    scar_resident_input_v1 input{};
@SCAR_INPUT_SETUP@
    const auto* token = producer && producer->delta == move->scalars[@SCAR_SCORE_SLOT@] ? producer : nullptr;
    return evaluate_resident(table_slot, &input, token, output);
}
