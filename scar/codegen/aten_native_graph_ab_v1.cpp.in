#define main scar_native_file_main
#include "entry.cpp"
#undef main

#include "aten_numa_pages_v1.h"

#include <ATen/Parallel.h>
#include <ATen/core/grad_mode.h>

#include <cfenv>
#include <charconv>
#include <chrono>
#include <cstring>
#include <optional>
#include <sched.h>
#include <string_view>

namespace {

using Clock = std::chrono::steady_clock;
using Inputs = std::array<at::Tensor, graph::input_count>;
using Outputs = std::array<at::Tensor, graph::output_count>;
using OperationTimes = std::array<std::int64_t, graph::operation_count>;

struct Sample {
    std::int64_t serial_ns;
    std::int64_t dual_ns;
    bool serial_first;
};

struct Calibration {
    OperationTimes operations;
    OperationTimes worker_operations;
    std::int64_t dispatch_ns;
};

struct NumaLocality {
    explicit NumaLocality(std::size_t window)
        : window_start(window), inputs(graph::input_count), caller_outputs(graph::operation_count),
          worker_outputs(graph::operation_count) {}

    std::size_t window_start;
    std::vector<graph::NumaPageSample> inputs;
    std::vector<graph::NumaPageSample> caller_outputs;
    std::vector<graph::NumaPageSample> worker_outputs;
    std::vector<OperationTimes> consumer_samples;
};

constexpr std::size_t locality_storage_budget = 128;
constexpr std::size_t joint_context_budget = 8;
constexpr std::size_t joint_storage_budget = 256;

struct JointNumaContext {
    std::vector<std::size_t> window_starts;
    std::vector<graph::NumaPageSample> output_pages;
    std::vector<OperationTimes> operation_samples;
};

struct JointNumaLocality {
    std::vector<graph::NumaPageSample> inputs;
    std::vector<graph::NumaPageSample> caller_outputs;
    std::vector<JointNumaContext> contexts;
};

bool enumerate_joint_contexts(std::vector<JointNumaContext>& contexts, std::vector<std::size_t>& starts,
                              std::size_t next) {
    for (std::size_t i = next; i < graph::operation_count; ++i) {
        if (!graph::legal_window_starts[i]) continue;
        const auto storage_count = graph::input_count + (2 + contexts.size()) * graph::operation_count;
        if (contexts.size() == joint_context_budget || storage_count > joint_storage_budget) return false;
        starts.push_back(i);
        contexts.push_back({starts, {}, {}});
        if (!enumerate_joint_contexts(contexts, starts, i + 2)) return false;
        starts.pop_back();
    }
    return true;
}

struct StorageGeometry {
    std::size_t bytes;
    at::ScalarType dtype;
    std::int64_t offset;
    std::vector<std::int64_t> sizes;
    std::vector<std::int64_t> strides;
};

using ResultStorage = std::array<std::optional<StorageGeometry>, graph::operation_count>;

template <class Observations>
void emit_storage_bytes(const Observations& observations) {
    for (std::size_t i = 0; i < observations.size(); ++i) {
        if (i != 0) std::cout << ',';
        std::cout << observations[i].value().bytes;
    }
}

void observe_storage(std::optional<StorageGeometry>& original, const at::Tensor& tensor) {
    if (!tensor.defined() || !tensor.device().is_cpu() || tensor.layout() != at::kStrided
            || !tensor.has_storage() || !tensor.storage().device().is_cpu()) {
        throw std::runtime_error("calibration requires an observable strided CPU Tensor storage");
    }
    const auto bytes = tensor.storage().nbytes();
    if (bytes > static_cast<std::uintmax_t>(std::numeric_limits<std::int64_t>::max())) {
        throw std::runtime_error("Tensor storage exceeds the calibration size range");
    }
    const auto sizes = tensor.sizes();
    const auto strides = tensor.strides();
    const auto dtype = tensor.scalar_type();
    const auto offset = tensor.storage_offset();
    if (!original) {
        original = StorageGeometry{bytes, dtype, offset, sizes.vec(), strides.vec()};
    } else if (original->bytes != bytes || original->dtype != dtype || original->offset != offset
            || !sizes.equals(original->sizes) || !strides.equals(original->strides)) {
        throw std::runtime_error("Tensor geometry or storage size changed during calibration");
    }
}

int integer(std::string_view text, int minimum, const char* field) {
    int parsed = 0;
    const auto* end = text.data() + text.size();
    const auto result = std::from_chars(text.data(), end, parsed);
    if (result.ec != std::errc{} || result.ptr != end || parsed < minimum) {
        throw std::invalid_argument(std::string("invalid benchmark ") + field);
    }
    return parsed;
}

graph::WindowSelection parse_windows(std::string_view specification) {
    graph::WindowSelection windows{};
    int previous = -1;
    for (;;) {
        const auto delimiter = specification.find(',');
        const int start = integer(specification.substr(0, delimiter), 0, "window start");
        const auto index = static_cast<std::size_t>(start);
        if (index >= graph::operation_count || !graph::legal_window_starts[index]
                || (previous >= 0 && start - previous < 2)) {
            throw std::invalid_argument("selected windows must be legal, ordered and disjoint");
        }
        windows[index] = true;
        if (delimiter == std::string_view::npos) return windows;
        specification.remove_prefix(delimiter + 1);
        previous = start;
    }
}

void check_launch(int caller, int worker) {
    cpu_set_t allowed;
    const bool pair = worker >= 0;
    if (caller >= CPU_SETSIZE || worker >= CPU_SETSIZE || (pair && caller == worker)
            || sched_getaffinity(0, sizeof(allowed), &allowed) != 0
            || CPU_COUNT(&allowed) != (pair ? 2 : 1) || !CPU_ISSET(caller, &allowed)
            || (pair && !CPU_ISSET(worker, &allowed))
            || std::fegetround() != FE_TONEAREST) {
        throw std::runtime_error("native graph requires its exact launch mask and default rounding");
    }
}

void check_lane(int cpu) {
    cpu_set_t allowed;
    if (sched_getaffinity(0, sizeof(allowed), &allowed) != 0 || CPU_COUNT(&allowed) != 1
            || !CPU_ISSET(cpu, &allowed) || sched_getcpu() != cpu
            || at::get_num_threads() != 1 || at::get_num_interop_threads() != 1
            || at::GradMode::is_enabled() || std::fegetround() != FE_TONEAREST) {
        throw std::runtime_error("benchmark lane context differs from its requested placement");
    }
}

void check_inputs(const Inputs& inputs, const std::array<std::vector<unsigned char>, graph::input_count>& starting) {
    for (std::size_t i = 0; i < inputs.size(); ++i) {
        const auto& bytes = starting[i];
        if (inputs[i].nbytes() != bytes.size()
                || (!bytes.empty() && std::memcmp(inputs[i].const_data_ptr<float>(), bytes.data(), bytes.size()) != 0)) {
            throw std::runtime_error("benchmark input bytes changed");
        }
    }
}

struct SampleInputs {
    std::array<std::vector<float>, graph::input_count> backing;
    std::array<std::vector<unsigned char>, graph::input_count> starting;
    Inputs tensors;

    explicit SampleInputs(char** paths) {
        for (std::size_t i = 0; i < tensors.size(); ++i) {
            const auto shape = graph::input_shapes[i];
            const auto bytes = checked_bytes(shape);
            backing[i] = read_tensor(paths[i], bytes);
            starting[i].resize(bytes);
            if (bytes != 0) std::memcpy(starting[i].data(), backing[i].data(), bytes);
            tensors[i] = at::from_blob(backing[i].data(), at::IntArrayRef(shape.data(), shape.size()),
                                      at::TensorOptions().device(at::kCPU).dtype(at::kFloat));
        }
    }

    void check() const { check_inputs(tensors, starting); }
};

void check_outputs(const Inputs& inputs, const Outputs& serial, const Outputs& dual) {
    for (const auto* outputs : {&serial, &dual}) {
        for (const auto& tensor : *outputs) {
            if (!tensor.defined() || !tensor.device().is_cpu() || tensor.layout() != at::kStrided
                    || tensor.scalar_type() != at::kFloat || !tensor.is_contiguous()
                    || tensor.is_neg() || tensor.is_conj() || tensor.requires_grad()) {
                throw std::runtime_error("benchmark output violates the native float32 contract");
            }
            if (std::ranges::any_of(inputs, [&](const at::Tensor& input) { return tensor.is_alias_of(input); })) {
                throw std::runtime_error("benchmark output aliases an input");
            }
        }
    }
    for (std::size_t i = 0; i < serial.size(); ++i) {
        const auto& left = serial[i];
        const auto& right = dual[i];
        if (left.sizes() != right.sizes() || left.strides() != right.strides()
                || (left.nbytes() != 0 && std::memcmp(left.const_data_ptr<float>(), right.const_data_ptr<float>(),
                                                      left.nbytes()) != 0)) {
            throw std::runtime_error("paired graph outputs differ in geometry or bytes");
        }
        for (std::size_t j = 0; j < dual.size(); ++j) {
            if (left.is_alias_of(dual[j]) || left.is_alias_of(serial[j]) != right.is_alias_of(dual[j])) {
                throw std::runtime_error("paired graph outputs differ in storage ownership");
            }
        }
    }
}

std::int64_t elapsed_ns(Clock::time_point start) {
    const auto duration = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
    if (duration <= 0) throw std::runtime_error("benchmark duration is below the clock resolution");
    return duration;
}

std::pair<std::int64_t, Outputs> timed(const Inputs& inputs, graph::CpuPair& pair,
                                      const graph::WindowSelection& windows, bool serial) {
    const auto start = Clock::now();
    auto outputs = serial ? graph::run(inputs) : graph::run_parallel(inputs, pair, windows);
    return {elapsed_ns(start), std::move(outputs)};
}

void emit_benchmark(int caller, int worker, int warmup, int measurements, const graph::WindowSelection& windows,
                    const std::vector<Sample>& samples, const ResultStorage& result_storage) {
    std::cout << "{\"warmup_pairs\":" << warmup << ",\"measured_pairs\":" << measurements
              << ",\"caller_cpu\":" << caller << ",\"worker_cpu\":" << worker
              << ",\"all_pairs_validated\":true,\"windows\":[";
    bool comma = false;
    for (std::size_t i = 0; i < windows.size(); ++i) {
        if (!windows[i]) continue;
        if (comma) std::cout << ',';
        std::cout << i;
        comma = true;
    }
    std::cout << "],\"samples\":[";
    for (std::size_t i = 0; i < samples.size(); ++i) {
        const auto& sample = samples[i];
        if (i != 0) std::cout << ',';
        std::cout << "{\"pair_index\":" << i << ",\"order\":["
                  << (sample.serial_first ? "\"SERIAL\",\"TWO_CPU\"" : "\"TWO_CPU\",\"SERIAL\"")
                  << "],\"serial_ns\":" << sample.serial_ns << ",\"dual_ns\":" << sample.dual_ns
                  << ",\"bitwise_identical\":true,\"input_values_unchanged\":true,\"fresh_owned_outputs\":true}";
    }
    std::cout << "],\"result_storage_bytes\":[";
    emit_storage_bytes(result_storage);
    std::cout << "]}\n";
}

void emit_page_samples(const std::vector<graph::NumaPageSample>& observations) {
    for (std::size_t i = 0; i < observations.size(); ++i) {
        if (i != 0) std::cout << ',';
        graph::write_numa_pages(std::cout, observations[i]);
    }
}

void emit_locality(const std::optional<NumaLocality>& locality) {
    std::cout << "{\"schema_version\":1,\"status\":";
    if (!locality) {
        constexpr auto storages = graph::input_count + 2 * graph::operation_count;
        std::cout << (storages > locality_storage_budget ? "\"GRAPH_EXCEEDS_LOCALITY_SAMPLE_BUDGET\""
                                                        : "\"REQUIRES_SINGLE_LEGAL_WINDOW\"") << '}';
        return;
    }

    std::cout << "\"MEASURED\",\"window_start\":" << locality->window_start << ",\"input_pages\":[";
    emit_page_samples(locality->inputs);
    std::cout << "],\"caller_output_pages\":[";
    emit_page_samples(locality->caller_outputs);
    std::cout << "],\"worker_output_pages\":[";
    emit_page_samples(locality->worker_outputs);
    std::cout << "],\"worker_output_consumer_samples_ns\":[";
    for (std::size_t row = 0; row < locality->consumer_samples.size(); ++row) {
        if (row != 0) std::cout << ',';
        std::cout << '[';
        const auto& times = locality->consumer_samples[row];
        for (std::size_t op = 0; op < times.size(); ++op) {
            if (op != 0) std::cout << ',';
            if (op > locality->window_start + 1) {
                std::cout << times[op];
            } else {
                std::cout << "null";
            }
        }
        std::cout << ']';
    }
    std::cout << "]}";
}

void emit_joint_locality(const std::optional<JointNumaLocality>& locality) {
    std::cout << "{\"schema_version\":2,\"status\":";
    if (!locality) {
        std::cout << "\"JOINT_CONTEXT_BUDGET_EXCEEDED\"}";
        return;
    }
    std::cout << "\"MEASURED_JOINT\",\"input_pages\":[";
    emit_page_samples(locality->inputs);
    std::cout << "],\"caller_output_pages\":[";
    emit_page_samples(locality->caller_outputs);
    std::cout << "],\"contexts\":[";
    for (std::size_t i = 0; i < locality->contexts.size(); ++i) {
        if (i != 0) std::cout << ',';
        const auto& context = locality->contexts[i];
        std::cout << "{\"window_starts\":[";
        for (std::size_t window = 0; window < context.window_starts.size(); ++window) {
            if (window != 0) std::cout << ',';
            std::cout << context.window_starts[window];
        }
        std::cout << "],\"output_pages\":[";
        emit_page_samples(context.output_pages);
        std::cout << "],\"operation_samples_ns\":[";
        for (std::size_t row = 0; row < context.operation_samples.size(); ++row) {
            if (row != 0) std::cout << ',';
            std::cout << '[';
            const auto& times = context.operation_samples[row];
            for (std::size_t op = 0; op < times.size(); ++op) {
                if (op != 0) std::cout << ',';
                std::cout << times[op];
            }
            std::cout << ']';
        }
        std::cout << "]}";
    }
    std::cout << "]}";
}

void emit_calibration(int caller, int worker, int warmup, const std::vector<Calibration>& calibration,
                      const std::array<std::optional<StorageGeometry>, graph::input_count>& input_storage,
                      const ResultStorage& result_storage, const std::optional<NumaLocality>& locality,
                      const std::optional<JointNumaLocality>& joint_locality) {
    std::cout << "{\"warmup_pairs\":" << warmup << ",\"caller_cpu\":" << caller << ",\"worker_cpu\":" << worker
              << ",\"calibration\":{\"operation_samples_ns\":[";
    for (std::size_t row = 0; row < calibration.size(); ++row) {
        if (row != 0) std::cout << ',';
        std::cout << '[';
        for (std::size_t i = 0; i < calibration[row].operations.size(); ++i) {
            if (i != 0) std::cout << ',';
            std::cout << calibration[row].operations[i];
        }
        std::cout << ']';
    }
    std::cout << "],\"worker_operation_samples_ns\":[";
    for (std::size_t row = 0; row < calibration.size(); ++row) {
        if (row != 0) std::cout << ',';
        std::cout << '[';
        const auto& times = calibration[row].worker_operations;
        for (std::size_t i = 0; i < times.size(); ++i) {
            if (i != 0) std::cout << ',';
            if (i != 0 && graph::legal_window_starts[i - 1]) {
                std::cout << times[i];
            } else {
                std::cout << "null";
            }
        }
        std::cout << ']';
    }
    std::cout << "],\"empty_dispatch_samples_ns\":[";
    for (std::size_t row = 0; row < calibration.size(); ++row) {
        if (row != 0) std::cout << ',';
        std::cout << calibration[row].dispatch_ns;
    }
    // These sizes describe each storage attached to the visible graph slots.
    // No storage handles, contents, or allocator memory totals are retained here.
    std::cout << "],\"input_storage_bytes\":[";
    emit_storage_bytes(input_storage);
    std::cout << "],\"result_storage_bytes\":[";
    emit_storage_bytes(result_storage);
    std::cout << "],\"numa_locality\":";
    if (std::ranges::count(graph::legal_window_starts, true) > 1) {
        emit_joint_locality(joint_locality);
    } else {
        emit_locality(locality);
    }
    std::cout << "}}\n";
}

void benchmark(char** args, int caller, int worker, graph::CpuPair& pair, const graph::WindowSelection& windows) {
    const int warmup = integer(args[0], 3, "warmup count");
    const int measurements = integer(args[1], 3, "measurement count");
    if (measurements % 2 == 0) throw std::invalid_argument("benchmark requires an odd number of measured pairs");

    const SampleInputs data(args + 2);
    const auto& inputs = data.tensors;
    ResultStorage result_storage;

    // Check each variant once in isolation, then keep validation out of both timed calls in each pair.
    {
        const auto serial = graph::run(inputs);
        data.check();
        const auto dual = graph::run_parallel_observed(inputs, pair, windows, [&](std::size_t op, auto&& call) {
            auto value = call();
            // Each lane writes a distinct operation slot in the observed fork/join.
            observe_storage(result_storage[op], value);
            return value;
        });
        data.check();
        check_outputs(inputs, serial, dual);
    }
    std::vector<Sample> samples;
    samples.reserve(measurements);
    const auto total = std::int64_t{warmup} + measurements;
    for (std::int64_t i = 0; i < total; ++i) {
        const bool serial_first = i % 2 == 0;
        const auto first = timed(inputs, pair, windows, serial_first);
        const auto second = timed(inputs, pair, windows, !serial_first);
        data.check();
        check_outputs(inputs, serial_first ? first.second : second.second,
                      serial_first ? second.second : first.second);
        if (i >= warmup) {
            samples.push_back({serial_first ? first.first : second.first,
                               serial_first ? second.first : first.first, serial_first});
        }
    }
    check_lane(caller);
    emit_benchmark(caller, worker, warmup, measurements, windows, samples, result_storage);
}

void calibrate(char** args, int caller, int worker, graph::CpuPair& pair) {
    const int warmup = integer(args[0], 3, "warmup count");
    const SampleInputs data(args + 1);
    const auto& inputs = data.tensors;
    std::array<std::optional<StorageGeometry>, graph::input_count> input_storage;
    ResultStorage result_storage;
    std::optional<NumaLocality> locality;
    if constexpr (graph::input_count + 2 * graph::operation_count <= locality_storage_budget) {
        if (std::ranges::count(graph::legal_window_starts, true) == 1) {
            const auto start = std::ranges::find(graph::legal_window_starts, true);
            locality.emplace(start - graph::legal_window_starts.begin());
            locality->consumer_samples.reserve(warmup);
        }
    }
    const auto check_sample_inputs = [&] {
        data.check();
        for (std::size_t i = 0; i < inputs.size(); ++i) {
            observe_storage(input_storage[i], inputs[i]);
        }
    };
    check_sample_inputs();
    const auto calibration_reference = graph::run(inputs);
    check_sample_inputs();
    for (int i = 1; i < warmup; ++i) {
        const auto warmed = graph::run(inputs);
        check_sample_inputs();
        check_outputs(inputs, calibration_reference, warmed);
    }
    pair.run([] {}, [] {});
    std::vector<Calibration> calibration;
    calibration.reserve(warmup);
    for (int i = 0; i < warmup; ++i) {
        Calibration row{};
        const auto observed = graph::run_observed(inputs, [&](std::size_t operation, auto&& call) {
            const auto start = Clock::now();
            auto value = call();
            row.operations.at(operation) = elapsed_ns(start);
            observe_storage(result_storage.at(operation), value);
            return value;
        });
        check_sample_inputs();
        check_outputs(inputs, calibration_reference, observed);
        if (std::ranges::find(row.operations, 0) != row.operations.end()) {
            throw std::runtime_error("calibration did not observe every operation in the generated graph");
        }
        const auto start = Clock::now();
        pair.run([] {}, [] {});
        row.dispatch_ns = elapsed_ns(start);
        calibration.push_back(row);
    }
    // Recreate each operand in original order. Only an operator admitted as a
    // worker lane may move off the caller, and the service clock runs after handoff.
    const auto sample_worker = [&](Calibration& row, OperationTimes* consumer_times) {
        const auto observed = graph::run_observed(inputs, [&](std::size_t operation, auto&& call) {
            at::Tensor value;
            if (operation != 0 && graph::legal_window_starts[operation - 1]) {
                pair.run([] {}, [&] {
                    const auto start = Clock::now();
                    value = call();
                    row.worker_operations.at(operation) = elapsed_ns(start);
                });
            } else if (consumer_times && operation > locality->window_start + 1) {
                const auto start = Clock::now();
                value = call();
                consumer_times->at(operation) = elapsed_ns(start);
            } else {
                value = call();
            }
            observe_storage(result_storage.at(operation), value);
            return value;
        });
        check_sample_inputs();
        check_outputs(inputs, calibration_reference, observed);
    };
    pair.run([] {}, [&] { check_lane(worker); });
    Calibration worker_warmup{};
    sample_worker(worker_warmup, nullptr);
    for (auto& row : calibration) {
        auto* consumer_times = locality ? &locality->consumer_samples.emplace_back() : nullptr;
        sample_worker(row, consumer_times);
    }
    if (locality) {
        // Keep kernel queries out of the operation, dispatch and graph timing paths.
        for (std::size_t i = 0; i < inputs.size(); ++i) {
            locality->inputs[i] = graph::observe_numa_pages(inputs[i]);
        }
        const auto observe_pages = [&](auto& pages, bool run_on_worker) {
            const auto observed = graph::run_observed(inputs, [&](std::size_t operation, auto&& call) {
                at::Tensor value;
                if (run_on_worker && operation == locality->window_start + 1) {
                    pair.run([] {}, [&] { value = call(); });
                } else {
                    value = call();
                }
                observe_storage(result_storage.at(operation), value);
                pages[operation] = graph::observe_numa_pages(value);
                return value;
            });
            check_sample_inputs();
            check_outputs(inputs, calibration_reference, observed);
        };
        observe_pages(locality->caller_outputs, false);
        observe_pages(locality->worker_outputs, true);
    }
    std::optional<JointNumaLocality> joint_locality;
    if (std::ranges::count(graph::legal_window_starts, true) > 1) {
        std::vector<JointNumaContext> contexts;
        std::vector<std::size_t> starts;
        if (enumerate_joint_contexts(contexts, starts, 0)) {
            joint_locality.emplace();
            joint_locality->contexts = std::move(contexts);
            joint_locality->inputs.reserve(inputs.size());
            for (const auto& input : inputs) joint_locality->inputs.push_back(graph::observe_numa_pages(input));

            // Replay in source order. Cross-lane results flow to later operators without
            // timing the handoff or including a page query in an operator timing interval.
            const auto run_context = [&](const graph::WindowSelection& windows, OperationTimes* timings,
                                         std::vector<graph::NumaPageSample>* pages) {
                const auto observed = graph::run_observed(inputs, [&](std::size_t op, auto&& call) {
                    at::Tensor value;
                    const auto run = [&] {
                        if (timings) {
                            const auto start = Clock::now();
                            value = call();
                            timings->at(op) = elapsed_ns(start);
                        } else {
                            value = call();
                        }
                    };
                    if (op != 0 && windows[op - 1]) {
                        pair.run([] {}, run);
                    } else {
                        run();
                    }
                    observe_storage(result_storage.at(op), value);
                    if (pages) pages->at(op) = graph::observe_numa_pages(value);
                    return value;
                });
                check_sample_inputs();
                check_outputs(inputs, calibration_reference, observed);
            };
            joint_locality->caller_outputs.resize(graph::operation_count);
            run_context(graph::WindowSelection{}, nullptr, &joint_locality->caller_outputs);
            for (auto& context : joint_locality->contexts) {
                graph::WindowSelection windows{};
                for (const auto start : context.window_starts) windows[start] = true;
                context.operation_samples.resize(warmup);
                run_context(windows, nullptr, nullptr);
                for (auto& row : context.operation_samples) run_context(windows, &row, nullptr);
                context.output_pages.resize(graph::operation_count);
                run_context(windows, nullptr, &context.output_pages);
            }
        }
    }
    pair.run([] {}, [&] { check_lane(worker); });
    check_lane(caller);
    emit_calibration(caller, worker, warmup, calibration, input_storage, result_storage, locality, joint_locality);
}

}  // namespace

int main(int argc, char** argv) {
    const std::string_view mode = argc > 1 ? argv[1] : "";
    const bool measure = mode == "--benchmark-windows";
    const bool calibrating = mode == "--calibrate-windows";
    const bool caller_only = mode == "--run-serial";
    if (!measure && !calibrating && !caller_only && mode != "--run-windows") return scar_native_file_main(argc, argv);
    const auto expected = graph::input_count + (measure ? 7 : calibrating ? 5 : (caller_only ? 3 : 5) + graph::output_count);
    if (static_cast<std::size_t>(argc) != expected) {
        std::fputs("usage: aten-graph --calibrate-windows <caller> <worker> <warmup> <input.f32>...\n"
                   "       aten-graph --benchmark-windows <caller> <worker> <window-spec> <warmup> <odd-count> <input.f32>...\n"
                   "       aten-graph --run-windows <caller> <worker> <window-spec> <input.f32>... <new-output.f32>...\n"
                   "       aten-graph --run-serial <caller> <input.f32>... <new-output.f32>...\n",
                   stderr);
        return 2;
    }
    try {
        const int caller = integer(argv[2], 0, "caller CPU");
        const int worker = caller_only ? -1 : integer(argv[3], 0, "worker CPU");
        const auto windows = calibrating || caller_only ? graph::WindowSelection{} : parse_windows(argv[4]);
        check_launch(caller, worker);
        at::set_num_threads(1);
        at::set_num_interop_threads(1);
        at::NoGradGuard no_grad;
        if (caller_only) {
            check_lane(caller);
            return invoke(argv + 3, graph::run);
        }
        graph::CpuPair pair(caller, worker);
        check_lane(caller);
        if (calibrating) {
            calibrate(argv + 4, caller, worker, pair);
        } else if (measure) {
            benchmark(argv + 5, caller, worker, pair, windows);
        } else {
            return invoke(argv + 5, [&](const auto& inputs) {
                auto result = graph::run_parallel(inputs, pair, windows);
                check_lane(caller);
                return result;
            });
        }
    } catch (const std::exception& error) {
        std::fprintf(stderr, "SCAR ATen CPU pair failed: %s\n", error.what());
        return 1;
    }
}
