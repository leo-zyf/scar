#include "cuda_schedule.hpp"

#include <algorithm>
#include <array>
#include <bit>
#include <cerrno>
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <limits>
#include <memory>
#include <stdexcept>
#include <string>
#include <string_view>
#include <system_error>
#include <unistd.h>
#include <utility>
#include <variant>

namespace {
namespace graph = scar_cuda_generated;
namespace fs = std::filesystem;
using graph::Buffer;
using graph::Memory;

static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559);
static_assert(std::endian::native == std::endian::little || std::endian::native == std::endian::big);
constexpr auto byte_order = std::endian::native == std::endian::little ? "little" : "big";

struct FilePort {
    std::size_t slot;
    std::size_t rows;
    std::size_t cols;
};

/* SCAR_FILE_PORTS */

/* SCAR_STAGED_FILE */

void read_input(const char* path, Buffer& target) {
    if (target.size() > static_cast<std::size_t>(std::numeric_limits<std::streamsize>::max())) {
        throw std::runtime_error("input exceeds file ABI stream limit");
    }
    const auto size = static_cast<std::streamsize>(target.size());
    std::ifstream source(path, std::ios::binary | std::ios::ate);
    if (!source || source.tellg() != size || !source.seekg(0)) {
        throw std::runtime_error(std::string("input size differs from the graph contract: ") + path);
    }
    if (!source.read(static_cast<char*>(target.data()), size)
            || source.peek() != std::char_traits<char>::eof() || source.bad()) {
        throw std::runtime_error(std::string("could not read exact input bytes: ") + path);
    }
}

template <std::size_t Count>
void write_ports(const std::array<FilePort, Count>& ports) {
    for (std::size_t index = 0; index < ports.size(); ++index) {
        if (index != 0) std::cout << ',';
        const auto& port = ports[index];
        std::cout << "{\"shape\":[" << port.rows << ',' << port.cols
                  << "],\"nbytes\":" << graph::buffers[port.slot].size << ",\"slot\":" << port.slot << '}';
    }
}

void describe() {
    std::size_t copies = 0, provider_calls = 0, waits = 0;
    for (const auto& step : graph::steps) {
        copies += std::holds_alternative<graph::Copy>(step.operation);
        provider_calls += std::holds_alternative<graph::MatrixMultiply>(step.operation);
        waits += step.wait_for.size();
    }
    std::cout << "{\"abi_version\":1,\"dtype\":\"float32\",\"layout\":\"row_major_contiguous\",\"byte_order\":\""
              << byte_order << "\",\"device\":" << graph::device << ",\"buffer_count\":" << graph::buffers.size()
              << ",\"stream_count\":" << graph::workspace_bytes.size() << ",\"copy_count\":" << copies
              << ",\"provider_calls\":" << provider_calls << ",\"cross_stream_waits\":" << waits
              << ",\"execution_requires_trial\":true,\"inputs\":[";
    write_ports(inputs);
    std::cout << "],\"outputs\":[";
    write_ports(outputs);
    std::cout << "]}\n";
}

bool device_available() {
    int count = 0;
    const auto status = cudaGetDeviceCount(&count);
    if (status == cudaErrorNoDevice || status == cudaErrorInsufficientDriver
            || status == cudaErrorInitializationError || status == cudaErrorSystemDriverMismatch
            || status == cudaErrorSystemNotReady || (status == cudaSuccess && graph::device >= count)) {
        const char* reason = status == cudaSuccess ? "selected device ordinal is absent" : cudaGetErrorString(status);
        std::fprintf(stderr, "CUDA device unavailable: %s\n", reason);
        return false;
    }
    scar::cuda_copy_v1::detail::check(status, "cudaGetDeviceCount");
    return true;
}

void execute(char** paths) {
    std::array<fs::path, outputs.size()> destinations;
    for (std::size_t index = 0; index < destinations.size(); ++index) {
        const fs::path path(paths[inputs.size() + index]);
        const auto parent = path.has_parent_path() ? path.parent_path() : fs::path(".");
        auto absolute = fs::canonical(parent) / path.filename();
        if (fs::exists(fs::symlink_status(absolute))
                || std::find(destinations.begin(), destinations.begin() + index, absolute) != destinations.begin() + index) {
            throw std::runtime_error("output path already exists or is repeated: " + absolute.string());
        }
        destinations[index] = std::move(absolute);
    }

    std::array<std::unique_ptr<Buffer>, graph::buffers.size()> storage;
    std::array<Buffer*, graph::buffers.size()> bindings;
    for (std::size_t index = 0; index < storage.size(); ++index) {
        const auto& spec = graph::buffers[index];
        storage[index] = std::make_unique<Buffer>(graph::device, spec.memory, spec.size);
        bindings[index] = storage[index].get();
    }
    for (std::size_t index = 0; index < inputs.size(); ++index) {
        read_input(paths[index], *bindings[inputs[index].slot]);
    }
    graph::run(bindings);

    std::array<StagedFile, outputs.size()> staged;
    for (std::size_t index = 0; index < outputs.size(); ++index) {
        const auto& result = *bindings[outputs[index].slot];
        staged[index].stage(destinations[index], result.data(), result.size());
    }
    for (std::size_t index = 0; index < staged.size(); ++index) staged[index].publish(destinations[index]);
}
}  // namespace

int main(int argc, char** argv) {
    const std::string_view flag = argc > 1 ? argv[1] : "";
    if (argc == 2 && flag == "--describe") {
        describe();
        return 0;
    }
    const bool probe = argc == 2 && flag == "--probe";
    const bool trial = flag == "--trial" && static_cast<std::size_t>(argc) == 2 + inputs.size() + outputs.size();
    if (!probe && !trial) {
        std::fputs("usage: aten-inference-cuda --describe | --probe | --trial <input.f32>... <new-output.f32>...\n", stderr);
        return 2;
    }
    try {
        if (!device_available()) return 77;
        if (trial) execute(argv + 2);
        else std::cout << "{\"device\":" << graph::device << ",\"available\":true}\n";
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "SCAR CUDA inference failed: %s\n", error.what());
        return 1;
    }
}
