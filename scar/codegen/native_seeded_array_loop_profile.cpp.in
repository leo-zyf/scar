#define main scar_private_loop_probe
#include "tape_0.inc"
#undef main

#include "numpy_observables.hpp"
#include "numpy_random.hpp"
#include "numpy_random_coefficients.hpp"

#include <algorithm>
#include <iterator>
#include <limits>

namespace {
using Coefficient = std::array<double, 8>;

enum class HookKind { coefficient, normalization };
struct Hook {
    std::size_t step;
    HookKind kind;
    std::size_t index;
};

@SEEDED_ROUTES@

constexpr std::size_t state_bytes = @STATE_BYTES@;
constexpr std::size_t steady_destination = @STEADY_DESTINATION@;

struct Handoffs {
    std::uint64_t copies{};
    std::uint64_t transfers{};
};

char* run_body(char* base, const std::array<Coefficient, coefficient_count>& prepared,
               std::size_t cursor, std::size_t end, std::vector<std::vector<char>>& unused) {
    auto hook = std::lower_bound(std::begin(hooks), std::end(hooks), cursor,
        [](const Hook& candidate, std::size_t step) { return candidate.step < step; });
    for (; hook != std::end(hooks) && hook->step < end; ++hook) {
        if (!execute_round(base, cursor, hook->step, false, unused)) return nullptr;
        const auto& step = steps[hook->step];
        if (hook->kind == HookKind::normalization) {
            auto* raw = base + step.offset[0];
            auto* scratch = base + step.offset[2];
            auto selected = scar_numpy_normalize_v1(step.count, raw, scratch);
            if (selected == 0) return raw;
            if (selected == 1) return scratch;
            return nullptr;
        }
        std::memcpy(base + step.offset[2], prepared[hook->index].data(), step.count);
        cursor = hook->step + 1;
    }
    return nullptr;
}

bool write_handoffs(const std::string& prefix, const Handoffs& counts) {
    const auto path = prefix + ".handoffs.json";
    auto* output = std::fopen(path.c_str(), "wbx");
    if (!output) return false;
    const auto wrote = std::fprintf(output, "{\"copies\": %llu, \"same_span_transfers\": %llu}\n",
        static_cast<unsigned long long>(counts.copies), static_cast<unsigned long long>(counts.transfers));
    return std::fclose(output) == 0 && wrote > 0;
}
}

extern "C" int scar_array_entry_profile_0(double* norm, double* difference, const char* state_prefix,
                                          std::uint64_t seed, std::uint64_t round_count) {
    if (round_count == 0 || seed > std::numeric_limits<std::uint32_t>::max()
            || !scar_numpy_complex_runtime_supported()) return 1;
    std::array<Coefficient, coefficient_count> prepared{};
    if (!prepare_coefficients(seed, prepared)) return 1;
    std::unique_ptr<void, decltype(&std::free)> arena(std::aligned_alloc(64, arena_bytes), &std::free);
    if (!arena) return 1;
    auto* base = static_cast<char*>(arena.get());
    std::vector<std::vector<char>> captured;
    Handoffs handoffs{};
    auto* state = run_body(base, prepared, rounds[0][0], rounds[0][1], captured);
    if (!state) return 1;
    if (state_prefix) captured.emplace_back(state, state + state_bytes);
    for (std::uint64_t iteration = 1; iteration < round_count; ++iteration) {
        auto* destination = base + steady_destination;
        if (state == destination) {
            ++handoffs.transfers;
        } else {
            std::memcpy(destination, state, state_bytes);
            ++handoffs.copies;
        }
        state = run_body(base, prepared, rounds[1][0] + 1, rounds[1][1], captured);
        if (!state) return 1;
        if (state_prefix) captured.emplace_back(state, state + state_bytes);
    }
    if (scar_numpy_split_observable_v1(state_bytes / item, state, norm, difference) != 0) return 1;
    if (state_prefix) {
        for (std::size_t index = 0; index < captured.size(); ++index) {
            if (!write_checkpoint(std::string(state_prefix) + "." + std::to_string(index) + ".bin",
                                  captured[index])) return 1;
        }
        if (!write_handoffs(state_prefix, handoffs)) return 1;
    }
    return 0;
}
