namespace {
namespace fs = std::filesystem;
constexpr int rows = @SCAR_ROWS@, cols = @SCAR_COLS@;
constexpr std::size_t cells = std::size_t(rows) * cols;
constexpr int owner_cpu = @SCAR_CPU@;
constexpr double diffusion_u = @SCAR_DIFF_UPPER@, diffusion_v = @SCAR_DIFF_LOWER@;
constexpr double initial_dt = @SCAR_DT@, maximum_rate = @SCAR_MAX_RATE@;
constexpr std::uint64_t report_frequency = @SCAR_REPORT_FREQ@, max_steps = @SCAR_MAX_STEPS@;
constexpr std::string_view frame_name = @SCAR_FRAME@;
static_assert(std::endian::native == std::endian::little && sizeof(double) == 8 &&
              std::numeric_limits<double>::is_iec559 && sizeof(intptr_t) == 8);

struct Asset {
    std::string_view name;
    std::size_t bytes;
    std::string_view sha;
};

constexpr Asset initial_asset{"assets/initial.bin", @SCAR_INITIAL_BYTES@, "@SCAR_INITIAL_SHA@"};
constexpr Asset frame_asset{"assets/initial.png", @SCAR_FRAME_BYTES@, "@SCAR_FRAME_SHA@"};
constexpr Asset session_asset{"lib/session.so", @SCAR_SESSION_BYTES@, "@SCAR_SESSION_SHA@"};

void require(bool condition, std::string_view message) {
    if (!condition) throw std::runtime_error(std::string(message));
}

std::string digest(std::span<const unsigned char> bytes) {
    std::array<unsigned char, EVP_MAX_MD_SIZE> hash{};
    unsigned int length = 0;
    require(EVP_Digest(bytes.data(), bytes.size(), hash.data(), &length, EVP_sha256(), nullptr) == 1 &&
            length == 32, "SHA-256 failed");
    const char hex[] = "0123456789abcdef";
    std::string result;
    result.reserve(64);
    for (unsigned int i = 0; i != length; ++i) {
        result.push_back(hex[hash[i] >> 4]);
        result.push_back(hex[hash[i] & 15]);
    }
    return result;
}

class Descriptor {
    int fd_;
public:
    explicit Descriptor(const fs::path& path) : fd_(::open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW)) {
        require(fd_ >= 0, "cannot open package asset");
    }
    Descriptor(const Descriptor&) = delete;
    ~Descriptor() { ::close(fd_); }
    int get() const { return fd_; }
};

void verify_read(const Descriptor& file, Asset asset, std::span<unsigned char> bytes) {
    require(bytes.size() == asset.bytes, "invalid asset size request");
    std::size_t offset = 0;
    while (offset != bytes.size()) {
        const auto amount = ::read(file.get(), bytes.data() + offset, bytes.size() - offset);
        if (amount < 0 && errno == EINTR) continue;
        require(amount > 0, "cannot read exact package asset");
        offset += static_cast<std::size_t>(amount);
    }
    unsigned char extra;
    require(::read(file.get(), &extra, 1) == 0 && digest(bytes) == asset.sha,
            "package asset differs from admitted bytes");
}

class Library {
    void* handle_ = nullptr;
public:
    explicit Library(const fs::path& root) {
        Descriptor file(root / session_asset.name);
        std::vector<unsigned char> bytes(session_asset.bytes);
        verify_read(file, session_asset, bytes);
        const auto name = "/proc/self/fd/" + std::to_string(file.get());
        handle_ = ::dlopen(name.c_str(), RTLD_LOCAL | RTLD_NOW);
        require(handle_ != nullptr, "cannot load exact retained native session");
    }
    Library(const Library&) = delete;
    ~Library() { ::dlclose(handle_); }
    template<class Signature>
    Signature symbol(const char* name) const {
        void* address = ::dlsym(handle_, name);
        require(address != nullptr, "native session symbol unavailable");
        return reinterpret_cast<Signature>(address);
    }
};

using Getter = const scar_stateful_table_v1* (*)();
using Plan = const char* (*)() noexcept;
using Create = int32_t (*)(const scar_stateful_table_v1*, const scar_array_v1*, uint64_t,
                          const scar_scalar_v1*, uint64_t, const scar_provider_v1*, uint64_t, void**) noexcept;
using Step = int32_t (*)(void*, const scar_stateful_table_v1*, const scar_array_v1*, uint64_t,
                        const scar_scalar_v1*, uint64_t, const scar_provider_v1*, uint64_t,
                        uint64_t*, uint64_t*) noexcept;
using Destroy = int32_t (*)(void**) noexcept;

// This is a single qualified broadcast square, with no generic power entry.
int multiply_self(void* context, char** data, const intptr_t* dimensions,
                  const intptr_t* strides, void* auxiliary) {
    if (!context || auxiliary || !data || !data[0] || !data[1] || !data[2] ||
        !dimensions || !strides || dimensions[0] != cols - 2 ||
        strides[0] != 8 || strides[1] != 0 || strides[2] != 8) return 1;
    double exponent;
    std::memcpy(&exponent, data[1], sizeof exponent);
    if (exponent != 2) return 1;
    const auto* values = reinterpret_cast<const double*>(data[0]);
    std::transform(values, values + dimensions[0], reinterpret_cast<double*>(data[2]),
                   [](double value) { return value * value; });
    return 0;
}

class Session {
    void* state_ = nullptr;
    const scar_stateful_table_v1* table_;
    Step step_;
    Destroy destroy_;
public:
    Session(const Library& library, const std::array<scar_array_v1, 2>& arrays,
            const std::array<scar_scalar_v1, 5>& scalars, const scar_provider_v1& square)
        : table_(library.symbol<Getter>("scar_get_stateful_table_v1")()),
          step_(library.symbol<Step>(@SCAR_STEP_SYMBOL@)),
          destroy_(library.symbol<Destroy>(@SCAR_DESTROY_SYMBOL@)) {
        const auto plan = library.symbol<Plan>(@SCAR_PLAN_SYMBOL@)();
        require(plan && std::string_view(plan) == "@SCAR_SESSION_PLAN@" &&
                table_ && table_->abi_version == 1 && table_->struct_size == sizeof(*table_) &&
                table_->array_count == arrays.size() && table_->scalar_count == scalars.size() &&
                table_->provider_count == 1, "native session ABI or plan differs");
        const auto create = library.symbol<Create>(@SCAR_CREATE_SYMBOL@);
        require(create(table_, arrays.data(), arrays.size(), scalars.data(), scalars.size(),
                       &square, 1, &state_) == 0 && state_, "failed to initialize native session");
    }
    Session(const Session&) = delete;
    ~Session() { if (state_) destroy_(&state_); }
    void step(const std::array<scar_array_v1, 2>& arrays, const std::array<scar_scalar_v1, 5>& scalars,
              const scar_provider_v1& square, bool repeated) {
        uint64_t committed = 0;
        uint64_t resident = 0;
        const auto status = step_(state_, table_, arrays.data(), arrays.size(),
                                  scalars.data(), scalars.size(), &square, 1, &committed, &resident);
        if (status != 0 || committed != 1 || resident != repeated) {
            throw std::runtime_error("native step rejected, status " + std::to_string(status));
        }
    }
    void close() { require(destroy_(&state_) == 0 && !state_, "native session close failed"); }
};

scar_array_v1 array_descriptor(double* data) {
    return {data, 2, {rows, cols}, {cols * sizeof(double), sizeof(double)},
            reinterpret_cast<uintptr_t>(data), reinterpret_cast<uintptr_t>(data + cells)};
}

void refresh_boundary(double* array) {
@SCAR_GHOST_ASSIGNMENTS@
}

template<class Value>
Value parse(std::string_view text) {
    Value value{};
    const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
    require(error == std::errc{} && end == text.data() + text.size(), "invalid numeric argument");
    return value;
}

struct Clock {
    double time = 0.0;
    double dt = initial_dt;
    std::uint64_t step = 0;

    void advance(double end) {
        const auto next = time + dt;
        require(std::isfinite(next) && next > time, "non-progressing time recurrence");
        time = next;
        const auto remaining = end - time;
        if (remaining < dt) dt = remaining;
        ++step;
    }
};

void write_file(const fs::path& path, std::span<const unsigned char> bytes) {
    std::ofstream stream(path, std::ios::binary | std::ios::trunc);
    stream.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
    stream.close();
    require(bool(stream), "output file publication failed");
}

void establish_context() {
    __builtin_cpu_init();
    require(__builtin_cpu_supports("avx2") && !__builtin_cpu_supports("avx512f") &&
            std::fegetround() == FE_TONEAREST && (_mm_getcsr() & 0x8040u) == 0,
            "the qualified x86 floating point context is unavailable");
    cpu_set_t mask;
    CPU_ZERO(&mask);
    require(sched_getaffinity(0, sizeof mask, &mask) == 0 && CPU_ISSET(owner_cpu, &mask),
            "native owner CPU outside the launch affinity");
    CPU_ZERO(&mask);
    CPU_SET(owner_cpu, &mask);
    require(sched_setaffinity(0, sizeof mask, &mask) == 0, "cannot bind the native owner CPU");
}

void run(int argc, char** argv) {
    require(argc == 6 || argc == 7, "expected t1 F k dump_freq outdir [diagnostic_state_path]");
    const auto end = parse<double>(argv[1]);
    const auto feed = parse<double>(argv[2]);
    const auto death = parse<double>(argv[3]);
    const auto dump_frequency = parse<std::uint64_t>(argv[4]);
    require(std::isfinite(end) && end > 0 && feed > 0 && feed <= maximum_rate &&
            death > 0 && death <= maximum_rate && dump_frequency > 0 &&
            argv[5][0] != '\0', "arguments outside the one-frame simulation domain");
    establish_context();
    Clock bound;
    while (bound.time < end) {
        require(bound.step < max_steps && bound.step < dump_frequency,
                "time range requires an unqualified step or second frame");
        bound.advance(end);
    }
    const auto outdir = fs::path(argv[5]);
    const auto frame_path = outdir / frame_name;
    if (argc == 7) {
        require(argv[6][0] != '\0' && fs::weakly_canonical(argv[6]) != fs::weakly_canonical(frame_path)
                && (!fs::exists(argv[6]) || !fs::exists(frame_path) || !fs::equivalent(argv[6], frame_path)),
                "diagnostic path must differ from the frame");
    }

    const auto root = fs::read_symlink("/proc/self/exe").parent_path().parent_path();
    std::vector<double> values(2 * cells);
    std::vector<unsigned char> frame(frame_asset.bytes);
    const auto raw = std::span(reinterpret_cast<unsigned char*>(values.data()), values.size() * sizeof(double));
    verify_read(Descriptor(root / initial_asset.name), initial_asset, raw);
    verify_read(Descriptor(root / frame_asset.name), frame_asset, frame);
    const Library library(root);
    const std::array arrays{array_descriptor(values.data()), array_descriptor(values.data() + cells)};
    std::array<scar_scalar_v1, 5> scalars{{@SCAR_SCALARS@}};
    char context;
    const scar_provider_v1 square{multiply_self, &context, nullptr};
    Session session(library, arrays, scalars, square);

    fs::create_directories(outdir);
    write_file(frame_path, frame);
    std::cout.imbue(std::locale::classic());
    std::cout << std::scientific << std::setprecision(6);
    Clock clock;
    while (clock.time < end) {
        if (clock.step % report_frequency == 0) {
            std::cout << "step=" << clock.step << "; time=" << clock.time << '\n';
        }
        scalars[@SCAR_DT_SLOT@].value = clock.dt;
        session.step(arrays, scalars, square, clock.step != 0);
        refresh_boundary(values.data());
        refresh_boundary(values.data() + cells);
        clock.advance(end);
    }
    session.close();
    if (argc == 7) write_file(argv[6], raw);
    require(bool(std::cout.flush()), "progress publication failed");
}
}

int main(int argc, char** argv) {
    try {
        run(argc, argv);
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
