#if @CPU_BINDING_ENABLED@ && !defined(_GNU_SOURCE)
#define _GNU_SOURCE
#endif
#include "loop_abi_v1.h"
#include <bit>
#include <cfenv>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <limits>
@OPENMP_INCLUDE@
#if @CPU_BINDING_ENABLED@
#ifndef __linux__
#error "CPU affinity binding requires Linux"
#endif
#include <cerrno>
#include <sched.h>
#include <unistd.h>
#endif

#pragma STDC FENV_ACCESS ON

namespace {
static_assert(sizeof(double) == 8 && std::numeric_limits<double>::is_iec559);

#if @CPU_BINDING_ENABLED@
constexpr int32_t affinity_guard_status = SCAR_CPU_AFFINITY_GUARD_V1;
constexpr int planned_cpu_ids[] = {@CPU_IDS@};
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;

// sched_*affinity with pid zero acts on the calling Linux thread. Keep its
// complete original mask, including CPUs outside this plan, and restore it on
// every exit. Dynamic CPU masks avoid the fixed CPU_SETSIZE limit.
class ThreadAffinity {
    cpu_set_t *saved_ = nullptr;
    cpu_set_t *target_ = nullptr;
    cpu_set_t *observed_ = nullptr;
    size_t slots_ = 0;
    size_t bytes_ = 0;
    int cpu_ = -1;
    bool changed_ = false;

    bool matches(const cpu_set_t *expected) noexcept {
        if (observed_ == nullptr) return false;
        CPU_ZERO_S(bytes_, observed_);
        return sched_getaffinity(0, bytes_, observed_) == 0 &&
               CPU_EQUAL_S(bytes_, expected, observed_);
    }

public:
    ThreadAffinity() noexcept {
        const long configured = sysconf(_SC_NPROCESSORS_CONF);
        slots_ = configured > 0 ? static_cast<size_t>(configured) : 128;
        if (slots_ < minimum_cpu_slots) slots_ = minimum_cpu_slots;
        for (; slots_ <= (size_t(1) << 20); slots_ *= 2) {
            saved_ = CPU_ALLOC(slots_);
            if (saved_ == nullptr) return;
            bytes_ = CPU_ALLOC_SIZE(slots_);
            CPU_ZERO_S(bytes_, saved_);
            if (sched_getaffinity(0, bytes_, saved_) == 0) {
                target_ = CPU_ALLOC(slots_);
                observed_ = CPU_ALLOC(slots_);
                return;
            }
            const int error = errno;
            CPU_FREE(saved_);
            saved_ = nullptr;
            if (error != EINVAL) return;
        }
    }

    ThreadAffinity(const ThreadAffinity &) = delete;
    ThreadAffinity &operator=(const ThreadAffinity &) = delete;

    bool contains(int cpu) const noexcept {
        return saved_ != nullptr && target_ != nullptr && observed_ != nullptr &&
               cpu >= 0 && static_cast<size_t>(cpu) < slots_ &&
               CPU_ISSET_S(cpu, bytes_, saved_);
    }

    bool bind(int cpu) noexcept {
        if (!contains(cpu)) return false;
        CPU_ZERO_S(bytes_, target_);
        CPU_SET_S(cpu, bytes_, target_);
        cpu_ = cpu;
        changed_ = true;
        return sched_setaffinity(0, bytes_, target_) == 0 && bound();
    }

    bool bound() noexcept {
        return changed_ && matches(target_) && sched_getcpu() == cpu_;
    }

    bool restore() noexcept {
        if (!changed_) return true;
        if (sched_setaffinity(0, bytes_, saved_) != 0 || !matches(saved_)) return false;
        changed_ = false;
        return true;
    }

    bool restore_original() noexcept {
        if (saved_ == nullptr || observed_ == nullptr) return false;
        if (!changed_ && matches(saved_)) return true;
        // Also cover a runtime that changed the OpenMP master thread's mask
        // before our worker scope began. Restore the caller entry snapshot.
        changed_ = true;
        return restore();
    }

    ~ThreadAffinity() {
        // Retry if an explicit restore failed; the caller still receives a
        // guard failure. An external cpuset change may prevent exact restore.
        restore();
        if (saved_ != nullptr) CPU_FREE(saved_);
        if (target_ != nullptr) CPU_FREE(target_);
        if (observed_ != nullptr) CPU_FREE(observed_);
    }
};
#endif

constexpr int64_t modeled_rows = @ROWS@LL;
constexpr int64_t modeled_cols = @COLS@LL;
constexpr uint64_t modeled_bytes = @BYTES@ULL;
constexpr uint64_t modeled_count = @TRIP_COUNT@ULL;
constexpr uint64_t payload_budget = @BUDGET@ULL;
constexpr int floating_flags = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;

class FloatingScope {
    fenv_t saved_;
    bool saved_ok_ = false;
    bool restored_ = false;
public:
    bool begin(const fenv_t *execution = nullptr) noexcept {
        saved_ok_ = std::fegetenv(&saved_) == 0;
        if (!saved_ok_) return false;
        if (execution != nullptr) return std::fesetenv(execution) == 0;
        fenv_t held;
        return std::feholdexcept(&held) == 0;
    }
    bool restore() noexcept {
        if (!saved_ok_) return false;
        restored_ = std::fesetenv(&saved_) == 0;
        return restored_;
    }
    ~FloatingScope() { if (saved_ok_ && !restored_) std::fesetenv(&saved_); }
};

bool valid_array(const scar_array_v1 &a) {
    if (a.rank != 2 || a.shape[0] != modeled_rows || a.shape[1] != modeled_cols ||
        a.lower_bound > a.upper_bound || reinterpret_cast<uintptr_t>(a.data) % alignof(double) ||
        a.strides[0] % int64_t(sizeof(double)) || a.strides[1] % int64_t(sizeof(double))) return false;
    if (modeled_rows == 0 || modeled_cols == 0) return true;
    if (a.data == nullptr || (modeled_cols > 1 && a.strides[1] != sizeof(double)) ||
        (modeled_rows > 1 && a.strides[0] != modeled_cols * int64_t(sizeof(double)))) return false;
    const __int128 offset = __int128(modeled_rows - 1) * a.strides[0] +
                            __int128(modeled_cols - 1) * a.strides[1];
    const __int128 address = reinterpret_cast<uintptr_t>(a.data);
    return offset >= 0 && offset <= std::numeric_limits<ptrdiff_t>::max() &&
           address >= a.lower_bound && address + offset + sizeof(double) <= a.upper_bound;
}

bool finite_bits(double value) {
    // Integer inspection preserves signaling-NaN payloads for the original
    // NumPy fallback, without classifying them through floating arithmetic.
    return (std::bit_cast<uint64_t>(value) & UINT64_C(0x7ff0000000000000)) !=
           UINT64_C(0x7ff0000000000000);
}

void execute_row(const scar_array_v1 &state, scar_array_v1 &output,
                 int64_t row, uint64_t steps, uint32_t &nonfinite) {
    const auto *input = static_cast<const double *>(state.data) + row * modeled_cols;
    auto *result = static_cast<double *>(output.data) + row * modeled_cols;
    for (int64_t col = 0; col < modeled_cols; ++col) {
        double carry;
        std::memcpy(&carry, input + col, sizeof(carry));
        if (!finite_bits(carry)) { nonfinite |= 1; continue; }
        // One body representation and one runtime loop, never source unrolling.
        #pragma GCC unroll 1
        for (uint64_t iteration = 0; iteration < steps; ++iteration) {
@BODY@
            carry = @RESULT@;
            if (!finite_bits(carry)) { nonfinite |= 1; break; }
        }
        result[col] = carry;
    }
}

int32_t run(const scar_array_v1 *state, uint64_t steps, scar_array_v1 *output) {
    if (steps == 0 || steps != modeled_count) return SCAR_LOOP_TRIP_COUNT_GUARD_V1;
    if (state == nullptr || output == nullptr || !valid_array(*state) || !valid_array(*output))
        return SCAR_ARGUMENT_GUARD_V1;
    if (__int128(modeled_rows) * modeled_cols * sizeof(double) != modeled_bytes ||
        modeled_bytes > payload_budget) return SCAR_LOOP_PAYLOAD_GUARD_V1;
    if (state->lower_bound < output->upper_bound && output->lower_bound < state->upper_bound)
        return SCAR_ARGUMENT_GUARD_V1;
@AFFINITY_START@
    FloatingScope caller_fenv;
    if (!caller_fenv.begin()) return SCAR_FLOATING_GUARD_V1;
    fenv_t execution_environment;
    if (std::fegetenv(&execution_environment) != 0) return SCAR_FLOATING_GUARD_V1;
    uint32_t floating_guard = 0;
    uint32_t placement_guard = 0;
    // Empty values must not form pointers into their possibly null allocation.
    if (modeled_rows != 0 && modeled_cols != 0) {
@LOOPS@
    }
    floating_guard |= static_cast<uint32_t>(std::fetestexcept(floating_flags) != 0);
    floating_guard |= static_cast<uint32_t>(!caller_fenv.restore());
@AFFINITY_FINISH@
    return floating_guard ? SCAR_FLOATING_GUARD_V1 : SCAR_OK_V1;
}

const scar_loop_table_v1 table = {
    1, sizeof(scar_loop_table_v1), modeled_count, &run,
    "@LOOP_SHA256@", "@STRATEGY_SHA256@", "@PLAN_SHA256@", "@CONTRACT_SHA256@"
};
}  // namespace

extern "C" SCAR_EXPORT_V1 const scar_loop_table_v1 *scar_get_loop_table_v1() {
    return &table;
}

