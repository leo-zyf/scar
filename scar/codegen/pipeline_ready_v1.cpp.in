#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
@PLAN_AND_DESCRIPTOR_HELPERS@
#include <cfenv>
#include <cerrno>
#include <condition_variable>
#include <mutex>
#include <sched.h>
#include <system_error>
#include <thread>
#include <unistd.h>

#pragma STDC FENV_ACCESS ON

namespace {
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
@AFFINITY_IMPLEMENTATION@
constexpr int32_t worker_guard = 16;
constexpr std::array<int, @CALL_COUNT@> call_cpu_ids = {{@CALL_CPUS@}};
constexpr std::array<int, @LANE_COUNT@> lane_cpu_ids = {{@LANE_CPUS@}};
constexpr std::array<std::array<uint8_t, @CALL_COUNT@>, @CALL_COUNT@> call_predecessors = {{
@CALL_PREDECESSORS@
}};
@WORKER_ENVIRONMENT_AND_ABI_CALL@

int32_t run_ready(const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
                  const scar_operator_table_v1 *const *operators, uint64_t operator_count,
                  uint64_t *failed_call, const fenv_t &caller_environment) {
    if (count != input_count || output == nullptr || (count && inputs == nullptr) ||
        operators == nullptr || operator_count != call_plans.size()) return argument_guard;
    __int128 payload = value_plans[final_value].bytes;
    for (const auto capacity : slot_capacities) {
        if (capacity % sizeof(double) || capacity > std::numeric_limits<ptrdiff_t>::max()) return budget_guard;
        payload += capacity;
    }
    if (payload > payload_budget || payload > std::numeric_limits<size_t>::max()) return budget_guard;
    for (const auto &p : value_plans) {
        if (__int128(p.rows) * p.cols * sizeof(double) != p.bytes) return shape_guard;
        if (p.kind == external_input &&
            (!valid_array(inputs[p.storage_index], p) || !contiguous(inputs[p.storage_index]))) return shape_guard;
    }
    if (!valid_array(*output, value_plans[final_value]) || !contiguous(*output)) return shape_guard;
    for (uint64_t i = 0; i < count; ++i) if (overlap(*output, inputs[i])) return argument_guard;
    for (size_t i = 0; i < call_plans.size(); ++i) {
        const auto *table = operators[i]; const auto &call = call_plans[i];
        if (table == nullptr || table->abi_version != 1 || table->struct_size < sizeof(scar_operator_table_v1) ||
            table->run == nullptr || table->input_count != call.count || table->plan_sha256 == nullptr ||
            std::strcmp(table->plan_sha256, call.plan_sha256) != 0) return operator_guard;
    }
    std::vector<std::unique_ptr<double[]>> slots(slot_capacities.size());
    for (size_t i = 0; i < slots.size(); ++i) if (slot_capacities[i]) {
        slots[i].reset(new (std::nothrow) double[slot_capacities[i] / sizeof(double)]);
        if (!slots[i]) return allocation_guard;
    }
    // Descriptors never change after launch. Payload writes are protected by
    // actual predecessor completion, per-lane ownership and pool-version guards.
    std::vector<scar_array_v1> values(value_plans.size());
    std::vector<uint8_t> ready(value_plans.size(), 0), state(call_plans.size(), 0);
    std::vector<uint64_t> owners(slot_capacities.size(), no_value), remaining(value_plans.size(), 0);
    for (size_t value = 0; value < value_plans.size(); ++value) {
        const auto &p = value_plans[value];
        if (p.kind == external_input) { values[value] = inputs[p.storage_index]; ready[value] = 1; }
        else if (p.kind == workspace) {
            if (p.storage_index >= slots.size() || p.bytes > slot_capacities[p.storage_index]) return budget_guard;
            values[value] = slot_array(slots[p.storage_index].get(), slot_capacities[p.storage_index], p);
        } else if (p.kind == final_output && value == final_value) values[value] = *output;
        else return lifetime_guard;
    }
    for (const auto &call : call_plans) for (uint64_t j = 0; j < call.count; ++j) {
        if (call.inputs[j] >= remaining.size()) return argument_guard;
        ++remaining[call.inputs[j]];
    }
    std::mutex mutex;
    std::condition_variable changed;
    size_t succeeded = 0, running = 0;
    bool stop = false;
    int32_t failure = SCAR_OK_V1;
    uint64_t failure_index = no_value;
    auto fail = [&](int32_t status, uint64_t index) {
        stop = true;
        if (failure == SCAR_OK_V1 || index < failure_index) { failure = status; failure_index = index; }
        changed.notify_all();
    };
    auto predecessors_complete = [&](size_t index) {
        for (size_t pred = 0; pred < call_plans.size(); ++pred)
            if (call_predecessors[index][pred] && state[pred] != 2) return false;
        return true;
    };
    auto next_for_cpu = [&](int cpu) {
        for (size_t i = 0; i < call_plans.size(); ++i)
            if (state[i] == 0 && call_cpu_ids[i] == cpu && predecessors_complete(i)) return i;
        return call_plans.size();
    };
    auto any_ready = [&]() {
        for (size_t i = 0; i < call_plans.size(); ++i)
            if (state[i] == 0 && predecessors_complete(i)) return true;
        return false;
    };
    auto admit_task = [&](size_t index) -> int32_t {
        const auto &call = call_plans[index]; const auto &p = value_plans[call.output];
        if (p.producer != int64_t(index) || p.bytes > call.output_budget ||
            !valid_array(values[call.output], p)) return budget_guard;
        if (p.kind == workspace) {
            const auto old = owners[p.storage_index];
            if (old != no_value && remaining[old] != 0) return lifetime_guard;
        } else if (p.kind != final_output) return lifetime_guard;
        for (uint64_t j = 0; j < call.count; ++j) {
            const auto value = call.inputs[j];
            if (!ready[value] || remaining[value] == 0 || overlap(values[call.output], values[value])) return lifetime_guard;
            if (call.c_contiguous_inputs && !contiguous(values[value])) return shape_guard;
        }
        for (size_t other_index = 0; other_index < call_plans.size(); ++other_index) {
            if (state[other_index] != 1) continue;
            const auto &other = call_plans[other_index];
            if (call_cpu_ids[index] == call_cpu_ids[other_index] ||
                overlap(values[call.output], values[other.output]) ||
                (p.kind == workspace && value_plans[other.output].kind == workspace &&
                 p.storage_index == value_plans[other.output].storage_index)) return lifetime_guard;
            for (uint64_t j = 0; j < other.count; ++j)
                if (overlap(values[call.output], values[other.inputs[j]])) return lifetime_guard;
            for (uint64_t j = 0; j < call.count; ++j)
                if (overlap(values[other.output], values[call.inputs[j]])) return lifetime_guard;
        }
        if (p.kind == workspace) {
            const auto old = owners[p.storage_index];
            if (old != no_value) ready[old] = 0;
            owners[p.storage_index] = call.output;
        }
        return SCAR_OK_V1;
    };
    auto worker = [&](int cpu) {
        for (;;) {
            std::unique_lock lock(mutex);
            changed.wait(lock, [&] {
                return stop || succeeded == call_plans.size() || next_for_cpu(cpu) != call_plans.size() ||
                       (running == 0 && !any_ready());
            });
            if (stop || succeeded == call_plans.size()) return;
            const size_t index = next_for_cpu(cpu);
            if (index == call_plans.size()) { fail(lifetime_guard, no_value); return; }
            const int32_t admission = admit_task(index);
            if (admission != SCAR_OK_V1) { fail(admission, index); return; }
            state[index] = 1; ++running;
            lock.unlock();
            const int32_t status = execute_task(index, values, operators, caller_environment);
            lock.lock();
            --running;
            if (status != SCAR_OK_V1) { state[index] = 3; fail(status, index); return; }
            state[index] = 2; ++succeeded;
            const auto &call = call_plans[index]; ready[call.output] = 1;
            for (uint64_t j = 0; j < call.count; ++j) {
                const auto value = call.inputs[j];
                if (remaining[value] == 0) { fail(lifetime_guard, index); return; }
                --remaining[value];
            }
            for (size_t value = 0; value < value_plans.size(); ++value) {
                const auto &p = value_plans[value];
                if (p.kind == workspace && remaining[value] == 0 && owners[p.storage_index] == value) {
                    ready[value] = 0; owners[p.storage_index] = no_value;
                }
            }
            // Release this CPU lane immediately. A true successor may run
            // while unrelated tasks on other lanes are still executing.
            changed.notify_all();
        }
    };
    std::vector<std::jthread> workers;
    bool creation_failed = false;
    try {
        workers.reserve(lane_cpu_ids.size());
        for (int cpu : lane_cpu_ids) workers.emplace_back(worker, cpu);
    } catch (const std::system_error &) { creation_failed = true; }
      catch (const std::bad_alloc &) { creation_failed = true; }
    if (creation_failed) {
        std::lock_guard lock(mutex); fail(worker_guard, no_value);
    }
    // No result or failure is published while a worker still has a pointer
    // into this entry's private pool. Thread-creation failures obey this too.
    for (auto &thread : workers) if (thread.joinable()) thread.join();
    if (failed_call != nullptr) *failed_call = failure_index;
    if (creation_failed) return worker_guard;
    if (failure != SCAR_OK_V1) return failure;
    if (succeeded != call_plans.size() || !ready[final_value]) return lifetime_guard;
    if (failed_call != nullptr) *failed_call = no_value;
    return SCAR_OK_V1;
}
} // namespace

extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_plan_sha256_v1() { return "@PIPELINE_SHA256@"; }
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_memory_sha256_v1() { return "@MEMORY_SHA256@"; }
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_schedule_sha256_v1() { return "@EXECUTION_SCHEDULE_SHA256@"; }
extern "C" SCAR_EXPORT_V1 int32_t scar_pipeline_run_v1(
    const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
    const scar_operator_table_v1 *const *operators, uint64_t operator_count, uint64_t *failed_call) {
    if (failed_call != nullptr) *failed_call = no_value;
    FloatingEnvironment caller;
    int32_t status = worker_guard;
    if (caller.ready()) {
        try { status = run_ready(inputs, count, output, operators, operator_count, failed_call, caller.entry()); }
        catch (const std::bad_alloc &) { status = allocation_guard; }
        catch (const std::system_error &) { status = worker_guard; }
    }
    return caller.restore() ? status : worker_guard;
}
