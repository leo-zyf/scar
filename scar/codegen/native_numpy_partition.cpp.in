#include "numpy_complex.hpp"

#include <array>
#include <cfenv>
#include <charconv>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <iostream>
#include <memory>
#include <span>
#include <stdexcept>
#include <string_view>

namespace {
enum class Op { copy_bytes, multiply, add };
struct Operand { unsigned root; std::int64_t offset, stride; };
struct Step {
    Op operation;
    std::int64_t count, repeat;
    std::array<Operand, 3> operand;
    std::array<std::int64_t, 3> advance;
};
struct Region {
    std::string_view name;
    std::array<std::size_t, 4> sizes, residues;
    std::span<const Step> body;
};

@PLANS@

struct Buffer {
    std::unique_ptr<void, decltype(&std::free)> owner{nullptr, std::free};
    char* data = nullptr;

    Buffer(std::size_t bytes, std::size_t residue) {
        owner.reset(std::aligned_alloc(64, (bytes + residue + 63) & ~std::size_t{63}));
        if (!owner) throw std::bad_alloc();
        data = static_cast<char*>(owner.get()) + residue;
    }
};

void read_root(char* data, std::size_t size, const char* path) {
    std::ifstream input(path, std::ios::binary);
    if (!input.read(data, size) || input.peek() != EOF)
        throw std::runtime_error("expected exact packed root bytes");
}

void publish(const char* path, const char* data, std::size_t size) {
    auto* output = std::fopen(path, "wbx");
    if (output == nullptr) throw std::runtime_error("expected a fresh output fixture");
    const auto written = std::fwrite(data, 1, size, output);
    const auto closed = std::fclose(output);
    if (written != size || closed != 0) throw std::runtime_error("cannot write complete output fixture");
}

void execute(const Region& region, const std::array<char*, 4>& roots) {
    for (const auto& step : region.body) {
        char* args[3];
        std::int64_t strides[3];
        for (unsigned index = 0; index != 3; ++index) {
            const auto& item = step.operand[index];
            args[index] = roots[item.root] + item.offset;
            strides[index] = item.stride;
        }
        constexpr auto errors = FE_DIVBYZERO | FE_OVERFLOW | FE_UNDERFLOW | FE_INVALID;
        const bool arithmetic = step.operation != Op::copy_bytes;
        if (arithmetic && std::feclearexcept(errors) != 0) throw std::runtime_error("cannot clear numeric status");
        for (std::int64_t segment = 0; segment != step.repeat; ++segment) {
            char* current[3];
            for (unsigned index = 0; index != 3; ++index)
                current[index] = args[index] + segment * step.advance[index];
            if (arithmetic) {
                auto loop = step.operation == Op::multiply ? scar_numpy_complex_multiply : scar_numpy_complex_add;
                loop(current, &step.count, strides, nullptr);
            } else {
                std::memcpy(current[1], current[0], step.count);
            }
        }
        if (arithmetic && std::fetestexcept(errors))
            throw std::runtime_error("stock operator reported floating-point status");
    }
}

const Region& get(std::string_view name) {
    for (const auto& region : regions) {
        if (region.name == name) return region;
    }
    throw std::runtime_error("unknown checked partition profile");
}
}

int main(int argc, char** argv) {
    try {
        if (argc != 6) throw std::runtime_error("expected PROFILE REPEATS TARGET MATRIX OUTPUT");
        if (!scar_numpy_complex_runtime_supported() || std::fegetround() != FE_TONEAREST)
            throw std::runtime_error("native ISA or floating-point mode differs");
        const auto& region = get(argv[1]);
        const std::string_view text(argv[2]);
        unsigned repeats{};
        const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), repeats);
        if (error != std::errc{} || end != text.data() + text.size() || !repeats || repeats > 1'000'000)
            throw std::runtime_error("invalid repeat count");
        std::array buffers{Buffer(region.sizes[0], region.residues[0]),
                           Buffer(region.sizes[1], region.residues[1]),
                           Buffer(region.sizes[2], region.residues[2]),
                           Buffer(region.sizes[3], region.residues[3])};
        std::array<char*, 4> roots{buffers[0].data, buffers[1].data, buffers[2].data, buffers[3].data};
        for (unsigned index = 0; index != 2; ++index)
            read_root(roots[index], region.sizes[index], argv[3 + index]);

        using Clock = std::chrono::steady_clock;
        static_assert(Clock::is_steady);
        const auto start = Clock::now();
        for (unsigned iteration = 0; iteration != repeats; ++iteration) execute(region, roots);
        const auto total = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
        publish(argv[5], roots[2], region.sizes[2]);
        std::cout << total << '\n';
        return 0;
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
