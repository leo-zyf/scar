#pragma once

#include <cassert>
#include <cstddef>
#include <cstdint>
#include <stdexcept>
#include <utility>
#include <vector>

namespace contourpy {

using index_t = std::ptrdiff_t;
using count_t = std::size_t;
using offset_t = std::uint32_t;

template<class T>
struct GridView {
    const T* pointer{};
    index_t rows{}, columns{};

    const T* data() const { return pointer; }
    index_t ndim() const { return pointer ? 2 : 0; }
    index_t shape(index_t axis) const { return axis == 0 ? rows : columns; }
};

using CoordinateArray = GridView<double>;
using MaskArray = GridView<bool>;
using PointLists = std::vector<std::vector<double>>;
using CodeLists = std::vector<std::vector<std::uint8_t>>;
using OuterCode = std::pair<PointLists, CodeLists>;

}
