#include "array_entry_argv.hpp"
#include "native_array_entry_io.hpp"
#include "numpy_observables.hpp"

#include <array>
#include <chrono>
#include <cmath>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <string>
#include <string_view>
#include <sys/resource.h>
#include <time.h>
#include <unistd.h>

namespace {
using namespace scar::array_entry_io;
using scar::public_argv::ParsedValue;

struct Result {
    double norm{}, split_difference{}, norm_error{}, tolerance{};
    double elapsed{}, worker_wall{}, worker_cpu{};
    long pid{}, peak_rss{};
    std::uint64_t seed{}, round_count{};
    bool tolerance_given{};
};

using Run = int (*)(double*, double*, const char*, std::uint64_t, std::uint64_t);
using Write = void (*)(std::ostream&, const Result&, bool);
using Match = bool (*)(const std::vector<ParsedValue>&);

struct Profile {
    Match matches;
    Run run;
    Write write;
    double default_tolerance;
};
}

@PROFILE_DECLARATIONS@

namespace {
@PROFILES@
}

int main(int argc, char** argv) {
    try {
        const auto values = scar::public_argv::parse(argc, argv);
        if (values.empty()) return 0;
        const auto* profile = static_cast<const Profile*>(nullptr);
        for (const auto& candidate : profiles) {
            if (candidate.matches(values)) {
                profile = &candidate;
                break;
            }
        }
        if (!profile) {
            std::cerr << "SCAR_PROFILE_UNAVAILABLE\n";
            return 2;
        }
        Result result{};
@RUNTIME_INGRESS@
        const auto& tolerance = values[@TOLERANCE_INDEX@].text;
        result.tolerance_given = !tolerance.empty();
        result.tolerance = result.tolerance_given ? std::strtod(tolerance.c_str(), nullptr)
                                                  : profile->default_tolerance;
        if (result.tolerance <= 0 || result.tolerance >= 1) {
            std::cerr << "invalid norm tolerance\n";
            return 2;
        }
        const auto start = Clock::now();
        const auto worker_start = Clock::now();
        const auto cpu = process_seconds();
        if (profile->run(&result.norm, &result.split_difference, std::getenv("SCAR_ARRAY_ENTRY_STATES"),
                         result.seed, result.round_count) != 0) {
            std::cerr << "SCAR_NATIVE_NUMERICAL_FRONTIER\n";
            return 3;
        }
        result.norm_error = scar_numpy_norm_error_v1(result.norm);
        if (!std::isfinite(result.norm) || result.norm_error > result.tolerance) {
            std::cerr << "state norm failed\n";
            return 1;
        }
        result.worker_cpu = process_seconds() - cpu;
        result.worker_wall = seconds(Clock::now() - worker_start);
        struct rusage usage{};
        if (getrusage(RUSAGE_SELF, &usage) != 0) throw std::runtime_error("resource counters unavailable");
        result.pid = static_cast<long>(getpid());
        result.peak_rss = usage.ru_maxrss;
        result.elapsed = seconds(Clock::now() - start);

        const auto& path = values[@OUTPUT_INDEX@].text;
        if (!path.empty()) {
            std::ofstream file(path, std::ios::binary | std::ios::trunc);
            file.exceptions(std::ios::failbit | std::ios::badbit);
            profile->write(file, result, true);
            file << '\n';
            file.close();
        }
        profile->write(std::cout, result, false);
        std::cout << '\n';
        return std::cout ? 0 : 1;
    } catch (const ScarPublicArgvError& error) {
        std::cerr << error.what() << '\n';
        return 2;
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
