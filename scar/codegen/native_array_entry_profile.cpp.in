#define main scar_private_probe_@INDEX@
#include "tape_@INDEX@.inc"
#undef main

#include "numpy_observables.hpp"

extern "C" int scar_array_entry_profile_@INDEX@(double* norm, double* difference, const char* state_prefix,
                                                  std::uint64_t) {
    if (!scar_numpy_complex_runtime_supported()) return 1;
    std::unique_ptr<void, decltype(&std::free)> arena(std::aligned_alloc(64, arena_bytes), &std::free);
    if (!arena) return 1;
    auto* bytes = static_cast<char*>(arena.get());
    const bool diagnostic = state_prefix != nullptr;
    std::vector<std::vector<char>> captured(diagnostic ? checkpoint_count : 0);
    for (const auto& round : rounds) {
        if (!execute_round(bytes, round[0], round[1], diagnostic, captured)) return 1;
    }
    const auto& final_step = steps[std::size(steps) - 1];
    if (final_step.operation != Op::checkpoint || final_step.count % item != 0 ||
            scar_numpy_split_observable_v1(final_step.count / item, bytes + final_step.offset[0],
                                           norm, difference) != 0) return 1;
    if (diagnostic) {
        for (std::size_t index = 0; index < captured.size(); ++index) {
            if (!write_checkpoint(std::string(state_prefix) + "." + std::to_string(index) + ".bin",
                                  captured[index])) return 1;
        }
    }
    return 0;
}
