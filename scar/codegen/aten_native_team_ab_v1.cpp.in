namespace {

using Clock = std::chrono::steady_clock;
using Inputs = std::array<at::Tensor, graph::input_count>;
using Outputs = std::array<at::Tensor, graph::output_count>;
using OperationTimes = std::array<std::int64_t, graph::operation_count>;
using LaneEligibility = std::array<bool, graph::operation_count>;
using OperationRows = std::vector<OperationTimes>;
using PageSamples = std::vector<graph::NumaPageSample>;
using Windows = std::vector<std::array<std::size_t, 2>>;

struct StorageGeometry {
    std::size_t bytes;
    at::ScalarType dtype;
    std::int64_t offset;
    std::vector<std::int64_t> sizes, strides;

    bool operator==(const StorageGeometry&) const = default;
};

using ResultStorage = std::array<std::optional<StorageGeometry>, graph::operation_count>;

void observe_storage(std::optional<StorageGeometry>& recorded, const at::Tensor& tensor) {
    if (!tensor.defined() || !tensor.device().is_cpu() || tensor.layout() != at::kStrided
            || !tensor.has_storage() || !tensor.storage().device().is_cpu()) {
        throw std::runtime_error("calibration requires observable strided CPU Tensor storage");
    }
    const StorageGeometry actual{tensor.storage().nbytes(), tensor.scalar_type(), tensor.storage_offset(),
                                 tensor.sizes().vec(), tensor.strides().vec()};
    if (recorded && *recorded != actual) throw std::runtime_error("calibration Tensor geometry changed");
    recorded = actual;
}

struct SampleInputs {
    std::array<std::vector<float>, graph::input_count> backing;
    std::array<std::vector<unsigned char>, graph::input_count> starting;
    Inputs tensors;

    explicit SampleInputs(char** paths) {
        for (std::size_t i = 0; i < tensors.size(); ++i) {
            const auto shape = graph::input_shapes[i];
            const auto bytes = checked_bytes(shape);
            backing[i] = read_tensor(paths[i], bytes);
            starting[i].resize(bytes);
            if (bytes) std::memcpy(starting[i].data(), backing[i].data(), bytes);
            tensors[i] = at::from_blob(backing[i].data(), at::IntArrayRef(shape.data(), shape.size()),
                                      at::TensorOptions().device(at::kCPU).dtype(at::kFloat));
        }
    }

    void check() const {
        for (std::size_t i = 0; i < tensors.size(); ++i) {
            const auto& expected = starting[i];
            if (tensors[i].nbytes() != expected.size() || (expected.size() &&
                    std::memcmp(tensors[i].const_data_ptr<float>(), expected.data(), expected.size()) != 0)) {
                throw std::runtime_error("native team input bytes changed");
            }
        }
    }
};

void check_outputs(const Inputs& inputs, const Outputs& baseline, const Outputs& candidate) {
    for (const auto* outputs : {&baseline, &candidate}) {
        for (const auto& tensor : *outputs) {
            if (!tensor.defined() || !tensor.device().is_cpu() || tensor.layout() != at::kStrided
                    || tensor.scalar_type() != at::kFloat || !tensor.is_contiguous()
                    || tensor.is_neg() || tensor.is_conj() || tensor.requires_grad()
                    || std::ranges::any_of(inputs, [&](const auto& input) { return tensor.is_alias_of(input); })) {
                throw std::runtime_error("native team output violates the independent float32 contract");
            }
        }
    }
    for (std::size_t i = 0; i < baseline.size(); ++i) {
        const auto& left = baseline[i];
        const auto& right = candidate[i];
        if (left.sizes() != right.sizes() || left.strides() != right.strides()
                || (left.nbytes() && std::memcmp(left.const_data_ptr<float>(), right.const_data_ptr<float>(),
                                                  left.nbytes()) != 0)) {
            throw std::runtime_error("native team paired outputs differ in geometry or bytes");
        }
        for (std::size_t j = 0; j < candidate.size(); ++j) {
            if (left.is_alias_of(candidate[j]) || left.is_alias_of(baseline[j]) != right.is_alias_of(candidate[j])) {
                throw std::runtime_error("native team paired outputs differ in storage ownership");
            }
        }
    }
}

std::int64_t elapsed_ns(Clock::time_point start) {
    const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - start).count();
    if (elapsed <= 0) throw std::runtime_error("native team duration is below clock resolution");
    return elapsed;
}

int integer(std::string_view text, int minimum, int maximum, const char* field) {
    const auto* end = text.data() + text.size();
    int value = 0;
    const auto parsed = std::from_chars(text.data(), end, value);
    if (parsed.ec != std::errc{} || parsed.ptr != end || value < minimum || value > maximum) {
        throw std::invalid_argument(std::string("invalid native team ") + field);
    }
    return value;
}

graph::WindowSelection parse_windows(std::string_view specification) {
    graph::WindowSelection windows{};
    std::size_t previous_end = 0;
    for (;;) {
        const auto delimiter = specification.find(',');
        const auto window = specification.substr(0, delimiter);
        const auto colon = window.find(':');
        if (colon == std::string_view::npos) throw std::invalid_argument("expected a start:width window");
        const auto start = static_cast<std::size_t>(integer(window.substr(0, colon), 0,
                                                            std::numeric_limits<int>::max(), "window start"));
        const int width = integer(window.substr(colon + 1), 2, 3, "window width");
        if (start >= windows.size() || start < previous_end || width > graph::legal_window_widths[start]) {
            throw std::invalid_argument("native team windows must be legal, ordered and disjoint");
        }
        windows[start] = static_cast<unsigned char>(width);
        if (delimiter == std::string_view::npos) return windows;
        previous_end = start + width;
        specification.remove_prefix(delimiter + 1);
    }
}

template <class Range>
void emit_numbers(const Range& values) {
    std::cout << '[';
    bool comma = false;
    for (const auto& value : values) {
        if (comma) std::cout << ',';
        std::cout << value;
        comma = true;
    }
    std::cout << ']';
}

void emit_storage(const ResultStorage& storage) {
    std::array<std::size_t, graph::operation_count> bytes{};
    for (std::size_t i = 0; i < bytes.size(); ++i) bytes[i] = storage[i].value().bytes;
    emit_numbers(bytes);
}

void emit_operations(const OperationRows& rows, const LaneEligibility* eligibility = nullptr) {
    std::cout << '[';
    for (std::size_t row = 0; row < rows.size(); ++row) {
        if (row) std::cout << ',';
        std::cout << '[';
        for (std::size_t op = 0; op < graph::operation_count; ++op) {
            if (op) std::cout << ',';
            if (eligibility && !(*eligibility)[op]) std::cout << "null";
            else std::cout << rows[row][op];
        }
        std::cout << ']';
    }
    std::cout << ']';
}

struct NumaTeamContext {
    Windows windows;
    PageSamples outputs;
    OperationRows services;
    std::vector<std::vector<std::int64_t>> group_samples;
    std::vector<std::size_t> consumer_indices;
    std::vector<std::vector<std::int64_t>> consumer_samples;
};

struct NumaTeam {
    PageSamples inputs, caller_outputs;
    std::vector<NumaTeamContext> contexts;
};

constexpr std::size_t max_numa_contexts = 8;
constexpr std::size_t max_numa_storages = 256;

bool enumerate_windows(std::size_t next, Windows& windows, std::vector<NumaTeamContext>& contexts) {
    for (std::size_t start = next; start < graph::operation_count; ++start) {
        for (std::size_t width = 2; width <= graph::legal_window_widths[start]; ++width) {
            const auto storage_count = graph::input_count + (2 + contexts.size()) * graph::operation_count;
            if (contexts.size() == max_numa_contexts || storage_count > max_numa_storages) return false;
            windows.push_back({start, width});
            contexts.push_back({windows, {}, {}, {}, {}, {}});
            if (!enumerate_windows(start + width, windows, contexts)) return false;
            windows.pop_back();
        }
    }
    return true;
}

std::optional<NumaTeam> calibrate_numa(const SampleInputs& data, const Outputs& reference, graph::CpuTeam& team,
                                      ResultStorage& storage, int warmup) {
    NumaTeam evidence;
    Windows windows;
    if (!enumerate_windows(0, windows, evidence.contexts)) return std::nullopt;

    const auto& inputs = data.tensors;
    for (const auto& input : inputs) evidence.inputs.push_back(graph::observe_numa_pages(input));

    const auto replay = [&](const Windows& selection, OperationTimes* timings, PageSamples* pages) {
        std::array<std::size_t, graph::operation_count> lanes{};
        for (const auto& [start, width] : selection) {
            for (std::size_t lane = 1; lane < width; ++lane) lanes[start + lane] = lane;
        }
        const auto output = graph::run_observed(inputs, [&](std::size_t op, auto&& call) {
            at::Tensor value;
            const auto run = [&] {
                if (timings) {
                    const auto started = Clock::now();
                    value = call();
                    timings->at(op) = elapsed_ns(started);
                } else {
                    value = call();
                }
            };
            if (lanes[op] == 0) run();
            else team.run_on_worker(lanes[op], run);
            observe_storage(storage[op], value);
            if (pages) pages->push_back(graph::observe_numa_pages(value));
            return value;
        });
        data.check();
        check_outputs(inputs, reference, output);
    };

    // Keep residency queries and integrity checks outside the in-lane operation clocks.
    evidence.caller_outputs.reserve(graph::operation_count);
    replay({}, nullptr, &evidence.caller_outputs);
    for (auto& context : evidence.contexts) {
        replay(context.windows, nullptr, nullptr);
        context.services.resize(warmup);
        for (auto& row : context.services) replay(context.windows, &row, nullptr);
        context.outputs.reserve(graph::operation_count);
        replay(context.windows, nullptr, &context.outputs);
    }
    return evidence;
}

std::vector<std::size_t> post_join_consumers(const Windows& windows) {
    LaneEligibility grouped{};
    for (const auto& [start, width] : windows) {
        for (std::size_t lane = 0; lane < width; ++lane) grouped[start + lane] = true;
    }
    auto descendants = grouped;
    for (const auto& [producer, consumer] : graph::team_data_edges) {
        if (descendants[producer]) descendants[consumer] = true;
    }
    std::vector<std::size_t> consumers;
    for (std::size_t op = 0; op < graph::operation_count; ++op) {
        if (descendants[op] && !grouped[op]) consumers.push_back(op);
    }
    return consumers;
}

void calibrate_concurrent(const SampleInputs& data, const Outputs& reference, graph::CpuTeam& team,
                          ResultStorage& storage, std::vector<NumaTeamContext>& contexts, int warmup) {
    const auto& inputs = data.tensors;
    for (auto& context : contexts) {
        graph::WindowSelection selection{};
        for (const auto& [start, width] : context.windows) selection[start] = static_cast<std::uint8_t>(width);
        context.consumer_indices = post_join_consumers(context.windows);
        LaneEligibility timed_consumers{};
        for (const auto op : context.consumer_indices) timed_consumers[op] = true;
        {
            // Qualify intermediate results on the concurrent path before entering the clocks.
            const auto observed = graph::run_parallel_observed(inputs, team, selection, [&](std::size_t op, auto&& call) {
                auto value = call();
                observe_storage(storage[op], value);
                return value;
            });
            data.check();
            check_outputs(inputs, reference, observed);
        }
        context.group_samples.resize(warmup);
        context.consumer_samples.resize(warmup);
        for (std::size_t sample = 0; sample < context.group_samples.size(); ++sample) {
            auto& row = context.group_samples[sample];
            auto& consumers = context.consumer_samples[sample];
            row.reserve(context.windows.size());
            consumers.reserve(context.consumer_indices.size());
            const auto observed = graph::run_parallel_groups_observed(inputs, team, selection,
                [](std::size_t, auto&& call) { return call(); },
                [&](std::size_t start, std::size_t width, auto&& run) {
                    if (row.size() >= context.windows.size()
                            || context.windows[row.size()] != std::array<std::size_t, 2>{start, width}) {
                        throw std::runtime_error("concurrent team groups differ from the calibration context");
                    }
                    const auto began = Clock::now();
                    run();
                    row.push_back(elapsed_ns(began));
                },
                [&](std::size_t op, auto&& call) {
                    if (!timed_consumers[op]) return call();
                    if (consumers.size() >= context.consumer_indices.size()
                            || context.consumer_indices[consumers.size()] != op) {
                        throw std::runtime_error("post-join consumers differ from static dependencies");
                    }
                    const auto began = Clock::now();
                    auto value = call();
                    consumers.push_back(elapsed_ns(began));
                    return value;
                });
            if (row.size() != context.windows.size()) {
                throw std::runtime_error("concurrent team clock missed a window");
            }
            if (consumers.size() != context.consumer_indices.size()) {
                throw std::runtime_error("concurrent team clock missed a post-join consumer");
            }
            data.check();
            check_outputs(inputs, reference, observed);
        }
    }
}

void emit_pages(const PageSamples& samples) {
    std::cout << '[';
    for (std::size_t i = 0; i < samples.size(); ++i) {
        if (i) std::cout << ',';
        graph::write_numa_pages(std::cout, samples[i]);
    }
    std::cout << ']';
}

void emit_windows(const Windows& windows) {
    std::cout << '[';
    for (std::size_t i = 0; i < windows.size(); ++i) {
        if (i) std::cout << ',';
        emit_numbers(windows[i]);
    }
    std::cout << ']';
}

void emit_timing_rows(const std::vector<std::vector<std::int64_t>>& rows) {
    std::cout << '[';
    for (std::size_t i = 0; i < rows.size(); ++i) {
        if (i) std::cout << ',';
        emit_numbers(rows[i]);
    }
    std::cout << ']';
}

void emit_numa(const std::optional<NumaTeam>& evidence) {
    std::cout << "{\"schema_version\":1,\"status\":";
    if (!evidence) {
        std::cout << "\"TEAM_CONTEXT_BUDGET_EXCEEDED\"}";
        return;
    }
    std::cout << "\"MEASURED\",\"input_pages\":";
    emit_pages(evidence->inputs);
    std::cout << ",\"caller_output_pages\":";
    emit_pages(evidence->caller_outputs);
    std::cout << ",\"contexts\":[";
    for (std::size_t i = 0; i < evidence->contexts.size(); ++i) {
        if (i) std::cout << ',';
        const auto& context = evidence->contexts[i];
        std::cout << "{\"windows\":";
        emit_windows(context.windows);
        std::cout << ",\"output_pages\":";
        emit_pages(context.outputs);
        std::cout << ",\"operation_samples_ns\":";
        emit_operations(context.services);
        std::cout << '}';
    }
    std::cout << "]}";
}

void emit_concurrent(const std::optional<NumaTeam>& evidence) {
    std::cout << "{\"schema_version\":1,\"status\":";
    if (!evidence) {
        std::cout << "\"TEAM_CONTEXT_BUDGET_EXCEEDED\"}";
        return;
    }
    std::cout << "\"MEASURED\",\"contexts\":[";
    for (std::size_t i = 0; i < evidence->contexts.size(); ++i) {
        if (i) std::cout << ',';
        const auto& context = evidence->contexts[i];
        std::cout << "{\"windows\":";
        emit_windows(context.windows);
        std::cout << ",\"group_samples_ns\":";
        emit_timing_rows(context.group_samples);
        std::cout << '}';
    }
    std::cout << "]}";
}

void emit_post_join(const std::optional<NumaTeam>& evidence) {
    std::cout << "{\"schema_version\":1,\"status\":";
    if (!evidence) {
        std::cout << "\"TEAM_CONTEXT_BUDGET_EXCEEDED\"}";
        return;
    }
    std::cout << "\"MEASURED\",\"contexts\":[";
    for (std::size_t i = 0; i < evidence->contexts.size(); ++i) {
        if (i) std::cout << ',';
        const auto& context = evidence->contexts[i];
        std::cout << "{\"windows\":";
        emit_windows(context.windows);
        std::cout << ",\"operation_indices\":";
        emit_numbers(context.consumer_indices);
        std::cout << ",\"consumer_samples_ns\":";
        emit_timing_rows(context.consumer_samples);
        std::cout << '}';
    }
    std::cout << "]}";
}

void calibrate(char** args, const std::array<int, 3>& cpus, graph::CpuTeam& team) {
    const int warmup = integer(args[0], 3, 100, "warmup count");
    const SampleInputs data(args + 1);
    const auto& inputs = data.tensors;
    const auto reference = graph::run(inputs);
    data.check();

    std::array<LaneEligibility, 2> eligible{};
    for (std::size_t start = 0; start < graph::operation_count; ++start) {
        const auto width = graph::legal_window_widths[start];
        for (std::size_t lane = 1; lane < width; ++lane) eligible[lane - 1][start + lane] = true;
    }
    ResultStorage storage;
    auto observe = [&](std::size_t lane, OperationTimes& timings) {
        const auto output = graph::run_observed(inputs, [&](std::size_t op, auto&& call) {
            at::Tensor value;
            const auto timed = [&] {
                const auto started = Clock::now();
                value = call();
                timings[op] = elapsed_ns(started);
            };
            if (lane == 0) timed();
            else if (eligible[lane - 1][op]) team.run_on_worker(lane, timed);
            else value = call();
            observe_storage(storage[op], value);
            return value;
        });
        data.check();
        check_outputs(inputs, reference, output);
    };
    std::array<OperationRows, 3> services;
    for (std::size_t lane = 0; lane < services.size(); ++lane) {
        OperationTimes prime{};
        observe(lane, prime);
        services[lane].resize(warmup);
        for (auto& row : services[lane]) observe(lane, row);
    }
    std::vector<std::int64_t> handoff_two, handoff_three;
    const auto idle = [] {};
    for (int i = 0; i < warmup; ++i) {
        auto started = Clock::now();
        team.run(idle, idle);
        handoff_two.push_back(elapsed_ns(started));
        started = Clock::now();
        team.run(idle, idle, idle);
        handoff_three.push_back(elapsed_ns(started));
    }
    std::array<std::size_t, graph::input_count> input_bytes{};
    for (std::size_t i = 0; i < inputs.size(); ++i) input_bytes[i] = inputs[i].storage().nbytes();
    auto numa = calibrate_numa(data, reference, team, storage, warmup);
    if (numa) calibrate_concurrent(data, reference, team, storage, numa->contexts, warmup);
    std::cout << "{\"warmup_pairs\":" << warmup << ",\"cpu_ids\":";
    emit_numbers(cpus);
    std::cout << ",\"calibration\":{\"operation_samples_ns\":";
    emit_operations(services[0]);
    std::cout << ",\"worker_operation_samples_ns\":[";
    emit_operations(services[1], &eligible[0]);
    std::cout << ',';
    emit_operations(services[2], &eligible[1]);
    std::cout << "],\"empty_dispatch_samples_ns\":{\"2\":";
    emit_numbers(handoff_two);
    std::cout << ",\"3\":";
    emit_numbers(handoff_three);
    std::cout << "},\"input_storage_bytes\":";
    emit_numbers(input_bytes);
    std::cout << ",\"result_storage_bytes\":";
    emit_storage(storage);
    std::cout << ",\"numa_team\":";
    emit_numa(numa);
    std::cout << ",\"concurrent_team\":";
    emit_concurrent(numa);
    std::cout << ",\"post_join_team\":";
    emit_post_join(numa);
    std::cout << "}}\n";
}

struct PairedSample {
    bool serial_first;
    std::int64_t serial_ns, parallel_ns;
};

void benchmark(char** args, const std::array<int, 3>& cpus, graph::CpuTeam& team,
               const graph::WindowSelection& windows) {
    const int warmup = integer(args[0], 3, 100, "warmup count");
    const int measured = integer(args[1], 3, 501, "measurement count");
    if (measured % 2 == 0) throw std::invalid_argument("native team requires an odd measured pair count");
    const SampleInputs data(args + 2);
    const auto& inputs = data.tensors;
    ResultStorage storage;
    {
        const auto baseline = graph::run_observed(inputs, [&](std::size_t op, auto&& call) {
            auto value = call();
            observe_storage(storage[op], value);
            return value;
        });
        data.check();
        const auto parallel = graph::run_parallel_observed(inputs, team, windows, [&](std::size_t op, auto&& call) {
            auto value = call();
            observe_storage(storage[op], value);
            return value;
        });
        data.check();
        check_outputs(inputs, baseline, parallel);
    }

    auto timed = [&](bool serial) {
        const auto started = Clock::now();
        auto output = serial ? graph::run(inputs) : graph::run_parallel(inputs, team, windows);
        return std::pair{elapsed_ns(started), std::move(output)};
    };
    std::vector<PairedSample> samples;
    samples.reserve(measured);
    for (int pair = 0; pair < warmup + measured; ++pair) {
        const bool serial_first = (pair % 2 == 0);
        const auto first = timed(serial_first);
        const auto second = timed(!serial_first);
        data.check();
        const auto& serial = serial_first ? first : second;
        const auto& parallel = serial_first ? second : first;
        check_outputs(inputs, serial.second, parallel.second);
        if (pair >= warmup) samples.push_back({serial_first, serial.first, parallel.first});
    }
    std::cout << "{\"warmup_pairs\":" << warmup << ",\"measured_pairs\":" << measured << ",\"cpu_ids\":";
    emit_numbers(cpus);
    std::cout << ",\"windows\":[";
    bool comma = false;
    for (std::size_t start = 0; start < windows.size(); ++start) {
        const unsigned int width = windows[start];
        if (!width) continue;
        if (comma) std::cout << ',';
        std::cout << '[' << start << ',' << width << ']';
        comma = true;
    }
    std::cout << "],\"all_pairs_validated\":true,\"samples\":[";
    for (std::size_t i = 0; i < samples.size(); ++i) {
        if (i) std::cout << ',';
        const auto& sample = samples[i];
        std::cout << "{\"order\":\"" << (sample.serial_first ? "AB" : "BA") << "\",\"serial_ns\":"
                  << sample.serial_ns << ",\"parallel_ns\":" << sample.parallel_ns << '}';
    }
    std::cout << "],\"result_storage_bytes\":";
    emit_storage(storage);
    std::cout << "}\n";
}

#ifdef SCAR_ATEN_READY_DAG
graph::ReadyLanes parse_ready_lanes(std::string_view text) {
    graph::ReadyLanes lanes{};
    if (text.size() != lanes.size()) throw std::invalid_argument("ready DAG requires one lane per operation");
    for (std::size_t i = 0; i < lanes.size(); ++i) {
        if (text[i] < '0' || text[i] > '2') throw std::invalid_argument("invalid ready DAG lane");
        lanes[i] = static_cast<std::uint8_t>(text[i] - '0');
    }
    return lanes;
}

void benchmark_ready(char** args, const std::array<int, 3>& cpus, graph::CpuTeam& team,
                     const graph::ReadyLanes& lanes) {
    const std::string_view baseline_spec(args[0]);
    const auto windows = baseline_spec == "serial" ? std::nullopt : std::optional(parse_windows(baseline_spec));
    const int warmup = integer(args[1], 3, 100, "warmup count");
    const int measured = integer(args[2], 4, 500, "measurement count");
    if (measured % 2 != 0) throw std::invalid_argument("ready DAG requires balanced AB/BA measurement pairs");
    const SampleInputs data(args + 3);
    const auto& inputs = data.tensors;
    ResultStorage storage;
    const auto input_bytes = std::accumulate(inputs.begin(), inputs.end(), std::size_t{0},
        [](std::size_t sum, const at::Tensor& tensor) { return sum + tensor.storage().nbytes(); });
    std::atomic_size_t live{input_bytes}, peak{input_bytes};
    std::array<std::atomic_bool, graph::operation_count> released{};
    {
        auto observe = [&](std::size_t op, auto&& call) {
            auto value = call();
            observe_storage(storage[op], value);
            return value;
        };
        const auto reference = graph::run_observed(inputs, observe);
        const auto ready = graph::run_ready_inspected(inputs, team, lanes, [&](std::size_t op, auto&& call) {
            const auto bytes = storage[op]->bytes;
            const auto current = live.fetch_add(bytes, std::memory_order_relaxed) + bytes;
            auto maximum = peak.load(std::memory_order_relaxed);
            while (current > maximum && !peak.compare_exchange_weak(maximum, current, std::memory_order_relaxed)) {}
            return observe(op, call);
        }, [&](std::size_t op) {
            if (released[op].exchange(true, std::memory_order_relaxed)) {
                throw std::runtime_error("ready DAG released a result twice");
            }
            live.fetch_sub(storage[op]->bytes, std::memory_order_relaxed);
        });
        data.check();
        check_outputs(inputs, reference, ready);
    }
    auto timed = [&](bool baseline) {
        const auto started = Clock::now();
        auto output = baseline ? (windows ? graph::run_parallel(inputs, team, *windows) : graph::run(inputs))
                               : graph::run_ready(inputs, team, lanes);
        return std::pair{elapsed_ns(started), std::move(output)};
    };
    std::vector<PairedSample> samples;
    samples.reserve(measured);
    for (int pair = 0; pair < warmup + measured; ++pair) {
        const bool baseline_first = pair % 2 == 0;
        const auto first = timed(baseline_first);
        const auto second = timed(!baseline_first);
        data.check();
        check_outputs(inputs, first.second, second.second);
        if (pair >= warmup) {
            const auto& baseline = baseline_first ? first : second;
            const auto& ready = baseline_first ? second : first;
            samples.push_back({baseline_first, baseline.first, ready.first});
        }
    }
    std::cout << "{\"warmup_pairs\":" << warmup << ",\"measured_pairs\":" << measured << ",\"cpu_ids\":";
    emit_numbers(cpus);
    std::cout << ",\"lanes\":[";
    for (std::size_t i = 0; i < lanes.size(); ++i) {
        if (i) std::cout << ',';
        std::cout << static_cast<unsigned int>(lanes[i]);
    }
    std::cout << "],\"baseline\":\"" << baseline_spec << "\",\"all_pairs_validated\":true,\"samples\":[";
    for (std::size_t i = 0; i < samples.size(); ++i) {
        if (i) std::cout << ',';
        const auto& sample = samples[i];
        std::cout << "{\"order\":\"" << (sample.serial_first ? "AB" : "BA") << "\",\"baseline_ns\":"
                  << sample.serial_ns << ",\"ready_ns\":" << sample.parallel_ns << '}';
    }
    std::cout << "],\"result_storage_bytes\":";
    emit_storage(storage);
    std::vector<std::size_t> released_indices;
    for (std::size_t op = 0; op < released.size(); ++op) {
        if (released[op].load(std::memory_order_relaxed)) released_indices.push_back(op);
    }
    std::cout << ",\"ready_lifetime\":{\"graph_held_peak_bytes\":" << peak.load(std::memory_order_relaxed)
              << ",\"retained_bytes_at_return\":" << live.load(std::memory_order_relaxed) << ",\"released_indices\":";
    emit_numbers(released_indices);
    std::cout << '}';
    std::cout << "}\n";
}
#endif

}  // namespace

int main(int argc, char** argv) {
    const std::string_view mode = argc > 1 ? argv[1] : "";
    const bool calibrating = mode == "--calibrate-team";
    const bool measuring = mode == "--benchmark-team";
    const bool serial = mode == "--run-serial";
    bool measuring_ready = false, running_ready = false;
#ifdef SCAR_ATEN_READY_DAG
    measuring_ready = mode == "--benchmark-ready";
    running_ready = mode == "--run-ready";
#endif
    if (!calibrating && !measuring && !serial && !measuring_ready && !running_ready && mode != "--run-team") {
        return scar_native_file_main(argc, argv);
    }
    const auto expected = graph::input_count + (measuring_ready ? 9 : measuring ? 8 : calibrating ? 6 :
                                               (serial ? 3 : 6) + graph::output_count);
    if (static_cast<std::size_t>(argc) != expected) {
        std::fputs("usage: aten-graph --calibrate-team <caller> <worker1> <worker2> <warmup> <input.f32>...\n"
                   "       aten-graph --benchmark-team <caller> <worker1> <worker2> <windows> <warmup> <odd-count> <input.f32>...\n"
                   "       aten-graph --run-team <caller> <worker1> <worker2> <windows> <input.f32>... <new-output.f32>...\n"
                   "       aten-graph --run-serial <caller> <input.f32>... <new-output.f32>...\n", stderr);
        return 2;
    }
    try {
        const int caller = integer(argv[2], 0, CPU_SETSIZE - 1, "caller CPU");
        at::set_num_threads(1);
        at::set_num_interop_threads(1);
        at::NoGradGuard no_grad;
        if (serial) {
            cpu_set_t mask;
            if (sched_getaffinity(0, sizeof(mask), &mask) != 0 || CPU_COUNT(&mask) != 1 || !CPU_ISSET(caller, &mask)
                    || sched_getcpu() != caller || std::fegetround() != FE_TONEAREST) {
                throw std::runtime_error("native serial run requires its exact CPU and default rounding");
            }
            return invoke(argv + 3, graph::run);
        }
        const std::array cpus{caller, integer(argv[3], 0, CPU_SETSIZE - 1, "first worker CPU"),
                              integer(argv[4], 0, CPU_SETSIZE - 1, "second worker CPU")};
        graph::CpuTeam team(cpus);
#ifdef SCAR_ATEN_READY_DAG
        if (measuring_ready || running_ready) {
            const auto lanes = parse_ready_lanes(argv[5]);
            if (running_ready) return invoke(argv + 6, [&](const auto& inputs) { return graph::run_ready(inputs, team, lanes); });
            benchmark_ready(argv + 6, cpus, team, lanes);
            return 0;
        }
#endif
        if (calibrating) {
            calibrate(argv + 5, cpus, team);
        } else {
            const auto windows = parse_windows(argv[5]);
            if (measuring) benchmark(argv + 6, cpus, team, windows);
            else return invoke(argv + 6, [&](const auto& inputs) { return graph::run_parallel(inputs, team, windows); });
        }
    } catch (const std::exception& error) {
        std::fprintf(stderr, "SCAR ATen CPU team failed: %s\n", error.what());
        return 1;
    }
}
