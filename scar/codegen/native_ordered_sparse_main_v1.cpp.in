int run_requests(std::span<const int> indices, std::span<const int> offsets) {
    std::uint64_t published = 0;
    try {
        if (sparse::count == 0) {
            require_eof();
        }
        const auto executable = std::filesystem::canonical("/proc/self/exe");
        const auto numeric = executable.parent_path() / "numeric";
        const auto outcome = sparse::run(numeric, indices, offsets,
            [](std::uint64_t sequence, std::span<std::byte> request) {
                std::array<std::byte, 8> number;
                read_exact(number, "missing or incomplete ordered sparse sequence");
                if (get_unsigned(number) != sequence) {
                    throw InputFailure{"ordered sparse request sequence differs"};
                }
                read_exact(request, "incomplete ordered sparse numeric request");
                if (sequence + 1 == sparse::count) {
                    require_eof();
                }
            },
            [&](const ordered::Retirement& row) {
                if (row.sequence != published || row.kind != ordered::Kind::success
                        || row.worker_status != 0 || row.result.size() != sparse::result_bytes) {
                    throw std::runtime_error("unexpected ordered sparse publication");
                }
                publish_record(published, Record::success, 0);
                write_exact(row.result);
                ++published;
            });
        if (outcome.published != published || outcome.complete != (published == sparse::count)) {
            throw std::runtime_error("ordered sparse publication accounting differs");
        }
        if (outcome.complete) {
            publish_record(published, Record::end, 0);
            return 0;
        }
        if (outcome.terminal_kind == ordered::Kind::worker_failure && outcome.worker_status != 0) {
            publish_record(published, Record::worker_failure, outcome.worker_status);
        } else if (outcome.terminal_kind == ordered::Kind::transport_failure) {
            publish_record(published, Record::transport_failure, 0);
        } else {
            throw std::runtime_error("unexpected ordered sparse terminal status");
        }
    } catch (const InputFailure& error) {
        publish_record(published, Record::protocol_failure, 0);
        std::fprintf(stderr, "%s\n", error.message);
    } catch (const std::exception& error) {
        publish_record(published, Record::host_failure, 0);
        std::fprintf(stderr, "%s\n", error.what());
    }
    return 1;
}

}  // namespace

int main(int argc, char**) {
    if (argc != 1) {
        std::fputs("ordered sparse executable accepts binary stdin and no arguments\n", stderr);
        return 1;
    }
    if (signal(SIGPIPE, SIG_IGN) == SIG_ERR) {
        std::fputs("cannot configure ordered sparse output transport\n", stderr);
        return 1;
    }
    try {
        auto observed = input_header;
        read_exact(observed, "incomplete ordered sparse input header");
        if (observed != input_header) {
            throw InputFailure{"ordered sparse input header differs from the compiled recipe"};
        }
        std::vector<int> indices(sparse::nnz), offsets(std::size_t{sparse::size} + 1);
        read_exact(std::as_writable_bytes(std::span(indices)), "incomplete ordered sparse CSR indices");
        read_exact(std::as_writable_bytes(std::span(offsets)), "incomplete ordered sparse CSR offsets");
        check_structure(indices, offsets);
        write_exact(output_header);
        return run_requests(indices, offsets);
    } catch (const InputFailure& error) {
        std::fprintf(stderr, "%s\n", error.message);
    } catch (const OutputFailure&) {
        std::fputs("cannot write ordered sparse output\n", stderr);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
    }
    return 1;
}
