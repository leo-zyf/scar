#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
@PLAN_AND_DESCRIPTOR_HELPERS@
#include <cfenv>
#include <cerrno>
#include <chrono>
#include <condition_variable>
#include <mutex>
#include <sched.h>
#include <system_error>
#include <thread>
#include <unistd.h>

#pragma STDC FENV_ACCESS ON

namespace {
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
@AFFINITY_IMPLEMENTATION@
@FLOATING_ENVIRONMENT@
constexpr int32_t worker_guard = 16;
constexpr size_t no_event = @EVENT_COUNT@;
constexpr size_t final_slot = slot_capacities.size();
enum class EventKind { allocate, compute, fence, release, export_value };
struct EventPlan { EventKind kind; size_t subject; size_t predecessors; };
constexpr std::array<EventPlan, @EVENT_COUNT@> events = {{
@EVENT_PLANS@
}};
constexpr std::array<size_t, @EVENT_COUNT@ + 1> successor_offsets = {{@SUCCESSOR_OFFSETS@}};
constexpr std::array<size_t, @SUCCESSOR_COUNT@> successors = {{@SUCCESSOR_IDS@}};
constexpr std::array<size_t, @CONTROL_COUNT@> controls = {{@CONTROL_IDS@}};
constexpr std::array<int, @LANE_COUNT@> cpu_ids = {{@LANE_CPUS@}};
constexpr std::array<size_t, @LANE_COUNT@ + 1> lane_offsets = {{@LANE_OFFSETS@}};
constexpr std::array<size_t, call_plans.size()> lane_events = {{@LANE_EVENT_IDS@}};

enum class Observation : uint64_t {
    workspace_allocated, final_storage_adopted, slot_acquired, compute_start, compute_success,
    compute_failure, value_ready, slot_retired, success_fence, workspace_released, final_published,
};
struct NativeEventV1 {
    uint64_t kind, event, timestamp_ns, value, slot;
    int64_t cpu, status;
};
static_assert(sizeof(NativeEventV1) == 7 * sizeof(uint64_t));
struct EventSink {
    NativeEventV1 *rows;
    size_t used = 0;

    void record(Observation kind, size_t event, uint64_t value = no_value,
                uint64_t slot = no_value, int cpu = -1, int32_t status = SCAR_OK_V1) noexcept {
        if (rows == nullptr) return;
        const auto now = std::chrono::steady_clock::now().time_since_epoch();
        const auto nanos = std::chrono::duration_cast<std::chrono::nanoseconds>(now).count();
        rows[used++] = {uint64_t(kind), uint64_t(event), uint64_t(nanos), value, slot, cpu, status};
    }
};

struct WorkspaceSlot {
    std::unique_ptr<double[]> storage;
    uint64_t owner = no_value;
    bool live = false;
};

int32_t run_resource_events(const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
                            const scar_operator_table_v1 *const *operators, uint64_t operator_count,
                            uint64_t *failed_call, const fenv_t &caller_environment,
                            EventSink &sink, size_t &export_event) {
    if (count != input_count || output == nullptr || (count && inputs == nullptr) ||
        operators == nullptr || operator_count != call_plans.size()) return argument_guard;
    __int128 payload = value_plans[final_value].bytes;
    for (const auto capacity : slot_capacities) {
        if (capacity % sizeof(double) || capacity > std::numeric_limits<ptrdiff_t>::max()) return budget_guard;
        payload += capacity;
    }
    if (payload > payload_budget || payload > std::numeric_limits<size_t>::max()) return budget_guard;
    for (const auto &p : value_plans) {
        if (__int128(p.rows) * p.cols * sizeof(double) != p.bytes) return shape_guard;
        if (p.kind == external_input &&
            (!valid_array(inputs[p.storage_index], p) || !contiguous(inputs[p.storage_index]))) return shape_guard;
        if (p.kind == workspace &&
            (p.storage_index >= slot_capacities.size() || p.bytes > slot_capacities[p.storage_index])) return budget_guard;
    }
    if (!valid_array(*output, value_plans[final_value]) || !contiguous(*output)) return shape_guard;
    for (uint64_t i = 0; i < count; ++i) if (overlap(*output, inputs[i])) return argument_guard;
    for (size_t i = 0; i < call_plans.size(); ++i) {
        const auto *table = operators[i];
        const auto &call = call_plans[i];
        if (table == nullptr || table->abi_version != 1 || table->struct_size < sizeof(scar_operator_table_v1) ||
            table->run == nullptr || table->input_count != call.count || table->plan_sha256 == nullptr ||
            std::strcmp(table->plan_sha256, call.plan_sha256) != 0) return operator_guard;
    }

    std::vector<WorkspaceSlot> slots(slot_capacities.size());
    std::vector<scar_array_v1> values(value_plans.size());
    std::vector<uint8_t> ready(value_plans.size(), 0), completed(events.size(), 0);
    std::vector<uint64_t> remaining(value_plans.size(), 0);
    for (size_t index = 0; index < value_plans.size(); ++index) {
        const auto &p = value_plans[index];
        if (p.kind == external_input) {
            values[index] = inputs[p.storage_index];
            ready[index] = 1;
        }
    }
    for (const auto &call : call_plans)
        for (size_t j = 0; j < call.count; ++j) ++remaining[call.inputs[j]];

    std::array<size_t, events.size()> waiting{};
    for (size_t event = 0; event < events.size(); ++event) waiting[event] = events[event].predecessors;
    auto lane_head = lane_offsets;
    std::mutex mutex;
    std::condition_variable changed;
    size_t active = 0, calls_succeeded = 0, events_succeeded = 0;
    bool stop = false, final_adopted = false, fenced = false;
    int32_t status = SCAR_OK_V1;
    uint64_t failure_index = no_value;

    auto fail = [&](int32_t reason, uint64_t index) {
        if (status == SCAR_OK_V1 || index < failure_index) {
            status = reason;
            failure_index = index;
        }
        stop = true;
        changed.notify_all();
    };
    auto complete = [&](size_t event) {
        completed[event] = 1;
        ++events_succeeded;
        // Only a successful event decreases its successors' prerequisites.
        for (size_t i = successor_offsets[event]; i < successor_offsets[event + 1]; ++i) --waiting[successors[i]];
        changed.notify_all();
    };
    auto lane_ready = [&](size_t lane) {
        return lane_head[lane] < lane_offsets[lane + 1] && waiting[lane_events[lane_head[lane]]] == 0;
    };
    auto any_lane_ready = [&]() {
        for (size_t lane = 0; lane < cpu_ids.size(); ++lane) if (lane_ready(lane)) return true;
        return false;
    };
    auto next_control = [&]() {
        for (size_t event : controls) if (!completed[event] && waiting[event] == 0) return event;
        return no_event;
    };
    auto retire = [&](size_t event, uint64_t value, int cpu) {
        const auto &p = value_plans[value];
        if (p.kind == workspace && remaining[value] == 0) {
            auto &slot = slots[p.storage_index];
            ready[value] = 0;
            slot.owner = no_value;
            sink.record(Observation::slot_retired, event, value, p.storage_index, cpu);
        }
    };
    auto admit_compute = [&](size_t event, size_t index) -> int32_t {
        const auto &call = call_plans[index];
        const auto &p = value_plans[call.output];
        if (p.producer != int64_t(index) || p.bytes > call.output_budget) return budget_guard;
        if (p.kind == workspace) {
            auto &slot = slots[p.storage_index];
            if (!slot.live || slot.owner != no_value) return lifetime_guard;
            values[call.output] = slot_array(slot.storage.get(), slot_capacities[p.storage_index], p);
        } else if (p.kind != final_output || !final_adopted || call.output != final_value) {
            return lifetime_guard;
        }
        if (!valid_array(values[call.output], p)) return shape_guard;
        for (size_t j = 0; j < call.count; ++j) {
            const auto value = call.inputs[j];
            const auto &input = value_plans[value];
            if (!ready[value] || remaining[value] == 0 || overlap(values[call.output], values[value])) return lifetime_guard;
            if (input.kind == workspace && (!slots[input.storage_index].live || slots[input.storage_index].owner != value))
                return lifetime_guard;
            if (call.c_contiguous_inputs && !contiguous(values[value])) return shape_guard;
        }
        if (p.kind == workspace) {
            slots[p.storage_index].owner = call.output;
            sink.record(Observation::slot_acquired, event, call.output, p.storage_index);
        }
        return SCAR_OK_V1;
    };

    auto worker = [&](size_t lane) {
        const int cpu = cpu_ids[lane];
        for (;;) {
            std::unique_lock lock(mutex);
            changed.wait(lock, [&] { return stop || lane_ready(lane); });
            if (stop) return;
            const size_t event = lane_events[lane_head[lane]];
            const size_t index = events[event].subject;
            const auto &call = call_plans[index];
            const int32_t admission = admit_compute(event, index);
            if (admission != SCAR_OK_V1) {
                sink.record(Observation::compute_failure, event, call.output, no_value, -1, admission);
                fail(admission, index);
                return;
            }
            std::array<scar_array_v1, max_arguments> arguments{};
            for (size_t j = 0; j < call.count; ++j) arguments[j] = values[call.inputs[j]];
            scar_array_v1 result = values[call.output];
            ++active;
            lock.unlock();

            ThreadAffinity affinity;
            FloatingEnvironment floating(&caller_environment);
            const bool bound = floating.ready() && affinity.bind(cpu);
            int32_t leaf_status = !floating.ready() ? worker_guard : !bound ? 104 : SCAR_OK_V1;
            int observed_cpu = -1;
            if (leaf_status == SCAR_OK_V1) {
                if (sink.rows != nullptr) {
                    observed_cpu = sched_getcpu();
                    std::lock_guard event_lock(mutex);
                    sink.record(Observation::compute_start, event, call.output, no_value, observed_cpu);
                }
                const int32_t result_status = operators[index]->run(arguments.data(), call.count, &result);
                leaf_status = result_status == SCAR_OK_V1 ? SCAR_OK_V1 :
                              result_status >= 1 && result_status <= 4 ? 100 + result_status : operator_guard;
            }
            const bool pin_kept = !bound || affinity.bound();
            const bool pin_restored = affinity.restore();
            const bool floating_restored = floating.restore();
            if (!pin_kept || !pin_restored) leaf_status = 104;
            else if (!floating_restored) leaf_status = worker_guard;

            lock.lock();
            --active;
            if (leaf_status != SCAR_OK_V1) {
                sink.record(Observation::compute_failure, event, call.output, no_value, observed_cpu, leaf_status);
                fail(leaf_status, index);
                return;
            }
            sink.record(Observation::compute_success, event, call.output, no_value, observed_cpu);
            ++calls_succeeded;
            ready[call.output] = 1;
            const auto &p = value_plans[call.output];
            sink.record(Observation::value_ready, event, call.output,
                        p.kind == workspace ? p.storage_index : final_slot, observed_cpu);
            for (size_t j = 0; j < call.count; ++j) {
                const auto value = call.inputs[j];
                if (remaining[value] == 0) {
                    fail(lifetime_guard, index);
                    return;
                }
                --remaining[value];
                retire(event, value, observed_cpu);
            }
            retire(event, call.output, observed_cpu);
            ++lane_head[lane];
            complete(event);
        }
    };

    std::vector<std::jthread> workers;
    auto join_workers = [&] {
        for (auto &thread : workers) if (thread.joinable()) thread.join();
    };
    try {
        workers.reserve(cpu_ids.size());
        for (size_t lane = 0; lane < cpu_ids.size(); ++lane) workers.emplace_back(worker, lane);
    } catch (const std::system_error &) {
        std::lock_guard lock(mutex);
        fail(worker_guard, no_value);
    } catch (const std::bad_alloc &) {
        std::lock_guard lock(mutex);
        fail(allocation_guard, no_value);
    }

    std::unique_lock lock(mutex);
    while (status == SCAR_OK_V1 && export_event == no_event) {
        changed.wait(lock, [&] { return status != SCAR_OK_V1 || next_control() != no_event ||
                                          (active == 0 && !any_lane_ready()); });
        if (status != SCAR_OK_V1) break;
        const size_t event = next_control();
        if (event == no_event) {
            fail(lifetime_guard, no_value);
            break;
        }
        const auto &plan = events[event];
        const size_t index = plan.subject;
        switch (plan.kind) {
        case EventKind::allocate:
            if (index == final_slot) {
                if (final_adopted) { fail(lifetime_guard, no_value); break; }
                // ABI1 supplies private storage. Adoption does not make its value ready.
                values[final_value] = *output;
                final_adopted = true;
                sink.record(Observation::final_storage_adopted, event, final_value, final_slot);
            } else {
                auto &slot = slots[index];
                if (slot.live) { fail(lifetime_guard, no_value); break; }
                const auto capacity = slot_capacities[index];
                if (capacity) {
                    slot.storage.reset(new (std::nothrow) double[capacity / sizeof(double)]);
                    if (!slot.storage) { fail(allocation_guard, no_value); break; }
                }
                slot.live = true;
                sink.record(Observation::workspace_allocated, event, no_value, index);
            }
            break;
        case EventKind::fence:
            if (calls_succeeded != call_plans.size() || active != 0) { fail(lifetime_guard, no_value); break; }
            stop = true;
            changed.notify_all();
            lock.unlock();
            join_workers();
            lock.lock();
            fenced = true;
            sink.record(Observation::success_fence, event);
            break;
        case EventKind::release: {
            auto &slot = slots[index];
            if (!slot.live || slot.owner != no_value) { fail(lifetime_guard, no_value); break; }
            slot.storage.reset();
            slot.live = false;
            sink.record(Observation::workspace_released, event, no_value, index);
            break;
        }
        case EventKind::export_value: {
            bool live_workspace = false;
            for (const auto &slot : slots) live_workspace |= slot.live;
            if (!fenced || !ready[final_value] || live_workspace || events_succeeded + 1 != events.size()) {
                fail(lifetime_guard, no_value);
                break;
            }
            export_event = event;
            break;
        }
        case EventKind::compute:
            fail(lifetime_guard, no_value);
            break;
        }
        if (status == SCAR_OK_V1) complete(event);
    }
    stop = true;
    changed.notify_all();
    lock.unlock();
    join_workers();
    if (failed_call != nullptr) *failed_call = failure_index;
    return status;
}

int32_t run_entry(const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
                  const scar_operator_table_v1 *const *operators, uint64_t operator_count,
                  uint64_t *failed_call, EventSink &sink) {
    if (failed_call != nullptr) *failed_call = no_value;
    FloatingEnvironment caller;
    int32_t status = worker_guard;
    size_t export_event = no_event;
    if (caller.ready()) {
        try {
            status = run_resource_events(inputs, count, output, operators, operator_count, failed_call,
                                         caller.entry(), sink, export_event);
        } catch (const std::bad_alloc &) { status = allocation_guard; }
          catch (const std::system_error &) { status = worker_guard; }
    }
    if (!caller.restore()) return worker_guard;
    if (status == SCAR_OK_V1) sink.record(Observation::final_published, export_event, final_value, final_slot);
    return status;
}
} // namespace

extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_plan_sha256_v1() { return "@PIPELINE_SHA256@"; }
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_memory_sha256_v1() { return "@MEMORY_SHA256@"; }
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_schedule_sha256_v1() { return "@EXECUTION_SCHEDULE_SHA256@"; }
extern "C" SCAR_EXPORT_V1 int32_t scar_pipeline_run_v1(
    const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
    const scar_operator_table_v1 *const *operators, uint64_t operator_count, uint64_t *failed_call) {
    EventSink sink{nullptr};
    return run_entry(inputs, count, output, operators, operator_count, failed_call, sink);
}
extern "C" SCAR_EXPORT_V1 int32_t scar_pipeline_run_diagnostic_v1(
    const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
    const scar_operator_table_v1 *const *operators, uint64_t operator_count, uint64_t *failed_call,
    NativeEventV1 *rows, uint64_t capacity, uint64_t *used) {
    if (failed_call != nullptr) *failed_call = no_value;
    if (used != nullptr) *used = 0;
    // Each control event adds one row. A compute adds at most four own
    // observations, plus one retirement charged to each produced value.
    if (rows == nullptr || used == nullptr || capacity < events.size() * @DIAGNOSTIC_CAPACITY_PER_EVENT@)
        return argument_guard;
    EventSink sink{rows};
    const auto status = run_entry(inputs, count, output, operators, operator_count, failed_call, sink);
    *used = sink.used;
    return status;
}
