struct DetachedInput {
    std::vector<double> values;
    std::vector<double> rhs;
    std::vector<int> diagonals;
};

@SCAR_LEGACY_UNUSED@DetachedInput read_snapshot(std::span<const int> indices, std::span<const int> offsets) {
    DetachedInput input{std::vector<double>(sparse::nnz), std::vector<double>(sparse::size), {}};
    read_exact(std::as_writable_bytes(std::span(input.values)), "incomplete detached CSR values");
    read_exact(std::as_writable_bytes(std::span(input.rhs)), "incomplete detached RHS values");
    constexpr double min_normal = std::numeric_limits<double>::min();
    constexpr double max_before_scale = std::numeric_limits<double>::max() / 2;
    if (!std::all_of(input.values.begin(), input.values.end(), [](double value) { return std::isfinite(value); })
            || !std::all_of(input.rhs.begin(), input.rhs.end(), [](double value) {
                const double magnitude = std::abs(value);
                return magnitude == 0.0 || (magnitude >= min_normal && magnitude <= max_before_scale);
            })) {
        throw InputFailure{"detached CSR or RHS includes a value outside its numerical contract"};
    }

    std::array<std::byte, 4> count_bytes;
    read_exact(count_bytes, "missing detached CSR row count");
    const auto count = get_unsigned(count_bytes);
    if (count > sparse::size) {
        throw InputFailure{"too many detached CSR rows"};
    }
    input.diagonals.reserve(static_cast<std::size_t>(count));
    int previous = -1;
    for (std::uint64_t i = 0; i < count; ++i) {
        std::array<std::byte, 8> row_slot;
        read_exact(row_slot, "incomplete detached CSR row and diagonal pair");
        const std::span<const std::byte> fields(row_slot);
        const auto row = std::bit_cast<std::int32_t>(static_cast<std::uint32_t>(get_unsigned(fields.first<4>())));
        const auto slot = std::bit_cast<std::int32_t>(static_cast<std::uint32_t>(get_unsigned(fields.last<4>())));
        if (row <= previous || row >= sparse::size || slot < offsets[row] || slot >= offsets[row + 1]
                || indices[slot] != row) {
            throw InputFailure{"invalid detached CSR row and diagonal pair"};
        }
        for (int j = offsets[row]; j < offsets[row + 1]; ++j) {
            if (std::bit_cast<std::uint64_t>(input.values[j]) != 0) {
                throw InputFailure{"detached CSR row template must contain only positive zero"};
            }
        }
        input.diagonals.push_back(slot);
        input.rhs[row] = 0.0;
        previous = row;
    }
    return input;
}

@SCAR_SOURCE_INGRESS@using ScaleCopy = void (*)(int, int, int, int, double, const double*, int, double*, int);

ScaleCopy scale_copy(const std::filesystem::path& provider_path) {
    void* handle = dlopen((provider_path / sparse::blas_member).c_str(), RTLD_NOLOAD | RTLD_NOW | RTLD_LOCAL);
    if (!handle) {
        throw std::runtime_error("detached RHS requires the loaded BLAS provider");
    }
    const auto config = reinterpret_cast<const char* (*)()>(dlsym(handle, "scipy_openblas_get_config"));
    const auto copy = reinterpret_cast<ScaleCopy>(dlsym(handle, "@SCAR_BLAS_SCALE_SYMBOL@"));
    const char* description = config ? config() : nullptr;
    const bool abi_ok = description && std::string_view(description).starts_with("OpenBLAS ")
        && std::string_view(description).find("USE64BITINT") == std::string_view::npos;
    dlclose(handle);
    if (!copy || !abi_ok) {
        throw std::runtime_error("detached RHS requires LP64 OpenBLAS DOMATCOPY");
    }
    return copy;
}

int run_requests(std::span<const int> indices, std::span<const int> offsets, DetachedInput& input) {
    std::uint64_t published = 0;
    Record failure = Record::transport_failure;
    std::int32_t worker_status = 0;
    try {
        sparse::detail::check_resources();
        const auto executable = std::filesystem::canonical("/proc/self/exe");
        const auto provider_path = std::filesystem::canonical(executable.parent_path() / "numeric");
        constexpr auto window = std::size(sparse::worker_cpus);
        const ordered::Config config{@SCAR_OWNER_CPU@, sparse::worker_cpus, window, sizeof(double), sparse::result_bytes,
            sparse::worker_limit, window * (sizeof(double) + sparse::result_bytes)};

        const auto factory = [&](int) {
            sparse::detail::private_worker_environment();
            auto provider = std::make_shared<scar::sparse_v1::Provider>(provider_path);
            sparse::detail::check_blas(provider_path);
            const auto copy = scale_copy(provider_path);
            scar::sparse_v1::Timings phase{};
            auto symbolic = std::unique_ptr<const void, scar::sparse_v1::Provider::Destroy>(provider->create(
                sparse::size, sparse::nnz, indices.data(), offsets.data(), sparse::symbolic_budget, &phase),
                provider->destroy);
            if (!symbolic || provider->retained_bytes(symbolic.get()) > sparse::symbolic_budget) {
                throw std::runtime_error("detached CSR structure or symbolic budget was refused");
            }
            return [&, copy, provider = std::move(provider), symbolic = std::move(symbolic),
                    rhs = std::vector<double>(sparse::size), solution = std::vector<double>(sparse::size)](
                    std::uint64_t, std::span<const std::byte> frame, std::span<std::byte> result) mutable -> std::int32_t {
                double scale;
                std::memcpy(&scale, frame.data(), sizeof(scale));
                // The dispatcher invokes this only in a forked worker, so template writes are private.
                for (const auto slot : input.diagonals) {
                    input.values[slot] = scale;
                }
                constexpr int row_major = 101, no_transpose = 111;
                copy(row_major, no_transpose, 1, sparse::size, scale, input.rhs.data(), sparse::size,
                    rhs.data(), sparse::size);
                scar::sparse_v1::Timings timing{};
                const auto status = provider->solve(symbolic.get(), sparse::size, sparse::nnz, indices.data(),
                    offsets.data(), input.values.data(), rhs.data(), solution.data(), &timing);
                if (status == 0) {
                    std::memcpy(result.data(), solution.data(), sparse::result_bytes);
                }
                return status;
            };
        };
        const auto fill = [](std::uint64_t sequence, std::span<std::byte> request) {
@SCAR_TICKET_BEGIN@
            std::array<std::byte, 8> number;
            read_exact(number, "missing or incomplete detached CSR sequence");
            if (get_unsigned(number) != sequence) {
                throw InputFailure{"detached CSR request sequence differs"};
            }
            read_exact(request, "incomplete detached CSR scale");
            const auto scale = std::bit_cast<double>(get_unsigned(request));
            if (!(scale >= 1.0 && scale < 2.0)) {
                throw InputFailure{"detached CSR scale is outside [1.0, 2.0)"};
            }
            if (sequence + 1 == sparse::count) {
                require_eof();
            }@SCAR_TICKET_END@
        };
        const auto retire = [&](const ordered::Retirement& row) {
            if (row.sequence != published) {
                throw std::runtime_error("unexpected detached CSR publication order");
            }
            if (row.kind != ordered::Kind::success) {
                if (row.kind == ordered::Kind::worker_failure && row.worker_status != 0) {
                    failure = Record::worker_failure;
                    worker_status = row.worker_status;
                } else if (row.kind != ordered::Kind::transport_failure) {
                    throw std::runtime_error("unexpected detached CSR runtime failure");
                }
                throw sparse::detail::Stop{};
            }
            if (row.worker_status != 0 || row.result.size() != sparse::result_bytes) {
                throw std::runtime_error("unexpected detached CSR result");
            }
            publish_record(published, Record::success, 0);
            write_exact(row.result);
            ++published;
        };
        if (sparse::count == 0) {
            require_eof();
        }
        ordered::dispatch(config, sparse::count, factory, fill, retire);
        if (published != sparse::count) {
            throw std::runtime_error("incomplete detached CSR publication");
        }
        publish_record(published, Record::end, 0);
        return 0;
    } catch (const sparse::detail::Stop&) {
        publish_record(published, failure, worker_status);
    } catch (const InputFailure& error) {
        publish_record(published, Record::protocol_failure, 0);
        std::fprintf(stderr, "%s\n", error.message);
    } catch (const std::exception& error) {
        publish_record(published, Record::host_failure, 0);
        std::fprintf(stderr, "%s\n", error.what());
    }
    return 1;
}

}  // namespace

int main(int argc, char**) {
    if (argc != 1) {
        std::fputs("detached sparse executable accepts binary stdin and no arguments\n", stderr);
        return 1;
    }
    if (signal(SIGPIPE, SIG_IGN) == SIG_ERR) {
        std::fputs("cannot configure detached sparse output transport\n", stderr);
        return 1;
    }
    try {
        auto observed = input_header;
        read_exact(observed, "incomplete detached CSR header");
        if (observed != input_header) {
            throw InputFailure{"detached CSR header differs from the compiled recipe"};
        }
        std::vector<int> indices(sparse::nnz), offsets(std::size_t{sparse::size} + 1);
        read_exact(std::as_writable_bytes(std::span(indices)), "incomplete detached CSR indices");
        read_exact(std::as_writable_bytes(std::span(offsets)), "incomplete detached CSR offsets");
        check_structure(indices, offsets);
        auto input = @SCAR_SNAPSHOT_READER@(indices, offsets);
        write_exact(output_header);
        return run_requests(indices, offsets, input);
    } catch (const InputFailure& error) {
        std::fprintf(stderr, "%s\n", error.message);
    } catch (const OutputFailure&) {
        std::fputs("cannot write detached CSR output\n", stderr);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
    }
    return 1;
}
