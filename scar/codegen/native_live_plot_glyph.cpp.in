namespace scar::live {

std::vector<Glyph> generate_glyphs(std::span<const char> bytes, double time) {
    require(std::fegetround() == FE_TONEAREST && std::string_view(std::setlocale(LC_CTYPE, nullptr)) == "C",
            "live title requires the original floating-point and C locale");
    const std::string text = std::string(title_prefix) + scientific(time) + title_suffix;
    Font provider{bytes};
    FT_Int major{}, minor{}, patch{};
    FT_Library_Version(provider.library, &major, &minor, &patch);
    require(major == ft_major && minor == ft_minor && patch == ft_patch &&
            std::string_view(hb_version_string()) == hb_version, "native glyph provider version differs");
    const auto height = canvas_height;
    const auto size = title_points;
    const auto dpi = title_dpi;
    const auto flags = title_load_flags;
    reset_size(provider.face, size, dpi);
    const auto layout = shape(provider.face, text, flags);
    require(layout.glyphs.size() <= 128, "native title exceeds glyph budget");
    const double ascent = std::max(layout.height - layout.descent, min_ascent(provider.face, size, dpi));
    const double x = title_x - layout.width / 2;
    const double y = height - (title_y - ascent);
    std::vector<Glyph> result;
    result.reserve(layout.glyphs.size());
    for (const auto& glyph : layout.glyphs) {
        reset_size(provider.face, size, dpi);
        FT_Vector delta{static_cast<long>(std::nearbyint(64.0 * (x + glyph.x / 64.0))),
                        static_cast<long>(std::nearbyint(64.0 * (height - y + glyph.y / 64.0)))};
        FT_Set_Transform(provider.face, nullptr, &delta);
        require(!FT_Load_Glyph(provider.face, glyph.id, flags)
                && !FT_Render_Glyph(provider.face->glyph, FT_RENDER_MODE_NORMAL),
                "native antialiased font rendering failed");
        const auto* slot = provider.face->glyph;
        const auto& bitmap = slot->bitmap;
        require(bitmap.rows <= 4096 && bitmap.width <= 4096 &&
                ((!bitmap.width && !bitmap.rows) || (bitmap.rows && bitmap.width &&
                bitmap.pixel_mode == FT_PIXEL_MODE_GRAY && bitmap.pitch >= 0 &&
                static_cast<unsigned>(bitmap.pitch) >= bitmap.width)), "unexpected original bitmap storage");
        auto& generated = result.emplace_back();
        generated.rows = bitmap.rows;
        generated.columns = bitmap.width;
        generated.x = slot->bitmap_left;
        generated.y = height - slot->bitmap_top + static_cast<int>(bitmap.rows);
        generated.bitmap.reserve(static_cast<std::size_t>(bitmap.rows) * bitmap.width);
        for (unsigned row = 0; row < bitmap.rows; ++row) {
            const auto* start = bitmap.buffer + row * bitmap.pitch;
            generated.bitmap.insert(generated.bitmap.end(), start, start + bitmap.width);
        }
    }
    return result;
}

}
