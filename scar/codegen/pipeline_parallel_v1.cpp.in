#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
@PLAN_AND_DESCRIPTOR_HELPERS@
#include <cfenv>
#include <cerrno>
#include <sched.h>
#include <system_error>
#include <thread>
#include <unistd.h>

#pragma STDC FENV_ACCESS ON

namespace {
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
@AFFINITY_IMPLEMENTATION@

constexpr int32_t worker_guard = 16;
constexpr std::array<int, @CALL_COUNT@> call_cpu_ids = {{@CALL_CPUS@}};
constexpr std::array<uint64_t, @WAVE_COUNT@ + 1> wave_offsets = {{@WAVE_OFFSETS@}};
constexpr std::array<uint64_t, @CALL_COUNT@> wave_calls = {{@WAVE_CALLS@}};
constexpr std::array<std::array<uint8_t, @CALL_COUNT@>, @CALL_COUNT@> call_predecessors = {{
@CALL_PREDECESSORS@
}};

// Save the complete environment, including controls beyond the rounding mode.
// Worker computation uses the captured caller controls with exceptions held;
// both the caller and each worker restore their own entry environments.
class FloatingEnvironment {
    fenv_t saved_{};
    bool saved_ok_ = false;
    bool active_ = false;
    bool ready_ = false;
public:
    explicit FloatingEnvironment(const fenv_t *desired = nullptr) noexcept {
        saved_ok_ = std::fegetenv(&saved_) == 0;
        if (!saved_ok_) return;
        active_ = true;
        if (desired != nullptr && std::fesetenv(desired) != 0) return;
        fenv_t held{};
        ready_ = std::feholdexcept(&held) == 0;
    }
    bool ready() const noexcept { return ready_; }
    const fenv_t &entry() const noexcept { return saved_; }
    bool restore() noexcept {
        if (!active_) return saved_ok_;
        if (std::fesetenv(&saved_) != 0) return false;
        active_ = false;
        return true;
    }
    ~FloatingEnvironment() { if (active_) restore(); }
};

int32_t execute_task(size_t index, const std::vector<scar_array_v1> &values,
                     const scar_operator_table_v1 *const *operators,
                     const fenv_t &caller_environment) noexcept {
    const auto &call = call_plans[index];
    std::array<scar_array_v1, max_arguments> arguments{};
    for (uint64_t j = 0; j < call.count; ++j) arguments[j] = values[call.inputs[j]];
    ThreadAffinity affinity;
    FloatingEnvironment floating(&caller_environment);
    const bool bound = floating.ready() && affinity.bind(call_cpu_ids[index]);
    int32_t status = !floating.ready() ? worker_guard :
                     !bound ? 104 : SCAR_OK_V1;
    if (status == SCAR_OK_V1) {
        // A descriptor is task-local. Payload belongs to this invocation and
        // is disjoint from every concurrent task input/output in this wave.
        scar_array_v1 output = values[call.output];
        const int32_t result = operators[index]->run(arguments.data(), call.count, &output);
        status = result == SCAR_OK_V1 ? SCAR_OK_V1 :
                 result >= 1 && result <= 4 ? 100 + result : operator_guard;
    }
    const bool pin_kept = !bound || affinity.bound();
    const bool pin_restored = affinity.restore();
    const bool floating_restored = floating.restore();
    if (!pin_kept || !pin_restored) return 104;
    if (!floating_restored) return worker_guard;
    return status;
}

int32_t run_waves(const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
                  const scar_operator_table_v1 *const *operators, uint64_t operator_count,
                  uint64_t *failed_call, const fenv_t &caller_environment) {
    if (count != input_count || output == nullptr || (count && inputs == nullptr) ||
        operators == nullptr || operator_count != call_plans.size()) return argument_guard;
    __int128 payload = value_plans[final_value].bytes;
    for (const auto capacity : slot_capacities) {
        if (capacity % sizeof(double) || capacity > std::numeric_limits<ptrdiff_t>::max()) return budget_guard;
        payload += capacity;
    }
    if (payload > payload_budget || payload > std::numeric_limits<size_t>::max()) return budget_guard;
    for (const auto &p : value_plans) {
        if (__int128(p.rows) * p.cols * sizeof(double) != p.bytes) return shape_guard;
        if (p.kind == external_input &&
            (!valid_array(inputs[p.storage_index], p) || !contiguous(inputs[p.storage_index]))) return shape_guard;
    }
    if (!valid_array(*output, value_plans[final_value]) || !contiguous(*output)) return shape_guard;
    for (uint64_t i = 0; i < count; ++i) if (overlap(*output, inputs[i])) return argument_guard;
    for (size_t i = 0; i < call_plans.size(); ++i) {
        const auto *table = operators[i]; const auto &call = call_plans[i];
        if (table == nullptr || table->abi_version != 1 || table->struct_size < sizeof(scar_operator_table_v1) ||
            table->run == nullptr || table->input_count != call.count || table->plan_sha256 == nullptr ||
            std::strcmp(table->plan_sha256, call.plan_sha256) != 0) return operator_guard;
    }

    // All pool payload is private and retained until every started worker has
    // joined. Slot versions are released by actual completed consumers, never
    // by a source-ordinal last_use check.
    std::vector<std::unique_ptr<double[]>> slots(slot_capacities.size());
    for (size_t i = 0; i < slots.size(); ++i) {
        if (slot_capacities[i]) {
            slots[i].reset(new (std::nothrow) double[slot_capacities[i] / sizeof(double)]);
            if (!slots[i]) return allocation_guard;
        }
    }
    std::vector<scar_array_v1> values(value_plans.size());
    std::vector<uint8_t> ready(value_plans.size(), 0), completed(call_plans.size(), 0);
    std::vector<uint64_t> owners(slot_capacities.size(), no_value), remaining(value_plans.size(), 0);
    for (size_t value = 0; value < value_plans.size(); ++value) {
        const auto &p = value_plans[value];
        if (p.kind == external_input) { values[value] = inputs[p.storage_index]; ready[value] = 1; }
        else if (p.kind == workspace) {
            if (p.storage_index >= slots.size() || p.bytes > slot_capacities[p.storage_index]) return budget_guard;
            values[value] = slot_array(slots[p.storage_index].get(), slot_capacities[p.storage_index], p);
        } else if (p.kind == final_output && value == final_value) values[value] = *output;
        else return lifetime_guard;
    }
    for (const auto &call : call_plans) {
        for (uint64_t j = 0; j < call.count; ++j) {
            if (call.inputs[j] >= remaining.size()) return argument_guard;
            ++remaining[call.inputs[j]];
        }
    }
    for (size_t wave = 0; wave + 1 < wave_offsets.size(); ++wave) {
        const auto first = wave_offsets[wave], end = wave_offsets[wave + 1];
        if (first >= end || end > wave_calls.size()) return lifetime_guard;
        for (auto at = first; at < end; ++at) {
            const auto index = wave_calls[at];
            if (index >= call_plans.size() || completed[index]) return lifetime_guard;
            if (failed_call != nullptr) *failed_call = index;
            for (size_t pred = 0; pred < call_plans.size(); ++pred)
                if (call_predecessors[index][pred] && !completed[pred]) return lifetime_guard;
            const auto &call = call_plans[index]; const auto &p = value_plans[call.output];
            if (p.producer != int64_t(index) || p.bytes > call.output_budget ||
                !valid_array(values[call.output], p)) return budget_guard;
            if (p.kind == workspace) {
                const auto old = owners[p.storage_index];
                if (old != no_value && remaining[old] != 0) return lifetime_guard;
            } else if (p.kind != final_output) return lifetime_guard;
            for (uint64_t j = 0; j < call.count; ++j) {
                const auto value = call.inputs[j];
                if (!ready[value] || remaining[value] == 0) return lifetime_guard;
                if (call.c_contiguous_inputs && !contiguous(values[value])) return shape_guard;
            }
            for (auto other_at = first; other_at < end; ++other_at) {
                const auto other_index = wave_calls[other_at];
                const auto &other = call_plans[other_index];
                if (other_at != at && (call_cpu_ids[index] == call_cpu_ids[other_index] ||
                    overlap(values[call.output], values[other.output]) ||
                    (p.kind == workspace && value_plans[other.output].kind == workspace &&
                     p.storage_index == value_plans[other.output].storage_index))) return lifetime_guard;
                for (uint64_t j = 0; j < other.count; ++j)
                    if (overlap(values[call.output], values[other.inputs[j]])) return lifetime_guard;
            }
        }
        for (auto at = first; at < end; ++at) {
            const auto value = call_plans[wave_calls[at]].output; const auto &p = value_plans[value];
            if (p.kind == workspace) {
                const auto old = owners[p.storage_index];
                if (old != no_value) ready[old] = 0;
                owners[p.storage_index] = value;
            }
        }
        std::vector<int32_t> statuses(end - first, worker_guard);
        std::vector<std::jthread> workers;
        bool creation_failed = false;
        try {
            workers.reserve(end - first);
            for (auto at = first; at < end; ++at) {
                workers.emplace_back([&, at]() noexcept {
                    statuses[at - first] = execute_task(wave_calls[at], values, operators, caller_environment);
                });
            }
        } catch (const std::system_error &) { creation_failed = true; }
          catch (const std::bad_alloc &) { creation_failed = true; }
        // Even a failed thread construction cannot return while earlier
        // tasks still access private workspace. Nothing escapes before join.
        for (auto &worker : workers) if (worker.joinable()) worker.join();
        size_t failed_index = call_plans.size(); int32_t failure = worker_guard;
        for (auto at = first; at < end; ++at) {
            if (statuses[at - first] != SCAR_OK_V1 && wave_calls[at] < failed_index) {
                failed_index = wave_calls[at]; failure = statuses[at - first];
            }
        }
        if (creation_failed || failed_index != call_plans.size()) {
            if (failed_call != nullptr && failed_index != call_plans.size()) *failed_call = failed_index;
            return creation_failed ? worker_guard : failure;
        }
        for (auto at = first; at < end; ++at) {
            const auto index = wave_calls[at];
            completed[index] = 1; ready[call_plans[index].output] = 1;
        }
        for (auto at = first; at < end; ++at) {
            const auto &call = call_plans[wave_calls[at]];
            for (uint64_t j = 0; j < call.count; ++j) {
                const auto value = call.inputs[j];
                if (remaining[value] == 0) return lifetime_guard;
                --remaining[value];
            }
        }
        for (size_t value = 0; value < value_plans.size(); ++value) {
            const auto &p = value_plans[value];
            if (p.kind == workspace && remaining[value] == 0 && owners[p.storage_index] == value) {
                ready[value] = 0; owners[p.storage_index] = no_value;
            }
        }
    }
    for (auto done : completed) if (!done) return lifetime_guard;
    if (!ready[final_value]) return lifetime_guard;
    if (failed_call != nullptr) *failed_call = no_value;
    return SCAR_OK_V1;
}
} // namespace

extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_plan_sha256_v1() { return "@PIPELINE_SHA256@"; }
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_memory_sha256_v1() { return "@MEMORY_SHA256@"; }
extern "C" SCAR_EXPORT_V1 const char *scar_pipeline_schedule_sha256_v1() { return "@EXECUTION_SCHEDULE_SHA256@"; }

extern "C" SCAR_EXPORT_V1 int32_t scar_pipeline_run_v1(
    const scar_array_v1 *inputs, uint64_t count, scar_array_v1 *output,
    const scar_operator_table_v1 *const *operators, uint64_t operator_count,
    uint64_t *failed_call) {
    if (failed_call != nullptr) *failed_call = no_value;
    FloatingEnvironment caller;
    int32_t status = worker_guard;
    if (caller.ready()) {
        try { status = run_waves(inputs, count, output, operators, operator_count, failed_call, caller.entry()); }
        catch (const std::bad_alloc &) { status = allocation_guard; }
        catch (const std::system_error &) { status = worker_guard; }
    }
    return caller.restore() ? status : worker_guard;
}
