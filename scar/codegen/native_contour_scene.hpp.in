#pragma once

#include <cstddef>
#include <cstdint>
#include <filesystem>
#include <vector>

namespace scar::contour {

struct Grid {
    std::size_t rows{}, cols{}, x_chunk_size{}, y_chunk_size{};
    bool corner_mask{};
    std::vector<double> x, y, z, levels;
    std::vector<std::uint8_t> mask;
};

struct Polygon {
    std::vector<double> xy;
    std::vector<std::uint8_t> codes;
};

using Band = std::vector<Polygon>;

Grid read_input(const std::filesystem::path& path);
std::vector<Band> filled_grid(const Grid& grid);
void write_output(const std::filesystem::path& path, const std::vector<Band>& bands);

}
