#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif

#include <algorithm>
#include <array>
#include <bit>
#include <chrono>
#include <cstdint>
#include <dlfcn.h>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <limits>
#include <link.h>
#include <memory>
#include <openssl/evp.h>
#include <span>
#include <stdexcept>
#include <string_view>
#include <sys/stat.h>
#include <unistd.h>
#include <vector>

namespace {
namespace fs = std::filesystem;
using Digest = std::array<unsigned char, 32>;
using Clock = std::chrono::steady_clock;
using SavePng = void (*)(const char*, const void*, std::uint32_t, std::uint32_t);
static_assert(Clock::is_steady && std::endian::native == std::endian::little && sizeof(std::uintptr_t) == 8);

constexpr std::uint32_t width = @WIDTH@, height = @HEIGHT@;
constexpr std::size_t rgba_bytes = std::size_t{4} * width * height;
constexpr std::uintptr_t symbol_offset = @SYMBOL_OFFSET@, symbol_bytes = @SYMBOL_BYTES@;
constexpr Digest symbol_digest{@SYMBOL_DIGEST@};
constexpr std::string_view provider_path = @PROVIDER@;

struct PackageFile {
    std::string_view path;
    std::size_t bytes;
    Digest digest;
};
constexpr std::array<PackageFile, @FILE_COUNT@> package_files{{@FILES@}};
constexpr std::array<std::string_view, @HOST_COUNT@> host_files{{@HOSTS@}};

void require(bool ok, const char* message) {
    if (!ok) throw std::runtime_error(message);
}

Digest hash(std::span<const unsigned char> data) {
    Digest digest{};
    unsigned int bytes{};
    require(EVP_Digest(data.data(), data.size(), digest.data(), &bytes, EVP_sha256(), nullptr) == 1 &&
            bytes == digest.size(), "native SHA-256 operation failed");
    return digest;
}

std::vector<unsigned char> exact_file(const fs::path& path, std::size_t bytes) {
    require(fs::symlink_status(path).type() == fs::file_type::regular && fs::file_size(path) == bytes,
            "native input is not a regular file of the expected size");
    std::vector<unsigned char> payload(bytes);
    std::ifstream file(path, std::ios::binary);
    require(bool(file.read(reinterpret_cast<char*>(payload.data()), bytes)) && file.peek() == EOF && file.eof(),
            "native input read differs");
    return payload;
}

void check_package(const fs::path& root) {
    for (const auto& member : package_files)
        require(hash(exact_file(root / member.path, member.bytes)) == member.digest,
                "native PNG provider package fingerprint differs");
}

class Library {
    void* handle_;
public:
    explicit Library(const fs::path& path) : handle_(::dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL)) {
        if (!handle_) throw std::runtime_error(::dlerror());
    }
    Library(const Library&) = delete;
    ~Library() { ::dlclose(handle_); }
    link_map* image() const {
        link_map* result = nullptr;
        require(::dlinfo(handle_, RTLD_DI_LINKMAP, &result) == 0 && result != nullptr && result->l_name,
                "native provider glibc link-map is missing");
        return result;
    }
};

struct RuntimeBinding {
    const fs::path& selected;
    std::uintptr_t base;
    std::vector<fs::path> allowed;
    std::vector<bool> seen;
    bool verified_text = false;
    std::string problem;

    RuntimeBinding(const fs::path& provider, std::uintptr_t load_bias, const fs::path& root)
        : selected(provider), base(load_bias) {
        for (const auto& member : package_files) allowed.push_back(fs::canonical(root / member.path));
        for (const auto& name : host_files) allowed.emplace_back(name);
        seen.resize(allowed.size());
    }

    void observe(const dl_phdr_info& image) {
        const std::string_view name(image.dlpi_name);
        if (name.empty() || name == "linux-vdso.so.1") return;
        const auto canonical = fs::canonical(name);
        const auto match = std::find(allowed.begin(), allowed.end(), canonical);
        require(match != allowed.end() && !seen[match - allowed.begin()],
                "native PNG process mapped another dependency or a duplicate image");
        seen[match - allowed.begin()] = true;
        if (canonical != selected) return;

        require(image.dlpi_addr == base && image.dlpi_phdr, "native provider load bias differs");
        for (unsigned int i = 0; i < image.dlpi_phnum; ++i) {
            const auto& segment = image.dlpi_phdr[i];
            if (segment.p_type != PT_LOAD || segment.p_flags != (PF_R | PF_X) || symbol_offset < segment.p_vaddr)
                continue;
            const auto start = symbol_offset - segment.p_vaddr;
            if (start <= segment.p_filesz && symbol_bytes <= segment.p_filesz - start)
                verified_text = true;
        }
    }
};

int observe_object(dl_phdr_info* info, std::size_t, void* context) noexcept {
    auto& guard = *static_cast<RuntimeBinding*>(context);
    try {
        guard.observe(*info);
        return 0;
    } catch (const std::exception& problem) {
        try { guard.problem = problem.what(); } catch (...) {}
        return 1;
    } catch (...) {
        return 1;
    }
}

SavePng bind(const Library& library, const fs::path& root, const fs::path& provider) {
    const auto* image = library.image();
    require(fs::canonical(image->l_name) == provider && image->l_addr > 0 &&
            symbol_bytes <= std::numeric_limits<std::uintptr_t>::max() - symbol_offset &&
            image->l_addr <= std::numeric_limits<std::uintptr_t>::max() - symbol_offset - symbol_bytes,
            "native PNG provider image identity differs");

    RuntimeBinding guard(provider, image->l_addr, root);
    const int visit = ::dl_iterate_phdr(observe_object, &guard);
    if (visit && !guard.problem.empty()) throw std::runtime_error(guard.problem);
    require(visit == 0 && guard.verified_text && std::all_of(guard.seen.begin(), guard.seen.end(), [](bool seen) {
        return seen;
    }), "native PNG dependency closure or executable segment differs");

    const auto address = reinterpret_cast<const unsigned char*>(image->l_addr + symbol_offset);
    Dl_info resolved{};
    require(::dladdr(address, &resolved) == 1 && resolved.dli_fname &&
            fs::canonical(resolved.dli_fname) == provider &&
            reinterpret_cast<std::uintptr_t>(resolved.dli_fbase) == image->l_addr &&
            hash(std::span(address, symbol_bytes)) == symbol_digest,
            "native PNG callable code bytes differ");
    return reinterpret_cast<SavePng>(image->l_addr + symbol_offset);
}

void prefault(const std::vector<unsigned char>& payload) {
    const auto size = ::sysconf(_SC_PAGESIZE);
    require(size > 0, "native page size unavailable");
    const auto* data = static_cast<const volatile unsigned char*>(payload.data());
    for (std::size_t offset = 0; offset < payload.size(); offset += size)
        static_cast<void>(data[offset]);
}
}

int main(int argc, char* argv[]) {
    try {
        require(argc == 3, "expected INPUT_RGBA FRESH_OUTPUT_PNG");
        const auto root = fs::read_symlink("/proc/self/exe").parent_path().parent_path();
        const auto requested = fs::absolute(argv[2]);
        require(!requested.filename().empty() && !fs::exists(fs::symlink_status(requested)),
                "PNG calibration requires a fresh target file");
        const auto output = requested.string();
        check_package(root);
        const auto provider = fs::canonical(root / provider_path);
        const Library library(provider);
        const auto save = bind(library, root, provider);
        const auto rgba = exact_file(argv[1], rgba_bytes);
        prefault(rgba);

        const auto begin = Clock::now();
        save(output.c_str(), rgba.data(), width, height);
        const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - begin).count();

        require(elapsed > 0 && fs::is_regular_file(requested), "native PNG publication did not complete");
        std::cout << elapsed << '\n';
        require(bool(std::cout.flush()), "cannot publish measurement");
        return 0;
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
