#include "scar_abi_v1.h"

#include <array>
#include <cstddef>
#include <cstdint>
#include <cstring>

namespace {
static_assert(sizeof(double) == 8 && sizeof(std::uintptr_t) == sizeof(std::uint64_t));

struct Shape {
    std::int64_t rows;
    std::int64_t columns;
};

struct Lane {
    std::size_t index;
    std::size_t offset;
    std::size_t step;
};

struct Copy {
    Lane read;
    Lane write;
    std::size_t repetitions;
    std::size_t bytes;
};

constexpr std::array<Shape, @ARRAY_COUNT@> shapes{{@ARRAYS@}};
constexpr std::array<Copy, @MOVE_COUNT@> ordered{{
    @MOVES@
}};

bool matches(const scar_array_v1& array, Shape shape) noexcept {
    if (array.rank != 2 || array.shape[0] != shape.rows || array.shape[1] != shape.columns ||
        array.lower_bound > array.upper_bound) return false;
    if (shape.rows == 0 || shape.columns == 0) return true;
    const auto address = reinterpret_cast<std::uintptr_t>(array.data);
    const auto bytes = static_cast<std::size_t>(shape.rows * shape.columns * 8);
    return array.data && address % alignof(double) == 0 &&
           array.strides[0] == shape.columns * 8 && array.strides[1] == 8 &&
           address >= array.lower_bound && address <= array.upper_bound &&
           bytes <= array.upper_bound - address;
}

bool overlaps(const scar_array_v1& a, const scar_array_v1& b) noexcept {
    return a.lower_bound < a.upper_bound && b.lower_bound < b.upper_bound &&
           a.lower_bound < b.upper_bound && b.lower_bound < a.upper_bound;
}
}

extern "C" const char* scar_array_copy_plan_sha256_v1() noexcept {
    return "@PLAN_SHA256@";
}

extern "C" std::int32_t scar_array_copy_preflight_v1(const scar_array_v1* arrays, std::uint64_t count) noexcept {
    if (!arrays || count != shapes.size()) return SCAR_ARGUMENT_GUARD_V1;
    for (std::size_t i = 0; i < shapes.size(); ++i) {
        if (!matches(arrays[i], shapes[i])) return SCAR_SHAPE_GUARD_V1;
        for (std::size_t j = 0; j < i; ++j) {
            if (overlaps(arrays[i], arrays[j])) return SCAR_ARGUMENT_GUARD_V1;
        }
    }
    return SCAR_OK_V1;
}

extern "C" std::int32_t scar_array_copy_run_v1(const scar_array_v1* arrays, std::uint64_t count) noexcept {
    const auto status = scar_array_copy_preflight_v1(arrays, count);
    if (status != SCAR_OK_V1) return status;
    for (const auto& copy : ordered) {
        if (copy.repetitions == 0) continue;
        const auto* source = static_cast<const std::byte*>(arrays[copy.read.index].data) + copy.read.offset;
        auto* destination = static_cast<std::byte*>(arrays[copy.write.index].data) + copy.write.offset;
        for (std::size_t i = 0; i < copy.repetitions; ++i) {
            std::memcpy(destination + i * copy.write.step, source + i * copy.read.step, copy.bytes);
        }
    }
    return SCAR_OK_V1;
}
