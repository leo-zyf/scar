#include "array_entry_argv.hpp"
#include "native_array_entry_io.hpp"
#include "native_ordered_dispatch.hpp"
#include "numpy_observables.hpp"

#include <array>
#include <cmath>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <iostream>
#include <string_view>
#include <time.h>

extern "C" int scar_array_entry_profile_0(double*, double*, const char*, std::uint64_t, std::uint64_t);

namespace {
using namespace scar::array_entry_io;

struct Request {
    std::uint64_t seed, rounds;
};

struct WorkerResult {
    double norm{}, split_difference{}, norm_error{}, worker_wall{}, worker_cpu{};
    std::int64_t pid{}, peak_rss{};
};

struct Result {
    std::uint64_t seed{}, round_count{}, task_count{}, worker_limit{};
    double elapsed{}, worker_cpu{}, norm_error{}, tolerance{};
    bool tolerance_given{};
    std::vector<WorkerResult> records;
    std::vector<std::int64_t> worker_pids;
};

static_assert(sizeof(Request) == 16 && sizeof(WorkerResult) == 56);

constexpr std::array launch_cpus{@LAUNCH_CPUS@};
constexpr std::array<int, @WIDTH@> worker_cpus{@WORKER_CPUS@};
constexpr auto owner_cpu = @OWNER_CPU@;
constexpr auto coordinator_limit = std::uint64_t{@COORDINATOR_LIMIT@};
constexpr bool use_process_team = @USE_PROCESS_TEAM@;

bool hardware_scope() {
    cpu_set_t actual;
    if (sched_getaffinity(0, sizeof(actual), &actual) != 0
            || CPU_COUNT(&actual) != static_cast<int>(launch_cpus.size())) return false;
    for (int cpu : launch_cpus) if (!CPU_ISSET(cpu, &actual)) return false;
    for (auto key : {"OPENBLAS_NUM_THREADS", "OMP_NUM_THREADS", "MKL_NUM_THREADS"}) {
        const auto* value = std::getenv(key);
        if (!value || std::string_view(value) != "1") return false;
    }
    return true;
}

bool enforce_coordinator_limit() {
    struct rlimit limit{};
    if (getrlimit(RLIMIT_AS, &limit) != 0) return false;
    limit.rlim_cur = std::min(limit.rlim_cur, static_cast<rlim_t>(coordinator_limit));
    return setrlimit(RLIMIT_AS, &limit) == 0;
}

std::int32_t compute(const Request& request, double tolerance, WorkerResult& result,
                     const char* diagnostic, std::uint64_t ordinal) {
    std::string checkpoint;
    if (diagnostic) checkpoint = std::string(diagnostic) + '.' + std::to_string(ordinal);
    const auto start = Clock::now();
    const auto cpu = process_seconds();
    if (scar_array_entry_profile_0(&result.norm, &result.split_difference, diagnostic ? checkpoint.c_str() : nullptr,
                                  request.seed, request.rounds) != 0) return 3;
    result.norm_error = scar_numpy_norm_error_v1(result.norm);
    if (!std::isfinite(result.norm) || result.norm_error > tolerance) return 1;
    result.worker_cpu = process_seconds() - cpu;
    result.worker_wall = seconds(Clock::now() - start);
    struct rusage usage{};
    if (getrusage(RUSAGE_SELF, &usage) != 0) return 3;
    result.pid = getpid();
    result.peak_rss = usage.ru_maxrss;
    return 0;
}

std::int32_t execute(Result& result) {
    const auto start = Clock::now();
    const auto* diagnostic = std::getenv("SCAR_ARRAY_ENTRY_STATES");
    result.records.resize(result.task_count);
    if (use_process_team) {
        const scar::ordered_v1::Config plan{owner_cpu, worker_cpus, @WINDOW@, sizeof(Request), sizeof(WorkerResult),
            @CHILD_LIMIT@, @TRANSPORT_BUDGET@};
        const auto factory = [tolerance = result.tolerance, diagnostic](int) {
            return [tolerance, diagnostic](std::uint64_t ordinal, std::span<const std::byte> input,
                                           std::span<std::byte> output) {
                Request request{};
                WorkerResult row{};
                std::memcpy(&request, input.data(), sizeof(request));
                const auto status = compute(request, tolerance, row, diagnostic, ordinal);
                if (status == 0) std::memcpy(output.data(), &row, sizeof(row));
                return status;
            };
        };
        std::int32_t status = 0;
        const auto summary = scar::ordered_v1::dispatch(plan, result.task_count, factory,
            [&](std::uint64_t task, std::span<std::byte> input) {
                const Request request{result.seed + task, result.round_count};
                std::memcpy(input.data(), &request, sizeof(request));
            },
            [&](const scar::ordered_v1::Retirement& retirement) {
                if (retirement.kind != scar::ordered_v1::Kind::success) {
                    if (status == 0) status = retirement.worker_status == 1 ? 1 : 3;
                    return;
                }
                auto& row = result.records[retirement.sequence];
                std::memcpy(&row, retirement.result.data(), sizeof(row));
                if (row.pid != retirement.pid && status == 0) status = 3;
            });
        if (status != 0) return status;
        if (summary.succeeded != result.task_count) return 3;
    } else {
        if (!scar::ordered_v1::detail::pin_cpu(owner_cpu)) return 3;
        for (std::uint64_t task = 0; task < result.task_count; ++task) {
            const auto status = compute({result.seed + task, result.round_count}, result.tolerance,
                                        result.records[task], diagnostic, task);
            if (status != 0) return status;
        }
    }
    result.elapsed = seconds(Clock::now() - start);
    for (const auto& row : result.records) {
        result.norm_error = std::max(result.norm_error, row.norm_error);
        result.worker_cpu += row.worker_cpu;
        if (std::find(result.worker_pids.begin(), result.worker_pids.end(), row.pid) == result.worker_pids.end())
            result.worker_pids.push_back(row.pid);
    }
    std::sort(result.worker_pids.begin(), result.worker_pids.end());
    return 0;
}

void write_worker(std::ostream& out, const WorkerResult& result, const Result& parent,
                  std::size_t task, bool pretty) {
@WORKER_REPORT@
}

void write_records(std::ostream& out, const Result& result, bool pretty, std::size_t depth) {
    out << '[';
    for (std::size_t task = 0; task < result.records.size(); ++task) {
        if (task != 0) out << (pretty ? "," : ", ");
        line(out, pretty, depth + 1);
        write_worker(out, result.records[task], result, task, pretty);
    }
    line(out, pretty, depth);
    out << ']';
}

void write_pids(std::ostream& out, const Result& result, bool pretty, std::size_t depth) {
    out << '[';
    for (std::size_t index = 0; index < result.worker_pids.size(); ++index) {
        if (index != 0) out << (pretty ? "," : ", ");
        line(out, pretty, depth + 1);
        out << result.worker_pids[index];
    }
    line(out, pretty, depth);
    out << ']';
}

void write_result(std::ostream& out, const Result& result, bool pretty) {
@OUTER_REPORT@
}
}

int main(int argc, char** argv) {
    try {
        const auto values = scar::public_argv::parse(argc, argv);
        if (values.empty()) return 0;
        if (!(@STATIC_SCOPE@) || !hardware_scope()) {
            std::cerr << "SCAR_PROFILE_UNAVAILABLE\n";
            return 2;
        }
        Result result{};
@INGRESS@
        const auto& tolerance = values[@TOLERANCE_INDEX@].text;
        result.tolerance_given = !tolerance.empty();
        result.tolerance = result.tolerance_given ? std::strtod(tolerance.c_str(), nullptr) : @DEFAULT_TOLERANCE@;
        if (!std::isfinite(result.tolerance) || result.tolerance <= 0 || result.tolerance >= 1) {
            std::cerr << "invalid norm tolerance\n";
            return 2;
        }
        if (!enforce_coordinator_limit()) return 2;
        const auto status = execute(result);
        if (status != 0) {
            std::cerr << (status == 1 ? "state norm failed\n" : "SCAR_NATIVE_NUMERICAL_FRONTIER\n");
            return status;
        }
        const auto& path = values[@OUTPUT_INDEX@].text;
        if (!path.empty()) {
            std::ofstream file(path, std::ios::binary | std::ios::trunc);
            file.exceptions(std::ios::failbit | std::ios::badbit);
            write_result(file, result, true);
            file << '\n';
            file.close();
        }
        write_result(std::cout, result, false);
        std::cout << '\n';
        return std::cout ? 0 : 1;
    } catch (const ScarPublicArgvError& error) {
        std::cerr << error.what() << '\n';
        return 2;
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
