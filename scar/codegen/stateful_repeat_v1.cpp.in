#include "stateful_abi_v1.h"
#include <cstring>

// Adapter only: every step uses the unchanged transactional ABI v1 body.
// A failed step has not committed. Earlier successful steps remain committed.
extern "C" SCAR_EXPORT_V1 int32_t scar_repeat_stateful_v1(
    const scar_stateful_table_v1 *table, const scar_array_v1 *arrays,
    uint64_t array_count, const scar_scalar_v1 *scalars, uint64_t scalar_count,
    const scar_provider_v1 *providers, uint64_t provider_count,
    uint64_t repetitions, uint64_t *completed) {
    if (!completed) return 1;
    *completed = 0;
    if (!table || table->abi_version != 1 ||
        table->struct_size != sizeof(scar_stateful_table_v1) || !table->run ||
        !table->region_sha256 || !table->plan_sha256 || !table->contract_sha256 ||
        std::strcmp(table->region_sha256, "@REGION_SHA256@") ||
        std::strcmp(table->plan_sha256, "@PLAN_SHA256@") ||
        std::strcmp(table->contract_sha256, "@CONTRACT_SHA256@") ||
        table->array_count != array_count || table->scalar_count != scalar_count ||
        table->provider_count != provider_count) return 1;
    for (uint64_t step = 0; step < repetitions; ++step) {
        const int32_t status = table->run(arrays, array_count, scalars, scalar_count,
                                         providers, provider_count);
        if (status) return status;
        *completed = step + 1;
    }
    return 0;
}
