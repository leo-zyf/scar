#include "stateful_abi_v1.h"

#include <algorithm>
#include <array>
#include <bit>
#include <cerrno>
#include <charconv>
#include <cmath>
#include <cstdint>
#include <fcntl.h>
#include <filesystem>
#include <iostream>
#include <limits>
#include <memory>
#include <stdexcept>
#include <string>
#include <string_view>
#include <sys/stat.h>
#include <unistd.h>
#include <vector>

@PROVIDER_DECLARATIONS@@UPDATE_DECLARATIONS@namespace {
namespace fs = std::filesystem;
static_assert(std::endian::native == std::endian::little &&
              sizeof(double) == 8 && std::numeric_limits<double>::is_iec559 &&
              sizeof(std::size_t) == 8);

struct ArrayPort {
    std::string_view id;
    std::int64_t rows;
    std::int64_t columns;
    bool output;
    std::size_t count() const { return rows * columns; }
};

constexpr std::array<ArrayPort, @ARRAY_COUNT@> arrays{{
    @ARRAYS@
}};
constexpr std::array<std::string_view, @SCALAR_COUNT@> scalars{{@SCALARS@}};
constexpr std::size_t output_count = @OUTPUT_COUNT@;

void require(bool ok, const char* message) {
    if (!ok) throw std::runtime_error(message);
}

class Descriptor {
    int fd_;
public:
    explicit Descriptor(int fd) : fd_(fd) { require(fd_ >= 0, "cannot open file"); }
    Descriptor(const Descriptor&) = delete;
    ~Descriptor() { if (fd_ >= 0) ::close(fd_); }
    int get() const { return fd_; }
    void close() {
        const int fd = fd_;
        fd_ = -1;
        require(::close(fd) == 0, "cannot close output file");
    }
};

template<class T>
T number(std::string_view value) {
    T result{};
    const auto [end, error] = std::from_chars(value.data(), value.data() + value.size(), result);
    require(error == std::errc{} && end == value.data() + value.size(), "invalid scalar value");
    return result;
}

struct Bindings {
    std::array<fs::path, arrays.size()> inputs;
    std::array<fs::path, arrays.size()> outputs;
    std::array<scar_scalar_v1, scalars.size()> values{};
};

Bindings bind(int argc, char* argv[]) {
    require(static_cast<std::size_t>(argc) == @BIND_COUNT@@ALTERNATE_BIND_COUNT@,
            "expected --in PORT FILE, --int/--float PORT VALUE, and --out PORT FILE triples");
    Bindings result;
    std::array<bool, scalars.size()> seen{};
    for (int index = 1; index < argc; index += 3) {
        const std::string_view flag = argv[index], id = argv[index + 1], value = argv[index + 2];
        require(!value.empty(), "empty port binding");
        if (flag == "--int" || flag == "--float") {
            const auto it = std::find(scalars.begin(), scalars.end(), id);
            require(it != scalars.end(), "unknown scalar port");
            const auto slot = it - scalars.begin();
@CHECK_SCALAR_INGRESS@            require(!seen[slot], "duplicate scalar binding");
            seen[slot] = true;
            if (flag == "--int") {
                constexpr auto limit = std::int64_t{1} << 53;
                const auto integer = number<std::int64_t>(value);
                require(integer >= -limit && integer <= limit, "scalar integer outside exact binary64 range");
                result.values[slot] = {static_cast<double>(integer), 1};
            } else {
                const auto floating = number<double>(value);
                require(std::isfinite(floating), "nonfinite scalar value");
                result.values[slot] = {floating, 0};
            }
            continue;
        }
        const auto it = std::find_if(arrays.begin(), arrays.end(),
                                     [id](const auto& port) { return port.id == id; });
        require(it != arrays.end(), "unknown array port");
        const auto slot = it - arrays.begin();
        if (flag == "--in") {
@CHECK_ARRAY_INGRESS@            require(result.inputs[slot].empty(), "duplicate array input binding");
            result.inputs[slot] = value;
        } else {
            require(flag == "--out" && it->output && result.outputs[slot].empty(), "invalid array output binding");
            const auto requested = fs::absolute(fs::path(value));
            require(!requested.filename().empty() && requested.filename() != "." && requested.filename() != "..",
                    "output must be a file");
            const auto output = fs::canonical(requested.parent_path()) / requested.filename();
            require(!fs::exists(fs::symlink_status(output)), "output already exists");
            require(std::find(result.outputs.begin(), result.outputs.end(), output) == result.outputs.end(),
                    "duplicate output path");
            result.outputs[slot] = output;
        }
    }
@CHECK_BINDINGS@    return result;
}

scar_array_v1 load(const fs::path& path, const ArrayPort& port, std::vector<double>& payload) {
    Descriptor input(::open(path.c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK));
    struct stat status{};
    const auto bytes = port.count() * sizeof(double);
    require(::fstat(input.get(), &status) == 0 && S_ISREG(status.st_mode) &&
            status.st_size >= 0 && static_cast<std::uint64_t>(status.st_size) == bytes,
            "input file is not the exact expected array size");
    payload.resize(port.count());
    auto* data = reinterpret_cast<char*>(payload.data());
    for (std::size_t done = 0; done < bytes;) {
        const auto amount = ::read(input.get(), data + done, std::min(bytes - done, std::size_t{1} << 20));
        if (amount < 0 && errno == EINTR) continue;
        require(amount > 0, "array input ended before expected size");
        done += amount;
    }
    char extra;
    ssize_t remaining;
    do {
        remaining = ::read(input.get(), &extra, 1);
    } while (remaining < 0 && errno == EINTR);
    require(remaining == 0, "array input has unexpected trailing bytes");
    const auto address = reinterpret_cast<std::uintptr_t>(data);
    return {data, 2, {port.rows, port.columns}, {port.columns * 8, 8}, address, address + bytes};
}

class PendingFile {
    fs::path destination_;
    std::string temporary_;
    bool staged_ = false;
    bool published_ = false;
public:
    explicit PendingFile(const fs::path& destination) : destination_(destination),
        temporary_((destination.parent_path() / ".scar-stateful-entry.XXXXXX").string()) {}
    ~PendingFile() {
        if (published_) ::unlink(destination_.c_str());
        if (staged_) ::unlink(temporary_.c_str());
    }
    void write(const std::vector<double>& values) {
        Descriptor file(::mkstemp(temporary_.data()));
        staged_ = true;
        const auto* data = reinterpret_cast<const char*>(values.data());
        const auto bytes = values.size() * sizeof(double);
        for (std::size_t done = 0; done < bytes;) {
            const auto amount = ::write(file.get(), data + done, std::min(bytes - done, std::size_t{1} << 20));
            if (amount < 0 && errno == EINTR) continue;
            require(amount > 0, "cannot stage array output");
            done += amount;
        }
        file.close();
    }
    void publish() {
        require(::link(temporary_.c_str(), destination_.c_str()) == 0, "cannot publish fresh output");
        published_ = true;
    }
    void keep() { published_ = false; }
};

void run(int argc, char* argv[]) {
@ENTRY_ARGUMENTS@
    const auto* table = scar_get_stateful_table_v1();
    require(table && table->run && table->abi_version == 1 && table->struct_size == sizeof(*table) &&
            table->array_count == arrays.size() && table->scalar_count == scalars.size() &&
            table->provider_count == @PROVIDER_COUNT@ && table->region_sha256 && table->plan_sha256 && table->contract_sha256 &&
            table->region_sha256 == std::string_view("@REGION_SHA256@") &&
            table->plan_sha256 == std::string_view("@PLAN_SHA256@") &&
            table->contract_sha256 == std::string_view("@CONTRACT_SHA256@"), "native table identity differs");

    std::array<std::vector<double>, arrays.size()> payloads;
    std::array<scar_array_v1, arrays.size()> descriptors{};
    for (std::size_t i = 0; i < arrays.size(); ++i) {
@MAY_INITIALIZE_ARRAY@        descriptors[i] = load(arguments.inputs[i], arrays[i], payloads[i]);
    }
@AFTER_ARRAYS_READY@@RUN_BODY@

    std::vector<std::unique_ptr<PendingFile>> pending;
    pending.reserve(output_count@UPDATE_OUTPUT_COUNT@);
    for (std::size_t i = 0; i < arrays.size(); ++i) {
        if (!arrays[i].output@OPTIONAL_ARRAY_OUTPUT@) continue;
        auto output = std::make_unique<PendingFile>(arguments.outputs[i]);
        output->write(payloads[i]);
        pending.push_back(std::move(output));
    }
@UPDATE_OUTPUT@    for (auto& output : pending) output->publish();
    for (auto& output : pending) output->keep();
@FINALIZE_EFFECTS@}
}

int main(int argc, char* argv[]) {
    try {
@MAIN_DISPATCH@
        return 0;
    }@MAIN_ARGV_ERROR@ catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
