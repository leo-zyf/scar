struct Prepared {
    void* handle = nullptr;
    ~Prepared() { scar_live_plot_destroy_v2(handle); }
};

int main(int argc, char** argv) {
    try {
        if (argc < 14 || (argc - 10) % 4 != 0)
            throw std::runtime_error("expected LAYOUT FONT BAD_LAYOUT SYMLINK STALE_PNG X OFF Y OFF (OUTPUT TIME Z OFF)+");
        Root x_storage(argv[6], argv[7], scar::live::root_shapes[0]);
        Root y_storage(argv[8], argv[9], scar::live::root_shapes[1]);
        const auto x = x_storage.descriptor(scar::live::root_shapes[0]);
        const auto y = y_storage.descriptor(scar::live::root_shapes[1]);
        std::array<char, 512> error{};
        Prepared rejected;
        if (!scar_live_plot_prepare_v2(&x, &y, argv[3], argv[2], &rejected.handle, error.data(), error.size()) ||
            rejected.handle || std::string_view(error.data()).find("digest differs") == std::string_view::npos)
            throw std::runtime_error("mutated layout did not fail before owner creation");
        if (!scar_live_plot_prepare_v2(&x, &y, argv[4], argv[2], &rejected.handle, error.data(), error.size()) ||
            rejected.handle || std::string_view(error.data()).find("cannot open") == std::string_view::npos)
            throw std::runtime_error("symlink layout did not fail before owner creation");
        Prepared owner;
        if (scar_live_plot_prepare_v2(&x, &y, argv[1], argv[2], &owner.handle, error.data(), error.size()))
            throw std::runtime_error(error.data());
        for (int start = 10; start < argc; start += 4) {
            Root z_storage(argv[start+2], argv[start+3], scar::live::root_shapes[2]);
            const auto z = z_storage.descriptor(scar::live::root_shapes[2]);
            std::size_t consumed{};
            const auto time = std::stod(argv[start+1], &consumed);
            if (consumed != std::string_view(argv[start+1]).size())
                throw std::runtime_error("invalid live render time");
            if (scar_live_plot_render_v2(owner.handle, &z, time, argv[start], error.data(), error.size()))
                throw std::runtime_error(error.data());
        }
        const auto stale = owner.handle;
        scar_live_plot_destroy_v2(stale);
        owner.handle = nullptr;
        scar_live_plot_destroy_v2(stale);
        if (scar_live_plot_prepare_v2(&x, &y, argv[1], argv[2], &owner.handle, error.data(), error.size()))
            throw std::runtime_error(error.data());
        auto z_storage = Root(argv[12], argv[13], scar::live::root_shapes[2]);
        auto z = z_storage.descriptor(scar::live::root_shapes[2]);
        if (owner.handle == stale ||
            !scar_live_plot_render_v2(stale, &z, 0., argv[5], error.data(), error.size()) ||
            std::string_view(error.data()).find("closed") == std::string_view::npos)
            throw std::runtime_error("closed owner could still render after another prepare");
        return 0;
    } catch (const std::exception& failure) {
        std::cerr << failure.what() << '\n';
        return 1;
    }
}
