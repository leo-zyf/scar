#pragma once

#include "scar_abi_v1.h"

#include <array>
#include <chrono>
#include <cstddef>
#include <cstdint>
#include <utility>

#define SCAR_PLOT_PHASE_DETAIL @PNG_DETAIL@

namespace scar::plot_phase {

enum class Phase : std::size_t {
    AssetReadVerify,
    FontSetup,
    CoordinatesPackGuard,
    Glyphs,
    ZPack,
    ContourScene,
    AggRaster,
    PngEncodePublish,
#if SCAR_PLOT_PHASE_DETAIL
    PngFilterSelection,
    PngDeflate,
    PngZlibLifecycle,
    PngTempIo,
    PngFinalPublish,
#endif
};

inline constexpr std::array names{
    "asset_read_verify", "font_setup", "coordinates_pack_guard", "glyphs",
    "z_pack", "contour_scene", "agg_raster", "png_encode_publish",
#if SCAR_PLOT_PHASE_DETAIL
    "png_filter_selection", "png_deflate", "png_zlib_lifecycle", "png_temp_io", "png_final_publish",
#endif
};
inline constexpr char backend[] = "@BACKEND@";
inline constexpr unsigned row_schema_version = 1 + SCAR_PLOT_PHASE_DETAIL;
using Clock = std::chrono::steady_clock;
static_assert(Clock::is_steady);

struct Metrics {
    std::array<std::uint64_t, names.size()> ns{}, count{};
};

class Scope {
    std::size_t phase_;
    Clock::time_point begin_;
    Scope* parent_;
    std::uint64_t children_ = 0;
public:
    explicit Scope(Phase phase) noexcept;
    Scope(const Scope&) = delete;
    ~Scope();
#if SCAR_PLOT_PHASE_DETAIL
    static void record_leaf(Phase phase, std::uint64_t elapsed) noexcept;
#endif
};

template<class Action>
decltype(auto) observe(Phase phase, Action&& action) {
    const Scope scope(phase);
    return std::forward<Action>(action)();
}

// Installed only in diagnostics. When SCAR_PLOT_PHASE_LOG is absent the
// sequence driver may still read counters without writing a process log.
class Operation {
    const char* name_;
    Metrics before_{};
    Clock::time_point begin_{};
    bool logging_;
    bool success_ = false;
public:
    explicit Operation(const char* name, bool active = true) noexcept;
    Operation(const Operation&) = delete;
    ~Operation();
    void success() noexcept { success_ = true; }
};

inline std::uint64_t nanoseconds(Clock::time_point begin, Clock::time_point end) noexcept {
    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(end - begin).count());
}

}

extern "C" SCAR_EXPORT_V1 void scar_plot_phase_reset_v1() noexcept;
extern "C" SCAR_EXPORT_V1 void scar_plot_phase_snapshot_v1(scar::plot_phase::Metrics* metrics) noexcept;
