
extern "C" __attribute__((visibility("default")))
int scar_recursive_driver_rebind_v2(scar_recursive_driver_v1* handle, const uint8_t* seed, std::size_t bytes) {
    if (!handle || !seed || bytes == 0) return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    try {
        World incoming;
        auto query = setup(std::string_view(reinterpret_cast<const char*>(seed), bytes), incoming, true);
        const auto version = choose_version(query.position);
        if (version != query.table || !incoming.@SCAR_HISTORY@.contains(query.position)) {
            return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
        }
        State root = query.position;
        // Capture stable references now. The new coroutine body starts on advance.
        auto next = drive(handle->world, tables[version], handle->query.position, handle->soft);
        static_assert(std::is_nothrow_move_assignable_v<Query>);
        static_assert(std::is_nothrow_move_assignable_v<State>);
        static_assert(noexcept(handle->world.@SCAR_HISTORY@.swap(incoming.@SCAR_HISTORY@)));
        static_assert(noexcept(handle->world.@SCAR_SCORE@.clear()));
        static_assert(std::is_nothrow_move_constructible_v<decltype(next)>);

        handle->stream.reset();
        handle->query = std::move(query);
        handle->world.@SCAR_DEADLINE@ = incoming.@SCAR_DEADLINE@;
        handle->world.@SCAR_HISTORY@.swap(incoming.@SCAR_HISTORY@);
        handle->world.@SCAR_NODES@ = 0;
        handle->world.@SCAR_ROOT@ = std::move(root);
        handle->world.@SCAR_SCORE@.clear();
@SCAR_CONFIGURATION@
        handle->world.deadline_reader = nullptr;
        handle->world.deadline_context = nullptr;
        handle->soft = 0;
        handle->stream.emplace(std::move(next));
        return SCAR_RECURSIVE_DRIVER_OK_V1;
    } catch (const Decline&) {
        return SCAR_RECURSIVE_DRIVER_DECLINED_V1;
    } catch (...) {
        return SCAR_RECURSIVE_DRIVER_INTERNAL_V1;
    }
}
