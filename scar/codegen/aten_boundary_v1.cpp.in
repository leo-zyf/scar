#include "aten_boundary_abi_v1.h"

#include <cstdio>
#include <cstdlib>
#include <exception>
#include <link.h>
#include <sched.h>
#include <sys/stat.h>
#include <unistd.h>

#define main scar_original_paired_trial_main
#include "measured-source.cpp"
#undef main
#include "adapter.hpp"

namespace {
constexpr std::int64_t selected_shape[] = {@SHAPE@};
constexpr std::int64_t selected_strides[] = {@STRIDES@};
constexpr int launch_cpus[] = {@LAUNCH_CPUS@};
constexpr scar::AtenBoundaryPlan selected{
    scar::aten_boundary_abi_version, scar::AtenMode::@MODE@, @CALLER@, @WORKER@, @INTRAOP@, @INTEROP@,
    selected_shape, selected_strides, @DTYPE@, @BOUNDARY@, @SOURCE_SHA@
};

struct MeasuredEnv { const char* key; std::string_view value; };
constexpr MeasuredEnv expected_env[] = {
@ENVIRONMENT@
};

struct ProviderFile {
    std::string_view path;
    std::uintmax_t device, inode, bytes;
    std::int64_t mtime_sec, mtime_nsec, ctime_sec, ctime_nsec;
    bool seen = false;
};
ProviderFile providers[] = {
@PROVIDERS@
};

int inspect_provider(dl_phdr_info* info, std::size_t, void*) {
    const std::string_view actual(info->dlpi_name);
    for (auto& provider : providers) {
        if (actual != provider.path) continue;
        struct stat state {};
        if (provider.seen || stat(info->dlpi_name, &state) != 0
                || static_cast<std::uintmax_t>(state.st_dev) != provider.device
                || static_cast<std::uintmax_t>(state.st_ino) != provider.inode
                || static_cast<std::uintmax_t>(state.st_size) != provider.bytes
                || state.st_mtim.tv_sec != provider.mtime_sec
                || state.st_mtim.tv_nsec != provider.mtime_nsec
                || state.st_ctim.tv_sec != provider.ctime_sec
                || state.st_ctim.tv_nsec != provider.ctime_nsec) return 1;
        provider.seen = true;
    }
    return 0;
}

bool admission() {
    cpu_set_t expected, actual;
    static_assert([] { for (int cpu : launch_cpus) if (cpu >= CPU_SETSIZE) return false; return true; }());
    CPU_ZERO(&expected);
    for (int cpu : launch_cpus) CPU_SET(cpu, &expected);
    if (sched_getaffinity(0, sizeof(actual), &actual) != 0 || !CPU_EQUAL(&expected, &actual)) return false;
    for (const auto& item : expected_env) {
        const char* value = std::getenv(item.key);
        if (value == nullptr || item.value != value) return false;
    }
    for (char** entry = environ; *entry != nullptr; ++entry) {
        if (std::string_view(*entry).starts_with("LD_")) return false;
    }
    if (dl_iterate_phdr(inspect_provider, nullptr) != 0) return false;
    for (const auto& provider : providers) if (!provider.seen) return false;
    return true;
}
}

int main(int argc, char**) {
    if (argc != 1 || !admission()) {
        std::fputs("SCAR ATen trial context differs from the sealed launch\n", stderr);
        return 78;
    }
    try {
        return scar_aten_boundary_main(selected);
    } catch (const std::exception& error) {
        std::fprintf(stderr, "SCAR ATen adapter failed: %s\n", error.what());
        return 1;
    }
}
