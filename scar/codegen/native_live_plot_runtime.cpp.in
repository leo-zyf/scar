#include "native_live_plot_abi_v1.h"
#include "live_plot_internal.hpp"
#include "live_plot_profile.hpp"

#include <cstring>

namespace {
std::vector<char> profile_bytes(const char* path, std::size_t size,
                                const std::array<unsigned char, 32>& expected) {
    require(path != nullptr, "missing native plot asset");
    std::ifstream input(path, std::ios::binary);
    std::vector<char> bytes(size);
    require(bool(input.read(bytes.data(), bytes.size())) && input.peek() == EOF && input.eof(),
            "native plot asset size differs");
    std::array<unsigned char, 32> hash{};
    unsigned int length{};
    require(EVP_Digest(bytes.data(), bytes.size(), hash.data(), &length, EVP_sha256(), nullptr) == 1 &&
            length == hash.size() && hash == expected, "native plot asset digest differs");
    return bytes;
}

std::vector<double> borrow_lattice(Tape& tape, const Grid& grid, const scar_array_v1& root) {
    const auto full_rows = tape.take<std::uint64_t>();
    const auto full_cols = tape.take<std::uint64_t>();
    const auto row = tape.take<std::uint64_t>();
    const auto col = tape.take<std::uint64_t>();
    require(full_rows && full_cols && full_rows <= limit / 8 / full_cols &&
            row <= full_rows && grid.rows <= full_rows - row &&
            col <= full_cols && grid.cols <= full_cols - col,
            "runtime root cannot contain original contour view");
    require(root.rank == 2 && root.shape[0] == static_cast<std::int64_t>(full_rows) &&
            root.shape[1] == static_cast<std::int64_t>(full_cols) && root.strides[1] == 8 &&
            root.strides[0] == static_cast<std::int64_t>(full_cols * 8),
            "runtime contour root shape or strides differ");
    const auto address = reinterpret_cast<std::uintptr_t>(root.data);
    require(root.data && address >= root.lower_bound && address <= root.upper_bound &&
            full_rows * full_cols * 8 <= root.upper_bound - address,
            "runtime contour root allocation does not cover the view");
    const auto* base = static_cast<const char*>(root.data);
    std::vector<double> result(grid.rows * grid.cols);
    for (std::size_t i = 0; i < grid.rows; ++i)
        std::memcpy(result.data() + i * grid.cols, base + ((row + i) * full_cols + col) * 8, grid.cols * 8);
    return result;
}

Grid live_grid(Tape& tape, const scar_array_v1& x, const scar_array_v1& y, const scar_array_v1& z) {
    Grid selected;
    selected.rows = tape.take<std::uint64_t>();
    selected.cols = tape.take<std::uint64_t>();
    selected.x_chunk_size = tape.take<std::uint64_t>();
    selected.y_chunk_size = tape.take<std::uint64_t>();
    const auto corner_mask = tape.take<std::uint64_t>();
    require(selected.rows > 1 && selected.cols > 1 && selected.rows <= limit / 24 / selected.cols &&
            corner_mask <= 1 && tape.take<std::uint64_t>() == 3, "invalid live contour geometry or roots");
    selected.corner_mask = corner_mask;
    selected.x = borrow_lattice(tape, selected, x);
    selected.y = borrow_lattice(tape, selected, y);
    selected.z = borrow_lattice(tape, selected, z);
    return selected;
}

void report_error(char* error, std::uint64_t capacity, const char* detail) noexcept {
    if (error && capacity) {
        const auto length = std::min<std::uint64_t>(capacity - 1, std::strlen(detail));
        std::memcpy(error, detail, length);
        error[length] = '\0';
    }
}
}

extern "C" int scar_live_plot_v1(const scar_array_v1* x, const scar_array_v1* y, const scar_array_v1* z,
    double time, const char* layout, const char* font, const char* output, char* error, std::uint64_t capacity) {
    try {
        require(x && y && z && output, "missing live plot roots or output");
        const auto source = profile_bytes(layout, scar::live::layout_size, scar::live::layout_hash);
        const auto face = profile_bytes(font, scar::live::font_size, scar::live::font_hash);
        const auto glyphs = scar::live::generate_glyphs(face, time);
        const auto scene = compose_scene(source, *x, *y, *z, glyphs);
        scar::live::render_scene(scene, output);
        report_error(error, capacity, "");
        return 0;
    } catch (const std::exception& failure) {
        report_error(error, capacity, failure.what());
    } catch (...) {
        report_error(error, capacity, "unknown native plot failure");
    }
    return 1;
}
