#include "scar_ordered_sparse_v1.hpp"

#include <array>
#include <bit>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <exception>
#include <filesystem>
#include <limits>
#include <signal.h>
#include <span>
#include <stdexcept>
#include <string_view>
#include <unistd.h>
#include <vector>

namespace {

namespace sparse = scar::ordered_sparse_v1;
namespace ordered = scar::ordered_v1;

static_assert(std::endian::native == std::endian::little && sizeof(int) == 4 && sizeof(double) == 8);
static_assert(std::numeric_limits<double>::is_iec559 && std::numeric_limits<int>::min() == INT32_MIN);
static_assert(sparse::size > 0 && sparse::nnz > 0 && sparse::count <= UINT32_MAX);

constexpr std::string_view recipe_hex = "@SCAR_RECIPE_DIGEST@";
static_assert(recipe_hex.size() == 64);

enum class Record : std::uint32_t {
    success = 0, worker_failure = 1, transport_failure = 2, protocol_failure = 3, end = 4, host_failure = 5,
};

struct InputFailure { const char* message; };
struct OutputFailure {};

constexpr void put_unsigned(std::span<std::byte> destination, std::uint64_t value) {
    for (auto& byte : destination) {
        byte = std::byte(value & 0xff);
        value >>= 8;
    }
}

constexpr std::uint64_t get_unsigned(std::span<const std::byte> source) {
    std::uint64_t value = 0;
    for (std::size_t i = source.size(); i != 0; --i) {
        value = (value << 8) | std::to_integer<unsigned>(source[i - 1]);
    }
    return value;
}

consteval unsigned digit(char character) {
    if ('0' <= character && character <= '9') {
        return character - '0';
    }
    if ('a' <= character && character <= 'f') {
        return character - 'a' + 10;
    }
    throw "invalid compiled recipe digest";
}

consteval std::array<std::byte, 56> header(std::string_view magic) {
    std::array<std::byte, 56> bytes{};
    for (std::size_t i = 0; i < 8; ++i) {
        bytes[i] = std::byte(magic[i]);
    }
    for (std::size_t i = 0; i < 32; ++i) {
        bytes[8 + i] = std::byte((digit(recipe_hex[2 * i]) << 4) | digit(recipe_hex[2 * i + 1]));
    }
    std::span<std::byte> fields(bytes);
    put_unsigned(fields.subspan(40, 4), sparse::size);
    put_unsigned(fields.subspan(44, 4), sparse::nnz);
    put_unsigned(fields.subspan(48, 4), sparse::count);
    return bytes;
}

constexpr auto input_header = header("@SCAR_INPUT_MAGIC@");
constexpr auto output_header = header("SCAROUT1");

void read_exact(std::span<std::byte> bytes, const char* incomplete) {
    while (!bytes.empty()) {
        const auto received = read(STDIN_FILENO, bytes.data(), bytes.size());
        if (received > 0) {
            bytes = bytes.subspan(static_cast<std::size_t>(received));
        } else if (received == 0) {
            throw InputFailure{incomplete};
        } else if (errno != EINTR) {
            throw InputFailure{"cannot read ordered sparse input"};
        }
    }
}

// A pipe producer must close stdin before the last request can be dispatched.
// It must supply the dispatch window without waiting for earlier responses.
void require_eof() {
    std::byte extra;
    ssize_t received;
    do {
        received = read(STDIN_FILENO, &extra, 1);
    } while (received < 0 && errno == EINTR);
    if (received != 0) {
        throw InputFailure{received < 0 ? "cannot verify ordered sparse EOF" : "extra ordered sparse request bytes"};
    }
}

void write_exact(std::span<const std::byte> bytes) {
    while (!bytes.empty()) {
        const auto written = write(STDOUT_FILENO, bytes.data(), bytes.size());
        if (written > 0) {
            bytes = bytes.subspan(static_cast<std::size_t>(written));
        } else if (written == 0 || errno != EINTR) {
            throw OutputFailure{};
        }
    }
}

void publish_record(std::uint64_t sequence, Record kind, std::int32_t status) {
    std::array<std::byte, 16> bytes;
    std::span<std::byte> fields(bytes);
    put_unsigned(fields.first<8>(), sequence);
    put_unsigned(fields.subspan<8, 4>(), static_cast<std::uint32_t>(kind));
    put_unsigned(fields.last<4>(), std::bit_cast<std::uint32_t>(status));
    write_exact(bytes);
}

void check_structure(std::span<const int> indices, std::span<const int> offsets) {
    if (offsets.front() != 0 || offsets.back() != sparse::nnz) {
        throw InputFailure{"ordered sparse CSR endpoints differ from the planned width"};
    }
    for (int row = 0; row < sparse::size; ++row) {
        const int start = offsets[row], stop = offsets[row + 1];
        if (start < 0 || stop < start || stop > sparse::nnz) {
            throw InputFailure{"invalid ordered sparse CSR row offsets"};
        }
        int previous = -1;
        for (int column = start; column < stop; ++column) {
            const int index = indices[column];
            if (index <= previous || index >= sparse::size) {
                throw InputFailure{"ordered sparse CSR columns must be sorted, unique and in range"};
            }
            previous = index;
        }
    }
}
