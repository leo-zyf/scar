#include "matrix_plan.hpp"
#include <cblas.h>

#include <algorithm>
#include <array>
#include <cerrno>
#include <cfenv>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <filesystem>
#include <memory>
#include <stdexcept>
#include <system_error>
#include <utility>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>

static_assert(sizeof(blasint) == 4 && sizeof(float) == 4);

struct File {
    int fd;
    explicit File(int fd) : fd(fd) {
        if (fd < 0) throw std::system_error(errno, std::generic_category(), "matrix file open");
    }
    File(const File&) = delete;
    File& operator=(const File&) = delete;
    ~File() { if (fd >= 0) ::close(fd); }

    void finish() {
        const int closed = std::exchange(fd, -1);
        if (::close(closed) != 0) throw std::system_error(errno, std::generic_category(), "matrix file close");
    }
};

using Buffer = std::unique_ptr<float[]>;
constexpr std::size_t chunk_bytes = 1 << 20;

Buffer load(const char* path, std::size_t bytes) {
    File file(::open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK));
    struct stat information{};
    if (::fstat(file.fd, &information) != 0 || !S_ISREG(information.st_mode)
            || information.st_size < 0 || static_cast<std::uint64_t>(information.st_size) != bytes) {
        throw std::runtime_error("matrix input needs its exact regular-file extent");
    }
    auto array = std::make_unique_for_overwrite<float[]>(bytes / sizeof(float));
    auto* content = reinterpret_cast<char*>(array.get());
    for (std::size_t position = 0; position < bytes;) {
        const auto received = ::read(file.fd, content + position, std::min(bytes - position, chunk_bytes));
        if (received < 0 && errno == EINTR) continue;
        if (received <= 0) throw std::runtime_error("matrix input changed while reading");
        position += static_cast<std::size_t>(received);
    }
    char trailing;
    ssize_t extra;
    do { extra = ::read(file.fd, &trailing, 1); } while (extra < 0 && errno == EINTR);
    if (extra != 0) throw std::runtime_error("matrix input changed while reading");
    return array;
}

void publish(const std::filesystem::path& path, const Buffer& matrix, std::size_t bytes) {
    File file(::open(path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0666));
    const auto* content = reinterpret_cast<const char*>(matrix.get());
    for (std::size_t position = 0; position < bytes;) {
        const auto written = ::write(file.fd, content + position, std::min(bytes - position, chunk_bytes));
        if (written < 0 && errno == EINTR) continue;
        if (written <= 0) throw std::runtime_error("matrix output write did not complete");
        position += static_cast<std::size_t>(written);
    }
    file.finish();
}

int main(int argc, char** argv) try {
    if (argc != 1 + matrix_plan::input_bytes.size() + matrix_plan::outputs.size()
            || std::fegetround() != FE_TONEAREST) {
        throw std::runtime_error("matrix entry requires its exact file ABI and normal FP32 rounding");
    }
    std::array<std::filesystem::path, matrix_plan::outputs.size()> destinations;
    for (std::size_t index = 0; index < destinations.size(); ++index) {
        const std::filesystem::path requested(argv[1 + matrix_plan::input_bytes.size() + index]);
        const auto folder = requested.has_parent_path() ? requested.parent_path() : std::filesystem::path(".");
        auto path = std::filesystem::canonical(folder) / requested.filename();
        if (std::filesystem::symlink_status(path).type() != std::filesystem::file_type::not_found
                || std::find(destinations.begin(), destinations.begin() + index, path) != destinations.begin() + index) {
            throw std::runtime_error("matrix output paths must be fresh and distinct");
        }
        destinations[index] = std::move(path);
    }
    openblas_set_num_threads(matrix_plan::threads);
    if (openblas_get_num_threads() != matrix_plan::threads) {
        throw std::runtime_error("matrix provider could not honor the planned thread count");
    }
    std::array<Buffer, matrix_plan::buffers> buffers;
    for (std::size_t index = 0; index < matrix_plan::input_bytes.size(); ++index) {
        buffers[index] = load(argv[1 + index], matrix_plan::input_bytes[index]);
    }
    for (std::size_t index = 0; index < matrix_plan::products.size(); ++index) {
        const auto& op = matrix_plan::products[index];
        auto result = std::make_unique_for_overwrite<float[]>(std::size_t(op.m) * op.n);
        cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasNoTrans, op.m, op.n, op.k, 1.0F,
                    buffers[op.left].get(), op.k, buffers[op.right].get(), op.n, 0.0F, result.get(), op.n);
        buffers[op.result] = std::move(result);
        for (auto rear = matrix_plan::release_offsets[index]; rear < matrix_plan::release_offsets[index + 1]; ++rear) {
            buffers[matrix_plan::releases[rear]].reset();
        }
    }
    for (std::size_t index = 0; index < matrix_plan::outputs.size(); ++index) {
        publish(destinations[index], buffers[matrix_plan::outputs[index]], matrix_plan::output_bytes[index]);
    }
    return 0;
} catch (const std::exception& error) {
    std::fprintf(stderr, "SCAR CPU matrix entry: %s\n", error.what());
    return 1;
}
