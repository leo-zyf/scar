#include <algorithm>
#include <array>
#include <bit>
#include <cfenv>
#include <complex>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <stdexcept>
#include <vector>

// Supply the header-only prerequisites and instantiate only the selected routines.
using npy_intp = std::intptr_t;
using npy_int64 = std::int64_t;
using npy_cfloat_wrapper = std::complex<float>;
using npy_cdouble_wrapper = std::complex<double>;
using npy_clongdouble_wrapper = std::complex<long double>;
constexpr npy_intp NPY_MAX_INTP = std::numeric_limits<npy_intp>::max();
#include "util.h"
#undef SPTOOLS_FOR_EACH_INDEX_DATA_TYPE_COMBINATION
#define SPTOOLS_FOR_EACH_INDEX_DATA_TYPE_COMBINATION(instantiate)
#include "coo.h"
#include "csr.h"
#undef SPTOOLS_FOR_EACH_INDEX_DATA_TYPE_COMBINATION

namespace {
using Index = std::int32_t;
using Scalar = double;
static_assert(std::endian::native == std::endian::little && sizeof(Scalar) == 8);
constexpr Index dimension = @DIMENSION@;
constexpr Index csr_count = @CSR_COUNT@;
constexpr Index matrix_count = @MATRIX_COUNT@;
constexpr Index rhs_count = @RHS_COUNT@;
constexpr Index boundary_count = @BOUNDARY_COUNT@;
constexpr std::array<unsigned char, 76> ingress = {@INGRESS@};
constexpr std::size_t coarse_header_bytes = 20;

template<class T>
void read_exact(T* data, std::size_t count) {
    if (std::fread(data, sizeof(T), count, stdin) != count) {
        throw std::runtime_error("incomplete COO input");
    }
}

template<class T>
void write_exact(const T* data, std::size_t count) {
    if (std::fwrite(data, sizeof(T), count, stdout) != count) {
        throw std::runtime_error("cannot publish canonical CSR input");
    }
}

bool valid_indices(const std::vector<Index>& indices) {
    return std::all_of(indices.begin(), indices.end(), [](Index value) {
        return value >= 0 && value < dimension;
    });
}

void run() {
    std::array<unsigned char, ingress.size()> header{};
    read_exact(header.data(), header.size());
    if (header != ingress) {
        throw std::runtime_error("COO input differs from the compiled wire profile");
    }
    std::vector<Index> rows(matrix_count), cols(matrix_count), rhs_rows(rhs_count), constraints(boundary_count);
    std::vector<Scalar> values(matrix_count), rhs_values(rhs_count);
    read_exact(rows.data(), rows.size());
    read_exact(cols.data(), cols.size());
    read_exact(values.data(), values.size());
    read_exact(rhs_rows.data(), rhs_rows.size());
    read_exact(rhs_values.data(), rhs_values.size());
    read_exact(constraints.data(), constraints.size());
    if (std::fgetc(stdin) != EOF || std::ferror(stdin)
            || !valid_indices(rows) || !valid_indices(cols)
            || !valid_indices(rhs_rows) || !valid_indices(constraints)) {
        throw std::runtime_error("COO ingress has invalid indices or trailing input");
    }
    if (std::fesetenv(FE_DFL_ENV) != 0) {
        throw std::runtime_error("cannot establish the default floating-point environment");
    }

    // Preserve the input order selected by COO's zero filter. The two
    // summations, including their duplicate visitation order, are upstream.
    Index kept = 0;
    for (Index index = 0; index < matrix_count; ++index) {
        if (values[index] != 0.0) {
            rows[kept] = rows[index];
            cols[kept] = cols[index];
            values[kept] = values[index];
            ++kept;
        }
    }
    std::vector<Index> offsets(dimension + 1), indices(kept), rhs_cols(rhs_count, 0);
    std::vector<Scalar> csr(kept), rhs(dimension, 0.0);
    coo_tocsr(dimension, dimension, kept, rows.data(), cols.data(), values.data(),
             offsets.data(), indices.data(), csr.data());
    if (!csr_has_sorted_indices(dimension, offsets.data(), indices.data())) {
        csr_sort_indices(dimension, offsets.data(), indices.data(), csr.data());
    }
    csr_sum_duplicates(dimension, dimension, offsets.data(), indices.data(), csr.data());
    if (offsets.back() != csr_count) {
        throw std::runtime_error("assembled CSR does not fit the selected solver contract");
    }
    coo_todense(dimension, Index{1}, rhs_count, rhs_rows.data(), rhs_cols.data(),
               rhs_values.data(), rhs.data(), 1);

    write_exact(header.data() + coarse_header_bytes, header.size() - coarse_header_bytes);
    write_exact(indices.data(), csr_count);
    write_exact(offsets.data(), offsets.size());
    write_exact(csr.data(), csr_count);
    write_exact(rhs.data(), rhs.size());
    write_exact(&boundary_count, 1);
    write_exact(constraints.data(), constraints.size());
    if (std::fflush(stdout) != 0) {
        throw std::runtime_error("cannot flush canonical CSR input");
    }
}
}

int main() {
    try {
        run();
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
