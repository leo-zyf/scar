@SCAR_COMBINED_SOURCE@

@SCAR_LEAVES@

#include "scalar_recursive_runtime.hpp"
#include <bit>
#include <cmath>
#include <iostream>
#include <iterator>
#include <sstream>

namespace {
@SCAR_BODY@

void publish(bool value) { std::cout << (value ? 1 : 0) << '\n'; }
void publish(Integer value) { std::cout << value << '\n'; }
void publish(double value) { std::cout << std::bit_cast<std::uint64_t>(value) << '\n'; }
void publish(const std::string& value) {
    constexpr std::string_view digits = "0123456789abcdef";
    for (const auto byte : value) {
        const auto index = static_cast<unsigned char>(byte);
        std::cout << digits[index >> 4] << digits[index & 15];
    }
    std::cout << '\n';
}
template<class... Value>
void publish(const std::tuple<Value...>& values) {
    std::apply([](const auto&... item) { (publish(item), ...); }, values);
}
void publish(const History& value) {
    // Python history is a set, body uses only exact membership.
    publish(checked_size(value.size()));
    std::vector<State> ordered_set(value.begin(), value.end());
    std::sort(ordered_set.begin(), ordered_set.end());
    for (const auto& key : ordered_set) publish(key);
}
template<class K, class V>
void publish(const scar::native::OrderedMap<K,V,TupleHash>& value) {
    publish(checked_size(value.size()));
    value.for_each([](const auto& key, const auto& item) { publish(key); publish(item); });
}

void publish_state(const World& world) {
@SCAR_PUBLISH_FIELDS@
}

struct Query {
    std::size_t table;
    State position;
    Integer threshold;
    Integer depth;
    bool root;
};

std::string line(std::istream& input) {
    std::string text;
    if (!std::getline(input, text)) throw Decline{};
    return text;
}

unsigned digit(char ch) {
    if ('0' <= ch && ch <= '9') return ch - '0';
    if ('a' <= ch && ch <= 'f') return ch - 'a' + 10;
    throw Decline{};
}

template<class Value>
Value receive(std::istream& input) {
    if constexpr (std::is_same_v<Value,Integer>) return parse_integer(line(input));
    else if constexpr (std::is_same_v<Value,bool>) return parse_bool(line(input));
    else if constexpr (std::is_same_v<Value,double>) {
        const auto text = line(input);
        std::uint64_t bits{};
        const auto result = std::from_chars(text.data(), text.data() + text.size(), bits);
        if (result.ec != std::errc{} || result.ptr != text.data() + text.size()) throw Decline{};
        const auto value = std::bit_cast<double>(bits);
        if (!std::isfinite(value)) throw Decline{};
        return value;
    } else if constexpr (std::is_same_v<Value,std::string>) {
        const auto text = line(input);
        if (text.size() % 2 != 0) throw Decline{};
        std::string recovered;
        recovered.reserve(text.size() / 2);
        for (std::size_t i = 0; i < text.size(); i += 2) {
            const auto value = digit(text[i]) * 16 + digit(text[i+1]);
            if (value == 0 || value > 127) throw Decline{};
            recovered += static_cast<char>(value);
        }
        return recovered;
    } else {
        return [&]<std::size_t... Port>(std::index_sequence<Port...>) {
            return Value{receive<std::tuple_element_t<Port,Value>>(input)...};
        }(std::make_index_sequence<std::tuple_size_v<Value>>{});
    }
}

template<class Value>
void receive_field(std::istream& input, Value& out) {
    out = receive<Value>(input);
}

void receive_field(std::istream& input, History& out) {
    const auto count = receive<Integer>(input);
    if (count < 0) throw Decline{};
    for (Integer i = 0; i < count; ++i) {
        if (!out.insert(receive<State>(input)).second) throw Decline{};
    }
}

template<class K,class V>
void receive_field(std::istream& input, scar::native::OrderedMap<K,V,TupleHash>& out) {
    const auto count = receive<Integer>(input);
    if (count < 0) throw Decline{};
    for (Integer i = 0; i < count; ++i) {
        const auto key = receive<K>(input);
        const auto item = receive<V>(input);
        if (!out.insert_or_assign(key, item)) throw Decline{};
    }
}

Query setup(std::string_view payload, World& world) {
    std::istringstream input{std::string(payload)};
    if (line(input) != "SCAR_RECURSIVE_INPUT_V1") throw Decline{};
    const auto version = line(input);
    const auto table = std::find_if(tables.begin(), tables.end(), [&](const Table& candidate) {
        return candidate.version == version;
    });
    if (table == tables.end()) throw Decline{};
    const Query query{static_cast<std::size_t>(table - tables.begin()), receive<State>(input),
                      receive<Integer>(input), receive<Integer>(input), receive<bool>(input)};
@SCAR_RECEIVE_FIELDS@
    if (input.peek() != std::char_traits<char>::eof()) throw Decline{};
    return query;
}

int execute(std::string_view payload, Integer repetitions, bool display) {
    if (repetitions < 1 || repetitions > 4096) throw Decline{};
    std::chrono::nanoseconds total{0};
    Integer stopped_count = 0;
    Integer result_checksum = 0;
    for (Integer i = 0; i < repetitions; ++i) {
        World world;
        const auto query = setup(payload, world);
        const auto start = std::chrono::steady_clock::now();
        std::optional<Integer> result;
        try {
            result = recurse(world, tables[query.table], query.position, query.threshold, query.depth, query.root);
        } catch (const SourceStop&) {
            ++stopped_count;
        }
        total += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start);
        if (result) result_checksum = add(result_checksum, *result);
        if (display) {
            std::cout << "SCAR_RECURSION_V1\n";
            if (result) { std::cout << "return\n"; publish(*result); }
            else std::cout << "stop\n";
            publish_state(world);
        }
    }
    if (!display) {
        std::cout << total.count() << ' ' << stopped_count << ' ' << result_checksum << '\n';
    }
    return std::cout ? 0 : 1;
}
}  // namespace

int main(int argc, char** argv) {
    try {
        const std::string payload{std::istreambuf_iterator<char>(std::cin), std::istreambuf_iterator<char>()};
        if (argc == 1) return execute(payload, 1, true);
        if (argc == 2) return execute(payload, parse_integer(argv[1]), false);
    } catch (const Decline&) {
    }
    std::fputs("recursive case fell outside its typed source domain\n", stderr);
    return 2;
}
