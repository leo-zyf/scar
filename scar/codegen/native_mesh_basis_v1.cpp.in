#include <ATen/Parallel.h>
#include <ATen/ops/abs.h>
#include <ATen/ops/add.h>
#include <ATen/ops/div.h>
#include <ATen/ops/empty.h>
#include <ATen/ops/isfinite.h>
#include <ATen/ops/mul.h>
#include <ATen/ops/neg.h>
#include <ATen/ops/stack.h>
#include <ATen/ops/sub.h>
#include <ATen/ops/zeros_like.h>

#include <array>
#include <bit>
#include <cfenv>
#include <cstdint>
#include <cstdio>
#include <stdexcept>

namespace {
constexpr std::int64_t vertices = @SCAR_VERTICES@;
constexpr std::int64_t cells = @SCAR_CELLS@;
constexpr std::int64_t points = @SCAR_POINTS@;
constexpr std::int64_t constraints = @SCAR_CONSTRAINTS@;
constexpr std::array<unsigned char, 120> input_header{@SCAR_HEADER@};
@SCAR_OUTPUT_HEADER_DECLARATION@static_assert(std::endian::native == std::endian::little && sizeof(double) == 8);

at::Tensor read_tensor(at::IntArrayRef shape, at::ScalarType type) {
    auto value = at::empty(shape, at::TensorOptions().device(at::kCPU).dtype(type));
    const auto bytes = value.nbytes();
    if (std::fread(value.data_ptr(), 1, bytes, stdin) != bytes) {
        throw std::runtime_error("incomplete mesh or reference-element operand");
    }
    if (type == at::kDouble && !at::isfinite(value).all().item<bool>()) {
        throw std::runtime_error("nonfinite mesh or reference-element operand");
    }
    return value;
}

void write_bytes(const void* data, std::size_t size) {
    if (std::fwrite(data, 1, size, stdout) != size) {
        throw std::runtime_error("cannot publish canonical Basis operands");
    }
}

void write_tensor(const at::Tensor& tensor) {
    const auto value = tensor.contiguous();
    write_bytes(value.const_data_ptr(), value.nbytes());
}

void run() {
    at::set_num_threads(1);
    at::set_num_interop_threads(1);
    if (std::fesetenv(FE_DFL_ENV) != 0) {
        throw std::runtime_error("cannot establish the qualified binary64 environment");
    }
    std::array<unsigned char, input_header.size()> observed;
    if (std::fread(observed.data(), 1, observed.size(), stdin) != observed.size() || observed != input_header) {
        throw std::runtime_error("mesh and Basis envelope differs from its admitted geometry");
    }
    const auto coordinates = read_tensor({2, vertices}, at::kDouble);
    const auto connectivity = read_tensor({3, cells}, at::kInt);
    const auto reference_value = read_tensor({3, points}, at::kDouble);
    const auto reference_gradient = read_tensor({3, 2, points}, at::kDouble);
    const auto reference_weights = read_tensor({points}, at::kDouble);
    const auto selected_rows = read_tensor({constraints}, at::kInt);
    if (std::fgetc(stdin) != EOF || std::ferror(stdin)) {
        throw std::runtime_error("mesh input has extra bytes or a read error");
    }

    const auto corners = coordinates.index_select(1, connectivity.reshape({-1}).to(at::kLong)).reshape({2, 3, cells});
    const auto origin = corners.select(1, 0);
    const auto edge1 = at::sub(corners.select(1, 1), origin);
    const auto edge2 = at::sub(corners.select(1, 2), origin);
    const auto a = edge1.select(0, 0), b = edge2.select(0, 0);
    const auto c = edge1.select(0, 1), d = edge2.select(0, 1);
    const auto determinant = at::sub(at::mul(a, d), at::mul(b, c));
    if (!at::isfinite(determinant).all().item<bool>() || determinant.eq(0.0).any().item<bool>()) {
        throw std::runtime_error("nonfinite or degenerate affine element");
    }
    const auto first = at::stack({at::div(d, determinant), at::div(at::neg(b), determinant)}).unsqueeze(0).unsqueeze(-1);
    const auto second = at::stack({at::div(at::neg(c), determinant), at::div(a, determinant)}).unsqueeze(0).unsqueeze(-1);
    const auto first_term = at::mul(first, reference_gradient.select(1, 0).unsqueeze(1).unsqueeze(2));
    const auto second_term = at::mul(second, reference_gradient.select(1, 1).unsqueeze(1).unsqueeze(2));
    const auto gradients = at::add(at::add(at::zeros_like(first_term), first_term), second_term);
    @SCAR_VALUE_VIEW@;
    const auto weights = at::mul(at::abs(determinant).unsqueeze(-1), reference_weights);

    @SCAR_OUTPUT_HEADER_WRITE@;
    write_tensor(gradients);
    write_tensor(values);
    write_tensor(weights);
    write_tensor(connectivity);
    write_tensor(selected_rows);
    if (std::fflush(stdout) != 0) {
        throw std::runtime_error("cannot flush canonical Basis operands");
    }
}
}  // namespace

int main() {
    try {
        run();
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
