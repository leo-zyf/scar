#include "scar_scalar_transition_resident_v1.h"
#include <cstring>

@SCAR_COMPUTATION@

@SCAR_TRANSPORT@

[[maybe_unused]] std::string read_text(const uint8_t* bytes, std::size_t size, std::size_t capacity) {
    if (size > capacity) {
        throw Decline{};
    }
    const std::string_view text(reinterpret_cast<const char*>(bytes), size);
    if (!ascii(text) || text.find('\0') != std::string_view::npos) {
        throw Decline{};
    }
    return std::string(text);
}

[[maybe_unused]] bool read_bool(Integer value) {
    if (value != 0 && value != 1) {
        throw Decline{};
    }
    return value != 0;
}

[[maybe_unused]] void write_text(uint8_t* destination, uint32_t& length, std::size_t capacity,
                                 const std::string& text) {
    if (text.size() > capacity) {
        throw Decline{};
    }
    std::memcpy(destination, text.data(), text.size());
    length = static_cast<uint32_t>(text.size());
}

}  // namespace

extern "C" __attribute__((visibility("default")))
int scar_resident_transition_v1(uint32_t table_slot, const scar_resident_input_v1* input,
    const scar_resident_score_v1* score, scar_resident_output_v1* output) {
    if (!input || !output || table_slot >= tables.size()) {
        return SCAR_RESIDENT_DECLINED_V1;
    }
    try {
        const auto& table = tables[table_slot];
@SCAR_INPUT_SETUP@
@SCAR_EVALUATION@
        scar_resident_output_v1 staged;
        std::memset(&staged, 0, sizeof(staged));
@SCAR_OUTPUT_SETUP@
        std::memcpy(output, &staged, sizeof(staged));
        return use_score ? SCAR_RESIDENT_TRANSPORTED_V1 : SCAR_RESIDENT_NATIVE_V1;
    } catch (const Decline&) {
        return SCAR_RESIDENT_DECLINED_V1;
    } catch (...) {
        return SCAR_RESIDENT_INTERNAL_ERROR_V1;
    }
}
