class DigestPublication {
public:
    DigestPublication()
        : library_(open_provider(), dlclose), update_(symbol<decltype(&EVP_DigestUpdate)>("EVP_DigestUpdate")),
          finalize_(symbol<decltype(&EVP_DigestFinal_ex)>("EVP_DigestFinal_ex")),
          context_(nullptr, symbol<decltype(&EVP_MD_CTX_free)>("EVP_MD_CTX_free")) {
        const auto initialize = symbol<decltype(&OPENSSL_init_crypto)>("OPENSSL_init_crypto");
        if (initialize(OPENSSL_INIT_NO_LOAD_CONFIG, nullptr) != 1) {
            throw std::runtime_error("cannot initialize bundled OpenSSL SHA-256 provider");
        }
        context_.reset(symbol<decltype(&EVP_MD_CTX_new)>("EVP_MD_CTX_new")());
        const auto sha256 = symbol<decltype(&EVP_sha256)>("EVP_sha256");
        const auto start = symbol<decltype(&EVP_DigestInit_ex)>("EVP_DigestInit_ex");
        if (!context_ || start(context_.get(), sha256(), nullptr) != 1) {
            throw std::runtime_error("cannot initialize ordered SHA-256 digest");
        }
    }

    void append(std::span<const std::byte> row) {
        if (row.size() != sparse::result_bytes || update_(context_.get(), row.data(), row.size()) != 1) {
            throw std::runtime_error("cannot hash one complete ordered solution");
        }
    }

    void complete() {
        std::array<unsigned char, 32> digest{};
        unsigned int size = 0;
        if (finalize_(context_.get(), digest.data(), &size) != 1 || size != digest.size()) {
            throw std::runtime_error("ordered SHA-256 result is incomplete");
        }
        constexpr std::string_view hex = "0123456789abcdef";
        std::array<std::byte, 65> line;
        for (std::size_t index = 0; index < digest.size(); ++index) {
            line[2 * index] = std::byte(hex[digest[index] >> 4]);
            line[2 * index + 1] = std::byte(hex[digest[index] & 15]);
        }
        line.back() = std::byte{'\n'};
        write_exact(line);
    }

private:
    static void* open_provider() {
        const auto root = std::filesystem::canonical("/proc/self/exe").parent_path();
        void* handle = dlopen((root / @SCAR_CRYPTO_PATH@).c_str(), RTLD_NOW | RTLD_LOCAL);
        if (!handle) {
            throw std::runtime_error("cannot load bundled OpenSSL SHA-256 provider");
        }
        return handle;
    }

    template<class Symbol>
    Symbol symbol(const char* name) const {
        auto result = reinterpret_cast<Symbol>(dlsym(library_.get(), name));
        if (!result) {
            throw std::runtime_error("bundled OpenSSL lacks an ordered SHA-256 symbol");
        }
        return result;
    }

    std::unique_ptr<void, int (*)(void*)> library_;
    decltype(&EVP_DigestUpdate) update_;
    decltype(&EVP_DigestFinal_ex) finalize_;
    std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> context_;
};

void publish_digest_failure(std::uint64_t sequence, Record kind, std::int32_t status) {
    std::fprintf(stderr, "ordered digest stopped at %llu (kind=%u, status=%d)\n",
        static_cast<unsigned long long>(sequence), static_cast<unsigned int>(kind), status);
}

void require_record(std::uint64_t sequence, Record kind) {
    std::array<std::byte, 16> frame;
    read_exact(frame, "incomplete binary solve record for digest publication");
    std::span<const std::byte> fields(frame);
    if (get_unsigned(fields.first<8>()) != sequence || get_unsigned(fields.subspan<8, 4>()) != unsigned(kind)
            || get_unsigned(fields.last<4>()) != 0) {
        throw InputFailure{"binary solve record is out of order, failed, or incomplete"};
    }
}

int consume_binary_results() {
    auto observed = output_header;
    read_exact(observed, "incomplete binary solve header for digest publication");
    if (observed != output_header) {
        throw InputFailure{"binary solve header differs from the compiled recipe"};
    }
    DigestPublication publication;
    std::vector<std::byte> solution(sparse::result_bytes);
    for (std::uint64_t sequence = 0; sequence < sparse::count; ++sequence) {
        require_record(sequence, Record::success);
        read_exact(solution, "incomplete binary solution for digest publication");
        publication.append(solution);
    }
    require_record(sparse::count, Record::end);
    require_eof();
    publication.complete();
    return 0;
}
