#include "scar_sparse_runtime_count.hpp"

#include <array>
#include <cerrno>
#include <filesystem>
#include <iostream>
#include <string>
#include <system_error>
#include <utility>
#include <unistd.h>

int main(int argc, char** argv) {
    try {
        if (argc != 2) {
            throw std::runtime_error("expected exactly one runtime iteration count");
        }
        const auto count = scar_runtime_count(argv[1]);
        constexpr std::array<std::pair<std::uint32_t, unsigned>, @OVERRIDE_COUNT@> overrides{{@OVERRIDES@}};
        unsigned width = @DEFAULT_WIDTH@;
        for (const auto& [known_count, known_width] : overrides) {
            if (count == known_count) {
                width = known_width;
                break;
            }
        }
        const auto root = std::filesystem::read_symlink("/proc/self/exe").parent_path().parent_path();
        auto executable = (root / "arms" / std::to_string(width) / "scar_sparse_parameterized").string();
        argv[0] = executable.data();
        ::execv(executable.c_str(), argv);
        throw std::system_error(errno, std::generic_category(), "execv");
    } catch (const std::exception& error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
