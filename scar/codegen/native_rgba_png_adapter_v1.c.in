/* Adapter for the retained Pillow C codec. It owns no Python objects or locks. */
#include "Imaging.h"
#include "ZipCodecs.h"

void ImagingSectionEnter(ImagingSectionCookie* cookie) { (void)cookie; }
void ImagingSectionLeave(ImagingSectionCookie* cookie) { (void)cookie; }

static void copy_row(UINT8* destination, const UINT8* source, int width) {
    memcpy(destination, source, (size_t)width * 4);
}

int scar_rgba_png_idat_v1(const void* rgba, int width, int height,
                        void* emitter, void (*emit)(void*, const unsigned char*, unsigned int)) {
    char** rows = malloc(sizeof(*rows) * height);
    const unsigned int block = width * 4 > 65536 ? width * 4 : 65536;
    UINT8* buffer = malloc(block);
    if (!rows || !buffer) {
        free(rows);
        free(buffer);
        return 1;
    }
    for (int y = 0; y < height; ++y) {
        rows[y] = (char*)rgba + (size_t)y * width * 4;
    }
    struct ImagingMemoryInstance image = {0};
    image.pixelsize = 4;
    image.image = rows;

    ZIPSTATE options = {0};
    options.mode = ZIP_PNG;
    options.compress_level = -1;
    options.compress_type = -1;
    struct ImagingCodecStateInstance codec = {0};
    codec.bits = 32;
    codec.bytes = width * 4;
    codec.xsize = width;
    codec.ysize = height;
    codec.shuffle = copy_row;
    codec.context = &options;
    int wrote;
    do {
        wrote = ImagingZipEncode(&image, &codec, buffer, block);
        if (wrote < 0) break;
        emit(emitter, buffer, wrote);
    } while (codec.errcode == 0);

    free(codec.buffer);
    free(buffer);
    free(rows);
    return wrote < 0 || codec.errcode != IMAGING_CODEC_END;
}
