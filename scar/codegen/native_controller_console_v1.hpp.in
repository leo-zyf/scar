#pragma once

#include "controller_effect_abi_v1.h"

#include <array>
#include <cerrno>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <fcntl.h>
#include <stdexcept>
#include <stdio_ext.h>
#include <sys/stat.h>
#include <unistd.h>
#include <utility>

class ControllerConsoleOverlay {
    static constexpr std::uint32_t selected = @ORDINAL@;
    static constexpr std::size_t capacity = @CAPACITY@;
    static constexpr int sink_changed = -20;
    static constexpr int invalid_text = -21;
    static constexpr int capacity_exceeded = -22;
    static constexpr int write_failed = -23;
    static constexpr int finished = -24;

    std::FILE* stream_;
    struct stat initial_{};
    std::array<char, capacity> pending_;
    std::size_t size_ = 0;
    bool finished_ = false;

    bool inspect(struct stat& state) const noexcept {
        if (!stream_ || ::fileno(stream_) != STDOUT_FILENO ||
            std::ferror(stream_) || ::__fpending(stream_) != 0) return false;
        if (::fstat(STDOUT_FILENO, &state) != 0 || !S_ISREG(state.st_mode) || state.st_size != 0) return false;
        const int flags = ::fcntl(STDOUT_FILENO, F_GETFL);
        return flags >= 0 && (flags & O_ACCMODE) != O_RDONLY && ::lseek(STDOUT_FILENO, 0, SEEK_CUR) == 0;
    }

    int append(const scar_controller_value_v1* arguments, std::uint64_t count) noexcept {
        if (finished_) return finished;
        if (!arguments || count != 1 || arguments->kind != SCAR_CONTROLLER_UTF8_V1 ||
            arguments->reserved != 0 || (!arguments->text && arguments->text_size != 0)) return invalid_text;
        const auto length = arguments->text_size;
        if (length >= capacity - size_) return capacity_exceeded;
        for (std::size_t i = 0; i < length; ++i) {
            if (static_cast<unsigned char>(arguments->text[i]) > 0x7f) return invalid_text;
        }
        if (length) std::memcpy(pending_.data() + size_, arguments->text, length);
        size_ += length;
        pending_[size_++] = '\n';
        return 0;
    }

public:
    explicit ControllerConsoleOverlay(std::FILE* stream) : stream_(stream) {
        static_assert(capacity > 0 && capacity < 8192);
        if (!inspect(initial_)) throw std::runtime_error("native console requires an exclusive empty regular stdout file");
    }

    ControllerConsoleOverlay(const ControllerConsoleOverlay&) = delete;
    ControllerConsoleOverlay& operator=(const ControllerConsoleOverlay&) = delete;

    template<class Delegate>
    int dispatch(std::uint32_t ordinal, const scar_controller_value_v1* arguments, std::uint64_t argument_count,
                 const scar_array_v1* roots, std::uint64_t root_count, Delegate&& forward) {
        if (ordinal == selected) return append(arguments, argument_count);
        return std::forward<Delegate>(forward)(ordinal, arguments, argument_count, roots, root_count);
    }

    int finish() noexcept {
        if (finished_) return finished;
        finished_ = true;
        struct stat actual{};
        if (!inspect(actual) || actual.st_dev != initial_.st_dev || actual.st_ino != initial_.st_ino)
            return sink_changed;
        if (!size_) return 0;
        ssize_t result;
        do {
            result = ::write(STDOUT_FILENO, pending_.data(), size_);
        } while (result < 0 && errno == EINTR);
        return result == static_cast<ssize_t>(size_) ? 0 : write_failed;
    }
};
