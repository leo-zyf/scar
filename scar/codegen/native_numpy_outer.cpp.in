#include "numpy_complex.hpp"
#include "numpy_outer.hpp"

#include <array>
#include <cfenv>
#include <cstdint>
#include <limits>
#include <string_view>

namespace {
using Triplet = std::array<std::int64_t, 3>;

struct Profile {
    std::string_view name;
    scar_numpy_outer_layout_v1 layout;
    std::int64_t count, repeats;
    Triplet offsets, strides, advance;
};

@PROFILES@

const Profile* lookup(const char* name) noexcept {
    if (name) {
        for (const auto& profile : profiles) {
            if (profile.name == name) return &profile;
        }
    }
    return nullptr;
}

struct Extent { std::uintptr_t first{}, last{}; };

bool extent(const void* pointer, std::size_t bytes, std::size_t residue, Extent& result) noexcept {
    const auto first = reinterpret_cast<std::uintptr_t>(pointer);
    if (!first || first % 64 != residue || !bytes || bytes > std::numeric_limits<std::uintptr_t>::max() - first)
        return false;
    result = {first, first + bytes};
    return true;
}

bool disjoint(Extent a, Extent b) noexcept {
    return a.last <= b.first || b.last <= a.first;
}
}

extern "C" int scar_numpy_outer_query_v1(const char* name, scar_numpy_outer_layout_v1* layout) noexcept {
    const auto* profile = lookup(name);
    if (!profile || !layout) return 1;
    *layout = profile->layout;
    return 0;
}

extern "C" int scar_numpy_outer_apply_v1(
    const char* name, const void* left, std::size_t left_bytes, const void* right, std::size_t right_bytes,
    void* unpublished, std::size_t output_bytes) noexcept {
    const auto* profile = lookup(name);
    if (!profile || !scar_numpy_complex_runtime_supported()) return 1;
    const auto& layout = profile->layout;
    Extent a, b, destination;
    if (left_bytes != layout.left_bytes || right_bytes != layout.right_bytes || output_bytes != layout.output_bytes ||
            !extent(left, left_bytes, layout.left_residue, a) || !extent(right, right_bytes, layout.right_residue, b) ||
            !extent(unpublished, output_bytes, layout.output_residue, destination) ||
            !disjoint(a, destination) || !disjoint(b, destination)) return 1;

    std::fenv_t saved{}, ignored{};
    if (std::fegetenv(&saved) != 0) return 1;
    if (std::feholdexcept(&ignored) != 0) {
        std::fesetenv(&saved);
        return 1;
    }
    const std::array<char*, 3> roots{
        const_cast<char*>(static_cast<const char*>(left)), const_cast<char*>(static_cast<const char*>(right)),
        static_cast<char*>(unpublished)
    };
    for (std::int64_t group = 0; group < profile->repeats; ++group) {
        char* operands[3];
        for (unsigned role = 0; role < roots.size(); ++role) {
            operands[role] = roots[role] + profile->offsets[role] + group * profile->advance[role];
        }
        scar_numpy_complex_multiply(operands, &profile->count, profile->strides.data(), nullptr);
    }
    const int errors = std::fetestexcept(FE_DIVBYZERO | FE_OVERFLOW | FE_UNDERFLOW | FE_INVALID);
    return std::fesetenv(&saved) == 0 && !errors ? 0 : 1;
}

#ifdef SCAR_OUTER_PROBE
#include <cstdio>
#include <cstdlib>
#include <fstream>
#include <memory>

namespace {
struct Buffer {
    std::unique_ptr<void, decltype(&std::free)> allocation{nullptr, std::free};
    char* data = nullptr;
    Buffer(std::size_t bytes, std::size_t residue) {
        allocation.reset(std::aligned_alloc(64, (bytes + residue + 63) & ~std::size_t{63}));
        if (allocation) data = static_cast<char*>(allocation.get()) + residue;
    }
};

bool input(const char* path, char* destination, std::size_t bytes) {
    std::ifstream file(path, std::ios::binary);
    return file.read(destination, bytes) && file.peek() == EOF;
}
}

int main(int argc, char** argv) {
    scar_numpy_outer_layout_v1 layout{};
    if (argc != 5 || scar_numpy_outer_query_v1(argv[1], &layout)) return 2;
    Buffer a(layout.left_bytes, layout.left_residue), b(layout.right_bytes, layout.right_residue),
        result(layout.output_bytes, layout.output_residue);
    if (!a.data || !b.data || !result.data || !input(argv[2], a.data, layout.left_bytes) ||
            !input(argv[3], b.data, layout.right_bytes)) return 2;
    if (scar_numpy_outer_apply_v1(argv[1], a.data, layout.left_bytes, b.data, layout.right_bytes,
                                  result.data, layout.output_bytes)) return 3;
    auto* out = std::fopen(argv[4], "wbx");
    if (!out) return 2;
    const auto written = std::fwrite(result.data, 1, layout.output_bytes, out);
    const auto status = std::fclose(out);
    return written == layout.output_bytes && status == 0 ? 0 : 2;
}
#endif
