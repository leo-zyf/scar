#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include "stateful_abi_v1.h"
#include <algorithm>
#include <array>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <chrono>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <limits>
#include <sched.h>
#include <unistd.h>
#include <vector>
#ifdef _OPENMP
#include <omp.h>
#endif
#pragma STDC FENV_ACCESS ON

namespace {
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
constexpr int32_t affinity_guard_status = 4;
constexpr int planned_cpu_ids[] = {@CPU_IDS@};
constexpr int floating_flags = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;
@AFFINITY_CLASS@
@FLOATING_CLASS@
@ARRAY_HELPERS@
@SCALAR_HELPERS@

// Deliberately stops before allocation, scans, affinity/fenv/team setup and
// execution. Those costs have separate resource components.
int32_t noop(const scar_array_v1 *arrays, uint64_t array_count,
             const scar_scalar_v1 *scalars, uint64_t scalar_count,
             const scar_provider_v1 *providers, uint64_t provider_count) {
    if (array_count != @ARRAY_COUNT@ || scalar_count != @SCALAR_COUNT@ ||
        provider_count != @PROVIDER_COUNT@ || (array_count && !arrays) ||
        (scalar_count && !scalars) || (provider_count && !providers)) return 1;
@ARRAY_GUARDS@
    for (uint64_t i=0;i<array_count;++i)
        for (uint64_t j=0;j<i;++j) if (overlap(arrays[i],arrays[j])) return 1;
    for (uint64_t i=0;i<provider_count;++i) if (!providers[i].loop || !providers[i].context) return 6;
    constexpr std::array<uint64_t,@SLOT_COUNT@> capacities={@SLOT_CAPACITIES@};
    __int128 total=0;
    for (uint64_t bytes:capacities) {
        if (bytes%8 || bytes>std::numeric_limits<ptrdiff_t>::max()) return 7;
        total+=bytes;
    }
    __int128 external=0;
    for (uint64_t i=0;i<array_count;++i) external+=__int128(arrays[i].shape[0])*arrays[i].shape[1]*8;
    if (total!=@PAYLOAD_BYTES@ULL || external!=@EXTERNAL_BYTES@ULL ||
        total+external!=@TOTAL_BYTES@ULL || total+external>@BUDGET@ULL) return 7;
    for (uint64_t i=0;i<scalar_count;++i)
        if (!finite(scalars[i].value) || (scalars[i].integer!=0 && scalars[i].integer!=1) ||
            (scalars[i].integer && (std::abs(scalars[i].value)>0x1p53 ||
                                   std::trunc(scalars[i].value)!=scalars[i].value))) return 8;
    return 0;
}
const scar_stateful_table_v1 table={1,sizeof(scar_stateful_table_v1),
    @ARRAY_COUNT@,@SCALAR_COUNT@,@PROVIDER_COUNT@,&noop,
    "@REGION_SHA256@","@PLAN_SHA256@","@CONTRACT_SHA256@"};
using Clock=std::chrono::steady_clock;
double now() { return std::chrono::duration<double,std::nano>(Clock::now().time_since_epoch()).count(); }
void fence(const void *p) { asm volatile("" : : "g"(p) : "memory"); }
int tid() {
#ifdef _OPENMP
    return omp_get_thread_num();
#else
    return 0;
#endif
}
int team_size() {
#ifdef _OPENMP
    return omp_get_num_threads();
#else
    return 1;
#endif
}
}
extern "C" SCAR_EXPORT_V1 const scar_stateful_table_v1 *scar_get_stateful_table_v1() { return &table; }

// A canonical operation chain, not the target scalar DAG. Generic dispatch
// overhead is retained. Timings use a persistent team and include only each
// single stage and its own implicit completion barrier.
extern "C" SCAR_EXPORT_V1 int32_t scar_tagged_scalar_probe_v1(
    const int32_t *operations,uint64_t count,const scar_scalar_v1 *operands,
    uint64_t repetitions,uint64_t warmup,double *samples,int32_t *placement,uint64_t *checksum) {
    constexpr int workers=sizeof(planned_cpu_ids)/sizeof(int);
    if (!operations || !count || count>4096 || !operands || !samples || !placement || !checksum ||
        repetitions<1 || repetitions>10000 || warmup>10000) return 1;
    for (uint64_t i=0;i<count;++i) if (operations[i]<1 || operations[i]>5) return 1;
    ThreadAffinity caller;
    for (int cpu:planned_cpu_ids) if (!caller.contains(cpu)) return 4;
    FloatingScope caller_environment;
    if (!caller_environment.begin()) return 3;
    fenv_t execution_environment;
    if (std::fegetenv(&execution_environment)!=0) return 3;
    placement[0]=sched_getcpu();
    std::vector<double> elapsed(workers);
    uint32_t guard=0,ready_guard=0;
    Scalar output;
    uint64_t sink=0;
    #pragma omp parallel num_threads(workers) reduction(|:guard)
    {
        const int worker=tid();
        placement[2+worker*4]=sched_getcpu();
        ThreadAffinity affinity; FloatingScope environment;
        bool ok=team_size()==workers && affinity.bind(planned_cpu_ids[worker]);
        ok=environment.begin(&execution_environment)&&ok;
        placement[3+worker*4]=sched_getcpu();
        #pragma omp atomic update
        ready_guard|=static_cast<uint32_t>(!ok);
        #pragma omp barrier
        if (!ready_guard) for (uint64_t rep=0;rep<repetitions+warmup;++rep) {
            // Rendezvous instrumentation lies outside the timed interval.
            #pragma omp barrier
            fence(operands); fence(operations);
            const double start=now();
            #pragma omp single
            {
                Scalar value{operands[0].value,operands[0].integer!=0};
                for (uint64_t i=0;i<count;++i) {
                    Scalar right{operands[i+1].value,operands[i+1].integer!=0};
                    const int32_t op=operations[i];
                    value=op==5?scalar_neg(value):scalar_op(value,right,
                        op==1?'+':op==2?'-':op==3?'*':'/',guard);
                }
                output=value;
                fence(&output); fence(&guard);
            }
            elapsed[worker]=now()-start;
            #pragma omp barrier
            #pragma omp master
            {
                if (rep>=warmup) samples[rep-warmup]=*std::max_element(elapsed.begin(),elapsed.end());
                sink^=std::bit_cast<uint64_t>(output.value);
            }
            #pragma omp barrier
        }
        guard|=static_cast<uint32_t>(!ok || std::fetestexcept(floating_flags));
        guard|=static_cast<uint32_t>(!environment.restore());
        const bool kept=affinity.bound(),restored=affinity.restore();
        placement[4+worker*4]=sched_getcpu();
        placement[5+worker*4]=static_cast<int32_t>(restored);
        guard|=static_cast<uint32_t>(!kept || !restored);
    }
    guard|=ready_guard;
    guard|=static_cast<uint32_t>(std::fetestexcept(floating_flags));
    const bool restored=caller_environment.restore(),affinity_restored=caller.restore_original();
    placement[1]=sched_getcpu(); *checksum=sink;
    return guard || !restored || !affinity_restored?3:0;
}
