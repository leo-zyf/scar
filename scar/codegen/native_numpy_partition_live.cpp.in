#define PY_SSIZE_T_CLEAN
#include <Python.h>
#define NPY_NO_DEPRECATED_API NPY_2_0_API_VERSION
#define NPY_TARGET_VERSION NPY_2_0_API_VERSION
#include <numpy/arrayobject.h>

#include "numpy_complex.hpp"

#include <array>
#include <cfenv>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <limits>
#include <memory>
#include <span>
#include <stdexcept>
#include <string_view>

namespace {

@CORE_TYPES@

@PLANS@

struct Layout {
    std::span<const std::int64_t> shape, strides;
};

@GUARDS@

@EXECUTE@

struct Interval {
    std::uintptr_t first{}, last{};
};

bool interval(const void* data, std::size_t size, Interval& result) {
    const auto first = reinterpret_cast<std::uintptr_t>(data);
    if (!first || !size || size > std::numeric_limits<std::uintptr_t>::max() - first) return false;
    result = {first, first + size};
    return true;
}

bool disjoint(Interval a, Interval b) {
    return a.last <= b.first || b.last <= a.first;
}

bool backing_contains(PyArrayObject* array, Interval touched) {
    for (unsigned depth = 0; depth < 64; ++depth) {
        auto* base = PyArray_BASE(array);
        if (base) {
            if (!PyArray_CheckExact(base)) return false;
            array = reinterpret_cast<PyArrayObject*>(base);
            continue;
        }
        if (!PyArray_CHKFLAGS(array, NPY_ARRAY_OWNDATA) ||
                (!PyArray_IS_C_CONTIGUOUS(array) && !PyArray_IS_F_CONTIGUOUS(array))) return false;
        const auto item_size = PyArray_ITEMSIZE(array);
        if (item_size <= 0) return false;
        auto bytes = static_cast<std::size_t>(item_size);
        for (int i = 0; i < PyArray_NDIM(array); ++i) {
            const auto dimension = PyArray_DIM(array, i);
            if (dimension <= 0 || bytes > std::numeric_limits<std::size_t>::max() / dimension) return false;
            bytes *= dimension;
        }
        Interval owner;
        return interval(PyArray_DATA(array), bytes, owner) &&
            owner.first <= touched.first && touched.last <= owner.last;
    }
    return false;
}

bool array_guard(PyObject* object, unsigned role, const Region& region, Interval& storage) {
    if (!PyArray_CheckExact(object)) return false;
    auto* array = reinterpret_cast<PyArrayObject*>(object);
    const auto& expected = geometry[role];
    if (PyArray_TYPE(array) != NPY_CDOUBLE || PyArray_ITEMSIZE(array) != 16 || !PyArray_ISNOTSWAPPED(array) ||
            !PyArray_ISALIGNED(array) || PyArray_CHKFLAGS(array, NPY_ARRAY_WRITEBACKIFCOPY) ||
            (role == 2 && !PyArray_ISWRITEABLE(array)) ||
            PyArray_NDIM(array) != static_cast<int>(expected.shape.size())) return false;
    for (std::size_t axis = 0; axis < expected.shape.size(); ++axis) {
        if (PyArray_DIM(array, axis) != expected.shape[axis] ||
                PyArray_STRIDE(array, axis) != expected.strides[axis]) return false;
    }
    return interval(PyArray_DATA(array), region.sizes[role], storage) &&
@INPUT_PLACEMENT@        backing_contains(array, storage);
}

bool selectors(PyObject* object) {
    const bool tuple = PyTuple_CheckExact(object);
    const bool list = PyList_CheckExact(object);
    if ((!tuple && !list) || (tuple ? PyTuple_GET_SIZE(object) : PyList_GET_SIZE(object)) != 2) return false;
    for (Py_ssize_t index = 0; index != 2; ++index) {
        auto* key = tuple ? PyTuple_GET_ITEM(object, index) : PyList_GET_ITEM(object, index);
        if (!PyTuple_CheckExact(key) || PyTuple_GET_SIZE(key) != 2 || PyTuple_GET_ITEM(key, 0) != Py_Ellipsis)
            return false;
        auto* value = PyTuple_GET_ITEM(key, 1);
        if (!PyLong_CheckExact(value)) return false;
        int overflow{};
        if (PyLong_AsLongAndOverflow(value, &overflow) != index || overflow) return false;
    }
    return true;
}

class FloatingEnvironment {
    std::fenv_t saved_{};
    bool active_ = false;
public:
    FloatingEnvironment() = default;
    FloatingEnvironment(const FloatingEnvironment&) = delete;
    ~FloatingEnvironment() { if (active_) std::fesetenv(&saved_); }
    bool hold() {
        if (std::fegetenv(&saved_) != 0) return false;
        active_ = true;
        std::fenv_t unused{};
        return std::feholdexcept(&unused) == 0;
    }
    bool restore() {
        if (!active_ || std::fesetenv(&saved_) != 0) return false;
        active_ = false;
        return true;
    }
};

constexpr std::size_t rounded(std::size_t bytes) {
    return (bytes + 63) & ~std::size_t{63};
}

PyObject* declined() noexcept {
    return Py_NewRef(Py_NotImplemented);
}

PyObject* try_apply(PyObject*, PyObject* const* args, Py_ssize_t count) {
    if (count != 4 || !selectors(args[2]) || !scar_numpy_complex_runtime_supported()) return declined();
    constexpr auto& region = regions[0];
    Interval target, matrix, output;
    if (!array_guard(args[0], 0, region, target) || !array_guard(args[1], 1, region, matrix) ||
            !array_guard(args[3], 2, region, output) || !disjoint(target, matrix) ||
            !disjoint(target, output) || !disjoint(matrix, output)) return declined();
    constexpr auto temp_offset = rounded(region.sizes[2] + region.residues[2]);
@WORKSPACE@    std::unique_ptr<void, decltype(&std::free)> private_storage(std::aligned_alloc(64, workspace), std::free);
    if (!private_storage) return declined();
    auto* bytes = static_cast<char*>(private_storage.get());
    @ROOTS_QUALIFIER@std::array<char*, 4> roots{
        reinterpret_cast<char*>(target.first), reinterpret_cast<char*>(matrix.first),
        bytes + region.residues[2], bytes + temp_offset + region.residues[3]
    };
@REPACK@    FloatingEnvironment numeric;
    if (!numeric.hold()) return declined();
    try {
        execute(region, roots);
    } catch (...) {
        return declined();
    }
    if (!numeric.restore()) return declined();
    std::memcpy(reinterpret_cast<void*>(output.first), roots[2], region.sizes[2]);
    return Py_NewRef(args[3]);
}

PyMethodDef methods[] = {
    {"try_apply", _PyCFunction_CAST(try_apply), METH_FASTCALL,
     "Publish a checked original partition schedule into the exact output object."},
    {nullptr, nullptr, 0, nullptr},
};

PyModuleDef module = {
    PyModuleDef_HEAD_INIT,
    "@MODULE@",
    "Scoped native NumPy bridge for one exact original layout.",
    0,
    methods,
};
}

PyMODINIT_FUNC PyInit_@MODULE@() {
    if (PyArray_ImportNumPyAPI() < 0) return nullptr;
    auto* instance = PyModule_Create(&module);
    if (instance && PyModule_AddIntConstant(instance, "scar_operator_abi", 1) != 0) {
        Py_DECREF(instance);
        return nullptr;
    }
    return instance;
}
