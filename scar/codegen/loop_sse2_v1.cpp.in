// SSE2 baseline: spatial chains are independent; time remains one runtime loop.
bool sse2_available() {
    unsigned eax, ebx, ecx, edx;
    return __get_cpuid(1, &eax, &ebx, &ecx, &edx) && (edx & bit_SSE2);
}

int nonfinite_pair(__m128d value) {
    const __m128i mask = _mm_set1_epi64x(INT64_C(0x7ff0000000000000));
    const __m128i exponent = _mm_and_si128(_mm_castpd_si128(value), mask);
    // SSE2 has 32-bit equality. movemask_pd selects the upper word of each
    // 64-bit lane, where all eleven exponent bits reside. No FP comparison.
    const __m128i equal = _mm_cmpeq_epi32(exponent, mask);
    return _mm_movemask_pd(_mm_castsi128_pd(equal));
}

void execute_scalar_tail(const double *input, double *result, int64_t begin,
                         uint64_t steps, uint32_t &nonfinite) {
    for (int64_t col = begin; col < modeled_cols; ++col) {
        double carry;
        std::memcpy(&carry, input + col, sizeof(carry));
        if (!finite_bits(carry)) { nonfinite |= 1; continue; }
        #pragma GCC unroll 1
        for (uint64_t iteration = 0; iteration < steps; ++iteration) {
@SCALAR_BODY@
            carry = @SCALAR_RESULT@;
            if (!finite_bits(carry)) { nonfinite |= 1; break; }
        }
        result[col] = carry;
    }
}

void execute_row(const scar_array_v1 &state, scar_array_v1 &output,
                 int64_t row, uint64_t steps, uint32_t &nonfinite) {
    const auto *input = static_cast<const double *>(state.data) + row * modeled_cols;
    auto *result = static_cast<double *>(output.data) + row * modeled_cols;
@VECTOR_CONSTANTS@
    int64_t col = 0;
    for (; col <= modeled_cols - @TILE_ELEMENTS@; col += @TILE_ELEMENTS@) {
@VECTOR_LOADS@
        int invalid = @VECTOR_BAD@;
        if (invalid) { nonfinite |= 1; continue; }
        #pragma GCC unroll 1
        for (uint64_t iteration = 0; iteration < steps; ++iteration) {
@VECTOR_BODY@
@VECTOR_UPDATES@
            invalid = @VECTOR_BAD@;
            if (invalid) { nonfinite |= 1; break; }
        }
@VECTOR_STORES@
    }
    execute_scalar_tail(input, result, col, steps, nonfinite);
}
