#include <algorithm>
#include <functional>
#include <optional>
#include <tuple>
#include <vector>

@SCAR_SHARED@
@SCAR_SCORER@

using Move = std::tuple<@SCAR_TYPES@>;
using Record = std::tuple<Integer, Move>;
constexpr std::size_t max_rows = @SCAR_MAX_ROWS@;

@SCAR_CONSTANTS@

Cells integer_row(std::span<const Row> rows, std::string_view key) {
    return table_row(Table{std::string_view{}, rows}, key);
}

std::vector<Record> ordered(const Table& table, Integer threshold, Integer capture, @SCAR_FORMALS@) {
    std::vector<Record> records;
    const auto emit = [&](Move move) {
        const Integer delta = evaluate_score(table, @SCAR_SCORER_ARGS@);
        if (delta >= threshold || capture != 0) {
            if (records.size() == max_rows) throw Decline{};
            records.emplace_back(delta, std::move(move));
        }
    };
@SCAR_BODY@
    std::stable_sort(records.begin(), records.end(), @SCAR_DESCENDING@);
    return records;
}

void encode(std::string& output, Integer value) {
    std::array<char, 22> formatted;
    const auto result = std::to_chars(formatted.data(), formatted.data() + formatted.size(), value);
    output += "i:";
    output.append(formatted.data(), result.ptr);
    output += '\n';
}

void encode(std::string& output, const std::string& value) {
    constexpr std::string_view hex = "0123456789abcdef";
    output += "s:";
    for (const unsigned char c : value) {
        output += hex[c >> 4];
        output += hex[c & 15];
    }
    output += '\n';
}

}  // namespace

int main(int argc, char** argv) {
    try {
        if (argc != @SCAR_ARGC@) throw Decline{};
        for (const auto& table : tables) {
            if (table.version != argv[1]) continue;
            const auto threshold = parse_integer(argv[2]);
            const auto capture = parse_integer(argv[3]);
            const auto records = ordered(table, threshold, capture, @SCAR_ACTUALS@);
            std::string output = "SCAR_SORTED_V1\n";
            for (const auto& [delta, move] : records) {
                encode(output, delta);
                std::apply([&](const auto&... item) { (encode(output, item), ...); }, move);
            }
            return std::fwrite(output.data(), 1, output.size(), stdout) == output.size()
                && std::fflush(stdout) == 0 ? 0 : 1;
        }
    } catch (const Decline&) {
    }
    std::fputs("ordered region fell outside the admitted scalar domain\n", stderr);
    return 2;
}
