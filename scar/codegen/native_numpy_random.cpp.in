#include "numpy_random.hpp"
#include "randutils.hpp"
#include "bitgen.h"

#include <array>
#include <cfenv>
#include <cmath>
#include <cstdint>
#include <xmmintrin.h>

extern "C" void scar_stock_pcg64_set_seed(void*, const std::uint64_t*, const std::uint64_t*);
extern "C" double scar_stock_pcg64_double(void*);
extern "C" double random_uniform(bitgen_t*, double, double);

asm(R"scar_rand(
@SCAR_STOCK_ROUTINES@
)scar_rand");

extern "C" void scar_numpy_pcg64_init_v1(std::uint64_t seed, std::uint64_t* state,
                                        std::uint64_t* seed_words) noexcept {
    std::array<std::uint32_t, 2> entropy{static_cast<std::uint32_t>(seed), static_cast<std::uint32_t>(seed >> 32)};
    randutils::seed_seq_fe128 sequence(entropy.begin(), entropy.begin() + (entropy[1] != 0 ? 2 : 1));
    std::array<std::uint32_t, 8> expanded{};
    sequence.generate(expanded.begin(), expanded.end());
    std::array<std::uint64_t, 4> seeds{};
    for (std::size_t i = 0; i < seeds.size(); ++i) {
        seeds[i] = expanded[2 * i] | (std::uint64_t{expanded[2 * i + 1]} << 32);
    }
    if (seed_words) std::copy(seeds.begin(), seeds.end(), seed_words);
    // The observed scalar-double callback reads just the PCG state pointer.
    auto* callback_state = state;
    scar_stock_pcg64_set_seed(&callback_state, seeds.data(), seeds.data() + 2);
}

extern "C" int scar_numpy_pcg64_uniform_v1(std::uint64_t* state, double low, double high,
                                          std::size_t count, double* out) noexcept {
    const double span = high - low;
    if (!state || (count && !out) || !std::isfinite(span) || span < 0.0 ||
        std::fegetround() != FE_TONEAREST || (_mm_getcsr() & 0xe040U) != 0) return 1;
    auto* callback_state = state;
    bitgen_t bitgen{&callback_state, nullptr, nullptr, scar_stock_pcg64_double, nullptr};
    for (std::size_t i = 0; i < count; ++i) out[i] = random_uniform(&bitgen, low, span);
    return 0;
}
