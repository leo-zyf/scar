#include "contour_agg_io.hpp"
#include "contour_style.hpp"
#include "contour_style_lut.hpp"

#include <cmath>
#include <openssl/evp.h>

namespace {
Grid live_grid(Tape& tape, int argc, char* argv[]) {
    Grid selected;
    selected.rows = tape.take<std::uint64_t>();
    selected.cols = tape.take<std::uint64_t>();
    selected.x_chunk_size = tape.take<std::uint64_t>();
    selected.y_chunk_size = tape.take<std::uint64_t>();
    const auto corner_mask = tape.take<std::uint64_t>();
    require(selected.rows > 1 && selected.cols > 1 && selected.rows <= limit / 24 / selected.cols
            && corner_mask <= 1, "invalid live contour geometry");
    selected.corner_mask = corner_mask;
    const auto root_count = tape.take<std::uint64_t>();
    require(root_count == 0 || root_count == 3, "invalid live contour root bindings");
    if (argc == 9) {
        require(root_count == 3, "original contour roots must be qualified before use");
        selected.x = lattice(tape, selected, argv[3], argv[4]);
        selected.y = lattice(tape, selected, argv[5], argv[6]);
        selected.z = lattice(tape, selected, argv[7], argv[8]);
        return selected;
    }
    for (std::uint64_t i = 0; i < 4 * root_count; ++i) tape.take<std::uint64_t>();
    auto runtime = scar::contour::read_input(argv[3]);
    require(runtime.rows == selected.rows && runtime.cols == selected.cols
            && runtime.x_chunk_size == selected.x_chunk_size && runtime.y_chunk_size == selected.y_chunk_size
            && runtime.corner_mask == selected.corner_mask && runtime.mask.empty(),
            "runtime grid differs from the qualified contour configuration");
    return runtime;
}

std::pair<double, double> finite_bounds(const std::vector<double>& values) {
    auto min = values.front();
    auto max = min;
    for (const auto value : values) {
        require(std::isfinite(value) && (value != 0 || !std::signbit(value)),
                "live contour requires finite values with canonical zero");
        min = std::min(min, value);
        max = std::max(max, value);
    }
    return {min, max};
}

void guard_plot_coordinates(Tape& template_input, const std::vector<double>& coordinates) {
    std::array<unsigned char, 32> expected{}, actual{};
    unsigned int length{};
    template_input.read(expected.data(), expected.size());
    require(EVP_Digest(coordinates.data(), coordinates.size() * sizeof(double), actual.data(), &length,
                       EVP_sha256(), nullptr) == 1 && length == actual.size() && actual == expected,
            "runtime plot coordinates cannot reuse the qualified residual layout");
}

struct Glyph {
    std::uint32_t rows, columns;
    std::int32_t x, y;
    std::vector<std::uint8_t> bitmap;
};

std::vector<Glyph> read_glyphs(const char* path) {
    Tape glyphs(path);
    std::array<char, 8> magic;
    glyphs.read(magic.data(), magic.size());
    require(std::string_view(magic.data(), magic.size()) == "SCARGLY1", "unsupported live glyph wire");
    const auto count = glyphs.take<std::uint32_t>();
    require(count && count <= 128, "live glyph count exceeds the text contract");
    std::vector<Glyph> result;
    result.reserve(count);
    for (std::uint32_t i = 0; i < count; ++i) {
        auto& g = result.emplace_back();
        g.rows = glyphs.take<std::uint32_t>();
        g.columns = glyphs.take<std::uint32_t>();
        require(g.rows <= 4096 && g.columns <= 4096 && (g.rows == 0) == (g.columns == 0),
                "live glyph shape exceeds the title contract");
        g.bitmap.resize(std::size_t{g.rows} * g.columns);
        glyphs.read(g.bitmap.data(), g.bitmap.size());
        g.x = glyphs.take<std::int32_t>();
        g.y = glyphs.take<std::int32_t>();
    }
    require(glyphs.end(), "trailing live glyph bytes");
    return result;
}
}

int main(int argc, char** argv) {
    try {
        require(argc == 4 || argc == 9 || argc == 5 || argc == 10,
                "expected TEMPLATE OUTPUT (CTI | X OFF Y OFF Z OFF) [LIVE_GLYPHS]");
        Tape tape(argv[1]);
        std::array<char, 8> magic;
        tape.read(magic.data(), magic.size());
        const std::string_view version(magic.data(), magic.size());
        const bool has_title = version == "SCARCTT3";
        require(has_title || version == "SCARCTT2", "unsupported live scene template");
        require(has_title == (argc == 5 || argc == 10), "live glyph argument does not match the scene");
        const auto glyphs = has_title ? read_glyphs(argv[argc - 1]) : std::vector<Glyph>{};
        auto grid = live_grid(tape, argc - has_title, argv);
        guard_plot_coordinates(tape, grid.x);
        guard_plot_coordinates(tape, grid.y);
        const auto nbins = tape.take<std::uint32_t>();
        const auto min_ticks = tape.take<std::uint32_t>();
        const auto [zmin, zmax] = finite_bounds(grid.z);
        const auto style = scar::contour::make_style(zmin, zmax,
                scar::contour::StyleParameters{.nbins=nbins, .min_n_ticks=min_ticks}, scar::contour::style_lut);
        grid.levels = style.contour_levels;
        const auto bands = scar::contour::filled_grid(grid);
        require(bands.size() && bands.size() <= 4096 && bands.size() == style.colors.size(),
                "live geometry and palette must have one entry per filled band");
        Scene scene;
        const auto steps = tape.take<std::uint64_t>();
        require(steps && steps <= 1024, "invalid live scene step count");
        for (std::uint64_t i = 0; i < steps; ++i) {
            switch (tape.take<std::uint8_t>()) {
            case 0:
                scene.literal(tape);
                break;
            case 1: {
                const double threshold = tape.take<double>();
                require(0 <= threshold && threshold <= 1, "invalid original simplification threshold");
                scene.append(static_cast<std::uint32_t>(bands.size()));
                for (const auto& band : bands) scene.polygon_band(band, threshold);
                break;
            }
            case 2:
                scene.append(static_cast<std::uint32_t>(style.colors.size()));
                scene.append(std::uint32_t{4});
                for (const auto& rgba : style.colors) scene.append(rgba.data(), 4 * sizeof(double));
                break;
            case 3: {
                const auto count = tape.take<std::uint32_t>();
                require(has_title && count <= 65536 - glyphs.size(), "invalid live draw count");
                scene.append(static_cast<std::uint32_t>(count + glyphs.size()));
                break;
            }
            case 4: {
                const auto size = tape.take<std::uint32_t>();
                std::array<char, 4096> prefix{};
                require(has_title && size > 1 && size <= prefix.size(), "invalid title graphics state");
                tape.read(prefix.data(), size);
                require(prefix[0] == 3, "invalid live glyph draw opcode");
                for (const auto& glyph : glyphs) {
                    scene.append(prefix.data(), size);
                    scene.append(glyph.rows);
                    scene.append(glyph.columns);
                    scene.append(glyph.bitmap.data(), glyph.bitmap.size());
                    scene.append(glyph.x);
                    scene.append(glyph.y);
                    scene.append(0.0);
                }
                break;
            }
            default:
                throw std::runtime_error("unknown live scene operation");
            }
        }
        require(tape.end(), "trailing live scene bytes");
        scene.publish(argv[2]);
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
