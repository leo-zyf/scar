#pragma once

#include <cfenv>
#include <cstdint>
#include <limits>
#include <omp.h>
#include <sched.h>
#include <span>

namespace scar::openmp_v1 {

// A lane writes only its own ordinal slots. The caller publishes after the join.
template<class Execute>
bool dispatch(std::span<const int> cpus, std::uint64_t count, Execute&& execute) {
    if (cpus.empty() || cpus.size() > CPU_SETSIZE || count < cpus.size()
            || count > std::numeric_limits<std::int64_t>::max() || omp_in_parallel()) return false;
    fenv_t caller_fp{};
    if (std::fegetenv(&caller_fp) != 0) return false;
    const int width = static_cast<int>(cpus.size());
    const int dynamic = omp_get_dynamic();
    omp_set_dynamic(0);
    int placement_failed = 0;
    int lane_failed = 0;

    #pragma omp parallel num_threads(width) reduction(|:lane_failed)
    {
        const auto lane = omp_get_thread_num();
        cpu_set_t original_mask{};
        fenv_t original_fp{};
        const bool mask_saved = sched_getaffinity(0, sizeof(original_mask), &original_mask) == 0;
        const bool fp_saved = std::fegetenv(&original_fp) == 0;
        bool ready = false;
        if (mask_saved && fp_saved && omp_get_num_threads() == width && lane < width) {
            const int cpu = cpus[lane];
            if (0 <= cpu && cpu < CPU_SETSIZE && CPU_ISSET(cpu, &original_mask)) {
                cpu_set_t target;
                CPU_ZERO(&target);
                CPU_SET(cpu, &target);
                ready = sched_setaffinity(0, sizeof(target), &target) == 0
                    && sched_getcpu() == cpu && std::fesetenv(&caller_fp) == 0;
            }
        }
        if (!ready) {
            #pragma omp atomic update
            placement_failed |= 1;
        }
        #pragma omp barrier
        if (placement_failed == 0) {
            try {
                for (std::uint64_t ordinal = lane; ordinal < count; ordinal += width) execute(ordinal, lane);
            } catch (...) {
                lane_failed |= 1;
            }
        }
        if (fp_saved && std::fesetenv(&original_fp) != 0) lane_failed |= 1;
        if (mask_saved && sched_setaffinity(0, sizeof(original_mask), &original_mask) != 0) lane_failed |= 1;
    }
    omp_set_dynamic(dynamic);
    return placement_failed == 0 && lane_failed == 0;
}

}
