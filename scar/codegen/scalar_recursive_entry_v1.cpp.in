#include <chrono>
#include <filesystem>
#include <fstream>
#include <iostream>

#include "source_pv.inc"

namespace {

enum class Command { reply, position, search, quit };
struct SearchInput {
    std::string_view seed;
    Integer depth;
    Integer hclock;
    bool white;
    double budget;
    double hard_limit;
    double soft_epoch;
};
struct Request {
    std::string_view bytes;
    Command operation;
    std::string_view response;
    std::size_t position;
};

@SCAR_TAPE@

using SteadyClock = std::chrono::steady_clock;
using Owner = std::unique_ptr<scar_recursive_driver_v1, decltype(&scar_recursive_driver_close_v1)>;

double elapsed(SteadyClock::time_point start) {
    return std::chrono::duration<double>(SteadyClock::now() - start).count();
}

void finish_line() {
    std::cout << '\n' << std::flush;
    if (!std::cout) throw Decline{};
}

void emit_info(double seconds, Integer depth, Integer nodes, Integer score,
               std::string_view bound, const std::vector<std::string>* variation) {
    const Integer sampled_ms = static_cast<Integer>(std::nearbyint(@SCAR_MS_SCALE@ * seconds));
    const Integer sampled_rate = static_cast<Integer>(std::nearbyint(nodes / std::max(seconds, @SCAR_NPS_FLOOR@)));
    std::cout @SCAR_INFO_FIELDS@;
    if (!bound.empty()) std::cout << ' ' << bound;
    if (variation != nullptr) {
        std::cout << @SCAR_PV_FIELD@;
        for (auto at = variation->begin(); at != variation->end(); ++at) {
            if (at != variation->begin()) std::cout << ' ';
            std::cout << *at;
        }
    }
    finish_line();
}

class Trace {
public:
    Trace(const std::filesystem::path& directory, std::size_t session) : folder(directory), index(session) {
        if (!folder.empty()) {
            probes.open(path(".probes"), std::ios::binary | std::ios::trunc);
            if (!probes) throw Decline{};
            probes << "SCAR_ENTRY_PROBES_V1\n";
        }
    }
    void begin(const scar_recursive_driver_v1& owner) {
        if (!probes.is_open()) return;
        publish(probes, static_cast<Integer>(owner.query.table));
        publish(probes, static_cast<Integer>(owner.world.@SCAR_MOVE_MAP@.size()));
        publish(probes, static_cast<Integer>(owner.world.@SCAR_SCORE_MAP@.size()));
    }
    void yield(const scar_recursive_yield_v1& row, const std::optional<Move>& move) {
        if (!probes.is_open()) return;
        publish(probes, row.depth);
        publish(probes, row.threshold);
        publish(probes, row.score);
        publish(probes, row.nodes);
        publish(probes, bool(move));
        if (move) publish(probes, *move);
        if (!probes) throw Decline{};
    }
    void finish(const scar_recursive_driver_v1& owner) {
        if (folder.empty()) return;
        std::ofstream state(path(".world"), std::ios::binary | std::ios::trunc);
        state << "SCAR_DRIVER_WORLD_V1\n";
        publish_state(state, owner.world);
        if (!state) throw Decline{};
    }
private:
    std::filesystem::path path(std::string_view suffix) const {
        return folder / (std::to_string(index) + std::string(suffix));
    }
    std::filesystem::path folder;
    std::size_t index;
    std::ofstream probes;
};

void search(Owner& owner, const SearchInput& input, Trace& trace) {
    const auto* data = reinterpret_cast<const std::uint8_t*>(input.seed.data());
    if (owner) {
        if (scar_recursive_driver_rebind_v2(owner.get(), data, input.seed.size())) throw Decline{};
    } else {
        scar_recursive_driver_v1* state = nullptr;
        if (scar_recursive_driver_create_v1(data, input.seed.size(), &state) || state == nullptr) throw Decline{};
        owner.reset(state);
    }
    trace.begin(*owner);
    const double deadline = exact_clock() + std::min(input.budget, input.hard_limit);
    const auto start = SteadyClock::now();
    std::string candidate, best;
    Integer last_depth = @SCAR_FIRST_DEPTH@;
    while (true) {
        scar_recursive_yield_v1 row{};
        if (scar_recursive_driver_advance_v1(owner.get(), input.soft_epoch, deadline, &row)) throw Decline{};
        const auto& [depth, threshold, score, move] = owner->stream->current();
        trace.yield(row, move);
        if (@SCAR_NEW_DEPTH@) {
            if (!candidate.empty()) best = candidate;
            last_depth = depth;
        }
        if (@SCAR_DEPTH_LIMIT@) {
            if ((@SCAR_FAIL_HIGH@) && move) best = scar_render_entry_move(*move, input.white);
            break;
        }
        const auto seconds = elapsed(start);
        if (@SCAR_FAIL_HIGH@) {
            if (!move) {
                emit_info(seconds, depth, row.nodes, score, {}, nullptr);
                break;
            }
            candidate = scar_render_entry_move(*move, input.white);
            const auto pv = scar_entry_pv(*owner, input.hclock);
            emit_info(seconds, depth, row.nodes, score, @SCAR_LOWER_LABEL@, &pv);
        } else {
            emit_info(seconds, depth, row.nodes, score, @SCAR_UPPER_LABEL@, nullptr);
        }
        if (@SCAR_TIME_EDGE@) throw Decline{};
    }
    owner->stream.reset();
    trace.finish(*owner);
    const auto pv = scar_entry_pv(*owner, input.hclock);
    const auto& played = best.empty() ? candidate : best;
    std::cout << @SCAR_BESTMOVE@;
    if (!played.empty() && pv.size() > 1 && pv.front() == played) {
        std::cout << played << @SCAR_PONDER@ << pv[1];
    } else {
        std::cout << (!played.empty() ? played : pv.empty() ? @SCAR_NO_MOVE@ : pv.front());
    }
    finish_line();
}

}

int main(int argc, char** argv) {
    try {
        std::filesystem::path observations;
        if (argc == 3 && std::string_view(argv[1]) == "--observe") {
            observations = argv[2];
            if (!std::filesystem::is_directory(observations)) return 77;
        } else if (argc != 1) {
            return 77;
        }
        Owner owner(nullptr, scar_recursive_driver_close_v1);
        std::optional<std::size_t> position;
        std::size_t session = 0;
        for (const auto& request : commands) {
            std::string text;
            if (!std::getline(std::cin, text) || text != request.bytes) return 77;
            switch (request.operation) {
            case Command::reply:
                std::cout << request.response << std::flush;
                if (!std::cout) return 77;
                break;
            case Command::position:
                position = request.position;
                break;
            case Command::search: {
                if (position != request.position || request.position >= searches.size()) return 77;
                Trace trace(observations, session++);
                search(owner, searches[request.position], trace);
                break;
            }
            case Command::quit:
                return session == searches.size() ? 0 : 77;
            }
        }
    } catch (...) {
        return 77;
    }
    return 77;
}
