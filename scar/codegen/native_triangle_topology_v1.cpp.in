#include <ATen/Parallel.h>
#include <ATen/ops/_unique2.h>
#include <ATen/ops/add.h>
#include <ATen/ops/cat.h>
#include <ATen/ops/empty.h>
#include <ATen/ops/floor_divide.h>
#include <ATen/ops/isfinite.h>
#include <ATen/ops/mul.h>
#include <ATen/ops/sort.h>
#include <ATen/ops/stack.h>
#include <ATen/ops/sub.h>

#include <array>
#include <bit>
#include <cfenv>
#include <cstdint>
#include <cstdio>
#include <stdexcept>

namespace {
constexpr std::int64_t seed_vertices = @SCAR_SEED_VERTICES@;
constexpr std::int64_t seed_cells = @SCAR_SEED_CELLS@;
constexpr std::int64_t depth = @SCAR_DEPTH@;
constexpr std::int64_t vertices = @SCAR_VERTICES@;
constexpr std::int64_t cells = @SCAR_CELLS@;
constexpr std::int64_t points = @SCAR_POINTS@;
constexpr std::int64_t rows = @SCAR_ROWS@;
constexpr std::size_t seed_header_bytes = 24;
constexpr std::array<unsigned char, 144> input_header{@SCAR_HEADER@};
static_assert(std::endian::native == std::endian::little && sizeof(double) == 8);

at::Tensor read_tensor(at::IntArrayRef shape, at::ScalarType dtype) {
    auto result = at::empty(shape, at::TensorOptions().dtype(dtype).device(at::kCPU));
    if (std::fread(result.data_ptr(), 1, result.nbytes(), stdin) != result.nbytes()) {
        throw std::runtime_error("incomplete triangular mesh seed");
    }
    if (dtype == at::kDouble && !at::isfinite(result).all().item<bool>()) {
        throw std::runtime_error("nonfinite triangular mesh operand");
    }
    return result;
}

void write_bytes(const void* source, std::size_t bytes) {
    if (std::fwrite(source, 1, bytes, stdout) != bytes) {
        throw std::runtime_error("cannot publish refined mesh");
    }
}

void write_tensor(const at::Tensor& tensor) {
    auto contiguous = tensor.contiguous();
    write_bytes(contiguous.const_data_ptr(), contiguous.nbytes());
}

struct Facets {
    at::Tensor first;
    at::Tensor second;
    at::Tensor cell_edges;
    at::Tensor incidence;
};

Facets facets(const at::Tensor& triangles, std::int64_t vertex_count) {
    const auto first = triangles.select(0, 0);
    const auto second = triangles.select(0, 1);
    const auto third = triangles.select(0, 2);
    // A bounded row-major encoding sorts vertex pairs lexicographically.
    const auto low = at::cat({first, second, first}, 0);
    const auto high = at::cat({second, third, third}, 0);
    const auto keys = at::add(at::mul(low, vertex_count), high);
    auto [unique, inverse, counts] = at::_unique2(keys, true, true, true);
    if (counts.max().item<std::int64_t>() > 2) {
        throw std::runtime_error("triangle facets require at most two incident cells");
    }
    auto endpoints = at::floor_divide(unique, vertex_count);
    auto other = at::sub(unique, at::mul(endpoints, vertex_count));
    return {endpoints, other, inverse.reshape({3, triangles.size(1)}), counts};
}

void refine(at::Tensor& coordinates, at::Tensor& triangles) {
    const auto n = coordinates.size(1);
    const auto edge = facets(triangles, n);
    const auto midpoints = at::mul(at::add(coordinates.index_select(1, edge.first),
                                          coordinates.index_select(1, edge.second)), 0.5);
    auto indices = at::add(edge.cell_edges, n);
    const auto ab = indices.select(0, 0);
    const auto bc = indices.select(0, 1);
    const auto ac = indices.select(0, 2);
    auto next = at::cat({
        at::stack({triangles.select(0, 0), ab, ac}),
        at::stack({triangles.select(0, 1), ab, bc}),
        at::stack({triangles.select(0, 2), ac, bc}),
        at::stack({ab, bc, ac}),
    }, 1);
    triangles = std::get<0>(at::sort(next, 0));
    coordinates = at::cat({coordinates, midpoints}, 1);
}

void run() {
    at::set_num_threads(1);
    at::set_num_interop_threads(1);
    if (std::fesetenv(FE_DFL_ENV) != 0) {
        throw std::runtime_error("cannot establish the binary64 environment");
    }
    std::array<unsigned char, input_header.size()> header{};
    if (std::fread(header.data(), 1, header.size(), stdin) != header.size() || header != input_header) {
        throw std::runtime_error("triangle seed header differs from the refinement contract");
    }
    auto coordinates = read_tensor({2, seed_vertices}, at::kDouble);
    auto triangles = read_tensor({3, seed_cells}, at::kInt).to(at::kLong);
    const auto values = read_tensor({3, points}, at::kDouble);
    const auto derivatives = read_tensor({3, 2, points}, at::kDouble);
    const auto weights = read_tensor({points}, at::kDouble);
    if (std::fgetc(stdin) != EOF || std::ferror(stdin)
            || triangles.min().item<std::int64_t>() < 0 || triangles.max().item<std::int64_t>() >= seed_vertices
            || !triangles[0].lt(triangles[1]).all().item<bool>() || !triangles[1].lt(triangles[2]).all().item<bool>()) {
        throw std::runtime_error("triangle seed has invalid connectivity or trailing data");
    }
    for (std::int64_t round = 0; round < depth; ++round) {
        refine(coordinates, triangles);
    }
    if (coordinates.size(1) != vertices || triangles.size(1) != cells || !at::isfinite(coordinates).all().item<bool>()) {
        throw std::runtime_error("refinement differs from the qualified mesh geometry");
    }
    const auto edge = facets(triangles, vertices);
    const auto boundary = edge.incidence.eq(1);
    auto endpoints = at::cat({edge.first.masked_select(boundary), edge.second.masked_select(boundary)}, 0);
    const auto constraints = std::get<0>(at::_unique2(endpoints, true, false, false)).to(at::kInt);
    if (constraints.numel() != rows) {
        throw std::runtime_error("boundary vertices differ from the selected wire dimension");
    }
    write_bytes(header.data() + seed_header_bytes, header.size() - seed_header_bytes);
    write_tensor(coordinates);
    write_tensor(triangles.to(at::kInt));
    write_tensor(values);
    write_tensor(derivatives);
    write_tensor(weights);
    write_tensor(constraints);
    if (std::fflush(stdout) != 0) {
        throw std::runtime_error("cannot flush refined mesh");
    }
}
}  // namespace

int main() {
    try {
        run();
        return 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "%s\n", error.what());
        return 1;
    }
}
