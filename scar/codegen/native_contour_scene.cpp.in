#include "contour_scene.hpp"
#include "mpl2014.h"

#include <array>
#include <bit>
#include <fstream>
#include <limits>
#include <memory>
#include <stdexcept>
#include <string_view>

namespace scar::contour {
namespace {

static_assert(std::endian::native == std::endian::little);
static_assert(sizeof(double) == 8 && std::numeric_limits<double>::is_iec559);
constexpr std::size_t max_input_bytes = 64 * 1024 * 1024;
constexpr std::size_t header_bytes = 8 + 7 * sizeof(std::uint64_t);

void require(bool valid, const char* reason) {
    if (!valid) throw std::invalid_argument(reason);
}

std::size_t grid_points(std::size_t rows, std::size_t cols) {
    require(rows >= 2 && cols >= 2, "contour grid must have at least two rows and columns");
    require(rows <= max_input_bytes / (3 * sizeof(double)) / cols, "contour grid exceeds the input ABI");
    return rows * cols;
}

template<class T>
void read(std::ifstream& stream, T* target, std::size_t size) {
    stream.read(reinterpret_cast<char*>(target), static_cast<std::streamsize>(size * sizeof(T)));
}

template<class T>
void read_vector(std::ifstream& stream, std::vector<T>& target, std::size_t size) {
    target.resize(size);
    read(stream, target.data(), size);
}

template<class T>
void write(std::ofstream& stream, const T* data, std::size_t count) {
    stream.write(reinterpret_cast<const char*>(data), static_cast<std::streamsize>(count * sizeof(T)));
}

void write_count(std::ofstream& stream, std::size_t count) {
    const auto value = static_cast<std::uint64_t>(count);
    write(stream, &value, 1);
}

}

Grid read_input(const std::filesystem::path& path) {
    const auto bytes = std::filesystem::file_size(path);
    require(bytes >= header_bytes && bytes <= max_input_bytes, "contour input size differs");
    std::ifstream stream(path, std::ios::binary);
    stream.exceptions(std::ios::badbit | std::ios::failbit);
    std::array<char, 8> magic{};
    std::array<std::uint64_t, 7> header{};
    read(stream, magic.data(), magic.size());
    read(stream, header.data(), header.size());
    require(std::string_view(magic.data(), magic.size()) == "SCARCTI1", "contour input magic differs");
    const auto [rows, cols, nlevels, corner_mask, x_chunk, y_chunk, mask] = header;
    require(rows <= max_input_bytes && cols <= max_input_bytes, "invalid contour dimensions");
    const auto points = grid_points(rows, cols);
    require(nlevels >= 2 && nlevels <= max_input_bytes / sizeof(double),
            "invalid number of contour levels");
    require(corner_mask <= 1 && mask <= 1 && x_chunk <= cols && y_chunk <= rows,
            "invalid contour options");
    require(bytes == header_bytes + (3 * points + nlevels) * sizeof(double) + mask * points,
            "contour input payload size differs");
    Grid result;
    result.rows = rows;
    result.cols = cols;
    result.corner_mask = corner_mask == 1;
    result.x_chunk_size = x_chunk;
    result.y_chunk_size = y_chunk;
    read_vector(stream, result.x, points);
    read_vector(stream, result.y, points);
    read_vector(stream, result.z, points);
    read_vector(stream, result.levels, nlevels);
    if (mask) read_vector(stream, result.mask, points);
    return result;
}

std::vector<Band> filled_grid(const Grid& grid) {
    using contourpy::CoordinateArray;
    using contourpy::MaskArray;
    const auto points = grid_points(grid.rows, grid.cols);
    require(grid.x.size() == points && grid.y.size() == points && grid.z.size() == points &&
            (grid.mask.empty() || grid.mask.size() == points), "contour array sizes differ");
    require(grid.x_chunk_size <= grid.cols && grid.y_chunk_size <= grid.rows &&
            grid.levels.size() >= 2 && grid.levels.size() <= max_input_bytes / sizeof(double),
            "invalid contour options");
    const auto rows = static_cast<contourpy::index_t>(grid.rows);
    const auto cols = static_cast<contourpy::index_t>(grid.cols);
    std::unique_ptr<bool[]> mask;
    if (!grid.mask.empty()) {
        mask = std::make_unique<bool[]>(points);
        for (std::size_t i = 0; i < points; ++i) {
            require(grid.mask[i] <= 1, "contour mask must contain bool values");
            mask[i] = grid.mask[i] == 1;
        }
    }
    contourpy::mpl2014::Mpl2014ContourGenerator generator(
        CoordinateArray{grid.x.data(), rows, cols}, CoordinateArray{grid.y.data(), rows, cols},
        CoordinateArray{grid.z.data(), rows, cols}, MaskArray{mask.get(), rows, cols},
        grid.corner_mask, grid.x_chunk_size, grid.y_chunk_size);
    std::vector<Band> bands;
    bands.reserve(grid.levels.size() - 1);
    for (std::size_t i = 1; i < grid.levels.size(); ++i) {
        auto [vertices, codes] = generator.filled(grid.levels[i - 1], grid.levels[i]);
        require(vertices.size() == codes.size(), "contour result polygon counts differ");
        auto& band = bands.emplace_back();
        band.reserve(vertices.size());
        for (std::size_t j = 0; j < vertices.size(); ++j)
            band.push_back({std::move(vertices[j]), std::move(codes[j])});
    }
    return bands;
}

void write_output(const std::filesystem::path& path, const std::vector<Band>& bands) {
    std::ofstream stream(path, std::ios::binary);
    stream.exceptions(std::ios::badbit | std::ios::failbit);
    write(stream, "SCARCTO1", 8);
    write_count(stream, bands.size());
    for (const auto& band : bands) {
        write_count(stream, band.size());
        for (const auto& polygon : band) {
            require(polygon.xy.size() == 2 * polygon.codes.size(), "contour output geometry differs");
            write_count(stream, polygon.codes.size());
            write(stream, polygon.xy.data(), polygon.xy.size());
            write(stream, polygon.codes.data(), polygon.codes.size());
        }
    }
    stream.close();
}

}
