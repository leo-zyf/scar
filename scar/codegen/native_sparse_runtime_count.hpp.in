#pragma once

#include <charconv>
#include <cstdint>
#include <stdexcept>
#include <string_view>
#include <system_error>

inline std::uint32_t scar_runtime_count(std::string_view token) {
    if (token.empty() || token.front() < '1' || token.front() > '9') {
        throw std::runtime_error("expected a canonical positive decimal iteration count");
    }
    std::uint32_t count = 0;
    const auto parsed = std::from_chars(token.data(), token.data() + token.size(), count);
    if (parsed.ec != std::errc{} || parsed.ptr != token.data() + token.size()
            || count < @SCAR_MIN@ || count > @SCAR_MAX@) {
        throw std::runtime_error("iteration count is outside the admitted positive integer range");
    }
    return count;
}
