#pragma once

#include <array>
#include <cstddef>
#include <span>
#include <vector>

namespace scar::contour {

using Rgba = std::array<double, 4>;

// Matplotlib 3.11.2, linear filled contours, default steps, no extensions,
// nonsymmetric MaxNLocator, data autolimits and default Normalize.
struct StyleParameters {
    std::size_t nbins;
    std::size_t min_n_ticks;
};

struct ContourStyle {
    std::vector<double> levels;
    std::vector<double> contour_levels;
    std::vector<double> layers;
    std::vector<Rgba> colors;
};

// lut stores the original N rows followed by under, over and bad rows.
ContourStyle make_style(double zmin, double zmax, const StyleParameters& parameters,
                        std::span<const Rgba> lut);

}
