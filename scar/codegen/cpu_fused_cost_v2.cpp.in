#ifndef _GNU_SOURCE
#define _GNU_SOURCE
#endif
#include "scar_abi_v1.h"
#include <algorithm>
#include <bit>
#include <cerrno>
#include <cfenv>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <memory>
#include <new>
#include <sched.h>
#include <unistd.h>
#include <vector>
#include <omp.h>
#pragma STDC FENV_ACCESS ON
namespace {
constexpr int planned_cpu_ids[] = {@CPU_IDS@};
constexpr size_t minimum_cpu_slots = @CPU_SLOTS@;
constexpr int32_t affinity_guard_status = 4;
constexpr int floating_flags = FE_DIVBYZERO | FE_INVALID | FE_OVERFLOW | FE_UNDERFLOW;
@AFFINITY_CLASS@
@FLOATING_CLASS@
using Clock=std::chrono::steady_clock;
double clock_ns(){return std::chrono::duration<double,std::nano>(Clock::now().time_since_epoch()).count();}
void fence(const void *p){asm volatile("" : : "g"(p) : "memory");}
struct Layout {int64_t rows,cols,strides[8],offsets[8];int32_t groups[8],loads;};
struct Args {int64_t rows,cols;double *inputs[8],*output;double scalars[16];};
@CANONICAL_FUNCTIONS@
using Kernel=void(*)(const Args &);
constexpr Kernel kernels[]={@CANONICAL_POINTERS@};
constexpr int required_loads[]={@CANONICAL_LOADS@};
}
extern "C" SCAR_EXPORT_V1 int32_t scar_fused_cost_probe_v2(int32_t primitive,const Layout *layout,
    uint64_t repetitions,uint64_t warmup,uint64_t batch,double *samples,uint64_t *checksum,int32_t *observed_cpu){
    if(!layout||!samples||!checksum||!observed_cpu||primitive<0||primitive>=int(sizeof(kernels)/sizeof(Kernel))||
        !repetitions||repetitions>10000||warmup>10000||!batch||batch>1024)return 1;
    const Layout &l=*layout;
    if(l.rows<1||l.cols<1||l.loads!=required_loads[primitive]||__int128(l.rows)*l.cols>4*1024*1024)return 1;
    std::unique_ptr<double[]> bases[8];uint64_t sizes[8]={};
    for(int i=0;i<l.loads;++i){
        if(l.groups[i]<0||l.groups[i]>=8||l.strides[i]<l.cols||l.offsets[i]<0)return 1;
        const __int128 size=__int128(l.rows-1)*l.strides[i]+l.offsets[i]+l.cols;
        if(size>PTRDIFF_MAX/8)return 1;
        sizes[l.groups[i]]=std::max(sizes[l.groups[i]],static_cast<uint64_t>(size));
    }
    uint64_t bytes=0;for(uint64_t n:sizes)bytes+=n*8;
    if(bytes>128*1024*1024)return 7;
    for(int i=0;i<8;++i)if(sizes[i]){bases[i].reset(new(std::nothrow)double[sizes[i]]);if(!bases[i])return 5;}
    std::unique_ptr<double[]> output(new(std::nothrow)double[l.rows*l.cols]);if(!output)return 5;
    Args a{};a.rows=l.rows;a.cols=l.cols;a.output=output.get();
    for(int i=0;i<8;++i)a.inputs[i]=bases[i].get();
    for(int i=0;i<16;++i)a.scalars[i]=0.625+double(i%5)/32;
    ThreadAffinity caller;for(int cpu:planned_cpu_ids)if(!caller.contains(cpu))return 4;
    FloatingScope caller_environment;if(!caller_environment.begin())return 3;
    fenv_t execution;if(std::fegetenv(&execution)!=0)return 3;
    observed_cpu[0]=sched_getcpu();
    constexpr int workers=sizeof(planned_cpu_ids)/sizeof(int);
    double elapsed[workers]={};uint32_t guard=0,ready_guard=0;uint64_t sink=0;
    #pragma omp parallel num_threads(workers) reduction(|:guard) reduction(^:sink)
    {
        ThreadAffinity affinity;FloatingScope environment;
        const bool ready=omp_get_num_threads()==workers&&affinity.bind(planned_cpu_ids[omp_get_thread_num()]);
        const bool floating_ready=environment.begin(&execution);
        #pragma omp atomic update
        ready_guard|=static_cast<uint32_t>(!ready||!floating_ready);
        #pragma omp barrier
        if(!ready_guard){
            for(int group=0;group<8;++group){
                #pragma omp for schedule(static)
                for(uint64_t i=0;i<sizes[group];++i)bases[group][i]=1.25+double(i%8)/64;
            }
            for(uint64_t iteration=0;iteration<repetitions+warmup;++iteration){
                fence(&a);
                #pragma omp barrier
                const double start=clock_ns();
                for(uint64_t stage=0;stage<batch;++stage){kernels[primitive](a);fence(a.output);}
                elapsed[omp_get_thread_num()]=clock_ns()-start;
                #pragma omp barrier
                #pragma omp master
                if(iteration>=warmup)samples[iteration-warmup]=*std::max_element(elapsed,elapsed+workers)/batch;
                #pragma omp barrier
            }
            #pragma omp for schedule(static)
            for(int64_t i=0;i<l.rows*l.cols;++i)sink^=std::bit_cast<uint64_t>(output[i]);
        }
        guard|=static_cast<uint32_t>(!ready||!floating_ready||std::fetestexcept(floating_flags));
        guard|=static_cast<uint32_t>(!environment.restore());
        const bool kept=affinity.bound(),restored=affinity.restore();guard|=static_cast<uint32_t>(!kept||!restored);
    }
    guard|=ready_guard;guard|=static_cast<uint32_t>(std::fetestexcept(floating_flags));
    const bool restored_fenv=caller_environment.restore(),restored_affinity=caller.restore_original();
    observed_cpu[1]=sched_getcpu();*checksum=sink;
    return guard||!restored_fenv||!restored_affinity?3:0;
}
