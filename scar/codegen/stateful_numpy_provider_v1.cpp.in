#include "stateful_abi_v1.h"

#include <cfenv>
#include <cstdint>
#include <cstring>
#include <stdexcept>

asm(R"SCAR_NUMPY(
@ORIGINAL_MACHINE_CODE@
)SCAR_NUMPY");

extern "C" void scar_numpy_legacy_double_power(char**, const intptr_t*, const intptr_t*, void*);

namespace {
char qualified_context;

int broadcast_square(void* context, char** data, const intptr_t* dimensions,
                     const intptr_t* strides, void* auxiliary) {
    if (context != &qualified_context || auxiliary || !data || !data[0] || !data[1] || !data[2] ||
        !dimensions || !strides || dimensions[0] < 0 ||
        strides[0] != 8 || strides[1] != 0 || strides[2] != 8) return 1;
    std::uint64_t exponent;
    std::memcpy(&exponent, data[1], sizeof exponent);
    if (exponent != UINT64_C(0x4000000000000000)) return 1;
    scar_numpy_legacy_double_power(data, dimensions, strides, nullptr);
    return 0;
}
}

scar_provider_v1 scar_numpy_power_provider() {
    __builtin_cpu_init();
    if (!__builtin_cpu_supports("avx2") || __builtin_cpu_supports("avx512f") ||
        std::fegetround() != FE_TONEAREST) {
        throw std::runtime_error("original NumPy power CPU or rounding context differs");
    }
    return {broadcast_square, &qualified_context, nullptr};
}
