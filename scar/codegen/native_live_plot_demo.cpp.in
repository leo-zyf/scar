#include "native_live_plot_abi_v1.h"
#include "live_plot_profile.hpp"

#include <array>
#include <charconv>
#include <fstream>
#include <iostream>
#include <stdexcept>
#include <string_view>
#include <vector>

struct Root {
    std::vector<char> storage;

    Root(const char* path, const char* offset, const std::array<std::int64_t, 2>& shape)
        : storage(static_cast<std::size_t>(shape[0] * shape[1] * 8)) {
        std::uint64_t start{};
        const std::string_view text(offset);
        const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), start);
        if (error != std::errc{} || end != text.data() + text.size() || start > 64'000'000)
            throw std::runtime_error("demo expects a bounded root byte offset");
        std::ifstream input(path, std::ios::binary);
        input.seekg(start);
        if (!input.read(storage.data(), storage.size()))
            throw std::runtime_error("demo input does not contain the complete root");
    }

    scar_array_v1 descriptor(const std::array<std::int64_t, 2>& shape) {
        const auto low = reinterpret_cast<std::uintptr_t>(storage.data());
        return {storage.data(), 2, {shape[0], shape[1]}, {shape[1] * 8, 8}, low, low + storage.size()};
    }
};

int main(int argc, char** argv) {
    try {
        if (argc != 11) throw std::runtime_error("expected LAYOUT FONT OUTPUT TIME X OFF Y OFF Z OFF");
        std::array<Root, 3> roots{
            Root(argv[5], argv[6], scar::live::root_shapes[0]),
            Root(argv[7], argv[8], scar::live::root_shapes[1]),
            Root(argv[9], argv[10], scar::live::root_shapes[2])};
        const auto x = roots[0].descriptor(scar::live::root_shapes[0]);
        const auto y = roots[1].descriptor(scar::live::root_shapes[1]);
        const auto z = roots[2].descriptor(scar::live::root_shapes[2]);
        std::size_t consumed{};
        const auto time = std::stod(argv[4], &consumed);
        if (consumed != std::string_view(argv[4]).size()) throw std::runtime_error("invalid demo time");
        std::array<char, 512> error{};
        const auto status = scar_live_plot_v1(&x, &y, &z, time, argv[1], argv[2], argv[3],
                                            error.data(), error.size());
        if (status) std::cerr << error.data() << '\n';
        return status;
    } catch (const std::exception& failure) {
        std::cerr << failure.what() << '\n';
        return 1;
    }
}
