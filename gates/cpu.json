    {
      "id": "HARDWARE_TOPOLOGY",
      "tests": ["tests/unit/test_target_replay_transaction.py", "tests/unit/test_cpu_hardware_placement.py"]
    },
    {
      "id": "M1_LEGAL_GRAPH_REWRITE",
      "tests": ["tests/unit/test_array_motion_legality.py", "tests/unit/test_native_plan_contract.py"]
    },
    {
      "id": "M2_RESOURCE_AND_TIME_COST",
      "tests": ["tests/unit/test_cpu_instruction_cost.py", "tests/unit/test_resource_solver.py"]
    },
    {
      "id": "M3_SEALED_SCHEDULE",
      "tests": [
        "tests/integration/test_native_stage_handoff.py::test_native_middle_replays_cost_and_schedule",
        "tests/unit/test_execution_recipe.py",
        "tests/unit/test_invariant_loop_schedule.py", "tests/unit/test_temporal_cpu_choices.py"
      ]
    },
    {
      "id": "B1_CPP20_LOWERING_AND_LINKAGE",
      "tests": [
        "tests/integration/test_native_stage_handoff.py::test_native_backend_delivers_cpp20_and_matches_locked_cases",
        "tests/integration/test_native_stage_handoff.py::test_native_lowering_requires_an_abi_bridge_for_kr_promotions"
      ]
    },
    {
      "id": "B2_NATIVE_CONTRACT",
      "tests": [
        "tests/unit/test_native_temporal_invariant.py",
        "tests/unit/test_export_loop.py",
        "tests/unit/test_caller_pipeline_capsule.py",
        "tests/unit/test_deployment_gate.py",
