{
  "gate": "CPU_COMPILER",
  "scope": "Independent source, graph, planning and C++20 delivery contracts on Linux CPU.",
  "limitations": [
    "Cases are bounded CPU workloads and verify the supported language profiles.",
    "CI verifies output equivalence, resource constraints and receipt replay. Wall-clock speed is not an acceptance threshold on shared runners.",
    "GPU and NPU qualification use separate target evidence."
  ],
  "criteria": [
    {
      "id": "F0_SOURCE_LOCK",
      "tests": [
        "tests/unit/test_source_bytes.py",
        "tests/integration/test_native_stage_handoff.py::test_native_frontend_locks_each_dialect"
      ]
    },
    {
      "id": "F1_TOKENS",
      "tests": ["tests/unit/test_source_tokens.py"]
    },
    {
      "id": "F2_SYNTAX",
      "tests": ["tests/unit/test_source_syntax.py"]
    },
    {
      "id": "F3_SYMBOLS_AND_CONTEXT",
      "tests": [
        "tests/unit/test_source_symbols.py",
        "tests/unit/test_source_contexts.py",
        "tests/unit/test_source_context_variants.py",
        "tests/unit/test_source_binding_variants.py",
        "tests/unit/test_compiler_topology.py"
      ]
    },
    {
      "id": "F4_TYPED_PROGRAM_GRAPH",
      "tests": [
        "tests/integration/test_formal_call_operands.py",
        "tests/integration/test_native_stage_handoff.py::test_native_graph_links_calls_and_platform",
        "tests/unit/test_ir.py::test_graph_validation_proves_static_line_coverage",
